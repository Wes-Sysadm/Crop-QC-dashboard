@model SampleDetailViewModel
@using System.Text.Json
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject IUserAccessService UserAccess
@{
    ViewData["Title"] = "QC Sample Detail";
    var defectOptionsJson = JsonSerializer.Serialize(Model.DefectTypes.Select(x => new { id = x.Id, name = x.Name }));
    var pageRefreshEnabled = bool.TryParse(Configuration["PageRefresh:Enabled"], out var parsedRefreshEnabled) ? parsedRefreshEnabled : true;
    var refreshIntervalMs = (int.TryParse(Configuration["PageRefresh:IntervalSeconds"], out var parsedRefreshInterval) ? Math.Clamp(parsedRefreshInterval, 15, 300) : 20) * 1000;
    var canEditDailyQc = await UserAccess.HasAccessAsync(User, ApplicationAreas.DailyQc, PageAccessLevel.Edit, Context.RequestAborted);
    var canAdminDailyQc = await UserAccess.HasAccessAsync(User, ApplicationAreas.DailyQc, PageAccessLevel.Admin, Context.RequestAborted);
}

<h1>QC Sample Detail</h1>
@if (TempData["Success"] is string success)
{
    <p class="notice success">@success</p>
}
@if (TempData["Warning"] is string warning)
{
    <p class="notice warning">@warning</p>
}
@if (TempData["Error"] is string error)
{
    <p class="notice error">@error</p>
}
@if (Model.DataWarning is not null)
{
    <p class="notice warning">@Model.DataWarning</p>
}
@if (Model.Sample is not null)
{
    <section class="panel">
        <h2>@Model.Sample.DisplayReceiptId</h2>
        <p>@Model.Sample.Warehouse | @Model.Sample.SampleType | @Model.Sample.Status | Starch: @Model.Sample.StarchStatus | Photos: @Model.Sample.PhotoStatus | Email: @Model.Sample.EmailStatus | Target sample size: @Model.TargetSampleSize | Entered fruit count: @Model.EnteredFruitCount</p>
        <p>@StarchSummary(Model.Readiness)</p>
        @if (CanChangeSampleType(Model.Sample.EmailStatus, canEditDailyQc, canAdminDailyQc))
        {
            <form method="post" action="/Samples/@Model.Sample.Id/sample-type" class="inline-form">
                <label>
                    Sample type
                    <select name="SampleTypeId">
                        @foreach (var sampleType in Model.SampleTypes)
                        {
                            <option value="@sampleType.Id" selected="@(string.Equals(sampleType.Name, Model.Sample.SampleType, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@sampleType.Name</option>
                        }
                    </select>
                </label>
                <button type="submit" class="secondary-button">Update Sample Type</button>
            </form>
        }
        <p>
            <a class="button" href="/Samples/@Model.Sample.Id/Starch">Starch Input</a>
            <a href="/Receipts/@Model.Sample.ReceiptId">Back to receipt</a>
            @if (canAdminDailyQc)
            {
                <a class="button secondary-button danger-link" href="/Samples/@Model.Sample.Id/Delete">Delete Sample</a>
            }
        </p>
    </section>

    <section class="panel">
        <h2>FTA Pressure Capture</h2>
        <p>FTA pressure capture is done through the local QC Station app. The browser does not connect directly to the physical FTA DLL.</p>
        <p>Selected sample: <strong>@Model.Sample.DisplayReceiptId</strong> | Sample ID: <code>@Model.Sample.Id</code> | Receipt ID: <code>@Model.Sample.ReceiptIdText</code></p>
        <p>Click Open in QC Station to launch the local WinForms app for <strong>@Model.Sample.DisplayReceiptId</strong>, then start continuous manual capture. Use the local Crop QC Station app for FTA pressure readings. Continue entering weight and grade on this page as needed.</p>
        <p>
            <button type="button" class="secondary-button" data-copy-sample-id="@Model.Sample.Id">Copy Sample ID</button>
            <a class="button secondary-button" href="cropqcstation://sample/@Model.Sample.Id">Open in QC Station</a>
        </p>
        <p class="muted">Requires the Crop QC Station app installer to be installed and a station config imported. If nothing opens, install the QC Station App Installer from Admin -> Downloads. If the app opens but cannot connect, rotate/download station config from Admin -> QC Stations and import it through Station Setup -> Import Station Config. The link sends only the sample ID; the station code and API key stay in the local config.</p>
    </section>
}

<section class="panel">
    <h2>Summary Readiness</h2>
    <p><span class="status @(Model.Readiness.IsReady ? "ready" : "missing")">@(Model.Readiness.IsReady ? "Ready to Send" : "Missing Required Data")</span></p>
    <p>Completed fruit: @Model.Readiness.CompletedFruitCount | Starch missing: @Model.Readiness.StarchMissingCount</p>
    <p>Sample type: @Model.Sample?.SampleType</p>
    @await Html.PartialAsync("_ReadinessChecklist", Model.Readiness.Checklist.Where(x => x.Category != "Required photos").ToList())
    @if (Model.Readiness.MissingItems.Count > 0)
    {
        <ul class="list">
        @foreach (var item in Model.Readiness.MissingItems)
        {
            <li>@item</li>
        }
        </ul>
    }
    @if (Model.Readiness.IsReady)
    {
        @if (canEditDailyQc)
        {
            <form method="post" action="/Samples/@Model.Sample?.Id/Send" class="inline-form">
                <p class="muted">Sending from: @User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>
                <p class="muted">To: @(Model.RecipientEmail ?? "configured QC recipients")</p>
                <button type="submit">Send QC Summary</button>
            </form>
        }
        else
        {
            <p class="muted">Viewers cannot send QC Summary email.</p>
        }
    }
    else
    {
        <button type="button" disabled>Send QC Summary</button>
        @if (Model.Sample is not null)
        {
            @if (canAdminDailyQc)
            {
                <a class="button secondary-button" href="/Samples/@Model.Sample.Id/OverrideSend">Override Send With Missing Data - Manager/Admin</a>
            }
        }
    }
</section>

@if (Model.Sample is not null)
{
    <form method="post" action="/Samples/@Model.Sample.Id/rows" id="qc-rows-form" data-sample-id="@Model.Sample.Id" data-refresh-url="/Samples/@Model.Sample.Id/refresh">
        <input type="hidden" name="SampleId" value="@Model.Sample.Id" />
        <div class="toolbar">
            <label class="field">
                Sample size
                <select name="TargetSampleSize" id="target-sample-size">
                    @foreach (var size in Model.AllowedSampleSizes)
                    {
                        <option value="@size" selected="@(size == Model.TargetSampleSize ? "selected" : null)">@size</option>
                    }
                </select>
            </label>
            <button type="button" class="secondary-button" id="refresh-sample-data">Refresh</button>
            <span class="muted" id="sample-refresh-status" aria-live="polite">Last updated: @DateTime.Now.ToString("h:mm:ss tt")</span>
        </div>
        <p class="notice warning" id="sample-size-warning" hidden>Reducing target sample size does not delete existing saved rows. Existing entered rows remain visible unless manually cleared.</p>
        <p class="notice warning" id="server-update-warning" hidden>New pressure data is available from QC Station. Save or discard your changes to refresh.</p>
        <h2>QC Grid</h2>
        <div class="table-wrap qc-grid-wrap">
            <table class="qc-grid">
                <thead>
                    <tr>
                        <th class="compact-cell">Row</th>
                        <th class="numeric-cell">P1 lbs</th>
                        <th class="numeric-cell">P2 lbs</th>
                        <th class="numeric-cell">Avg lbs</th>
                        <th class="numeric-cell">Weight g</th>
                        <th class="compact-cell">Grade</th>
                        <th class="wide-cell">Defects</th>
                        <th class="wide-cell">Other notes</th>
                        <th class="compact-cell">Size</th>
                        <th class="nowrap-cell">Size Status</th>
                        <th class="nowrap-cell">Status</th>
                    </tr>
                </thead>
                <tbody>
                @for (var i = 0; i < Model.FruitRows.Count; i++)
                {
                    var row = Model.FruitRows[i];
                    <tr class="fruit-row" data-row-index="@i" data-row-number="@row.RowNumber">
                        <td class="compact-cell">
                            @row.RowNumber
                            <input type="hidden" name="Rows[@i].RowNumber" value="@row.RowNumber" />
                        </td>
                        <td class="numeric-cell"><input class="number-input" name="Rows[@i].Pressure1Lbs" type="number" step="0.01" min="0" value="@row.Pressure1Lbs" /></td>
                        <td class="numeric-cell"><input class="number-input" name="Rows[@i].Pressure2Lbs" type="number" step="0.01" min="0" value="@row.Pressure2Lbs" /></td>
                        <td class="numeric-cell pressure-average">@row.PressureAverageLbs</td>
                        <td class="numeric-cell"><input class="number-input" name="Rows[@i].WeightGrams" type="number" step="0.0001" min="0" value="@row.WeightGrams" /></td>
                        <td class="compact-cell">
                            <select name="Rows[@i].GradeId">
                                <option value="">--</option>
                                @foreach (var grade in Model.Grades)
                                {
                                    <option value="@grade.Id" selected="@(row.GradeId == grade.Id ? "selected" : null)">@grade.Code</option>
                                }
                            </select>
                        </td>
                        <td class="wide-cell">
                            <div class="selected-defects" data-row-index="@i"></div>
                            <div class="defect-hidden-inputs" data-row-index="@i">
                                @foreach (var defectId in row.DefectTypeIds)
                                {
                                    <input type="hidden" name="Rows[@i].DefectTypeIds" value="@defectId" />
                                }
                            </div>
                            <div class="defect-palette" aria-label="Available defects for row @row.RowNumber">
                                @foreach (var defect in Model.DefectTypes)
                                {
                                    <button type="button" class="chip chip-action" data-defect-id="@defect.Id" data-defect-name="@defect.Name" title="Double-click to add @defect.Name">@defect.Name</button>
                                }
                            </div>
                        </td>
                        <td class="wide-cell"><input class="other-notes" name="Rows[@i].OtherDefectNotes" value="@row.OtherDefectNotes" disabled="@(!row.Defects.Contains("Other") ? "disabled" : null)" /></td>
                        <td class="compact-cell size-category">@row.SizeCategory</td>
                        <td class="nowrap-cell size-status">@row.SizeStatus</td>
                        <td class="nowrap-cell"><span class="status row-entry-status @StatusClass(row.EntryStatus)">@row.EntryStatus</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <p class="muted">Rows save as Empty, In Progress, or Complete. In-progress rows are saved and can be finished later. Complete rows require Pressure 1, Pressure 2, weight, and grade. Use the separate Starch Input page after fruit is cut. Changing sample size controls expected rows but never deletes existing row data.</p>
        <p class="muted">FTA readings may be captured from QC Station and saved here. Saving this grid remains available for manual pressure entry and weight/grade/defect edits.</p>
        <button type="submit">Save QC Rows</button>
    </form>

    <section>
        <h2>Photos / Requirements</h2>
        <p class="muted">Required photos vary by sample type. Receiving samples require truck photo, top of truck, Hectre, whole sample, cut apples, and starch apples. Door and lot samples require the photos configured for their sample type. Removed photos no longer count toward requirements or QC Summary emails.</p>
        <div class="grid-two">
            <div class="panel">
                <h3>Current Photos</h3>
                @await Html.PartialAsync("_PhotoGroups", Model.PhotoGroups)
            </div>
            @await Html.PartialAsync("_PhotoPlaceholderForm", new PhotoPlaceholderFormViewModel
            {
                FormAction = $"/Samples/{Model.Sample.Id}/photos",
                Title = "Add Sample Photo",
                DefaultPhotoType = Model.AddPhotoForm.PhotoType,
                PhotoTypes = Model.AvailablePhotoTypes.Select(x => x.PhotoType).Append("Other").Distinct(StringComparer.OrdinalIgnoreCase).ToList(),
                CropYear = Model.Sample.CropYear,
                Warehouse = Model.Sample.Warehouse,
                ReceiptId = Model.Sample.ReceiptIdText
            })
            <div class="panel">
                <h3>Requirements</h3>
                <ul class="compact-list">
                    @foreach (var photoType in Model.AvailablePhotoTypes)
                    {
                        var hasPhoto = Model.PhotoGroups.Any(group =>
                            string.Equals(NormalizePhotoType(group.PhotoType), NormalizePhotoType(photoType.PhotoType), StringComparison.OrdinalIgnoreCase)
                            && group.Photos.Count > 0);
                        <li>
                            @photoType.FriendlyName - @(photoType.IsRequired ? "Required" : "Optional")
                            <span class="status @(hasPhoto ? "ready" : photoType.IsRequired ? "missing" : "pending")">@(hasPhoto ? "Present" : photoType.IsRequired ? "Missing" : "Optional")</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </section>
}

<dialog id="unsaved-dialog">
    <form method="dialog" class="stack-form">
        <h2>Unsaved changes</h2>
        <p>You have unsaved QC sample changes. Save changes or discard changes before refreshing.</p>
        <div class="button-row">
            <button type="button" id="save-then-navigate">Save changes</button>
            <button type="button" class="secondary-button" id="discard-then-navigate">Discard changes</button>
            <button type="button" class="secondary-button" id="stay-on-page">Cancel</button>
        </div>
    </form>
</dialog>

<script>
    (() => {
        const defects = @Html.Raw(defectOptionsJson);
        const refreshEnabled = @JsonSerializer.Serialize(pageRefreshEnabled);
        const refreshIntervalMs = @refreshIntervalMs;
        const form = document.querySelector("#qc-rows-form");
        const refreshStatus = document.querySelector("#sample-refresh-status");
        const serverUpdateWarning = document.querySelector("#server-update-warning");
        const sampleSizeWarning = document.querySelector("#sample-size-warning");
        const targetSampleSize = document.querySelector("#target-sample-size");
        const unsavedDialog = document.querySelector("#unsaved-dialog");
        let dirty = false;
        let pendingNavigation = null;
        let pendingRefreshAfterSave = false;

        function setDirty(value) {
            dirty = value;
        }

        function showStatus(message) {
            if (!refreshStatus) return;
            refreshStatus.textContent = message;
            if (message) {
                setTimeout(() => {
                    if (refreshStatus.textContent === message) refreshStatus.textContent = "";
                }, 4500);
            }
        }

        function markDirty() {
            setDirty(true);
        }

        document.addEventListener("input", event => {
            if (event.target.closest("#unsaved-dialog")) return;
            if (event.target.matches("input, select, textarea")) markDirty();
        });
        document.addEventListener("change", event => {
            if (event.target.closest("#unsaved-dialog")) return;
            if (event.target.matches("input, select, textarea")) markDirty();
        });
        for (const pageForm of document.querySelectorAll("form")) {
            pageForm.addEventListener("submit", () => setDirty(false));
        }

        if (targetSampleSize) {
            const initialSize = Number(targetSampleSize.defaultValue || targetSampleSize.value);
            targetSampleSize.addEventListener("change", () => {
                if (sampleSizeWarning && Number(targetSampleSize.value) < initialSize) {
                    sampleSizeWarning.hidden = false;
                }
            });
        }

        function findDefectName(id) {
            return defects.find(defect => defect.id === Number(id))?.name ?? `Defect ${id}`;
        }

        function syncOtherNotes(row) {
            const hasOther = Array.from(row.querySelectorAll(".defect-hidden-inputs input"))
                .some(input => findDefectName(input.value) === "Other");
            const notes = row.querySelector(".other-notes");
            if (!notes) return;
            notes.disabled = !hasOther;
            if (!hasOther) notes.value = "";
        }

        function renderSelectedDefects(row) {
            const rowIndex = row.dataset.rowIndex;
            const target = row.querySelector(".selected-defects");
            const hiddenInputs = row.querySelector(".defect-hidden-inputs");
            target.innerHTML = "";
            for (const input of hiddenInputs.querySelectorAll("input")) {
                const chip = document.createElement("span");
                chip.className = "chip selected-chip";
                chip.textContent = findDefectName(input.value);

                const removeButton = document.createElement("button");
                removeButton.type = "button";
                removeButton.className = "chip-remove";
                removeButton.textContent = "x";
                removeButton.setAttribute("aria-label", `Remove ${chip.textContent} from row ${Number(rowIndex) + 1}`);
                removeButton.addEventListener("click", () => {
                    input.remove();
                    markDirty();
                    renderSelectedDefects(row);
                    syncOtherNotes(row);
                });

                chip.appendChild(removeButton);
                target.appendChild(chip);
            }

            syncOtherNotes(row);
        }

        function addDefect(row, button) {
            const rowIndex = row.dataset.rowIndex;
            const hiddenInputs = row.querySelector(".defect-hidden-inputs");
            const defectId = button.dataset.defectId;
            if (hiddenInputs.querySelector(`input[value="${defectId}"]`)) {
                return;
            }

            const input = document.createElement("input");
            input.type = "hidden";
            input.name = `Rows[${rowIndex}].DefectTypeIds`;
            input.value = defectId;
            hiddenInputs.appendChild(input);
            markDirty();
            renderSelectedDefects(row);
        }

        for (const row of document.querySelectorAll(".fruit-row")) {
            renderSelectedDefects(row);
            for (const button of row.querySelectorAll(".chip-action")) {
                button.addEventListener("dblclick", () => addDefect(row, button));
                button.addEventListener("click", () => addDefect(row, button));
            }
        }

        for (const button of document.querySelectorAll("[data-copy-sample-id]")) {
            button.addEventListener("click", async () => {
                const sampleId = button.dataset.copySampleId;
                try {
                    await navigator.clipboard.writeText(sampleId);
                    button.textContent = "Sample ID copied";
                } catch {
                    window.prompt("Copy QC Station sample ID", sampleId);
                }
            });
        }

        function navigateWithDirtyCheck(url) {
            if (!dirty || !unsavedDialog) {
                window.location.href = url;
                return;
            }

            pendingNavigation = url;
            unsavedDialog.showModal();
        }

        document.addEventListener("click", event => {
            const anchor = event.target.closest("a[href]");
            if (!anchor || !form || anchor.href.startsWith("cropqcstation:") || anchor.target === "_blank") return;
            if (!dirty) return;
            event.preventDefault();
            navigateWithDirtyCheck(anchor.href);
        });

        document.querySelector("#stay-on-page")?.addEventListener("click", () => {
            pendingNavigation = null;
            pendingRefreshAfterSave = false;
            unsavedDialog?.close();
        });

        document.querySelector("#discard-then-navigate")?.addEventListener("click", () => {
            setDirty(false);
            unsavedDialog?.close();
            if (pendingRefreshAfterSave) {
                pendingRefreshAfterSave = false;
                refreshSampleData(true);
                return;
            }
            if (pendingNavigation) window.location.href = pendingNavigation;
        });

        document.querySelector("#save-then-navigate")?.addEventListener("click", async () => {
            if (!form || (!pendingNavigation && !pendingRefreshAfterSave)) return;
            const response = await fetch(form.action, { method: "POST", body: new FormData(form), credentials: "same-origin" });
            if (response.ok) {
                setDirty(false);
                if (pendingRefreshAfterSave) {
                    pendingRefreshAfterSave = false;
                    unsavedDialog?.close();
                    await refreshSampleData(true);
                    return;
                }
                window.location.href = pendingNavigation;
            } else {
                showStatus("Save failed. Stay on this page and try again.");
            }
        });

        window.addEventListener("beforeunload", event => {
            if (!dirty) return;
            event.preventDefault();
            event.returnValue = "";
        });

        function updateRows(rows) {
            for (const row of rows ?? []) {
                const tr = document.querySelector(`.fruit-row[data-row-number="${row.rowNumber}"]`);
                if (!tr) continue;
                const p1 = tr.querySelector(`[name$=".Pressure1Lbs"]`);
                const p2 = tr.querySelector(`[name$=".Pressure2Lbs"]`);
                const weight = tr.querySelector(`[name$=".WeightGrams"]`);
                if (p1) p1.value = row.pressure1Lbs ?? "";
                if (p2) p2.value = row.pressure2Lbs ?? "";
                if (weight) weight.value = row.weightGrams ?? "";
                tr.querySelector(".pressure-average")?.replaceChildren(document.createTextNode(row.pressureAverageLbs ?? ""));
                tr.querySelector(".size-category")?.replaceChildren(document.createTextNode(row.sizeCategory ?? ""));
                tr.querySelector(".size-status")?.replaceChildren(document.createTextNode(row.sizeStatus ?? ""));
                const status = tr.querySelector(".row-entry-status");
                if (status) {
                    const entryStatus = row.entryStatus ?? "";
                    status.replaceChildren(document.createTextNode(entryStatus));
                    status.className = `status row-entry-status ${entryStatus === "Complete" ? "ready" : entryStatus === "In Progress" ? "pending" : "missing"}`;
                }
            }
        }

        async function refreshSampleData(manual = false) {
            if (!form) return;
            if (dirty) {
                if (serverUpdateWarning) serverUpdateWarning.hidden = false;
                if (manual) {
                    pendingNavigation = null;
                    pendingRefreshAfterSave = true;
                    unsavedDialog?.showModal();
                    showStatus("Refresh paused: unsaved changes.");
                }
                return;
            }

            const response = await fetch(form.dataset.refreshUrl, { credentials: "same-origin" });
            if (!response.ok) {
                if (manual) showStatus("Refresh failed.");
                return;
            }

            const data = await response.json();
            updateRows(data.rows);
            if (serverUpdateWarning) serverUpdateWarning.hidden = true;
            showStatus(`Updated from QC Station. Last updated: ${new Date().toLocaleTimeString()}`);
        }

        document.querySelector("#refresh-sample-data")?.addEventListener("click", () => refreshSampleData(true));
        if (form && refreshEnabled) {
            window.setInterval(() => refreshSampleData(false), refreshIntervalMs);
        }
    })();
</script>

@functions {
    private static string YesNo(bool value) => value ? "Yes" : "No";

    private static string StatusClass(string status) => status switch
    {
        "Complete" => "ready",
        "In Progress" => "pending",
        _ => "missing"
    };

    private static string StarchSummary(ReadinessViewModel readiness)
    {
        if (readiness.CompletedFruitCount == 0)
        {
            return "Starch status: no completed fruit rows yet.";
        }

        return readiness.StarchMissingCount == 0
            ? "Starch status: Starch Complete."
            : $"Starch status: {readiness.StarchMissingCount} of {readiness.CompletedFruitCount} completed rows missing starch.";
    }

    private static bool CanChangeSampleType(string emailStatus, bool canEditDailyQc, bool canAdminDailyQc) =>
        canAdminDailyQc || (!emailStatus.Equals("Sent", StringComparison.OrdinalIgnoreCase) && canEditDailyQc);

    private static string NormalizePhotoType(string? photoType)
    {
        var normalized = (photoType ?? "").Trim();
        return normalized switch
        {
            "TopTruck" or "TopTruckPhoto" or "TopOfTruckPhoto" => "TopOfTruck",
            _ when normalized.Equals("Top truck photo", StringComparison.OrdinalIgnoreCase) => "TopOfTruck",
            _ when normalized.Equals("Top of truck", StringComparison.OrdinalIgnoreCase) => "TopOfTruck",
            _ => normalized
        };
    }
}
