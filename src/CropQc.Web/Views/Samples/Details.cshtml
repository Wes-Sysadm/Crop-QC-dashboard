@model SampleDetailViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "QC Sample Detail";
    var defectOptionsJson = JsonSerializer.Serialize(Model.DefectTypes.Select(x => new { id = x.Id, name = x.Name }));
}

<h1>QC Sample Detail</h1>
@if (TempData["Success"] is string success)
{
    <p class="notice success">@success</p>
}
@if (TempData["Warning"] is string warning)
{
    <p class="notice warning">@warning</p>
}
@if (TempData["Error"] is string error)
{
    <p class="notice error">@error</p>
}
@if (Model.DataWarning is not null)
{
    <p class="notice warning">@Model.DataWarning</p>
}
@if (Model.Sample is not null)
{
    <section class="panel">
        <h2>@Model.Sample.DisplayReceiptId</h2>
        <p>@Model.Sample.Warehouse | @Model.Sample.Status | Starch: @Model.Sample.StarchStatus | Photos: @Model.Sample.PhotoStatus | Email: @Model.Sample.EmailStatus | Sample size: @Model.Sample.ActualSampleSize</p>
        <p>@StarchSummary(Model.Readiness)</p>
        <p>
            <a class="button" href="/Samples/@Model.Sample.Id/Starch">Open Starch Test</a>
            <a href="/Receipts/@Model.Sample.ReceiptId">Back to receipt</a>
        </p>
    </section>
}

<section class="panel">
    <h2>Summary Readiness</h2>
    <p><span class="status @(Model.Readiness.IsReady ? "ready" : "missing")">@(Model.Readiness.IsReady ? "Ready to Send" : "Missing Required Data")</span></p>
    <p>Completed fruit: @Model.Readiness.CompletedFruitCount | Starch missing: @Model.Readiness.StarchMissingCount</p>
    <p>Photos: Bin/truck @YesNo(Model.Readiness.HasBinTruck), before cutting @YesNo(Model.Readiness.HasSampleBeforeCutting), cut fruit @YesNo(Model.Readiness.HasCutFruit), after starch @YesNo(Model.Readiness.HasFruitAfterStarch)</p>
    @if (Model.Readiness.MissingItems.Count > 0)
    {
        <ul class="list">
        @foreach (var item in Model.Readiness.MissingItems)
        {
            <li>@item</li>
        }
        </ul>
    }
    @if (Model.Readiness.IsReady)
    {
        <button type="button">Send QC Summary Placeholder</button>
    }
    else
    {
        <button type="button" disabled>Send QC Summary Placeholder</button>
    }
</section>

@if (Model.Sample is not null)
{
    <form method="post" action="/Samples/@Model.Sample.Id/rows">
        <input type="hidden" name="SampleId" value="@Model.Sample.Id" />
        <h2>25-Row QC Grid</h2>
        <div class="table-wrap qc-grid-wrap">
            <table class="qc-grid">
                <thead>
                    <tr>
                        <th>Row</th>
                        <th>P1 lbs</th>
                        <th>P2 lbs</th>
                        <th>Avg</th>
                        <th>Weight g</th>
                        <th>Grade</th>
                        <th>Defects</th>
                        <th>Other notes</th>
                        <th>Size</th>
                        <th>Size Status</th>
                        <th>Completed</th>
                    </tr>
                </thead>
                <tbody>
                @for (var i = 0; i < Model.FruitRows.Count; i++)
                {
                    var row = Model.FruitRows[i];
                    <tr class="fruit-row" data-row-index="@i">
                        <td>
                            @row.RowNumber
                            <input type="hidden" name="Rows[@i].RowNumber" value="@row.RowNumber" />
                        </td>
                        <td><input class="number-input" name="Rows[@i].Pressure1Lbs" type="number" step="0.01" min="0" value="@row.Pressure1Lbs" /></td>
                        <td><input class="number-input" name="Rows[@i].Pressure2Lbs" type="number" step="0.01" min="0" value="@row.Pressure2Lbs" /></td>
                        <td>@row.PressureAverageLbs</td>
                        <td><input class="number-input" name="Rows[@i].WeightGrams" type="number" step="0.0001" min="0" value="@row.WeightGrams" /></td>
                        <td>
                            <select name="Rows[@i].GradeId">
                                <option value="">--</option>
                                @foreach (var grade in Model.Grades)
                                {
                                    <option value="@grade.Id" selected="@(row.GradeId == grade.Id ? "selected" : null)">@grade.Code</option>
                                }
                            </select>
                        </td>
                        <td>
                            <div class="selected-defects" data-row-index="@i"></div>
                            <div class="defect-hidden-inputs" data-row-index="@i">
                                @foreach (var defectId in row.DefectTypeIds)
                                {
                                    <input type="hidden" name="Rows[@i].DefectTypeIds" value="@defectId" />
                                }
                            </div>
                            <div class="defect-palette" aria-label="Available defects for row @row.RowNumber">
                                @foreach (var defect in Model.DefectTypes)
                                {
                                    <button type="button" class="chip chip-action" data-defect-id="@defect.Id" data-defect-name="@defect.Name" title="Double-click to add @defect.Name">@defect.Name</button>
                                }
                            </div>
                        </td>
                        <td><input class="other-notes" name="Rows[@i].OtherDefectNotes" value="@row.OtherDefectNotes" disabled="@(!row.Defects.Contains("Other") ? "disabled" : null)" /></td>
                        <td>@row.SizeCategory</td>
                        <td>@row.SizeStatus</td>
                        <td>@YesNo(row.IsCompleted)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <p class="muted">Blank rows are ignored. Use the separate Starch Test page after fruit is cut.</p>
        <button type="submit">Save QC Rows</button>
    </form>

    <section>
        <h2>Sample Photos</h2>
        <div class="grid-two">
            <div class="panel">
                <h3>Photo Metadata</h3>
                @await Html.PartialAsync("_PhotoGroups", Model.PhotoGroups)
            </div>
            @await Html.PartialAsync("_PhotoPlaceholderForm", new PhotoPlaceholderFormViewModel
            {
                FormAction = $"/Samples/{Model.Sample.Id}/photos",
                Title = "Add Sample Photo",
                DefaultPhotoType = Model.AddPhotoForm.PhotoType,
                PhotoTypes = ["SampleBeforeCutting", "CutFruit", "FruitAfterStarch", "Other"],
                CropYear = Model.Sample.CropYear,
                Warehouse = Model.Sample.Warehouse,
                ReceiptId = Model.Sample.ReceiptIdText
            })
        </div>
    </section>
}

<script>
    (() => {
        const defects = @Html.Raw(defectOptionsJson);

        function findDefectName(id) {
            return defects.find(defect => defect.id === Number(id))?.name ?? `Defect ${id}`;
        }

        function syncOtherNotes(row) {
            const hasOther = Array.from(row.querySelectorAll(".defect-hidden-inputs input"))
                .some(input => findDefectName(input.value) === "Other");
            const notes = row.querySelector(".other-notes");
            if (!notes) return;
            notes.disabled = !hasOther;
            if (!hasOther) notes.value = "";
        }

        function renderSelectedDefects(row) {
            const rowIndex = row.dataset.rowIndex;
            const target = row.querySelector(".selected-defects");
            const hiddenInputs = row.querySelector(".defect-hidden-inputs");
            target.innerHTML = "";
            for (const input of hiddenInputs.querySelectorAll("input")) {
                const chip = document.createElement("span");
                chip.className = "chip selected-chip";
                chip.textContent = findDefectName(input.value);

                const removeButton = document.createElement("button");
                removeButton.type = "button";
                removeButton.className = "chip-remove";
                removeButton.textContent = "x";
                removeButton.setAttribute("aria-label", `Remove ${chip.textContent} from row ${Number(rowIndex) + 1}`);
                removeButton.addEventListener("click", () => {
                    input.remove();
                    renderSelectedDefects(row);
                    syncOtherNotes(row);
                });

                chip.appendChild(removeButton);
                target.appendChild(chip);
            }

            syncOtherNotes(row);
        }

        function addDefect(row, button) {
            const rowIndex = row.dataset.rowIndex;
            const hiddenInputs = row.querySelector(".defect-hidden-inputs");
            const defectId = button.dataset.defectId;
            if (hiddenInputs.querySelector(`input[value="${defectId}"]`)) {
                return;
            }

            const input = document.createElement("input");
            input.type = "hidden";
            input.name = `Rows[${rowIndex}].DefectTypeIds`;
            input.value = defectId;
            hiddenInputs.appendChild(input);
            renderSelectedDefects(row);
        }

        for (const row of document.querySelectorAll(".fruit-row")) {
            renderSelectedDefects(row);
            for (const button of row.querySelectorAll(".chip-action")) {
                button.addEventListener("dblclick", () => addDefect(row, button));
                button.addEventListener("click", () => addDefect(row, button));
            }
        }
    })();
</script>

@functions {
    private static string YesNo(bool value) => value ? "Yes" : "No";

    private static string StarchSummary(ReadinessViewModel readiness)
    {
        if (readiness.CompletedFruitCount == 0)
        {
            return "Starch status: no completed fruit rows yet.";
        }

        return readiness.StarchMissingCount == 0
            ? "Starch status: Starch Complete."
            : $"Starch status: {readiness.StarchMissingCount} of {readiness.CompletedFruitCount} completed rows missing starch.";
    }
}
