@model StarchTestViewModel
@inject IUserAccessService UserAccess
@{
    ViewData["Title"] = Model.Sample is null ? "Starch Input" : $"Starch Input - {Model.Sample.DisplayReceiptId}";
    var availableFruitNumbers = Model.FruitRows.Select(x => x.RowNumber).ToHashSet();
    var trayPositions = Enumerable.Range(0, 5)
        .SelectMany(trayRow => Enumerable.Range(0, 5).Select(trayColumn => trayColumn * 5 + trayRow + 1))
        .Where(availableFruitNumbers.Contains)
        .Concat(availableFruitNumbers.Where(x => x > 25).OrderBy(x => x))
        .ToList();
    var canEditDailyQc = await UserAccess.HasAccessAsync(User, ApplicationAreas.DailyQc, PageAccessLevel.Edit, Context.RequestAborted);
}

<h1>@ViewData["Title"]</h1>
@if (TempData["Success"] is string success)
{
    <p class="notice success">@success</p>
}
@if (TempData["Error"] is string error)
{
    <p class="notice error">@error</p>
}
@if (Model.DataWarning is not null)
{
    <p class="notice warning">@Model.DataWarning</p>
}

@if (Model.Sample is not null && Model.Receipt is not null)
{
    <section class="panel">
        <h2>@Model.Sample.DisplayReceiptId</h2>
        <div class="detail-grid">
            <div><strong>Display receipt ID:</strong> @Model.Sample.DisplayReceiptId</div>
            <div><strong>Original receipt ID:</strong> @Model.Receipt.CompuTechReceiptId</div>
            <div><strong>Grower:</strong> @Model.Receipt.GrowerName</div>
            <div><strong>Lot:</strong> @Model.Receipt.LotCode</div>
            <div><strong>Variety:</strong> @Model.Receipt.VarietyCode</div>
            <div><strong>Warehouse:</strong> @Model.Receipt.Warehouse</div>
            <div><strong>Room:</strong> @Model.Receipt.Room</div>
            <div><strong>Sample time:</strong> @BusinessTime.FormatPacific(Model.Sample.SampleTakenAt)</div>
            <div><strong>Starch:</strong> @StarchSummary(Model.Readiness)</div>
        </div>
        <p>
            <a href="/Receipts/@Model.Sample.ReceiptId">Back to receipt detail</a>
            <a class="inline-action" href="/Samples/@Model.Sample.Id">Back to sample detail</a>
        </p>
    </section>

    <section class="panel">
        <h2>QC Station and Browser Capture Status</h2>
        <p class="notice" data-starch-station-state="@Model.QcStationStatus.State">
            <strong>QC Station: @Model.QcStationStatus.State.</strong> @Model.QcStationStatus.Message
        </p>
        <p class="muted" data-starch-browser-status>The Starch form loads independently from QC Station and camera access. Camera diagnostics will appear in the device panel below.</p>
        <div class="button-row">
            <a class="button secondary-button" href="cropqcstation://sample/@Model.Sample.Id">Open / Retry QC Station</a>
            <button type="button" class="secondary-button" data-retry-starch-capture>Retry browser capture</button>
        </div>
    </section>

    <section class="panel">
        <h2>Starch Readiness</h2>
        <p>Completed fruit rows: @Model.Readiness.CompletedFruitCount | Rows missing starch: @Model.Readiness.StarchMissingCount</p>
        <p>FruitAfterStarch photo: <span class="status @(Model.Readiness.HasFruitAfterStarch ? "ready" : "missing")">@(Model.Readiness.HasFruitAfterStarch ? "Complete" : "Missing")</span></p>
        <p class="muted">The after-starch photo is required before the normal QC Summary send can be used.</p>
    </section>

    @if (canEditDailyQc)
    {
        @await Html.PartialAsync("_DeviceCapturePanel", new DeviceCapturePanelViewModel(
            Model.DeviceCapture,
            StarchPhotoAction: $"/Samples/{Model.Sample.Id}/Starch/photos",
            ShowApplePhotos: true))
    }

    <form method="post" action="/Samples/@Model.Sample.Id/Starch">
        <input type="hidden" name="SampleId" value="@Model.Sample.Id" />
        <section class="panel tray-panel">
            <h2>Tray Map</h2>
            <div class="tray-legend" aria-label="Tray status legend">
                <span><span class="legend-swatch not-sampled"></span>Not Sampled</span>
                <span><span class="legend-swatch missing-starch"></span>Missing Starch</span>
                <span><span class="legend-swatch complete-starch"></span>Starch Complete</span>
            </div>
            <div class="tray-map" aria-label="Starch tray map">
                @foreach (var position in trayPositions)
                {
                    var fruit = Model.FruitRows.Single(row => row.RowNumber == position);
                    <button type="button"
                            class="tray-position @TrayClass(fruit)"
                            data-row-number="@fruit.RowNumber"
                            aria-label="Fruit @fruit.RowNumber @TrayStatus(fruit)">
                        <span class="tray-number">@fruit.RowNumber</span>
                        <span class="tray-value">@TrayLabel(fruit)</span>
                        <span class="tray-status">@TrayStatus(fruit)</span>
                    </button>
                }
            </div>
        </section>

        <section class="panel starch-input-panel">
                <h2>Starch Input</h2>
                <p class="muted">Starch values can be saved at any time. In-progress rows are saved and can be completed later; readiness still shows which rows need more data before email.</p>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Fruit</th>
                                <th>QC Row Status</th>
                                <th>Starch Value</th>
                            </tr>
                        </thead>
                        <tbody>
                        @for (var i = 0; i < Model.FruitRows.Count; i++)
                        {
                            var row = Model.FruitRows[i];
                            <tr id="starch-row-@row.RowNumber" class="starch-entry-row @TrayClass(row)">
                                <td>
                                    @row.RowNumber
                                    <input type="hidden" name="Rows[@i].RowNumber" value="@row.RowNumber" />
                                </td>
                                <td>@row.EntryStatus</td>
                                <td>
                                    <select class="starch-input" name="Rows[@i].StarchScaleValueId" data-row-number="@row.RowNumber">
                                        <option value="">--</option>
                                        @foreach (var starch in Model.StarchScaleValues)
                                        {
                                            <option value="@starch.Id" selected="@(row.StarchScaleValueId == starch.Id ? "selected" : null)">@starch.Value.ToString("0.0")</option>
                                        }
                                    </select>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <button type="submit">Save Starch Input</button>
        </section>
    </form>

    <section>
        <h2>After-Starch Photo</h2>
        <div class="grid-two">
            <div class="panel">
                <h3>Photo Metadata</h3>
                @await Html.PartialAsync("_PhotoGroups", Model.PhotoGroups)
            </div>
            @await Html.PartialAsync("_PhotoPlaceholderForm", new PhotoPlaceholderFormViewModel
            {
                FormAction = $"/Samples/{Model.Sample.Id}/Starch/photos",
                Title = "Add After-Starch Photo",
                DefaultPhotoType = "FruitAfterStarch",
                PhotoTypes = ["FruitAfterStarch", "Other"],
                CropYear = Model.Sample.CropYear,
                Warehouse = Model.Sample.Warehouse,
                ReceiptId = Model.Sample.ReceiptIdText
            })
        </div>
    </section>
}

<script>
    (() => {
        function clearHighlights() {
            for (const row of document.querySelectorAll(".starch-entry-row")) {
                row.classList.remove("highlight-row");
            }
            for (const position of document.querySelectorAll(".tray-position")) {
                position.classList.remove("highlight-position");
            }
        }

        for (const position of document.querySelectorAll(".tray-position")) {
            position.addEventListener("click", () => {
                const rowNumber = position.dataset.rowNumber;
                const targetRow = document.getElementById(`starch-row-${rowNumber}`);
                const input = document.querySelector(`.starch-input[data-row-number="${rowNumber}"]`);
                clearHighlights();
                position.classList.add("highlight-position");
                targetRow?.classList.add("highlight-row");
                targetRow?.scrollIntoView({ block: "center", behavior: "smooth" });
                if (input && !input.disabled) {
                    input.focus();
                }
            });
        }

        const browserStatus = document.querySelector("[data-starch-browser-status]");
        function updateBrowserStatus() {
            if (!window.isSecureContext) {
                browserStatus.textContent = "Camera access is blocked because this page is not in a secure HTTPS context. The Starch form remains usable; use file upload or open the HTTPS dashboard URL.";
                return;
            }
            if (!navigator.mediaDevices?.getUserMedia) {
                browserStatus.textContent = "This browser does not expose camera capture. The Starch form remains usable; use file upload or a supported browser.";
                return;
            }
            browserStatus.textContent = "Browser camera API is available. Use Device Setup below to grant permission or reconnect the camera.";
        }
        document.querySelector("[data-retry-starch-capture]")?.addEventListener("click", () => {
            updateBrowserStatus();
            document.querySelector("[data-device-settings]")?.click();
        });
        updateBrowserStatus();
    })();
</script>

@functions {
    private static string StarchSummary(ReadinessViewModel readiness)
    {
        if (readiness.CompletedFruitCount == 0)
        {
            return "No completed fruit rows yet.";
        }

        return readiness.StarchMissingCount == 0
            ? "Starch Complete"
            : $"{readiness.StarchMissingCount} of {readiness.CompletedFruitCount} completed rows missing starch";
    }

    private static string TrayClass(FruitReadingRowViewModel row)
    {
        if (row.EntryStatus == "Empty" && row.StarchScaleValueId is null)
        {
            return "not-sampled";
        }

        return row.StarchScaleValueId is null ? "missing-starch" : "complete-starch";
    }

    private static string TrayLabel(FruitReadingRowViewModel row)
    {
        if (row.EntryStatus == "Empty" && row.StarchScaleValueId is null)
        {
            return "--";
        }

        return string.IsNullOrWhiteSpace(row.Starch) ? "--" : row.Starch;
    }

    private static string TrayStatus(FruitReadingRowViewModel row)
    {
        if (row.EntryStatus == "Empty" && row.StarchScaleValueId is null)
        {
            return "Not Sampled";
        }

        return row.StarchScaleValueId is null ? "Missing Starch" : "Starch Complete";
    }
}
