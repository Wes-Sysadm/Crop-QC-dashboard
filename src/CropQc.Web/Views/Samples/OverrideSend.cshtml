@model OverrideSendViewModel
@{
    ViewData["Title"] = Model.Sample is null ? "Override Send" : $"Override Send - {Model.Sample.DisplayReceiptId}";
}

<h1>@ViewData["Title"]</h1>
@if (TempData["Error"] is string error)
{
    <p class="notice error">@error</p>
}
@if (Model.DataWarning is not null)
{
    <p class="notice warning">@Model.DataWarning</p>
}

@if (Model.Sample is not null && Model.Receipt is not null)
{
    <section class="panel">
        <h2>Manager/Admin Override Send</h2>
        <p>@Model.Sample.DisplayReceiptId | @Model.Receipt.GrowerName | @Model.Receipt.LotCode | @Model.Receipt.VarietyCode</p>
        <p>Sending from: <strong>@(Model.SenderEmail ?? "current Google user")</strong></p>
        <p>To: <strong>@(Model.RecipientEmail ?? "configured QC recipients")</strong></p>
        <p class="notice warning">This sends a QC Summary email even though required data is missing.</p>
        <p class="muted">Emails send from the logged-in Google Workspace account. Allowed Google Workspace domains: @Model.AllowedGoogleDomains.</p>
        <p class="muted">If Gmail permission is missing, sign out and sign back in to reconnect Google/Gmail with the send permission.</p>
        <p>
            <a href="/Samples/@Model.Sample.Id">Back to sample detail</a>
            <a class="inline-action" href="/Receipts/@Model.Sample.ReceiptId">Back to receipt detail</a>
        </p>
    </section>

    <section class="panel">
        <h2>Email Diagnostics</h2>
        <div class="table-wrap">
            <table>
                <tbody>
                    <tr><th>Current user email</th><td>@(Model.SenderEmail ?? "Unknown")</td></tr>
                    <tr><th>Current user domain</th><td>@(Model.SenderDomain ?? "Unknown")</td></tr>
                    <tr><th>Domain allowed</th><td><span class="status @(Model.SenderDomainAllowed ? "ready" : "missing")">@(Model.SenderDomainAllowed ? "Yes" : "No")</span></td></tr>
                    <tr><th>Gmail send permission granted</th><td><span class="status @(Model.GmailSendPermissionGranted ? "ready" : "missing")">@(Model.GmailSendPermissionGranted ? "Yes" : "No")</span></td></tr>
                    <tr><th>Gmail credential present</th><td><span class="status @(Model.GmailCredentialPresent ? "ready" : "missing")">@(Model.GmailCredentialPresent ? "Yes" : "No")</span></td></tr>
                    <tr><th>Email provider GmailUser</th><td><span class="status @(Model.GmailUserProviderEnabled ? "ready" : "missing")">@(Model.GmailUserProviderEnabled ? "Yes" : "No")</span></td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="panel">
        <h2>Missing Items Being Overridden</h2>
        @await Html.PartialAsync("_ReadinessChecklist", Model.Checklist)
        @if (Model.Readiness.MissingItems.Count > 0)
        {
            <ul class="list">
            @foreach (var item in Model.Readiness.MissingItems)
            {
                <li>@item</li>
            }
            </ul>
        }
    </section>

    <form class="panel form-grid" method="post" action="/Samples/@Model.Sample.Id/OverrideSend">
        <h2>Confirm Override</h2>
        <input type="hidden" name="SampleId" value="@Model.Sample.Id" />
        <label class="field wide">Override reason
            <textarea name="OverrideReason" required rows="4"></textarea>
        </label>
        <label class="checkbox-field wide">
            <input name="ConfirmOverride" type="checkbox" value="true" required />
            I confirm this should be sent with missing data.
        </label>
        <button type="submit">Send QC Summary Override</button>
    </form>
}
