@model CropQc.Web.Models.PerformanceDiagnosticsPageViewModel
@{
    ViewData["Title"] = "Performance Diagnostics";
}

<section class="page-header">
    <div>
        <h1>Performance Diagnostics</h1>
        <p>Recent staging request metrics for authenticated validation. Values are aggregate timings and counts only.</p>
    </div>
</section>

<section class="panel">
    <div class="section-header">
        <div>
            <h2>@Model.EnvironmentDisplayName</h2>
            <p class="muted">Retaining the latest @Model.RecentRequestLimit requests. SQL text, parameters, request bodies, response bodies, cookies, and credentials are not recorded.</p>
        </div>
    </div>

    @if (Model.Metrics.Count == 0)
    {
        <p class="empty-state">No request metrics have been captured yet.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table compact-table">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Route</th>
                        <th>Status</th>
                        <th>Elapsed</th>
                        <th>EF</th>
                        <th>DB time</th>
                        <th>Bytes</th>
                        <th>External</th>
                        <th>Warning</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var metric in Model.Metrics)
                {
                    <tr>
                        <td>@metric.CapturedAt.ToLocalTime().ToString("g")</td>
                        <td>
                            <strong>@metric.Method</strong> @metric.Path
                            @if (!string.IsNullOrWhiteSpace(metric.EndpointName))
                            {
                                <span class="muted"> @metric.EndpointName</span>
                            }
                            <span class="muted"> trace @metric.TraceIdentifier</span>
                        </td>
                        <td>@metric.StatusCode</td>
                        <td>@metric.ElapsedMilliseconds.ToString("0.0") ms</td>
                        <td>@metric.EfCommandCount commands</td>
                        <td>@metric.EfCommandElapsedMilliseconds.ToString("0.0") ms</td>
                        <td>@(metric.ResponseBytes?.ToString("N0") ?? "n/a")</td>
                        <td>@metric.ExternalProviders</td>
                        <td>@(metric.WarningThresholdExceeded ? "Threshold exceeded" : "OK")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
