@model EbsInventoryCleanupPageViewModel
@{
    ViewData["Title"] = "EBS Test Inventory Cleanup Review";
}

<div class="room-card-header">
    <div>
        <h1>EBS Test Inventory Cleanup Review</h1>
        <p class="muted">Admin-only, read-only review of EBS inventory outside the protected Evans 7 room. This page cannot change inventory.</p>
    </div>
</div>

@if (TempData["Error"] is string error)
{
    <p class="notice error">@error</p>
}

<section class="panel">
    <p class="notice warning">
        <strong>@Model.ProtectedRoom</strong> (room ID @Model.ProtectedRoomId) is excluded by room identity.
        All receipts, lots, ledger rows, and balances in that room must remain unchanged.
        Production cleanup requires the reviewed preflight/apply/verify package, a verified backup,
        and separate explicit authorization.
    </p>
    <p><strong>Candidate balance outside Evans 7:</strong> @Model.CandidateCurrentBins bins across @Model.TotalRows room-lot balances.</p>
    @if (Model.Rows.Count == 0)
    {
        <p>No EBS inventory outside Evans 7 is visible on this page.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Room</th><th>Lot / grower</th><th>Fruit</th><th>Current</th><th>Evidence</th><th>Last activity</th></tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@row.Room</td>
                        <td><strong>@row.Lot</strong><br /><span class="muted">@row.Grower · crop @row.CropYear</span></td>
                        <td>@row.Variety<br /><span class="muted">@row.ProductionType</span></td>
                        <td><strong>@row.CurrentBins bins</strong><br /><span class="muted">origin @row.PositiveLedgerOrigin · runs @row.BinsRunDeductions · transfers @row.TransferActivity · true-ups @row.TrueUps</span></td>
                        <td>@row.EvidenceSource<br /><span class="notice warning">@row.WarningReason</span></td>
                        <td>@BusinessTime.FormatPacific(row.LastActivityAt)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    <p class="muted">Showing @Model.Rows.Count of @Model.TotalRows rows.</p>
    <div class="action-bar">
        @if (Model.HasPreviousPage)
        {
            <a class="button secondary-button" href="?page=@(Model.Page - 1)&amp;pageSize=@Model.PageSize">Previous</a>
        }
        @if (Model.HasNextPage)
        {
            <a class="button secondary-button" href="?page=@(Model.Page + 1)&amp;pageSize=@Model.PageSize">Next</a>
        }
    </div>
</section>
