@model EndOfDayFillAdminPageViewModel
@{ ViewData["Title"] = "End of Day Fill Report Groups"; }
<partial name="_MasterDataNavigation" model='"end-of-day-fill"' />
<div class="page-heading-row"><div><h1>End of Day Fill Report Groups</h1><p class="muted">Configure report definitions and the global recipient list. Room membership is authoritative on each Room master record.</p></div><a href="/MasterData">Back to Master Data</a></div>
@if (TempData["Error"] is not null) { <p class="notice warning">@TempData["Error"]</p> }
@if (TempData["Success"] is not null) { <p class="notice success">@TempData["Success"]</p> }

@if (Model.StaleAttempts.Count > 0)
{
    <section class="panel notice warning" role="alert">
        <h2>Stale or uncertain email sends require review</h2>
        <p>Do not resend. Verify the sender's Gmail Sent folder, open the exact candidate report, then record one explicit outcome.</p>
        @foreach (var attempt in Model.StaleAttempts)
        {
            <article class="panel">
                <h3>@attempt.GroupName — @(attempt.RevisionNumber == 0 ? "Original" : $"REVISION {attempt.RevisionNumber}")</h3>
                <dl><dt>Sender</dt><dd>@attempt.Sender</dd><dt>Attempted</dt><dd>@attempt.AttemptedAt</dd><dt>Subject</dt><dd>@attempt.Subject</dd><dt>Recipients</dt><dd>@attempt.Recipients</dd><dt>Snapshot</dt><dd><code>@attempt.SnapshotHash</code></dd></dl>
                <p><a href="/MasterData/end-of-day-fill-groups/recovery/@attempt.SendAttemptId">View exact candidate report</a></p>
                <form method="post" action="/MasterData/end-of-day-fill-groups/recovery" class="form-grid">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="SendAttemptId" value="@attempt.SendAttemptId" />
                    <label class="field">Verified result<select name="Resolution" required><option value="">Select after checking Gmail Sent</option><option value="confirmed-sent">Confirmed sent</option><option value="confirmed-not-sent">Confirmed not sent</option></select></label>
                    <label class="field">Reason<input name="Reason" required minlength="5" maxlength="1000" /></label>
                    <label class="field">Gmail message ID, if known<input name="GmailMessageId" maxlength="500" /></label>
                    <label class="checkbox-field"><input type="checkbox" name="Confirmed" value="true" required /> I verified the sender's Gmail Sent folder and confirm this resolution.</label>
                    <input type="hidden" name="Confirmed" value="false" />
                    <button type="submit">Resolve uncertain send</button>
                </form>
            </article>
        }
    </section>
}

<section class="panel"><h2>Create report group</h2><form method="post" action="/MasterData/end-of-day-fill-groups/group" class="form-grid">@Html.AntiForgeryToken()<label class="field">Name<input name="Name" required maxlength="150" /></label><label class="field">Facility<select name="Facility"><option>WP</option><option>EBS</option></select></label><label class="checkbox-field"><input type="checkbox" name="IsActive" value="true" checked /> Active</label><input type="hidden" name="IsActive" value="false" /><button type="submit">Create</button></form></section>

@foreach (var group in Model.Groups)
{
    <section class="panel">
        <form method="post" action="/MasterData/end-of-day-fill-groups/group">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@group.Id" />
            <div class="form-grid"><label class="field">Name<input name="Name" value="@group.Name" required maxlength="150" /></label><label class="field">Facility<select name="Facility"><option selected="@(group.Facility == "WP")">WP</option><option selected="@(group.Facility == "EBS")">EBS</option></select></label><label class="checkbox-field"><input type="checkbox" name="IsActive" value="true" checked="@group.IsActive" /> Active</label><input type="hidden" name="IsActive" value="false" /></div>
            <h3>Rooms assigned to this report: @group.AssignedRoomCount</h3>
            @if (group.AssignedRooms.Count > 0)
            {
                <ul class="compact-list">
                @foreach (var room in group.AssignedRooms)
                {
                    <li><strong>@room.Code</strong> — @room.Name @if (!string.IsNullOrWhiteSpace(room.Location)) { <span>— @room.Location</span> } — @room.CapacityBins bins</li>
                }
                </ul>
            }
            else
            {
                <p class="muted">No rooms are currently assigned.</p>
            }
            <p><a href="/MasterData/rooms">Manage room assignments</a></p>
            <button type="submit">Save group</button>
        </form>
    </section>
}

<section class="panel"><h2>Report Recipients</h2><p class="muted">Global recipients for every End of Day Fill report.</p>
@foreach (var recipient in Model.Recipients)
{
    <form method="post" action="/MasterData/end-of-day-fill-groups/recipient" class="toolbar">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@recipient.Id" /><label class="field">Email<input type="email" name="EmailAddress" value="@recipient.Email" required /></label><label class="field">Order<input type="number" name="SortOrder" value="@recipient.SortOrder" /></label><label class="checkbox-field"><input type="checkbox" name="IsActive" value="true" checked="@recipient.IsActive" /> Active</label><input type="hidden" name="IsActive" value="false" /><button class="secondary-button" type="submit">Save</button></form>
}
<h3>Add recipient</h3><form method="post" action="/MasterData/end-of-day-fill-groups/recipient" class="toolbar">@Html.AntiForgeryToken()<label class="field">Email<input type="email" name="EmailAddress" required /></label><label class="field">Order<input type="number" name="SortOrder" value="100" /></label><label class="checkbox-field"><input type="checkbox" name="IsActive" value="true" checked /> Active</label><input type="hidden" name="IsActive" value="false" /><button type="submit">Add recipient</button></form></section>
