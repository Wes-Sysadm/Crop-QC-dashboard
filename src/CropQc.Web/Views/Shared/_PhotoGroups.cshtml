@model IReadOnlyList<PhotoGroupViewModel>
@{
    var wholeSampleLabel = ViewData["WholeSampleLabel"] as string;
    var cutFruitLabel = ViewData["CutFruitLabel"] as string;
    var commodity = ViewData["Commodity"] as string;
}

@if (Model.Count == 0)
{
    <p class="muted">No photo metadata recorded.</p>
}
@foreach (var group in Model)
{
    <div class="panel">
        <h2>@FriendlyPhotoType(group.PhotoType, wholeSampleLabel, cutFruitLabel, commodity)</h2>
        <div class="table-wrap">
            <table>
                <thead><tr><th>File</th><th>Source</th><th>Type</th><th>Size</th><th>Captured</th><th>Actions</th></tr></thead>
                <tbody>
                @foreach (var photo in group.Photos)
                {
                    <tr>
                        <td>
                            @if (photo.WebUrl is not null)
                            {
                                <a href="@photo.WebUrl" target="_blank" rel="noopener">
                                    @if (photo.DisplayAsThumbnail)
                                    {
                                        <img src="@photo.WebUrl" alt="@photo.FileName" style="max-width:180px;max-height:120px;width:auto;height:auto;display:block;" loading="lazy" />
                                    }
                                    @photo.FileName
                                </a>
                            }
                            else
                            {
                                @photo.FileName
                            }
                        </td>
                        <td>@photo.PhotoSource</td>
                        <td>@photo.ContentType</td>
                        <td>@photo.FileSizeBytes</td>
                        <td>@BusinessTime.FormatPacific(photo.CapturedAt)</td>
                        <td>
                            @if (photo.CanDelete && (!string.IsNullOrWhiteSpace(photo.DeleteAction) || photo.DeleteFromSampleId is long))
                            {
                                var deleteAction = photo.DeleteAction ?? $"/Samples/{photo.DeleteFromSampleId}/photos/{photo.Id}/remove";
                                <form class="inline-form" method="post" action="@deleteAction" data-requires-autosave onsubmit="return confirm('Remove this photo from the sample?');">
                                    <button type="submit" class="link-button danger-link">Remove Photo</button>
                                </form>
                            }
                            else
                            {
                                <span class="muted">-</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@functions {
    private static string FriendlyPhotoType(string photoType, string? wholeSampleLabel, string? cutFruitLabel, string? commodity) => NormalizePhotoType(photoType) switch
    {
        "BinTruck" => "Truck photo",
        "TopOfTruck" => "Top of truck",
        "Hectre" => "Hectre",
        "SampleBeforeCutting" => wholeSampleLabel ?? "Whole sample",
        "CutFruit" => cutFruitLabel ?? "Cut apples",
        "FruitAfterStarch" => $"Starch {commodity ?? "apples"}",
        "Other" => "Other",
        _ => photoType
    };

    private static string NormalizePhotoType(string? photoType)
    {
        var normalized = (photoType ?? "").Trim();
        return normalized switch
        {
            "TopTruck" or "TopTruckPhoto" or "TopOfTruckPhoto" => "TopOfTruck",
            _ when normalized.Equals("Top truck photo", StringComparison.OrdinalIgnoreCase) => "TopOfTruck",
            _ when normalized.Equals("Top of truck", StringComparison.OrdinalIgnoreCase) => "TopOfTruck",
            _ => normalized
        };
    }
}
