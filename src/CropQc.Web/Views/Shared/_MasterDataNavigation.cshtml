@model string
@inject IUserAccessService UserAccess
@{
    var canViewMasterData = await UserAccess.HasAccessAsync(User, ApplicationAreas.MasterData, PageAccessLevel.View, Context.RequestAborted);
    var canViewGrowerLots = await UserAccess.HasAccessAsync(User, ApplicationAreas.GrowerLots, PageAccessLevel.View, Context.RequestAborted);
    var canManageRecipients = await UserAccess.HasAccessAsync(User, ApplicationAreas.Configuration, PageAccessLevel.Admin, Context.RequestAborted);
    string Active(string key) => string.Equals(Model, key, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    string? Current(string key) => string.Equals(Model, key, StringComparison.OrdinalIgnoreCase) ? "page" : null;
}

<nav class="operation-tabs master-data-navigation" aria-label="Master Data and Grower Lots">
    @if (canViewMasterData)
    {
        <a class="@(Active("home"))" aria-current="@(Current("home"))" href="/MasterData">Master Data home</a>
        <a class="@(Active("fruit-profiles"))" aria-current="@(Current("fruit-profiles"))" href="/MasterData/fruit-profiles">Fruit Profiles / Varieties</a>
        <a class="@(Active("growers"))" aria-current="@(Current("growers"))" href="/MasterData/canonical-growers">Growers</a>
        <a class="@(Active("orchards"))" aria-current="@(Current("orchards"))" href="/MasterData/orchard-blocks">Orchards / Blocks</a>
        <a class="@(Active("end-of-day-fill"))" aria-current="@(Current("end-of-day-fill"))" href="/MasterData/end-of-day-fill-groups">End of Day Fill Groups</a>
    }
    @if (canViewGrowerLots)
    {
        <a class="@(Active("grower-lots"))" aria-current="@(Current("grower-lots"))" href="/GrowerLots/Current">Grower Lots</a>
    }
    @if (canManageRecipients)
    {
        <a class="@(Active("qc-recipients"))" aria-current="@(Current("qc-recipients"))" href="/Admin/OrchardRecipients">QC Recipients</a>
        <a class="@(Active("manager-import"))" aria-current="@(Current("manager-import"))" href="/Admin/OrchardRecipientImports">Manager Import</a>
        <a class="@(Active("unmatched"))" aria-current="@(Current("unmatched"))" href="/Admin/OrchardRecipientImports#recent-review-batches">Unmatched Identities</a>
    }
</nav>
