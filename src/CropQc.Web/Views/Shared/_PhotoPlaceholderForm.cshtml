@model PhotoPlaceholderFormViewModel
@{
    var instanceId = $"photo-{Guid.NewGuid():N}";
    var defaultPhotoType = string.IsNullOrWhiteSpace(Model.DefaultPhotoType)
        ? Model.PhotoTypes.FirstOrDefault() ?? "Other"
        : Model.DefaultPhotoType;
}

<form class="panel form-grid photo-workflow" method="post" action="@Model.FormAction" id="@instanceId" enctype="multipart/form-data"
      data-crop-year="@Model.CropYear"
      data-warehouse="@Model.Warehouse"
      data-receipt-id="@Model.ReceiptId">
    <h3>@Model.Title</h3>
    <label class="field">Photo type
        <select name="PhotoType" class="photo-type">
            @foreach (var photoType in Model.PhotoTypes)
            {
                <option value="@photoType" selected="@(photoType == defaultPhotoType ? "selected" : null)">@FriendlyPhotoType(photoType)</option>
            }
        </select>
    </label>
    <label class="field">Photo source
        <select name="PhotoSource" class="photo-source">
            <option value="Upload File" selected>Upload File</option>
            <option value="USB Camera">USB Camera</option>
        </select>
    </label>

    <input type="hidden" name="FileName" class="photo-file-name" required />
    <input type="hidden" name="ContentType" class="photo-content-type" required />
    <input type="hidden" name="FileSizeBytes" class="photo-file-size" />
    <input type="hidden" name="SharePointDriveId" class="photo-drive-id" />
    <input type="hidden" name="SharePointItemId" class="photo-item-id" />
    <input type="hidden" name="WebUrl" class="photo-web-url" />

    <div class="source-panel upload-panel wide">
        <input type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" capture="environment" class="photo-file-input" name="@Model.FileInputName" multiple="@(Model.AllowMultiple ? "multiple" : null)" hidden />
        <button type="button" class="upload-zone">
            <span>Drop photo here or click to browse</span>
        </button>
        <div class="photo-preview" aria-live="polite">
            <span>No photo selected</span>
        </div>
    </div>

    <div class="source-panel camera-panel wide" hidden>
        <video class="photo-camera-video" autoplay playsinline muted hidden></video>
        <canvas class="photo-camera-canvas" hidden></canvas>
        <p class="camera-placeholder" aria-live="polite">Start the camera to preview it.</p>
        <div class="button-row">
            <button type="button" class="camera-start">Start Camera Preview</button>
            <button type="button" class="camera-capture">Capture Photo</button>
        </div>
    </div>

    <p class="notice warning photo-validation-message wide" role="alert" hidden></p>

    <div class="metadata-summary wide" aria-live="polite">
        <div><strong>Target folder:</strong> <span class="target-folder"></span></div>
        <div><strong>Generated file:</strong> <span class="generated-file"></span></div>
        <div><strong>Selected file:</strong> <span class="selected-file">None</span></div>
        <div><strong>File size:</strong> <span class="selected-size">0 bytes</span></div>
        <div><strong>Content type:</strong> <span class="selected-content-type">image/jpeg</span></div>
    </div>

    <p class="muted wide">Photos are validated, saved through the configured storage provider, and associated with this record. Maximum file size: 15 MB.</p>
    <button type="submit">Save Photo</button>
</form>

<script>
    (() => {
        const form = document.getElementById("@instanceId");
        if (!form) return;

        const photoType = form.querySelector(".photo-type");
        const photoSource = form.querySelector(".photo-source");
        const fileInput = form.querySelector(".photo-file-input");
        const uploadPanel = form.querySelector(".upload-panel");
        const cameraPanel = form.querySelector(".camera-panel");
        const uploadZone = form.querySelector(".upload-zone");
        const preview = form.querySelector(".photo-preview");
        const fileNameInput = form.querySelector(".photo-file-name");
        const contentTypeInput = form.querySelector(".photo-content-type");
        const fileSizeInput = form.querySelector(".photo-file-size");
        const driveIdInput = form.querySelector(".photo-drive-id");
        const itemIdInput = form.querySelector(".photo-item-id");
        const webUrlInput = form.querySelector(".photo-web-url");
        const targetFolder = form.querySelector(".target-folder");
        const generatedFile = form.querySelector(".generated-file");
        const selectedFile = form.querySelector(".selected-file");
        const selectedSize = form.querySelector(".selected-size");
        const selectedContentType = form.querySelector(".selected-content-type");
        const cameraStart = form.querySelector(".camera-start");
        const cameraCapture = form.querySelector(".camera-capture");
        const cameraVideo = form.querySelector(".photo-camera-video");
        const cameraCanvas = form.querySelector(".photo-camera-canvas");
        const cameraMessage = form.querySelector(".camera-placeholder");
        const validationMessage = form.querySelector(".photo-validation-message");
        let selectedUploadFiles = [];
        let cameraStream = null;
        let previewUrl = null;
        const maxPhotoSize = 15 * 1024 * 1024;
        const allowedTypes = new Set(["image/jpeg", "image/jpg", "image/png", "image/webp"]);

        function pad(value) {
            return value.toString().padStart(2, "0");
        }

        function clean(value) {
            return (value || "Unknown").toString().replace(/[^A-Za-z0-9_-]/g, "");
        }

        function formatBytes(value) {
            if (!value) return "0 bytes";
            if (value < 1024) return `${value} bytes`;
            if (value < 1024 * 1024) return `${(value / 1024).toFixed(1)} KB`;
            return `${(value / (1024 * 1024)).toFixed(1)} MB`;
        }

        function buildMetadata(file) {
            const now = new Date();
            const datePart = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
            const timePart = `${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;
            const type = clean(photoType.value);
            const receiptId = clean(form.dataset.receiptId);
            const extension = file?.name?.includes(".") ? file.name.slice(file.name.lastIndexOf(".")) : ".jpg";
            const folder = `Photos/${form.dataset.cropYear}/${clean(form.dataset.warehouse)}/Receipt-${receiptId}/${type}/`;
            const generated = `${receiptId}_${type}_${datePart}_${timePart}${extension}`;

            fileNameInput.value = file?.name || generated;
            contentTypeInput.value = file?.type || "image/jpeg";
            fileSizeInput.value = file?.size ?? 0;
            driveIdInput.value = folder;
            itemIdInput.value = generated;
            webUrlInput.value = `${folder}${generated}`;

            targetFolder.textContent = folder;
            generatedFile.textContent = generated;
            selectedFile.textContent = file?.name || generated;
            selectedSize.textContent = formatBytes(file?.size ?? 0);
            selectedContentType.textContent = file?.type || "image/jpeg";
        }

        function showPreview(files) {
            if (previewUrl) {
                URL.revokeObjectURL(previewUrl);
                previewUrl = null;
            }
            preview.innerHTML = "";
            if (!files || files.length === 0) {
                preview.appendChild(document.createTextNode("No photo selected"));
                return;
            }

            for (const file of files) {
                const image = document.createElement("img");
                image.alt = `Selected photo preview: ${file.name}`;
                image.src = URL.createObjectURL(file);
                preview.appendChild(image);
            }
        }

        function setUploadFiles(files) {
            const selected = Array.from(files || []);
            const invalid = selected.find(file => !allowedTypes.has((file.type || "").toLowerCase()) || file.size > maxPhotoSize);
            if (invalid) {
                validationMessage.textContent = invalid.size > maxPhotoSize
                    ? `${invalid.name} is larger than 15 MB. Choose or capture a smaller image.`
                    : `${invalid.name} is not a supported image. Only JPG, PNG, or WEBP images are allowed.`;
                validationMessage.hidden = false;
                return false;
            }
            validationMessage.hidden = true;
            validationMessage.textContent = "";
            selectedUploadFiles = @Model.AllowMultiple.ToString().ToLowerInvariant() ? selected : selected.slice(0, 1);
            if (selectedUploadFiles.length > 0 && window.DataTransfer) {
                const dataTransfer = new DataTransfer();
                selectedUploadFiles.forEach(file => dataTransfer.items.add(file));
                fileInput.files = dataTransfer.files;
            }
            buildMetadata(selectedUploadFiles[0] || null);
            showPreview(selectedUploadFiles);
            selectedFile.textContent = selectedUploadFiles.length > 1
                ? `${selectedUploadFiles.length} photos selected`
                : selectedUploadFiles[0]?.name || "None";
            selectedSize.textContent = formatBytes(selectedUploadFiles.reduce((total, file) => total + file.size, 0));
            return true;
        }

        function stopCamera() {
            cameraStream?.getTracks().forEach(track => track.stop());
            cameraStream = null;
            cameraVideo.srcObject = null;
            cameraVideo.hidden = true;
        }

        function cameraError(error) {
            if (!window.isSecureContext) return "Camera access requires HTTPS (or localhost). Use file selection on this connection.";
            if (error?.name === "NotAllowedError" || error?.name === "SecurityError") return "Camera permission was denied. Allow camera access in browser site settings, then retry, or select a file.";
            if (error?.name === "NotFoundError") return "No camera was found. Connect a camera or select a file.";
            if (error?.name === "NotReadableError" || error?.name === "AbortError") return "The camera is busy or unavailable. Close other camera apps, then retry.";
            return `Camera could not start (${error?.name || "unknown error"}). Select a file or retry.`;
        }

        async function startCamera() {
            if (!navigator.mediaDevices?.getUserMedia) {
                cameraMessage.textContent = window.isSecureContext
                    ? "This browser does not provide camera capture. Select a photo file instead."
                    : "Camera access is blocked on this non-HTTPS page. Select a photo file instead.";
                return false;
            }
            try {
                stopCamera();
                cameraStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: "environment" } }, audio: false });
                cameraVideo.srcObject = cameraStream;
                cameraVideo.hidden = false;
                await cameraVideo.play();
                cameraMessage.textContent = "Camera connected. Review the preview, then capture.";
                return true;
            } catch (error) {
                stopCamera();
                cameraMessage.textContent = cameraError(error);
                return false;
            }
        }

        function syncSource() {
            const isCamera = photoSource.value === "USB Camera";
            uploadPanel.hidden = isCamera;
            cameraPanel.hidden = !isCamera;
            buildMetadata(isCamera ? null : selectedUploadFiles[0]);
            if (isCamera) {
                preview.innerHTML = "";
                preview.appendChild(document.createTextNode("No photo selected"));
            } else {
                stopCamera();
            }
        }

        photoType.addEventListener("change", () => buildMetadata(photoSource.value === "USB Camera" ? null : selectedUploadFiles[0]));
        photoSource.addEventListener("change", syncSource);
        uploadZone.addEventListener("click", () => fileInput.click());
        uploadZone.addEventListener("dragover", event => {
            event.preventDefault();
            uploadZone.classList.add("drag-over");
        });
        uploadZone.addEventListener("dragleave", () => uploadZone.classList.remove("drag-over"));
        uploadZone.addEventListener("drop", event => {
            event.preventDefault();
            uploadZone.classList.remove("drag-over");
            if (event.dataTransfer.files?.length) setUploadFiles(event.dataTransfer.files);
        });
        fileInput.addEventListener("change", () => {
            if (fileInput.files?.length) setUploadFiles(fileInput.files);
        });

        cameraStart.addEventListener("click", startCamera);
        cameraCapture.addEventListener("click", async () => {
            if (!cameraStream && !await startCamera()) return;
            const width = cameraVideo.videoWidth || 1280;
            const height = cameraVideo.videoHeight || 720;
            cameraCanvas.width = width;
            cameraCanvas.height = height;
            cameraCanvas.getContext("2d").drawImage(cameraVideo, 0, 0, width, height);
            const blob = await new Promise(resolve => cameraCanvas.toBlob(resolve, "image/jpeg", 0.9));
            if (!blob) {
                cameraMessage.textContent = "The browser could not create an image from the camera. Retry or select a file.";
                return;
            }
            const file = new File([blob], `camera-${Date.now()}.jpg`, { type: "image/jpeg" });
            if (setUploadFiles([file])) cameraMessage.textContent = "Photo captured. Review the preview, then save.";
        });
        form.addEventListener("submit", event => {
            const hasPostedFile = fileInput.files && fileInput.files.length > 0;
            if (!hasPostedFile) {
                event.preventDefault();
                validationMessage.textContent = "Choose or capture a photo before saving.";
                validationMessage.hidden = false;
                uploadZone.focus();
                uploadZone.classList.add("drag-over");
                return;
            }

            buildMetadata(photoSource.value === "USB Camera" ? null : selectedUploadFiles[0]);
        });

        buildMetadata(null);
        syncSource();
        window.addEventListener("pagehide", () => {
            stopCamera();
            if (previewUrl) URL.revokeObjectURL(previewUrl);
        });
    })();
</script>

@functions {
    private static string FriendlyPhotoType(string photoType) => NormalizePhotoType(photoType) switch
    {
        "BinTruck" => "Truck photo",
        "TopOfTruck" => "Top of truck",
        "Hectre" => "Hectre",
        "SampleBeforeCutting" => "Whole sample",
        "CutFruit" => "Cut apples",
        "FruitAfterStarch" => "Starch apples",
        "Other" => "Other",
        _ => photoType
    };

    private static string NormalizePhotoType(string? photoType)
    {
        var normalized = (photoType ?? "").Trim();
        return normalized switch
        {
            "TopTruck" or "TopTruckPhoto" or "TopOfTruckPhoto" => "TopOfTruck",
            _ when normalized.Equals("Top truck photo", StringComparison.OrdinalIgnoreCase) => "TopOfTruck",
            _ when normalized.Equals("Top of truck", StringComparison.OrdinalIgnoreCase) => "TopOfTruck",
            _ => normalized
        };
    }
}
