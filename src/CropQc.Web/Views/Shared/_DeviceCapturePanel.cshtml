@model DeviceCapturePanelViewModel
@{
    var panelId = $"device-capture-{Guid.NewGuid():N}";
    var hasPhotoAction = !string.IsNullOrWhiteSpace(Model.ReceiptPhotoAction)
        || !string.IsNullOrWhiteSpace(Model.SamplePhotoAction)
        || !string.IsNullOrWhiteSpace(Model.StarchPhotoAction);
    var canStageReceiptPhotos = Model.StageReceiptPhotos && Model.ShowTruckPhotos;
    var hasPhotoTarget = hasPhotoAction || canStageReceiptPhotos;
    var saveFirstMessage = Model.RequiresSavedTargetMessage
        ?? (!hasPhotoTarget && (Model.ShowTruckPhotos || Model.ShowApplePhotos) ? "Save the receipt first to attach photos." : null);
}
<section class="panel device-capture-panel"
         id="@panelId"
         data-receipt-photo-action="@Model.ReceiptPhotoAction"
         data-sample-photo-action="@Model.SamplePhotoAction"
         data-starch-photo-action="@Model.StarchPhotoAction"
         data-stage-receipt-photos="@Model.StageReceiptPhotos.ToString().ToLowerInvariant()"
         data-global-enabled="@Model.Settings.Enabled.ToString().ToLowerInvariant()"
         data-brio-enabled="@Model.Settings.BrioEnabled.ToString().ToLowerInvariant()"
         data-obsbot-enabled="@Model.Settings.ObsbotEnabled.ToString().ToLowerInvariant()"
         data-scale-enabled="@Model.Settings.ScaleEnabled.ToString().ToLowerInvariant()"
         data-whole-sample-label="@Model.WholeSampleLabel"
         data-cut-fruit-label="@Model.CutFruitLabel">
    <h2>Capture from Devices</h2>
    <p class="notice warning" data-device-disabled>Device capture is disabled.</p>
    <div class="button-row">
        <button type="button" data-device-enable>Enable Device Capture on this browser</button>
        <button type="button" class="secondary-button" data-device-settings>Device Setup / Select Cameras</button>
        <button type="button" class="secondary-button" data-device-reset>Reset Device Settings</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(saveFirstMessage))
    {
        <p class="notice" data-device-save-first>@saveFirstMessage</p>
    }
    <div class="device-status-grid" aria-live="polite">
        <div><strong>Brio camera:</strong> <span data-device-status="apple">Not selected</span></div>
        <div><strong>OBSBOT camera:</strong> <span data-device-status="truck">Not selected</span></div>
        <div><strong>Scale:</strong> <span data-device-status="scale">Not connected</span></div>
        <div><strong>Last weight:</strong> <span data-device-status="last-weight">None</span></div>
        <div><strong>Last photo:</strong> <span data-device-status="last-photo">None</span></div>
    </div>
    <div class="device-preview-row">
        <video class="device-video" autoplay playsinline muted hidden></video>
        <canvas class="device-canvas" hidden></canvas>
    </div>
    <details class="device-settings" hidden>
        <summary>Device Selection</summary>
        <p class="muted" data-camera-permission-message hidden>Allow camera access to identify cameras.</p>
        <div class="button-row">
            <button type="button" class="secondary-button" data-camera-permission>Allow Camera Access</button>
            <button type="button" class="secondary-button" data-camera-test>Test Camera Preview</button>
            <button type="button" class="secondary-button" data-device-save>Save device choices</button>
        </div>
        <div class="form-grid">
            <label class="field"><span data-fruit-camera-label>@Model.FruitCameraLabel</span>
                <select data-camera-select="apple"></select>
            </label>
            <label class="field">Truck camera
                <select data-camera-select="truck"></select>
            </label>
            <label class="field">Scale
                <select data-scale-select>
                    <option value="">Browser scale connection</option>
                    <option value="web-serial">Web Serial</option>
                    <option value="web-usb">WebUSB</option>
                </select>
            </label>
        </div>
        <section class="camera-control-panel" data-camera-controls hidden aria-labelledby="@($"{panelId}-camera-controls-heading")">
            <div>
                <h3 id="@($"{panelId}-camera-controls-heading")">Camera Image Setup</h3>
                <p><strong>Current camera:</strong> <span data-camera-current-label>Not connected</span></p>
                <p class="muted">Changes apply to the live camera. Settings are remembered for this camera on this computer.</p>
            </div>
            <div class="button-row camera-quick-controls">
                <button type="button" data-camera-use-automatic>Use Automatic Color &amp; Exposure</button>
                <button type="button" class="secondary-button" data-camera-lock-current disabled>Lock Current Color &amp; Exposure</button>
                <button type="button" class="secondary-button" data-camera-controls-reset>Reset Camera</button>
            </div>
            <p class="muted" data-camera-lock-help>Connect a camera to see whether its current color and exposure can be locked.</p>
            <p class="muted" data-camera-controls-none hidden>This camera/driver does not provide adjustable image controls. Test photos remain available.</p>

            <section class="camera-control-section" data-camera-section="lighting" hidden>
                <h4>Lighting</h4>
                <label class="camera-control-toggle" data-camera-control="exposureMode" hidden>
                    <input type="checkbox" data-camera-auto-exposure />
                    <span>Auto Exposure</span>
                </label>
                <label class="field camera-control-field" data-camera-control="exposureCompensation" hidden>
                    Exposure
                    <span class="camera-range-ends"><span>Darker</span><span>Brighter</span></span>
                    <input type="range" data-camera-control-input="exposureCompensation" />
                    <output data-camera-control-value="exposureCompensation"></output>
                </label>
                <label class="field camera-control-field" data-camera-control="exposureTime" hidden>
                    Manual Exposure
                    <input type="range" data-camera-control-input="exposureTime" />
                    <output data-camera-control-value="exposureTime"></output>
                </label>
            </section>

            <section class="camera-control-section" data-camera-section="whiteBalance" hidden>
                <h4>Color Temperature</h4>
                <label class="camera-control-toggle" data-camera-control="whiteBalanceMode" hidden>
                    <input type="checkbox" data-camera-auto-white-balance />
                    <span>Auto White Balance</span>
                </label>
                <label class="field camera-control-field" data-camera-control="colorTemperature" hidden>
                    <span class="camera-range-ends"><span>Cooler</span><span>Warmer</span></span>
                    <input type="range" data-camera-control-input="colorTemperature" />
                    <output data-camera-control-value="colorTemperature"></output>
                </label>
            </section>

            <section class="camera-control-section" data-camera-section="color" hidden>
                <h4>Color</h4>
                <div class="camera-control-grid">
                    <label class="field camera-control-field" data-camera-control="brightness" hidden>Brightness
                        <input type="range" data-camera-control-input="brightness" />
                        <output data-camera-control-value="brightness"></output>
                    </label>
                    <label class="field camera-control-field" data-camera-control="contrast" hidden>Contrast
                        <input type="range" data-camera-control-input="contrast" />
                        <output data-camera-control-value="contrast"></output>
                    </label>
                    <label class="field camera-control-field" data-camera-control="saturation" hidden>Saturation
                        <input type="range" data-camera-control-input="saturation" />
                        <output data-camera-control-value="saturation"></output>
                    </label>
                </div>
            </section>

            <section class="camera-control-section" data-camera-section="focus" hidden>
                <h4>Focus</h4>
                <div class="camera-control-field" data-camera-control="focus" hidden>
                    <label class="camera-control-toggle">
                        <input type="checkbox" data-camera-auto-focus />
                        <span>Auto Focus</span>
                    </label>
                    <p class="muted" data-camera-focus-mode></p>
                    <label class="field" data-camera-manual-focus data-camera-control="focusDistance" hidden>Manual Focus
                        <input type="range" data-camera-control-input="focusDistance" />
                        <output data-camera-control-value="focusDistance"></output>
                    </label>
                </div>
            </section>

            <section class="camera-control-section camera-test-section">
                <h4>Test Camera Image</h4>
                <p class="muted">Test photos stay on this computer and are not saved to the QC record.</p>
                <div class="button-row">
                    <button type="button" data-camera-capture-test>Capture Test Photo</button>
                    <button type="button" class="secondary-button" data-camera-clear-tests>Clear Tests</button>
                </div>
                <div class="camera-test-grid" data-camera-test-grid>
                    <div class="camera-test-empty">No test photos captured.</div>
                </div>
            </section>

            <details class="camera-advanced" data-camera-advanced>
                <summary>Advanced</summary>
                <div class="camera-control-grid">
                    <label class="field camera-control-field" data-camera-control="sharpness" hidden>Sharpness
                        <input type="range" data-camera-control-input="sharpness" />
                        <output data-camera-control-value="sharpness"></output>
                    </label>
                    <label class="field camera-control-field" data-camera-control="iso" hidden>ISO
                        <input type="range" data-camera-control-input="iso" />
                        <output data-camera-control-value="iso"></output>
                    </label>
                </div>
                <div class="camera-details">
                    <h4>Camera Details</h4>
                    <pre data-camera-details></pre>
                    <button type="button" class="secondary-button" data-camera-copy-details>Copy Camera Details</button>
                </div>
            </details>
            <p class="muted camera-control-message" data-camera-control-message aria-live="polite"></p>
        </section>
        <p class="muted">Manual upload and manual weight entry remain available. Device capture is optional.</p>
    </details>
    <div class="button-row device-actions" data-device-actions hidden>
        @if (Model.ShowTruckPhotos)
        {
            <button type="button" data-capture-photo="BinTruck" data-camera-role="truck" disabled="@(!hasPhotoAction && !canStageReceiptPhotos)">Capture Truck Photo</button>
            <button type="button" class="secondary-button" data-capture-photo="TopOfTruck" data-camera-role="truck" disabled="@(!hasPhotoAction && !canStageReceiptPhotos)">Capture Top of Truck</button>
        }
        @if (Model.ShowApplePhotos)
        {
            <button type="button" data-capture-photo="SampleBeforeCutting" data-camera-role="apple" data-whole-sample-action disabled="@(!hasPhotoAction)">Capture @Model.WholeSampleLabel Photo</button>
            <button type="button" class="secondary-button" data-capture-photo="CutFruit" data-camera-role="apple" data-cut-fruit-action disabled="@(!hasPhotoAction)">Capture @Model.CutFruitLabel Photo</button>
            <button type="button" class="secondary-button" data-capture-photo="FruitAfterStarch" data-camera-role="apple" disabled="@(!hasPhotoAction)">Capture Starch Photo</button>
        }
        @if (Model.ShowScale)
        {
            <button type="button" data-scale-connect>Connect Scale</button>
            <button type="button" class="secondary-button" data-scale-read>Read Weight from Scale</button>
            <button type="button" class="secondary-button" data-scale-next>Capture Next Fruit Weight</button>
        }
    </div>
    <p class="muted device-message upload-feedback" data-device-message role="status" aria-live="polite">
        <span class="upload-feedback-spinner" data-device-upload-spinner aria-hidden="true" hidden></span>
        <span data-device-message-text>Manual upload and manual weight entry remain available. Device capture is optional.</span>
    </p>
    <span data-device-antiforgery hidden>@Html.AntiForgeryToken()</span>
</section>
<script src="~/js/device-camera-controls.js" asp-append-version="true"></script>
<script>
    (() => {
        const panel = document.getElementById("@panelId");
        if (!panel || panel.dataset.initialized === "true") return;
        panel.dataset.initialized = "true";

        const storageKeys = {
            enabled: "cropqc.deviceCapture.enabled",
            apple: "cropqc.deviceCapture.appleCameraId",
            truck: "cropqc.deviceCapture.truckCameraId",
            scale: "cropqc.deviceCapture.scaleSelection"
        };
        const video = panel.querySelector(".device-video");
        const canvas = panel.querySelector(".device-canvas");
        const message = panel.querySelector("[data-device-message]");
        const photoUploadSpinner = panel.querySelector("[data-device-upload-spinner]");
        const disabledMessage = panel.querySelector("[data-device-disabled]");
        const actions = panel.querySelector("[data-device-actions]");
        const settings = panel.querySelector(".device-settings");
        const permissionMessage = panel.querySelector("[data-camera-permission-message]");
        const scaleSelect = panel.querySelector("[data-scale-select]");
        const cameraControlsApi = window.CropQcCameraControls;
        const cameraControlsPanel = panel.querySelector("[data-camera-controls]");
        const cameraControlsNone = panel.querySelector("[data-camera-controls-none]");
        const cameraControlMessage = panel.querySelector("[data-camera-control-message]");
        const currentCameraLabel = panel.querySelector("[data-camera-current-label]");
        const useAutomaticButton = panel.querySelector("[data-camera-use-automatic]");
        const lockCurrentButton = panel.querySelector("[data-camera-lock-current]");
        const lockHelp = panel.querySelector("[data-camera-lock-help]");
        const autoExposureInput = panel.querySelector("[data-camera-auto-exposure]");
        const autoWhiteBalanceInput = panel.querySelector("[data-camera-auto-white-balance]");
        const autoFocusInput = panel.querySelector("[data-camera-auto-focus]");
        const focusModeMessage = panel.querySelector("[data-camera-focus-mode]");
        const manualFocusField = panel.querySelector("[data-camera-manual-focus]");
        const cameraDetailsOutput = panel.querySelector("[data-camera-details]");
        const cameraTestGrid = panel.querySelector("[data-camera-test-grid]");
        const cameraControlInputs = Object.fromEntries(
            Array.from(panel.querySelectorAll("[data-camera-control-input]"))
                .map(input => [input.dataset.cameraControlInput, input]));
        const cameraControlOutputs = Object.fromEntries(
            Array.from(panel.querySelectorAll("[data-camera-control-value]"))
                .map(output => [output.dataset.cameraControlValue, output]));
        const cameraSelects = {
            apple: panel.querySelector("[data-camera-select='apple']"),
            truck: panel.querySelector("[data-camera-select='truck']")
        };
        let stream = null;
        let activeRole = null;
        let activeCameraDeviceId = null;
        let cameraControlSession = null;
        let cameraControlCapabilities = {};
        const cameraTestBuffer = cameraControlsApi ? new cameraControlsApi.TestPhotoBuffer(window.URL) : null;
        const cameraControlTimers = {};
        const cameraControlVersions = {};
        const stageReceiptPhotos = panel.dataset.stageReceiptPhotos === "true";
        let serialPort = null;
        let serialReader = null;
        let lastWeight = null;
        let nextWeightRowIndex = 0;
        let photoCaptureBusy = false;
        let receiptSubmissionBusy = false;
        const photoCaptureButtons = Array.from(panel.querySelectorAll("[data-capture-photo]"));
        const photoCaptureButtonDefaults = new Map(photoCaptureButtons.map(button => [button, button.disabled]));
        const storage = {
            getItem(key) {
                try { return window.localStorage.getItem(key); }
                catch { return null; }
            },
            setItem(key, value) {
                try { window.localStorage.setItem(key, value); return true; }
                catch { show("Browser storage is blocked. Device choices will work for this page only and must be selected again next time.", true); return false; }
            },
            removeItem(key) {
                try { window.localStorage.removeItem(key); }
                catch { }
            }
        };

        function localCaptureEnabled() {
            return storage.getItem(storageKeys.enabled) === "true";
        }

        function setEnabled(enabled) {
            storage.setItem(storageKeys.enabled, enabled ? "true" : "false");
            disabledMessage.hidden = enabled;
            actions.hidden = !enabled;
            if (enabled) {
                show("Device capture is enabled on this browser. Select a camera to start live preview.");
            } else {
                stopCamera();
                show("Manual upload and manual weight entry remain available. Device capture is optional.");
            }
        }

        function status(name, value) {
            const target = panel.querySelector(`[data-device-status='${name}']`);
            if (target) target.textContent = value;
        }

        function show(text, warning = false) {
            panel.querySelector("[data-device-message-text]").textContent = text;
            message.classList.toggle("warning-text", warning);
        }

        function beginPhotoCapture(messageText) {
            if (photoCaptureBusy) return false;
            photoCaptureBusy = true;
            panel.setAttribute("aria-busy", "true");
            photoUploadSpinner.hidden = false;
            photoCaptureButtons.forEach(button => { button.disabled = true; });
            show(messageText);
            return true;
        }

        function endPhotoCapture() {
            photoCaptureBusy = false;
            panel.removeAttribute("aria-busy");
            photoUploadSpinner.hidden = true;
            photoCaptureButtons.forEach(button => {
                button.disabled = receiptSubmissionBusy || photoCaptureButtonDefaults.get(button) === true;
            });
        }

        function setCameraControlMessage(messageText, warning = false) {
            if (!cameraControlMessage) return;
            cameraControlMessage.textContent = messageText;
            cameraControlMessage.classList.toggle("warning-text", warning);
        }

        function hideCameraControls() {
            if (cameraControlsPanel) cameraControlsPanel.hidden = true;
            cameraControlSession = null;
            cameraControlCapabilities = {};
            activeCameraDeviceId = null;
            if (currentCameraLabel) currentCameraLabel.textContent = "Not connected";
            for (const name of [
                "exposureMode", "exposureCompensation", "exposureTime",
                "whiteBalanceMode", "colorTemperature",
                "brightness", "contrast", "saturation", "sharpness", "iso",
                "focusMode", "focusDistance"
            ]) {
                window.clearTimeout(cameraControlTimers[name]);
                cameraControlVersions[name] = (cameraControlVersions[name] || 0) + 1;
            }
        }

        function renderRangeControl(name, range, currentValue) {
            const row = panel.querySelector("[data-camera-control='" + name + "']");
            const input = cameraControlInputs[name];
            const output = cameraControlOutputs[name];
            if (!row || !input || !output) return false;
            row.hidden = !range;
            if (!range) return false;
            input.min = String(range.min);
            input.max = String(range.max);
            input.step = String(range.step);
            const applied = cameraControlsApi.clampToRange(currentValue ?? range.min, range);
            input.value = String(applied ?? range.min);
            output.value = input.value;
            output.textContent = name === "colorTemperature" ? input.value + " K" : input.value;
            return true;
        }

        async function captureCameraJpeg() {
            if (cameraControlsApi?.captureJpegBlob) {
                return cameraControlsApi.captureJpegBlob(video, canvas, 0.92);
            }
            const width = video.videoWidth || 1280;
            const height = video.videoHeight || 720;
            canvas.width = width;
            canvas.height = height;
            canvas.getContext("2d").drawImage(video, 0, 0, width, height);
            return new Promise(resolve => canvas.toBlob(resolve, "image/jpeg", 0.92));
        }

        function renderCameraControls(actualSettings) {
            if (!cameraControlsPanel || !cameraControlSession || !cameraControlsApi) return;
            const description = cameraControlsApi.describeCapabilities(cameraControlCapabilities);
            const exposureModeRow = panel.querySelector("[data-camera-control='exposureMode']");
            const canToggleExposure = description.automaticExposureSupported && description.manualExposureSupported;
            const exposureIsManual = actualSettings.exposureMode === description.manualExposureMode;
            if (exposureModeRow) exposureModeRow.hidden = !canToggleExposure;
            if (autoExposureInput) {
                autoExposureInput.checked = !exposureIsManual && description.automaticExposureSupported;
                autoExposureInput.disabled = !canToggleExposure;
            }
            const hasExposureAdjustment = renderRangeControl("exposureCompensation", description.exposureCompensation, actualSettings.exposureCompensation);
            if (cameraControlInputs.exposureCompensation) cameraControlInputs.exposureCompensation.disabled = exposureIsManual;
            const exposureAdjustmentRow = panel.querySelector("[data-camera-control='exposureCompensation']");
            if (exposureAdjustmentRow) exposureAdjustmentRow.hidden = !hasExposureAdjustment || exposureIsManual;
            const hasManualExposure = renderRangeControl("exposureTime", description.exposureTime, actualSettings.exposureTime);
            const manualExposureRow = panel.querySelector("[data-camera-control='exposureTime']");
            if (manualExposureRow) manualExposureRow.hidden = !hasManualExposure || !description.manualExposureSupported || !exposureIsManual;

            const whiteBalanceModeRow = panel.querySelector("[data-camera-control='whiteBalanceMode']");
            const canToggleWhiteBalance = description.automaticWhiteBalanceSupported && description.manualWhiteBalanceSupported;
            const whiteBalanceIsManual = actualSettings.whiteBalanceMode === description.manualWhiteBalanceMode;
            if (whiteBalanceModeRow) whiteBalanceModeRow.hidden = !canToggleWhiteBalance;
            if (autoWhiteBalanceInput) {
                autoWhiteBalanceInput.checked = !whiteBalanceIsManual && description.automaticWhiteBalanceSupported;
                autoWhiteBalanceInput.disabled = !canToggleWhiteBalance;
            }
            const hasColorTemperature = renderRangeControl("colorTemperature", description.colorTemperature, actualSettings.colorTemperature);
            const colorTemperatureRow = panel.querySelector("[data-camera-control='colorTemperature']");
            if (colorTemperatureRow) colorTemperatureRow.hidden = !hasColorTemperature || !description.manualWhiteBalanceSupported || !whiteBalanceIsManual;

            const focusRow = panel.querySelector("[data-camera-control='focus']");
            const hasFocus = Boolean(description.autoFocusMode || description.manualFocusSupported);
            if (focusRow) focusRow.hidden = !hasFocus;

            if (hasFocus && autoFocusInput) {
                const manual = actualSettings.focusMode === description.manualFocusMode;
                autoFocusInput.checked = !manual && Boolean(description.autoFocusMode);
                autoFocusInput.disabled = !description.autoFocusMode || !description.manualFocusSupported;
                if (focusModeMessage) {
                    focusModeMessage.textContent = description.manualFocusSupported
                        ? "Current mode: " + (actualSettings.focusMode || (autoFocusInput.checked ? description.autoFocusMode : description.manualFocusMode))
                        : "Manual focus is not supported by this camera/driver.";
                }
                if (manualFocusField) manualFocusField.hidden = !description.manualFocusSupported;
                if (description.manualFocusSupported) {
                    renderRangeControl("focusDistance", description.focusDistance, actualSettings.focusDistance);
                    cameraControlInputs.focusDistance.disabled = !manual;
                }
            }

            const hasBrightness = renderRangeControl("brightness", description.brightness, actualSettings.brightness);
            const hasContrast = renderRangeControl("contrast", description.contrast, actualSettings.contrast);
            const hasSaturation = renderRangeControl("saturation", description.saturation, actualSettings.saturation);
            const hasSharpness = renderRangeControl("sharpness", description.sharpness, actualSettings.sharpness);
            const hasIso = renderRangeControl("iso", description.iso, actualSettings.iso);
            panel.querySelector("[data-camera-section='lighting']").hidden = !(
                canToggleExposure || hasExposureAdjustment || (hasManualExposure && description.manualExposureSupported));
            panel.querySelector("[data-camera-section='whiteBalance']").hidden = !(
                canToggleWhiteBalance || (hasColorTemperature && description.manualWhiteBalanceSupported));
            panel.querySelector("[data-camera-section='color']").hidden = !(hasBrightness || hasContrast || hasSaturation);
            panel.querySelector("[data-camera-section='focus']").hidden = !hasFocus;

            const automaticValues = cameraControlsApi.automaticColorExposureValues(cameraControlCapabilities);
            useAutomaticButton.disabled = Object.keys(automaticValues).length === 0;
            const lock = cameraControlsApi.lockCurrentColorExposureValues(cameraControlCapabilities, actualSettings);
            lockCurrentButton.disabled = !lock.canLock;
            lockCurrentButton.title = lock.canLock
                ? "Freeze the supported current exposure and white-balance values."
                : "This camera/driver does not expose safe current manual values to lock.";
            lockHelp.textContent = lock.canLock
                ? "Locks the current values where supported; unsupported portions will remain unchanged."
                : "Lock is unavailable because this camera/driver does not expose safe current manual values.";

            const cameraLabel = cameraSelects.apple?.options[cameraSelects.apple.selectedIndex]?.textContent || "Camera";
            if (currentCameraLabel) currentCameraLabel.textContent = cameraLabel;
            if (cameraDetailsOutput) {
                cameraDetailsOutput.textContent = JSON.stringify(
                    cameraControlsApi.cameraDetails(cameraLabel, actualSettings, cameraControlCapabilities), null, 2);
            }

            const anySupported = canToggleExposure || hasExposureAdjustment || hasManualExposure
                || canToggleWhiteBalance || hasColorTemperature || hasFocus
                || hasBrightness || hasContrast || hasSaturation || hasSharpness || hasIso;
            cameraControlsNone.hidden = anySupported;
            cameraControlsPanel.hidden = false;
        }

        function persistActualCameraControls(actualSettings) {
            if (!activeCameraDeviceId || !cameraControlsApi || !cameraControlSession) return;
            const values = cameraControlsApi.settingsForPersistence(actualSettings, cameraControlCapabilities);
            cameraControlsApi.saveControls(storage, activeCameraDeviceId, values);
        }

        function friendlyControlError(error, controlName) {
            const label = {
                exposureMode: "exposure mode",
                exposureCompensation: "exposure",
                exposureTime: "manual exposure",
                whiteBalanceMode: "white-balance mode",
                colorTemperature: "color temperature",
                focusDistance: "focus",
                focusMode: "focus"
            }[controlName] || controlName;
            if (error?.name === "OverconstrainedError") {
                return "The camera did not accept that " + label + " setting. The previous setting is still in use.";
            }
            if (error?.name === "NotReadableError" || error?.name === "AbortError") {
                return "The camera is busy or disconnected. Preview and manual upload remain available.";
            }
            return "The camera could not apply that " + label + " setting. The previous setting is still in use.";
        }

        async function applyCameraControl(values, controlName, version) {
            if (!cameraControlSession) return;
            try {
                const actual = await cameraControlSession.apply(values);
                if (version !== undefined && version !== cameraControlVersions[controlName]) return;
                renderCameraControls(actual);
                persistActualCameraControls(actual);
                setCameraControlMessage("Camera " + (controlName === "focusDistance" ? "focus" : controlName) + " updated.");
                return true;
            } catch (error) {
                if (version !== undefined && version !== cameraControlVersions[controlName]) return;
                renderCameraControls(cameraControlSession.getSettings());
                setCameraControlMessage(friendlyControlError(error, controlName), true);
                return false;
            }
        }

        function scheduleCameraControl(name, value) {
            cameraControlVersions[name] = (cameraControlVersions[name] || 0) + 1;
            const version = cameraControlVersions[name];
            window.clearTimeout(cameraControlTimers[name]);
            cameraControlTimers[name] = window.setTimeout(
                () => applyCameraControl({ [name]: value }, name, version),
                150);
        }

        async function initializeAppleCameraControls(track, deviceId, reapplySaved = true) {
            if (!cameraControlsApi || !track) {
                hideCameraControls();
                return;
            }

            activeCameraDeviceId = deviceId;
            cameraControlSession = new cameraControlsApi.CameraControlSession(track);
            cameraControlCapabilities = cameraControlSession.capabilities;
            let actual = cameraControlSession.getSettings();
            const saved = reapplySaved ? cameraControlsApi.savedControls(storage, deviceId) : {};
            const sanitized = cameraControlsApi.sanitizeValues(saved, cameraControlCapabilities);
            const description = cameraControlsApi.describeCapabilities(cameraControlCapabilities);
            if (sanitized.values.focusDistance !== undefined
                && sanitized.values.focusMode !== description.manualFocusMode) {
                delete sanitized.values.focusDistance;
                sanitized.discarded.push("focusDistance");
            }
            if (reapplySaved && Object.keys(saved).length === 0 && description.autoFocusMode) {
                sanitized.values.focusMode = description.autoFocusMode;
            }
            if (sanitized.discarded.length > 0) {
                cameraControlsApi.saveControls(storage, deviceId, sanitized.values);
            }

            if (Object.keys(sanitized.values).length > 0) {
                try {
                    actual = await cameraControlSession.apply(sanitized.values);
                    persistActualCameraControls(actual);
                } catch (error) {
                    cameraControlsApi.clearControls(storage, deviceId);
                    actual = cameraControlSession.getSettings();
                    setCameraControlMessage("Saved camera controls were not accepted and were cleared. The preview remains available.", true);
                }
            } else {
                cameraControlsApi.clearControls(storage, deviceId);
            }

            renderCameraControls(actual);
        }

        function stopCamera() {
            if (stream) {
                stream.getTracks().forEach(track => track.stop());
                stream = null;
            }
            hideCameraControls();
            activeRole = null;
            video.srcObject = null;
            video.hidden = true;
        }

        function renderTestPhotos() {
            if (!cameraTestGrid || !cameraTestBuffer) return;
            cameraTestGrid.replaceChildren();
            if (cameraTestBuffer.items.length === 0) {
                const empty = document.createElement("div");
                empty.className = "camera-test-empty";
                empty.textContent = "No test photos captured.";
                cameraTestGrid.appendChild(empty);
                return;
            }

            cameraTestBuffer.items.forEach((item, index) => {
                const figure = document.createElement("figure");
                figure.className = "camera-test-card";
                const image = document.createElement("img");
                image.src = item.url;
                image.alt = `Camera test ${index + 1}`;
                const caption = document.createElement("figcaption");
                const title = document.createElement("strong");
                title.textContent = `Test ${index + 1}`;
                caption.appendChild(title);
                for (const setting of item.settings) {
                    const row = document.createElement("span");
                    row.textContent = `${setting.label}: ${setting.value}`;
                    caption.appendChild(row);
                }
                figure.append(image, caption);
                cameraTestGrid.appendChild(figure);
            });
        }

        async function captureTestPhoto() {
            const started = activeRole === "apple" && stream ? true : await startCamera("apple");
            if (!started || !cameraControlSession || !cameraTestBuffer) return;
            await new Promise(resolve => setTimeout(resolve, 150));
            const blob = await captureCameraJpeg();
            if (!blob) {
                setCameraControlMessage("Could not capture a test photo. The camera preview remains available.", true);
                return;
            }
            const actualSettings = cameraControlSession.getSettings();
            const snapshot = cameraControlsApi.importantSettingsSnapshot(actualSettings, cameraControlCapabilities);
            cameraTestBuffer.add(blob, snapshot);
            renderTestPhotos();
            setCameraControlMessage("Test photo captured locally. It was not uploaded or saved to the QC record.");
        }

        function friendlyPhotoType(photoType) {
            return {
                BinTruck: "Truck photo",
                TopOfTruck: "Top of truck",
                SampleBeforeCutting: `${panel.dataset.wholeSampleLabel || "Whole fruit sample"} photo`,
                CutFruit: `${panel.dataset.cutFruitLabel || "Cut fruit"} photo`,
                FruitAfterStarch: "Starch photo"
            }[photoType] || photoType;
        }

        function actionFor(photoType) {
            if (photoType === "BinTruck" || photoType === "TopOfTruck") {
                return panel.dataset.receiptPhotoAction || panel.dataset.samplePhotoAction;
            }

            if (photoType === "FruitAfterStarch" && panel.dataset.starchPhotoAction) {
                return panel.dataset.starchPhotoAction;
            }

            return panel.dataset.samplePhotoAction || panel.dataset.starchPhotoAction;
        }

        function defaultRoleForDevice(label) {
            const value = (label || "").toLowerCase();
            if (value.includes("obsbot") || value.includes("tiny")) return "truck";
            if (value.includes("brio") || value.includes("logitech")) return "apple";
            return null;
        }

        function friendlyCameraError(error, role) {
            if (!window.isSecureContext) {
                return "Camera access requires HTTPS (or localhost). The form remains available; use file upload on this connection.";
            }
            if (error?.name === "NotAllowedError" || error?.name === "SecurityError") {
                return "Camera permission denied. Allow camera access in browser site settings, then retry. The form remains available.";
            }

            if (error?.name === "NotFoundError" || error?.name === "OverconstrainedError") {
                return role === "truck" ? "OBSBOT camera not found." : "Brio camera not found.";
            }

            if (error?.name === "NotReadableError" || error?.name === "AbortError") {
                return "Camera is busy or unavailable. Close other camera applications, reconnect it, then retry.";
            }

            return `Camera connection failed (${error?.name || "unknown error"}). Retry Device Setup or use manual upload.`;
        }

        async function requestCameraPermission() {
            if (!navigator.mediaDevices?.getUserMedia) {
                show("Browser camera API unavailable.", true);
                return false;
            }

            try {
                const permissionStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
                permissionStream.getTracks().forEach(track => track.stop());
                await ensureCameraList();
                show("Camera access allowed. Select a camera to preview it.");
                return true;
            } catch (error) {
                show(friendlyCameraError(error), true);
                return false;
            }
        }

        async function ensureCameraList() {
            if (!navigator.mediaDevices?.enumerateDevices) {
                show("Browser camera API unavailable.", true);
                return [];
            }

            let devices;
            try {
                devices = await navigator.mediaDevices.enumerateDevices();
            } catch (error) {
                show(friendlyCameraError(error, "apple"), true);
                return [];
            }
            let cameras = devices.filter(device => device.kind === "videoinput");
            const hasLabels = cameras.some(device => device.label);
            permissionMessage.hidden = cameras.length === 0 || hasLabels;
            if (cameras.length > 0 && !hasLabels) {
                show("Allow camera access to identify cameras.");
            }

            for (const role of ["apple", "truck"]) {
                const select = cameraSelects[role];
                if (!select) continue;
                const previous = select.value || storage.getItem(storageKeys[role]) || "";
                select.innerHTML = "";
                if (cameras.length === 0) {
                    const option = document.createElement("option");
                    option.value = "";
                    option.textContent = "No camera found";
                    select.appendChild(option);
                    status(role, "Camera not found");
                    continue;
                }

                for (const camera of cameras) {
                    const option = document.createElement("option");
                    option.value = camera.deviceId;
                    option.textContent = camera.label || `USB camera ${select.options.length + 1}`;
                    select.appendChild(option);
                }

                const mapped = cameras.find(camera => defaultRoleForDevice(camera.label) === role)?.deviceId;
                const nextValue = cameras.some(camera => camera.deviceId === previous)
                    ? previous
                    : mapped || cameras[0]?.deviceId || "";
                select.value = nextValue;
                if (nextValue) {
                    storage.setItem(storageKeys[role], nextValue);
                    status(role, select.options[select.selectedIndex]?.textContent || "Selected");
                }
            }

            return cameras;
        }

        async function startCamera(role, options = {}) {
            if (!navigator.mediaDevices?.getUserMedia) {
                show("Browser camera API unavailable.", true);
                return false;
            }

            await ensureCameraList();
            const deviceId = cameraSelects[role]?.value || storage.getItem(storageKeys[role]);
            if (!deviceId) {
                show(role === "truck" ? "OBSBOT camera not found." : "Brio camera not found.", true);
                return false;
            }

            if (stream) stopCamera();

            try {
                stream = await navigator.mediaDevices.getUserMedia({ video: { deviceId: { exact: deviceId } }, audio: false });
                video.srcObject = stream;
                video.hidden = false;
                await video.play();
                activeRole = role;
                const label = cameraSelects[role]?.options[cameraSelects[role]?.selectedIndex]?.textContent || "Camera";
                status(role, `${label} connected`);
                if (role === "apple") {
                    const track = stream.getVideoTracks?.()[0];
                    track?.addEventListener?.("ended", () => {
                        if (stream?.getVideoTracks?.().includes(track)) {
                            stopCamera();
                            show("Camera disconnected. Reconnect it in Device Setup or use manual upload.", true);
                        }
                    }, { once: true });
                    await initializeAppleCameraControls(track, deviceId, options.reapplySaved !== false);
                } else {
                    hideCameraControls();
                }
                show("Camera connected.");
                return true;
            } catch (error) {
                stopCamera();
                show(friendlyCameraError(error, role), true);
                return false;
            }
        }

        async function capturePhoto(photoType, role) {
            const action = actionFor(photoType);
            const shouldStage = !action
                && stageReceiptPhotos
                && (photoType === "BinTruck" || photoType === "TopOfTruck");
            if (!action && !shouldStage) {
                show("Save the receipt first to attach photos.", true);
                return;
            }
            const hasPendingFieldSample = window.fieldSampleAutosave?.hasPending();
            if (!beginPhotoCapture(hasPendingFieldSample
                ? "Saving Field Sample changes before the photo upload..."
                : `Preparing ${friendlyPhotoType(photoType)}...`)) return;

            let reloading = false;
            try {
                if (hasPendingFieldSample && !await window.fieldSampleAutosave.flush()) {
                    show("Save the pending Field Sample changes before capturing a photo. The entered values remain on this page.", true);
                    return;
                }

                show(`Preparing ${friendlyPhotoType(photoType)}...`);
                const started = activeRole === role && stream ? true : await startCamera(role);
                if (!started) return;
                await new Promise(resolve => setTimeout(resolve, 150));
                const blob = await captureCameraJpeg();
                if (!blob) {
                    show("Could not capture photo from camera.", true);
                    return;
                }

                const safeType = photoType.replace(/[^A-Za-z0-9_-]/g, "");
                const fileName = `${safeType}_${new Date().toISOString().replace(/[:.]/g, "-")}.jpg`;
                const photoSource = role === "truck" ? "OBSBOT Tiny 2 Lite" : "Logitech Brio 4K";
                const file = new File([blob], fileName, { type: "image/jpeg" });
                if (shouldStage) {
                    window.dispatchEvent(new CustomEvent("cropqc:stage-receipt-photo", {
                        detail: { file, photoType, photoSource }
                    }));
                    status("last-photo", `${friendlyPhotoType(photoType)} staged`);
                    show(`${friendlyPhotoType(photoType)} staged. Review the thumbnail before saving the receipt.`);
                    return;
                }
                const form = new FormData();
                form.append("PhotoType", photoType);
                form.append("PhotoSource", photoSource);
                form.append("PhotoFile", file);
                form.append("FileName", fileName);
                form.append("ContentType", "image/jpeg");
                form.append("FileSizeBytes", String(blob.size));
                const antiforgery = panel.querySelector("[data-device-antiforgery] input[name='__RequestVerificationToken']");
                if (antiforgery) form.append("__RequestVerificationToken", antiforgery.value);

                show(`Uploading ${friendlyPhotoType(photoType)}...`);
                const response = await fetch(action, {
                    method: "POST",
                    body: form,
                    credentials: "same-origin"
                });

                if (!response.ok) {
                    show(`Photo upload failed (${response.status}). Manual upload is still available.`, true);
                    return;
                }

                status("last-photo", `${friendlyPhotoType(photoType)} captured`);
                show(`${friendlyPhotoType(photoType)} uploaded. Reloading...`);
                reloading = true;
                window.location.reload();
            } catch {
                show("Photo upload could not be completed. The record remains available; retry or use manual upload.", true);
            } finally {
                if (!reloading) endPhotoCapture();
            }
        }

        async function connectScale() {
            storage.setItem(storageKeys.scale, scaleSelect?.value || "");
            if ("serial" in navigator) {
                try {
                    serialPort = await navigator.serial.requestPort();
                    await serialPort.open({ baudRate: 9600 });
                    status("scale", "Connected");
                    show("Scale connected. If no weight appears, confirm the scale exposes serial output.");
                    readScaleLoop();
                } catch (error) {
                    show("Scale not connected.", true);
                }
                return;
            }

            if ("usb" in navigator) {
                show("WebUSB is available, but this scale is not configured as a browser USB device. Use manual entry or a QC Station/local helper if it does not expose Web Serial.", true);
                return;
            }

            show("Browser does not support Web Serial/WebUSB. Use manual entry or QC Station/local helper.", true);
        }

        async function readScaleLoop() {
            if (!serialPort?.readable || serialReader) return;
            const decoder = new TextDecoder();
            serialReader = serialPort.readable.getReader();
            let buffer = "";
            try {
                while (true) {
                    const { value, done } = await serialReader.read();
                    if (done) break;
                    buffer += decoder.decode(value);
                    const match = buffer.match(/(-?\d+(?:\.\d+)?)\s*g?/i);
                    if (match) {
                        lastWeight = Number(match[1]);
                        status("last-weight", `${lastWeight} g`);
                        buffer = "";
                    }
                }
            } catch {
                status("scale", "Disconnected");
            } finally {
                serialReader.releaseLock();
                serialReader = null;
            }
        }

        function selectedWeightInput() {
            const rows = Array.from(document.querySelectorAll("tr.fruit-row"));
            if (rows.length === 0) return null;
            const active = document.querySelector("tr.fruit-row.device-selected-row");
            const row = active || rows[Math.min(nextWeightRowIndex, rows.length - 1)];
            return row?.querySelector("input[name$='.WeightGrams']");
        }

        function captureWeight(advance) {
            if (lastWeight === null) {
                show("Scale not connected or no current weight is available.", true);
                return;
            }

            const input = selectedWeightInput();
            if (!input) {
                show("No fruit weight row is available on this page.", true);
                return;
            }

            input.dataset.changeSource = "Scale";
            input.value = String(lastWeight);
            input.dispatchEvent(new Event("input", { bubbles: true }));
            status("last-weight", `${lastWeight} g captured`);
            show(`Captured ${lastWeight} g into the selected fruit row and recalculated its size.`);
            if (advance) {
                const rows = Array.from(document.querySelectorAll("tr.fruit-row"));
                nextWeightRowIndex = Math.min(rows.length - 1, rows.indexOf(input.closest("tr")) + 1);
                rows.forEach(row => row.classList.remove("device-selected-row"));
                rows[nextWeightRowIndex]?.classList.add("device-selected-row");
            }
        }

        document.addEventListener("click", event => {
            const row = event.target?.closest?.("tr.fruit-row");
            if (!row) return;
            const rows = Array.from(document.querySelectorAll("tr.fruit-row"));
            rows.forEach(item => item.classList.remove("device-selected-row"));
            row.classList.add("device-selected-row");
            nextWeightRowIndex = Math.max(0, rows.indexOf(row));
        });

        panel.querySelector("[data-device-enable]")?.addEventListener("click", async () => {
            setEnabled(true);
            settings.hidden = false;
            settings.open = true;
            await ensureCameraList();
        });
        panel.querySelector("[data-device-settings]")?.addEventListener("click", async () => {
            settings.hidden = !settings.hidden;
            if (!settings.hidden) {
                settings.open = true;
                await ensureCameraList();
            }
        });
        panel.querySelector("[data-device-reset]")?.addEventListener("click", () => {
            stopCamera();
            storage.removeItem(storageKeys.enabled);
            storage.removeItem(storageKeys.apple);
            storage.removeItem(storageKeys.truck);
            storage.removeItem(storageKeys.scale);
            setEnabled(false);
            status("apple", "Not selected");
            status("truck", "Not selected");
            status("scale", "Not connected");
        });
        panel.querySelector("[data-camera-permission]")?.addEventListener("click", requestCameraPermission);
        panel.querySelector("[data-camera-test]")?.addEventListener("click", async () => {
            await startCamera(cameraSelects.apple?.value ? "apple" : "truck");
        });
        useAutomaticButton?.addEventListener("click", async () => {
            if (!cameraControlSession) return;
            const values = cameraControlsApi.automaticColorExposureValues(cameraControlCapabilities);
            if (Object.keys(values).length === 0) {
                setCameraControlMessage("This camera/driver does not provide automatic exposure or white balance.", true);
                return;
            }
            const applied = await applyCameraControl(values, "automatic color and exposure");
            if (applied) setCameraControlMessage("Automatic color and exposure are enabled where supported.");
        });
        lockCurrentButton?.addEventListener("click", async () => {
            if (!cameraControlSession) return;
            const lock = cameraControlsApi.lockCurrentColorExposureValues(
                cameraControlCapabilities, cameraControlSession.getSettings());
            if (!lock.canLock) {
                setCameraControlMessage("The camera driver does not provide safe current values to lock.", true);
                return;
            }
            const applied = await applyCameraControl(lock.values, "color and exposure lock");
            if (!applied) return;
            const lockedText = lock.locked.join(" and ") + " locked.";
            const unsupportedText = lock.unsupported.length > 0
                ? " " + lock.unsupported.join(" and ") + " is not supported by this camera/driver."
                : "";
            setCameraControlMessage(lockedText + unsupportedText);
        });
        autoExposureInput?.addEventListener("change", async () => {
            if (!cameraControlSession) return;
            const description = cameraControlsApi.describeCapabilities(cameraControlCapabilities);
            const targetMode = autoExposureInput.checked
                ? description.autoExposureMode
                : description.manualExposureMode;
            if (!targetMode) {
                renderCameraControls(cameraControlSession.getSettings());
                setCameraControlMessage("The camera driver does not provide that exposure mode.", true);
                return;
            }
            const values = { exposureMode: targetMode };
            if (!autoExposureInput.checked && description.manualExposureSupported) {
                values.exposureTime = Number(cameraControlInputs.exposureTime.value);
            }
            cameraControlVersions.exposureMode = (cameraControlVersions.exposureMode || 0) + 1;
            await applyCameraControl(values, "exposureMode", cameraControlVersions.exposureMode);
        });
        autoWhiteBalanceInput?.addEventListener("change", async () => {
            if (!cameraControlSession) return;
            const description = cameraControlsApi.describeCapabilities(cameraControlCapabilities);
            const targetMode = autoWhiteBalanceInput.checked
                ? description.autoWhiteBalanceMode
                : description.manualWhiteBalanceMode;
            if (!targetMode) {
                renderCameraControls(cameraControlSession.getSettings());
                setCameraControlMessage("The camera driver does not provide that white-balance mode.", true);
                return;
            }
            const values = { whiteBalanceMode: targetMode };
            if (!autoWhiteBalanceInput.checked && description.manualWhiteBalanceSupported) {
                values.colorTemperature = Number(cameraControlInputs.colorTemperature.value);
            }
            cameraControlVersions.whiteBalanceMode = (cameraControlVersions.whiteBalanceMode || 0) + 1;
            await applyCameraControl(values, "whiteBalanceMode", cameraControlVersions.whiteBalanceMode);
        });
        autoFocusInput?.addEventListener("change", async () => {
            if (!cameraControlSession) return;
            const description = cameraControlsApi.describeCapabilities(cameraControlCapabilities);
            const targetMode = autoFocusInput.checked
                ? description.autoFocusMode
                : description.manualFocusMode;
            if (!targetMode) {
                renderCameraControls(cameraControlSession.getSettings());
                return;
            }
            const values = { focusMode: targetMode };
            if (!autoFocusInput.checked && description.manualFocusSupported) {
                values.focusDistance = Number(cameraControlInputs.focusDistance.value);
            }
            cameraControlVersions.focusMode = (cameraControlVersions.focusMode || 0) + 1;
            await applyCameraControl(values, "focusMode", cameraControlVersions.focusMode);
        });
        for (const name of [
            "exposureCompensation", "exposureTime", "colorTemperature",
            "brightness", "contrast", "saturation", "sharpness", "iso", "focusDistance"
        ]) {
            cameraControlInputs[name]?.addEventListener("input", event => {
                const output = cameraControlOutputs[name];
                if (output) {
                    output.value = event.target.value;
                    output.textContent = name === "colorTemperature" ? event.target.value + " K" : event.target.value;
                }
                scheduleCameraControl(name, Number(event.target.value));
            });
        }
        panel.querySelector("[data-camera-capture-test]")?.addEventListener("click", captureTestPhoto);
        panel.querySelector("[data-camera-clear-tests]")?.addEventListener("click", () => {
            cameraTestBuffer?.clear();
            renderTestPhotos();
            setCameraControlMessage("Test photos cleared from this page.");
        });
        panel.querySelector("[data-camera-copy-details]")?.addEventListener("click", async () => {
            if (!cameraDetailsOutput?.textContent) return;
            try {
                await navigator.clipboard.writeText(cameraDetailsOutput.textContent);
                setCameraControlMessage("Camera details copied to the clipboard.");
            } catch {
                setCameraControlMessage("Camera details could not be copied. You can select the text manually.", true);
            }
        });
        panel.querySelector("[data-camera-controls-reset]")?.addEventListener("click", async () => {
            const deviceId = activeCameraDeviceId || cameraSelects.apple?.value;
            if (!deviceId || !cameraControlsApi) return;
            cameraControlsApi.clearControls(storage, deviceId);
            stopCamera();
            const restarted = await startCamera("apple", { reapplySaved: false });
            setCameraControlMessage(restarted
                ? "Saved camera controls were cleared. The camera restarted without saved advanced constraints."
                : "Saved camera controls were cleared. Reconnect the camera to refresh its controls.",
                !restarted);
        });
        panel.querySelector("[data-device-save]")?.addEventListener("click", () => {
            for (const role of ["apple", "truck"]) {
                if (cameraSelects[role]?.value) {
                    storage.setItem(storageKeys[role], cameraSelects[role].value);
                }
            }
            storage.setItem(storageKeys.scale, scaleSelect?.value || "");
            setEnabled(true);
            show("Device choices saved on this browser.");
        });
        for (const role of ["apple", "truck"]) {
            cameraSelects[role]?.addEventListener("change", async event => {
                storage.setItem(storageKeys[role], event.target.value);
                status(role, event.target.options[event.target.selectedIndex]?.textContent || "Selected");
                if (localCaptureEnabled() || (activeRole === role && stream)) {
                    await startCamera(role);
                }
            });
        }
        for (const button of panel.querySelectorAll("[data-capture-photo]")) {
            button.addEventListener("click", () => capturePhoto(button.dataset.capturePhoto, button.dataset.cameraRole));
        }
        window.addEventListener("cropqc:receipt-submit-busy", () => {
            receiptSubmissionBusy = true;
            photoCaptureButtons.forEach(button => { button.disabled = true; });
        });
        panel.querySelector("[data-scale-connect]")?.addEventListener("click", connectScale);
        panel.querySelector("[data-scale-read]")?.addEventListener("click", () => captureWeight(false));
        panel.querySelector("[data-scale-next]")?.addEventListener("click", () => captureWeight(true));
        window.addEventListener("beforeunload", () => cameraTestBuffer?.clear(), { once: true });

        if (storage.getItem(storageKeys.scale) && scaleSelect) {
            scaleSelect.value = storage.getItem(storageKeys.scale);
        }
        setEnabled(localCaptureEnabled());
        if (localCaptureEnabled()) {
            ensureCameraList().catch(error => show(friendlyCameraError(error, "apple"), true));
        }
    })();
</script>
