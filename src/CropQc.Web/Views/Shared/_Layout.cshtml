<!doctype html>
@using System.Security.Claims
@using Microsoft.AspNetCore.WebUtilities
@inject CropQc.Web.Services.IFacilityContextService FacilityContext
@inject CropQc.Web.Services.ISiteNavigationService SiteNavigation
@inject CropQc.Web.Services.AppEnvironmentOptions AppEnvironment
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Crop QC Dashboard</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var requestedFacility = Context.Request.Query["facility"].FirstOrDefault();
        var activeFacility = FacilityContext.Normalize(requestedFacility);
        var facilityRouteValue = string.IsNullOrWhiteSpace(requestedFacility) ? null : activeFacility;
        var siteNavigation = User.Identity?.IsAuthenticated == true
            ? await SiteNavigation.BuildAsync(User, Context.Request.Path, Context.Request.Query, facilityRouteValue, Context.RequestAborted)
            : new SiteNavigationViewModel([], []);

        string FacilityContextUrl(string facility)
        {
            var query = Context.Request.Query
                .Where(x => !x.Key.Equals("facility", StringComparison.OrdinalIgnoreCase))
                .SelectMany(x => x.Value.Select(value => new KeyValuePair<string, string?>(x.Key, value)))
                .Append(new KeyValuePair<string, string?>("facility", facility));
            return QueryHelpers.AddQueryString(Context.Request.Path.Value ?? "/", query);
        }
    }
    @if (AppEnvironment.IsStaging)
    {
        <div class="environment-banner" role="status" aria-label="Staging environment">
            STAGING - Non-production data
            <span>@AppEnvironment.DisplayName</span>
        </div>
    }
    <header class="topbar" data-site-header>
        <a class="brand" asp-controller="Home" asp-action="Index" asp-route-facility="@facilityRouteValue">
            <span class="brand-full">Crop QC Dashboard</span>
            <span class="brand-mobile">Crop QC</span>
        </a>
        <button type="button" class="mobile-menu-button" aria-controls="primary-navigation" aria-expanded="false" data-mobile-menu-button>
            <span class="mobile-menu-icon" aria-hidden="true"></span>
            <span data-mobile-menu-label>Menu</span>
        </button>
        <nav id="primary-navigation" data-primary-navigation aria-label="Primary navigation">
            @if (User.Identity?.IsAuthenticated == true)
            {
                var role = User.FindAll(ClaimTypes.Role).Select(x => x.Value).OrderBy(x => x).FirstOrDefault() ?? "Viewer";
                var currentEmail = User.FindFirstValue(ClaimTypes.Email) ?? "";
                @foreach (var category in siteNavigation.Categories)
                {
                    <details class="site-nav-category @(category.IsActive ? "active" : "")" data-nav-category="@category.Key">
                        <summary aria-expanded="false">
                            <span>@category.Label</span>
                            <svg class="nav-chevron" width="12" height="8" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 6 6.5l5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </summary>
                        <div class="site-nav-panel @(category.Key == "admin" ? "site-nav-panel-wide" : "")">
                            @foreach (var group in category.Items.GroupBy(x => x.Group))
                            {
                                <div class="site-nav-group">
                                    @if (!string.IsNullOrWhiteSpace(group.Key))
                                    {
                                        <span class="site-nav-heading">@group.Key</span>
                                    }
                                    @foreach (var item in group)
                                    {
                                        <a class="@(item.IsActive ? "active" : "")"
                                           aria-current="@(item.IsActive ? "page" : null)"
                                           href="@item.Url">@item.Label</a>
                                    }
                                </div>
                            }
                        </div>
                    </details>
                }
                <div class="account-controls">
                    <span class="user-email">@currentEmail</span>
                    <span class="status">@role</span>
                    @if (AppEnvironment.IsProduction)
                    {
                        <span class="environment-badge">@AppEnvironment.DisplayName</span>
                    }
                    <form class="logout-form" method="post" action="/Logout">
                        <button type="submit" class="link-button">Logout</button>
                    </form>
                </div>
            }
            else
            {
                <a href="/Login">Login</a>
            }
        </nav>
    </header>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="facility-context-bar no-print" aria-label="Active facility context">
            <strong>Facility:</strong>
            @foreach (var facility in new[] { "WP", "EBS", "All" })
            {
                <a class="@(activeFacility == facility ? "active" : "")"
                   href="@FacilityContextUrl(facility)">@facility</a>
            }
        </nav>
        @if (siteNavigation.Breadcrumbs.Count > 0)
        {
            <nav class="site-breadcrumb no-print" aria-label="Breadcrumb">
                <ol>
                    @foreach (var crumb in siteNavigation.Breadcrumbs)
                    {
                        <li>
                            @if (crumb.IsCurrent)
                            {
                                <span aria-current="page">@crumb.Label</span>
                            }
                            else
                            {
                                <a href="@crumb.Url">@crumb.Label</a>
                            }
                        </li>
                    }
                </ol>
            </nav>
        }
    }
    <main class="page">
        @RenderBody()
    </main>
    <dialog id="page-refresh-dialog">
        <form method="dialog" class="stack-form">
            <h2>Unsaved changes</h2>
            <p>Save changes or discard changes before refreshing this page.</p>
            <div class="button-row">
                <button type="button" data-refresh-save>Save changes</button>
                <button type="button" class="secondary-button" data-refresh-discard>Discard changes</button>
                <button type="button" class="secondary-button" data-refresh-cancel>Cancel</button>
            </div>
        </form>
    </dialog>
    <script src="~/js/site-navigation.js" asp-append-version="true"></script>
    <script src="~/js/upload-feedback.js" asp-append-version="true"></script>
    <script>
        (() => {
            for (const input of document.querySelectorAll("input[type='number']")) {
                if (input.hasAttribute("inputmode")) continue;
                const step = (input.getAttribute("step") || "1").toLowerCase();
                input.inputMode = step === "1" || step === "any" && input.matches("[name*='Count'], [name*='Bins']")
                    ? "numeric"
                    : "decimal";
            }
        })();
        (() => {
            const bars = Array.from(document.querySelectorAll("[data-page-refresh]"));
            if (bars.length === 0) return;
            const dialog = document.querySelector("#page-refresh-dialog");

            function status(bar, message) {
                const target = bar.querySelector("[data-refresh-status]");
                if (target) target.textContent = message;
            }

            function dirtyForms() {
                return Array.from(document.querySelectorAll("form[data-dirty='true']"));
            }

            function isDirty() {
                return dirtyForms().length > 0 || document.body.dataset.pageDirty === "true";
            }

            function setDirty(form, value) {
                if (!form) {
                    document.body.dataset.pageDirty = value ? "true" : "false";
                    return;
                }
                form.dataset.dirty = value ? "true" : "false";
            }

            function reloadPage() {
                sessionStorage.setItem("cropqc-refresh-scroll", String(window.scrollY));
                window.location.reload();
            }

            function requestRefresh(bar, manual) {
                const warning = bar.querySelector("[data-refresh-dirty-warning]");
                if (isDirty()) {
                    if (warning) warning.hidden = false;
                    status(bar, manual ? "Refresh paused: unsaved changes." : "New data may be available.");
                    if (manual && dialog) {
                        dialog.showModal();
                    }
                    return;
                }

                if (warning) warning.hidden = true;
                status(bar, "Refreshing...");
                reloadPage();
            }

            document.addEventListener("input", event => {
                const field = event.target;
                if (!(field instanceof HTMLElement) || field.closest("#page-refresh-dialog")) return;
                if (field.matches("input, select, textarea")) setDirty(field.closest("form"), true);
            });
            document.addEventListener("change", event => {
                const field = event.target;
                if (!(field instanceof HTMLElement) || field.closest("#page-refresh-dialog")) return;
                if (field.matches("input, select, textarea")) setDirty(field.closest("form"), true);
            });
            document.addEventListener("submit", event => setDirty(event.target, false));
            window.addEventListener("beforeunload", () => {
                if (!isDirty()) return;
                sessionStorage.removeItem("cropqc-refresh-scroll");
            });
            window.addEventListener("load", () => {
                const scroll = sessionStorage.getItem("cropqc-refresh-scroll");
                if (scroll) {
                    sessionStorage.removeItem("cropqc-refresh-scroll");
                    window.scrollTo(0, Number(scroll));
                }
            });

            dialog?.querySelector("[data-refresh-cancel]")?.addEventListener("click", () => {
                dialog.close();
            });
            dialog?.querySelector("[data-refresh-discard]")?.addEventListener("click", () => {
                for (const form of dirtyForms()) setDirty(form, false);
                setDirty(null, false);
                dialog.close();
                reloadPage();
            });
            dialog?.querySelector("[data-refresh-save]")?.addEventListener("click", () => {
                const form = dirtyForms()[0];
                if (!form) {
                    dialog.close();
                    reloadPage();
                    return;
                }
                dialog.close();
                form.requestSubmit();
            });

            for (const bar of bars) {
                bar.querySelector("[data-refresh-button]")?.addEventListener("click", () => requestRefresh(bar, true));
                if (bar.dataset.autoRefresh === "true") {
                    const seconds = Number(bar.dataset.refreshIntervalSeconds || "20");
                    window.setInterval(() => requestRefresh(bar, false), Math.max(15, seconds) * 1000);
                }
            }
        })();
    </script>
    <script src="~/js/photo-orientation.js" asp-append-version="true"></script>
</body>
</html>
