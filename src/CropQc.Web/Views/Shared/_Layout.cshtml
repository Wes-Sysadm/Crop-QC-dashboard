<!doctype html>
@using System.Security.Claims
@inject CropQc.Web.Services.IAdminAuthorizationService AdminAuthorization
@inject CropQc.Web.Services.IUserAccessService UserAccess
@inject CropQc.Web.Services.AppEnvironmentOptions AppEnvironment
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Crop QC Dashboard</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (AppEnvironment.IsStaging)
    {
        <div class="environment-banner" role="status" aria-label="Staging environment">
            STAGING - Non-production data
            <span>@AppEnvironment.DisplayName</span>
        </div>
    }
    <header class="topbar">
        <a class="brand" href="/">Crop QC Dashboard</a>
        <nav>
            @if (User.Identity?.IsAuthenticated == true)
            {
                var role = User.FindAll(ClaimTypes.Role).Select(x => x.Value).OrderBy(x => x).FirstOrDefault() ?? "Viewer";
                var currentEmail = User.FindFirstValue(ClaimTypes.Email) ?? "";
                var canAccessDashboard = await UserAccess.HasAccessAsync(User, CropQc.Web.Services.ApplicationAreas.Dashboard, CropQc.Web.Services.PageAccessLevel.View, Context.RequestAborted);
                var canAccessDailyQc = await UserAccess.HasAccessAsync(User, CropQc.Web.Services.ApplicationAreas.DailyQc, CropQc.Web.Services.PageAccessLevel.View, Context.RequestAborted);
                var canAccessFieldSamples = await UserAccess.HasAccessAsync(User, CropQc.Web.Services.ApplicationAreas.FieldSamples, CropQc.Web.Services.PageAccessLevel.View, Context.RequestAborted);
                var canAccessReceipts = await UserAccess.HasAccessAsync(User, CropQc.Web.Services.ApplicationAreas.Receipts, CropQc.Web.Services.PageAccessLevel.View, Context.RequestAborted);
                var canAccessRooms = await UserAccess.HasAccessAsync(User, CropQc.Web.Services.ApplicationAreas.Rooms, CropQc.Web.Services.PageAccessLevel.View, Context.RequestAborted);
                var canAccessGrowerLots = await UserAccess.HasAccessAsync(User, CropQc.Web.Services.ApplicationAreas.GrowerLots, CropQc.Web.Services.PageAccessLevel.View, Context.RequestAborted);
                var canAccessCropYearReview = await UserAccess.HasAccessAsync(User, CropQc.Web.Services.ApplicationAreas.CropYearReview, CropQc.Web.Services.PageAccessLevel.View, Context.RequestAborted);
                var canAccessUsers = await UserAccess.HasAccessAsync(User, CropQc.Web.Services.ApplicationAreas.Users, CropQc.Web.Services.PageAccessLevel.Admin, Context.RequestAborted);
                var canAccessQcStations = await UserAccess.HasAccessAsync(User, CropQc.Web.Services.ApplicationAreas.QcStations, CropQc.Web.Services.PageAccessLevel.View, Context.RequestAborted);
                var canAccessMasterData = await UserAccess.HasAccessAsync(User, CropQc.Web.Services.ApplicationAreas.MasterData, CropQc.Web.Services.PageAccessLevel.View, Context.RequestAborted);
                var canAccessCurrentLots = await UserAccess.HasAccessAsync(User, CropQc.Web.Services.ApplicationAreas.CurrentLots, CropQc.Web.Services.PageAccessLevel.View, Context.RequestAborted);
                var canAccessBinsRun = await UserAccess.HasAccessAsync(User, CropQc.Web.Services.ApplicationAreas.BinsRun, CropQc.Web.Services.PageAccessLevel.View, Context.RequestAborted);
                var canAccessDownloads = await UserAccess.HasAccessAsync(User, CropQc.Web.Services.ApplicationAreas.Downloads, CropQc.Web.Services.PageAccessLevel.View, Context.RequestAborted);
                var canAccessConfiguration = await UserAccess.HasAccessAsync(User, CropQc.Web.Services.ApplicationAreas.Configuration, CropQc.Web.Services.PageAccessLevel.Admin, Context.RequestAborted);
                var canAccessVarietyColors = await UserAccess.HasAccessAsync(User, CropQc.Web.Services.ApplicationAreas.VarietyColors, CropQc.Web.Services.PageAccessLevel.View, Context.RequestAborted);
                var canAccessBackups = await UserAccess.HasAccessAsync(User, CropQc.Web.Services.ApplicationAreas.Backups, CropQc.Web.Services.PageAccessLevel.Admin, Context.RequestAborted);
                var canAccessDataCleanup = await UserAccess.HasAccessAsync(User, CropQc.Web.Services.ApplicationAreas.DataCleanup, CropQc.Web.Services.PageAccessLevel.Admin, Context.RequestAborted);
                var showAdminMenu = canAccessUsers || canAccessQcStations || canAccessMasterData || canAccessCurrentLots || canAccessDownloads || canAccessConfiguration || canAccessVarietyColors || canAccessBackups || canAccessDataCleanup;
                @if (canAccessDashboard)
                {
                    <a href="/">Dashboard</a>
                }
                @if (canAccessDailyQc)
                {
                    <a href="/DailyQc">Daily QC</a>
                }
                @if (canAccessFieldSamples)
                {
                    <a href="/FieldSamples">Field Samples</a>
                }
                @if (canAccessReceipts)
                {
                    <a href="/Receipts">Receipts</a>
                }
                @if (canAccessRooms)
                {
                    <a href="/Rooms">Rooms</a>
                }
                @if (canAccessBinsRun)
                {
                    <a href="/BinsRun">Bins Run &amp; Transfers</a>
                }
                @if (canAccessGrowerLots)
                {
                    <a href="/GrowerLots/Current">Grower Lots</a>
                }
                @if (canAccessCropYearReview)
                {
                    <a href="/CropYearReview">Crop Year Review</a>
                }
                @if (showAdminMenu)
                {
                    <details class="nav-dropdown">
                        <summary>Admin</summary>
                        <div class="nav-dropdown-menu">
                            @if (canAccessUsers)
                            {
                                <a href="/Admin/Users">Users</a>
                            }
                            @if (canAccessQcStations)
                            {
                                <a href="/Admin/QcStations">QC Stations</a>
                            }
                            @if (canAccessMasterData)
                            {
                                <a href="/MasterData">Master Data</a>
                            }
                            @if (canAccessCurrentLots)
                            {
                                <a href="/Admin/RoomInventory">Current Lots</a>
                            }
                            @if (canAccessDownloads)
                            {
                                <a href="/Admin/Downloads">Downloads</a>
                            }
                            @if (canAccessConfiguration)
                            {
                                <a href="/Admin/Configuration">Configuration</a>
                                <a href="/Admin/OrchardRecipients">Orchard QC Recipients</a>
                                <a href="/Admin/OrchardRecipientImports">Orchard Manager Import</a>
                            }
                            @if (canAccessVarietyColors)
                            {
                                <a href="/MasterData/fruit-profiles">Variety Colors</a>
                            }
                            @if (canAccessBackups)
                            {
                                <a href="/Admin/Backups">Backups</a>
                            }
                            @if (canAccessDataCleanup)
                            {
                                <a href="/Admin/DataCleanup">Data Cleanup</a>
                            }
                        </div>
                    </details>
                }
                <span class="user-email">@currentEmail</span>
                <span class="status">@role</span>
                @if (AppEnvironment.IsProduction)
                {
                    <span class="environment-badge">@AppEnvironment.DisplayName</span>
                }
                <form class="logout-form" method="post" action="/Logout">
                    <button type="submit" class="link-button">Logout</button>
                </form>
            }
            else
            {
                <a href="/Login">Login</a>
            }
        </nav>
    </header>
    <main class="page">
        @RenderBody()
    </main>
    <dialog id="page-refresh-dialog">
        <form method="dialog" class="stack-form">
            <h2>Unsaved changes</h2>
            <p>Save changes or discard changes before refreshing this page.</p>
            <div class="button-row">
                <button type="button" data-refresh-save>Save changes</button>
                <button type="button" class="secondary-button" data-refresh-discard>Discard changes</button>
                <button type="button" class="secondary-button" data-refresh-cancel>Cancel</button>
            </div>
        </form>
    </dialog>
    <script>
        (() => {
            const dropdowns = document.querySelectorAll(".nav-dropdown");
            dropdowns.forEach(dropdown => {
                let closeTimer = null;
                dropdown.addEventListener("mouseenter", () => {
                    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
                    clearTimeout(closeTimer);
                    dropdown.open = true;
                });
                dropdown.addEventListener("mouseleave", () => {
                    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
                    closeTimer = setTimeout(() => { dropdown.open = false; }, 220);
                });
                dropdown.querySelector("summary")?.addEventListener("click", () => {
                    dropdowns.forEach(other => {
                        if (other !== dropdown) other.open = false;
                    });
                });
            });
        })();
        (() => {
            const bars = Array.from(document.querySelectorAll("[data-page-refresh]"));
            if (bars.length === 0) return;
            const dialog = document.querySelector("#page-refresh-dialog");

            function status(bar, message) {
                const target = bar.querySelector("[data-refresh-status]");
                if (target) target.textContent = message;
            }

            function dirtyForms() {
                return Array.from(document.querySelectorAll("form[data-dirty='true']"));
            }

            function isDirty() {
                return dirtyForms().length > 0 || document.body.dataset.pageDirty === "true";
            }

            function setDirty(form, value) {
                if (!form) {
                    document.body.dataset.pageDirty = value ? "true" : "false";
                    return;
                }
                form.dataset.dirty = value ? "true" : "false";
            }

            function reloadPage() {
                sessionStorage.setItem("cropqc-refresh-scroll", String(window.scrollY));
                window.location.reload();
            }

            function requestRefresh(bar, manual) {
                const warning = bar.querySelector("[data-refresh-dirty-warning]");
                if (isDirty()) {
                    if (warning) warning.hidden = false;
                    status(bar, manual ? "Refresh paused: unsaved changes." : "New data may be available.");
                    if (manual && dialog) {
                        dialog.showModal();
                    }
                    return;
                }

                if (warning) warning.hidden = true;
                status(bar, "Refreshing...");
                reloadPage();
            }

            document.addEventListener("input", event => {
                const field = event.target;
                if (!(field instanceof HTMLElement) || field.closest("#page-refresh-dialog")) return;
                if (field.matches("input, select, textarea")) setDirty(field.closest("form"), true);
            });
            document.addEventListener("change", event => {
                const field = event.target;
                if (!(field instanceof HTMLElement) || field.closest("#page-refresh-dialog")) return;
                if (field.matches("input, select, textarea")) setDirty(field.closest("form"), true);
            });
            document.addEventListener("submit", event => setDirty(event.target, false));
            window.addEventListener("beforeunload", () => {
                if (!isDirty()) return;
                sessionStorage.removeItem("cropqc-refresh-scroll");
            });
            window.addEventListener("load", () => {
                const scroll = sessionStorage.getItem("cropqc-refresh-scroll");
                if (scroll) {
                    sessionStorage.removeItem("cropqc-refresh-scroll");
                    window.scrollTo(0, Number(scroll));
                }
            });

            dialog?.querySelector("[data-refresh-cancel]")?.addEventListener("click", () => {
                dialog.close();
            });
            dialog?.querySelector("[data-refresh-discard]")?.addEventListener("click", () => {
                for (const form of dirtyForms()) setDirty(form, false);
                setDirty(null, false);
                dialog.close();
                reloadPage();
            });
            dialog?.querySelector("[data-refresh-save]")?.addEventListener("click", () => {
                const form = dirtyForms()[0];
                if (!form) {
                    dialog.close();
                    reloadPage();
                    return;
                }
                dialog.close();
                form.requestSubmit();
            });

            for (const bar of bars) {
                bar.querySelector("[data-refresh-button]")?.addEventListener("click", () => requestRefresh(bar, true));
                if (bar.dataset.autoRefresh === "true") {
                    const seconds = Number(bar.dataset.refreshIntervalSeconds || "20");
                    window.setInterval(() => requestRefresh(bar, false), Math.max(15, seconds) * 1000);
                }
            }
        })();
    </script>
</body>
</html>
