<!doctype html>
@using System.Security.Claims
@inject CropQc.Web.Services.IAdminAuthorizationService AdminAuthorization
@inject CropQc.Web.Services.AppEnvironmentOptions AppEnvironment
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Crop QC Dashboard</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    @if (AppEnvironment.IsStagingLike)
    {
        <div class="environment-banner">
            TEST SITE — DO NOT ENTER REAL QC DATA
            <span>@AppEnvironment.DisplayName</span>
        </div>
    }
    <header class="topbar">
        <a class="brand" href="/">Crop QC Dashboard</a>
        <nav>
            @if (User.Identity?.IsAuthenticated == true)
            {
                var isAdmin = AdminAuthorization.IsAdmin(User);
                var isManagerOrAdmin = AdminAuthorization.IsManagerOrAdmin(User);
                var role = User.FindAll(ClaimTypes.Role).Select(x => x.Value).OrderBy(x => x).FirstOrDefault() ?? "Viewer";
                var currentEmail = User.FindFirstValue(ClaimTypes.Email) ?? "";
                var cleanupAllowedEmails = (Configuration["DataCleanup:AllowedEmails"] ?? "wes@fruitandland.com")
                    .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
                var canAccessDataCleanup = isAdmin && cleanupAllowedEmails.Contains(currentEmail, StringComparer.OrdinalIgnoreCase);
                var canAccessCropYearReview = string.Equals(currentEmail, "wes@fruitandland.com", StringComparison.OrdinalIgnoreCase);
                var showAdminMenu = isManagerOrAdmin || isAdmin;
                <a href="/">Dashboard</a>
                <a href="/DailyQc">Daily QC</a>
                <a href="/Receipts">Receipts</a>
                <a href="/Rooms">Rooms</a>
                <a href="/GrowerLots/Current">Grower Lots</a>
                @if (canAccessCropYearReview)
                {
                    <a href="/CropYearReview">Crop Year Review</a>
                }
                @if (showAdminMenu)
                {
                    <details class="nav-dropdown">
                        <summary>Admin</summary>
                        <div class="nav-dropdown-menu">
                            @if (isAdmin)
                            {
                                <a href="/Admin/Users">Users</a>
                            }
                            @if (isManagerOrAdmin)
                            {
                                <a href="/Admin/QcStations">QC Stations</a>
                                <a href="/MasterData">Master Data</a>
                                <a href="/Admin/RoomInventory">Current Lots</a>
                            }
                            @if (isAdmin)
                            {
                                <a href="/Admin/Downloads">Downloads</a>
                                <a href="/Admin/Configuration">Configuration</a>
                                <a href="/Admin/Backups">Backups</a>
                            }
                            @if (canAccessDataCleanup)
                            {
                                <a href="/Admin/DataCleanup">Data Cleanup</a>
                            }
                        </div>
                    </details>
                }
                <span class="user-email">@currentEmail</span>
                <span class="status">@role</span>
                @if (AppEnvironment.IsProduction)
                {
                    <span class="environment-badge">@AppEnvironment.DisplayName</span>
                }
                <form class="logout-form" method="post" action="/Logout">
                    <button type="submit" class="link-button">Logout</button>
                </form>
            }
            else
            {
                <a href="/Login">Login</a>
            }
        </nav>
    </header>
    <main class="page">
        @RenderBody()
    </main>
    <script>
        (() => {
            const dropdowns = document.querySelectorAll(".nav-dropdown");
            dropdowns.forEach(dropdown => {
                let closeTimer = null;
                dropdown.addEventListener("mouseenter", () => {
                    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
                    clearTimeout(closeTimer);
                    dropdown.open = true;
                });
                dropdown.addEventListener("mouseleave", () => {
                    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
                    closeTimer = setTimeout(() => { dropdown.open = false; }, 220);
                });
                dropdown.querySelector("summary")?.addEventListener("click", () => {
                    dropdowns.forEach(other => {
                        if (other !== dropdown) other.open = false;
                    });
                });
            });
        })();
    </script>
</body>
</html>
