@model HomeDashboardViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard</h1>
<p class="notice"><strong>Active crop year: @Model.ActiveCropYear · Facility: @Model.RoomSummaryFilter.Facility</strong> <a href="/Receipts?Facility=@Model.RoomSummaryFilter.Facility&amp;CropYear=@Model.ActiveCropYear">View @Model.ActiveCropYear receipts</a></p>
@await Html.PartialAsync("_PageRefreshControls")
@if (Model.DataWarning is not null)
{
    <p class="notice warning">@Model.DataWarning</p>
}

<section class="cards">
@foreach (var card in Model.Cards)
{
    <a class="card @card.CssClass" href="@card.Href">
        <span class="count">@card.Count</span>
        <span class="label">@card.Label</span>
        <span class="helper">@card.HelperText</span>
    </a>
}
</section>

<h2>Room Summary</h2>
<p class="muted">Current room rollups count bins and lots only in each exact room. Receipts/receiving add current inventory; Door and Lot samples are observational and contribute quality trends without adding bins.</p>
<form class="toolbar" method="get" action="/">
    <label class="field">Facility
        <select name="Facility">
            @foreach (var facility in Model.FacilityOptions)
            {
                <option value="@facility" selected="@IsSelected(Model.RoomSummaryFilter.Facility, facility)">@facility</option>
            }
        </select>
    </label>
    @if (Model.RoomSummaryFilter.Facility is "All" or "EBS")
    {
        <label class="field">EBS location
            <select name="EbsLocation">
                @foreach (var location in Model.EbsLocationOptions)
                {
                    <option value="@location" selected="@IsSelected(Model.RoomSummaryFilter.EbsLocation, location)">@location</option>
                }
            </select>
        </label>
    }
    <button type="submit">Apply</button>
    <a class="button secondary-button" href="/GrowerLots/Current?Facility=@Model.RoomSummaryFilter.Facility">View grower lots</a>
</form>

@if (Model.StorageByFacility.Count > 0)
{
    <section class="metric-grid storage-metrics" aria-label="Current storage by facility">
    @foreach (var item in Model.StorageByFacility)
    {
        <div>
            <strong>@item.CurrentBins</strong>
            <span>@item.Facility bins</span>
            <p class="muted">@item.CurrentGrowerLots grower lots in @item.CurrentRooms rooms</p>
        </div>
    }
    </section>
}

@if (Model.RoomSummaries.Count == 0)
{
    <p class="notice">No rooms match the selected filters.</p>
}
else
{
    @foreach (var facilityGroup in Model.RoomSummaries.GroupBy(x => x.Facility).OrderBy(x => FacilitySort(x.Key)).ThenBy(x => x.Key))
    {
        <section class="panel">
            <h3>@facilityGroup.Key</h3>
            @foreach (var locationGroup in facilityGroup.GroupBy(x => string.IsNullOrWhiteSpace(x.LocationGroup) ? facilityGroup.Key : x.LocationGroup).OrderBy(x => LocationSort(x.Key)).ThenBy(x => x.Key))
            {
                @if (facilityGroup.Key == "EBS")
                {
                    <h4>@locationGroup.Key</h4>
                }
                <div class="room-card-grid">
                @foreach (var room in locationGroup.OrderBy(x => x.AttentionSort).ThenByDescending(x => x.QcMissingBins == 0 ? 0m : x.QcMissingBins / (decimal)(x.CurrentBinsCount ?? 1)).ThenBy(x => x.LastSampleDate ?? DateTimeOffset.MinValue).ThenBy(x => x.RoomCode))
                {
                    <a class="room-card @RoomStatusClass(room.Status) variety-colored @(room.IsMajorityOrganic ? "majority-organic" : "") @(room.IsSealed ? "sealed-room" : room.IsSealScheduled ? "scheduled-seal-room" : "")" href="/Dashboard/Rooms/@room.RoomId?Facility=@room.Facility" style="--room-variety-bg: @BuildVarietyBandBackground(room.VarietyColorSegments)">
                        <div class="room-card-content">
                            <div class="room-card-header">
                                <div>
                                    <h3>@room.Warehouse / @room.RoomCode</h3>
                                    <p>@room.RoomName</p>
                                </div>
                                <span class="status @RoomStatusClass(room.Status)">@room.Status</span>
                            </div>
                            <p><span class="status @(room.IsSealed ? "review" : room.IsSealScheduled ? "pending" : "ready")">@(room.IsSealed ? "SEALED" : room.IsSealScheduled ? "SCHEDULED TO SEAL" : "UNSEALED")</span>@if (room.IsSealed) { <span class="muted"> Sealed since @BusinessTime.FormatPacific(room.SealedAt) by @(room.SealedBy ?? "unknown user")</span> } else if (room.IsSealScheduled) { <span class="muted"> Scheduled @BusinessTime.FormatPacific(room.SealedAt) by @(room.SealedBy ?? "unknown user")</span> }</p>
                            <dl class="room-metrics">
                                <div>
                                    <dt>Current bins / capacity</dt>
                                    <dd>@FormatBins(room.CurrentBinsCount ?? 0) / @(room.IsCapacityConfigured ? FormatBins(room.RoomCapacityBins) : "Not configured")</dd>
                                </div>
                                <div>
                                    <dt>Room fill</dt>
                                    <dd>
                                        @(room.PercentFull is null ? "Capacity not configured" : $"{room.PercentFull:0.#}% full")
                                        @if (room.IsOverCapacity)
                                        {
                                            <span class="metric-warning">Over capacity</span>
                                        }
                                    </dd>
                                </div>
                                <div><dt>Lots</dt><dd>@room.CurrentLotsCount</dd></div>
                                <div><dt>QC coverage</dt><dd>@room.QcRepresentedBins / @(room.CurrentBinsCount ?? 0) bins (@room.QcCoveragePercent.ToString("0.#")%)</dd></div>
                            </dl>
                            <dl class="room-metrics room-qc-metrics">
                                <div>
                                    <dt>Receiving starch</dt>
                                    <dd>@Format(room.AverageStarch)</dd>
                                    <small>@Coverage(room.ReceivingStarchRepresentedBins, room.CurrentBinsCount ?? 0)</small>
                                </div>
                                <div>
                                    <dt>Receiving pressure</dt>
                                    <dd>@FormatLbs(room.AveragePressureLbs)</dd>
                                    <small>@Coverage(room.ReceivingPressureRepresentedBins, room.CurrentBinsCount ?? 0)</small>
                                </div>
                                <div>
                                    <dt>Latest pressure</dt>
                                    <dd>@FormatLbs(room.LatestPressureLbs)</dd>
                                    <small>@BusinessTime.FormatPacific(room.LatestPressureDate, empty: Coverage(room.LatestPressureRepresentedBins, room.CurrentBinsCount ?? 0))</small>
                                </div>
                                <div>
                                    <dt>30-day pressure change</dt>
                                    <dd>@FormatChange(room.MonthOverMonthPressureChangeLbs)</dd>
                                    <small>@Coverage(room.PressureChangeRepresentedBins, room.CurrentBinsCount ?? 0)</small>
                                </div>
                                <div>
                                    <dt>Latest pressure SD</dt>
                                    <dd>@(room.PressureStdDevLbs is null ? "Insufficient readings" : $"{room.PressureStdDevLbs:0.##} lb")</dd>
                                    <small>@room.PressureReadingCount pressure readings / @Coverage(room.PressureStandardDeviationRepresentedBins, room.CurrentBinsCount ?? 0)</small>
                                </div>
                                <div><dt>Last sample</dt><dd>@BusinessTime.FormatPacific(room.LastSampleDate, empty: "No data")</dd></div>
                            </dl>
                            <div class="variety-legend" aria-label="Current varieties by bins">
                                @foreach (var segment in room.VarietyColorSegments.Take(4))
                                {
                                    <span><i style="background: @segment.HexColor"></i>@segment.VarietyName - @segment.IdentityLabel - @segment.CurrentBins bins</span>
                                }
                            </div>
                            @if (room.IsMajorityOrganic)
                            {
                                <p class="room-lots"><strong>Majority organic:</strong> @room.OrganicBins / @(room.CurrentBinsCount ?? 0) bins (@room.OrganicPercent.ToString("0.#")%)</p>
                            }
                            @if (room.UnknownOrganicStatusBins > 0)
                            {
                                <p class="room-lots"><strong>Organic status unknown:</strong> @room.UnknownOrganicStatusBins bins</p>
                            }
                            <p class="room-lots"><strong>@room.AttentionCategory:</strong> @room.RankingReason</p>
                            @if (!string.IsNullOrWhiteSpace(room.MajorWeakLotIndicator))
                            {
                                <p class="room-lots"><strong>Indicator:</strong> @room.MajorWeakLotIndicator</p>
                            }
                            <p class="room-lots">@room.LotSummary</p>
                            @if (!string.IsNullOrWhiteSpace(room.WeakestLotLabel))
                            {
                                <p class="room-lots"><strong>Weakest lot:</strong> @room.WeakestLotLabel - @room.WeakestLotReason</p>
                            }
                            @if (room.ReviewFlags.Count > 0)
                            {
                                <ul class="compact-list">
                                @foreach (var flag in room.ReviewFlags.Take(3))
                                {
                                    <li>@flag</li>
                                }
                                </ul>
                            }
                        </div>
                    </a>
                }
            </div>
            }
        </section>
    }
}

<h2>Today's Receiving Samples</h2>
<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Sample</th>
                <th>Warehouse</th>
                <th>Status</th>
                <th>Starch</th>
                <th>Photos</th>
                <th>Email</th>
                <th>Ready</th>
                <th>Sample Time</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var sample in Model.TodaySamples)
        {
            <tr>
                <td><a href="/Samples/@sample.Id">@sample.DisplayReceiptId</a></td>
                <td>@sample.Warehouse</td>
                <td><span class="status @StatusClass(sample.Status)">@sample.Status</span></td>
                <td>
                    @sample.StarchStatus
                    @if (!sample.StarchStatus.Contains("complete", StringComparison.OrdinalIgnoreCase))
                    {
                        <a class="inline-action" href="/Samples/@sample.Id/Starch">Starch Input</a>
                    }
                </td>
                <td>@sample.PhotoStatus</td>
                <td>
                    <span class="status @StatusClass(sample.EmailStatus)">@sample.EmailStatus</span>
                    @if (sample.EmailSentAt is not null)
                    {
                        <div class="muted">Sent @BusinessTime.FormatPacific(sample.EmailSentAt.Value) by @(sample.EmailSentBy ?? "unknown")</div>
                    }
                </td>
                <td><span class="status @(sample.IsReady ? "ready" : "missing")">@(sample.IsReady ? "Ready" : "Missing")</span></td>
                <td>@BusinessTime.FormatPacific(sample.SampleTakenAt)</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@functions {
    private static string StatusClass(string status) =>
        status.Contains("review", StringComparison.OrdinalIgnoreCase) ? "review" :
        status.Contains("resend", StringComparison.OrdinalIgnoreCase) ? "review" :
        status.Contains("ready", StringComparison.OrdinalIgnoreCase) ? "ready" :
        status.Contains("sent", StringComparison.OrdinalIgnoreCase) ? "sent" :
        status.Contains("pending", StringComparison.OrdinalIgnoreCase) ? "pending" : "";

    private static string RoomStatusClass(string status) =>
        status.Contains("attention", StringComparison.OrdinalIgnoreCase) ? "review" :
        status.Contains("watch", StringComparison.OrdinalIgnoreCase) ? "review" :
        status.Contains("review", StringComparison.OrdinalIgnoreCase) ? "review" :
        status.Contains("stable", StringComparison.OrdinalIgnoreCase) ? "ready" :
        status.Contains("active", StringComparison.OrdinalIgnoreCase) ? "ready" :
        status.Contains("empty", StringComparison.OrdinalIgnoreCase) ? "pending" : "";

    private static string Format(decimal? value) => value?.ToString("0.##") ?? "No data";
    private static string FormatLbs(decimal? value) => value is null ? "No data" : $"{value:0.##} lb";
    private static string FormatBins(int value) => value.ToString("N0", CultureInfo.CurrentCulture);
    private static string FormatChange(decimal? value) => value is null
        ? "Not enough history"
        : value == 0
            ? "Unchanged"
            : $"{(value > 0 ? "+" : "")}{value:0.##} lb/month";
    private static string Coverage(int representedBins, int totalBins) =>
        totalBins <= 0 ? "No current bins" : $"{FormatBins(representedBins)} of {FormatBins(totalBins)} bins";
    private static bool IsSelected(string current, string value) => string.Equals(current, value, StringComparison.OrdinalIgnoreCase);
    private static int FacilitySort(string facility) => facility switch { "MCD" => 0, "WP" => 1, "EBS" => 2, "DH" => 3, _ => 9 };
    private static int LocationSort(string location) => location switch { "Evans" => 0, "Lamb" => 1, "BM" => 2, _ => 9 };
    private static string BuildVarietyBandBackground(IReadOnlyList<RoomVarietyColorSegmentViewModel> segments)
    {
        if (segments.Count == 0) return "#ffffff";
        var stops = new List<string>();
        var start = 0m;
        foreach (var segment in segments)
        {
            var end = Math.Min(100m, start + segment.Percent);
            stops.Add($"{segment.HexColor} {start.ToString("0.###", CultureInfo.InvariantCulture)}% {end.ToString("0.###", CultureInfo.InvariantCulture)}%");
            start = end;
        }
        if (start < 100m)
        {
            stops.Add($"{segments[^1].HexColor} {start.ToString("0.###", CultureInfo.InvariantCulture)}% 100%");
        }
        return segments.Count == 1 ? segments[0].HexColor : $"linear-gradient(90deg, {string.Join(", ", stops)})";
    }
}
