<section class="panel">
    <h2>Depleted / Historical Lots</h2>
    @if (Model.DepletedLots.Count == 0)
    {
        <p class="muted">No fully depleted lots recorded for this room.</p>
    }
    else
    {
        <div class="responsive-card-grid">
        @foreach (var lot in Model.DepletedLots)
        {
            @await Html.PartialAsync("_RoomLotCard", lot)
        }
        </div>
    }
</section>

<script src="~/js/treatment-reports.js" asp-append-version="true"></script>
<script>
(() => {
    const form = document.getElementById('dropped-bins-form');
    if (!form) return;
    const select = document.getElementById('dropped-inventory-identity');
    const expected = document.getElementById('dropped-expected-current');
    const treatmentSignature = document.getElementById('dropped-treatment-signature');
    const treatmentSegmentId = document.getElementById('dropped-treatment-segment-id');
    const count = document.getElementById('dropped-bin-count');
    const summary = document.getElementById('dropped-identity-summary');
    const refresh = () => {
        const option = select.options[select.selectedIndex];
        const current = option?.dataset.current ?? '';
        expected.value = current;
        treatmentSignature.value = option?.dataset.treatmentSignature ?? '';
        treatmentSegmentId.value = option?.dataset.treatmentSegmentId ?? '';
        summary.hidden = !current;
        for (const field of summary.querySelectorAll('[data-loss-field]')) {
            field.textContent = field.dataset.lossField === 'current'
                ? current
                : option?.dataset[field.dataset.lossField] ?? '';
        }
        count.max = current;
    };
    select.addEventListener('change', refresh);
    form.addEventListener('submit', event => {
        refresh();
        const dropped = Number.parseInt(count.value, 10);
        const current = Number.parseInt(expected.value, 10);
        if (!Number.isInteger(dropped) || dropped <= 0 || !Number.isInteger(current) || dropped > current) {
            event.preventDefault();
            window.alert(`Bins dropped must be between 1 and the current packable balance (${Number.isInteger(current) ? current : 0}).`);
            return;
        }
        const remaining = current - dropped;
        if (!window.confirm(`Mark ${dropped} bins as dropped?\n\nThe original receipt quantity will remain unchanged.\n\nCurrent packable inventory will change from ${current} bins to ${remaining} bins.`)) {
            event.preventDefault();
        }
    });
})();
</script>

@functions {
    private static string IdentityLabel(string? productionType, string organicLabel) =>
        string.IsNullOrWhiteSpace(productionType) || string.Equals(productionType, organicLabel, StringComparison.OrdinalIgnoreCase)
            ? organicLabel
            : $"{productionType} · {organicLabel}";

    private static string RoomStatusClass(string status) =>
        status.Contains("review", StringComparison.OrdinalIgnoreCase) ? "review" :
        status.Contains("active", StringComparison.OrdinalIgnoreCase) ? "ready" :
        status.Contains("empty", StringComparison.OrdinalIgnoreCase) ? "pending" : "";

    private static string Format(decimal? value) => value?.ToString("0.##") ?? "Unavailable";
    private static string FormatLbs(decimal? value) => value is null ? "Unavailable" : $"{value:0.##} lb";
    private static string FormatBins(int value) => value.ToString("N0");
    private static string FormatFileSize(long value) => value >= 1024 * 1024
        ? $"{value / (1024m * 1024m):0.#} MB"
        : value >= 1024 ? $"{value / 1024m:0.#} KB" : $"{value} B";
    private static string Coverage(int represented, int total) => total <= 0
        ? "Coverage unavailable"
        : $"Coverage: {represented:N0} of {total:N0} current bins ({decimal.Round(represented / (decimal)total * 100m, 1):0.#}%)";
    private static string FormatSigned(int value) => value > 0 ? $"+{value}" : value.ToString();
    private static string FormatChange(decimal? value) => value is null
        ? "N/A"
        : value == 0
            ? "unchanged"
            : $"{(value > 0 ? "+" : "")}{value:0.##} lbs";
}
