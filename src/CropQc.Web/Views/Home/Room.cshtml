@model RoomDetailViewModel
@{
    ViewData["Title"] = "Room Summary";
    ViewData["AutoRefresh"] = "true";
    var likelySourceReceiptIds = Model.LikelySourceReceipts.Select(x => x.ReceiptId).ToHashSet();
    var otherLinkedReceipts = Model.LinkedReceipts.Where(x => !likelySourceReceiptIds.Contains(x.Id)).ToList();
}

<h1>Room Summary</h1>
@await Html.PartialAsync("_PageRefreshControls")
@if (TempData["Success"] is string success)
{
    <p class="notice success">@success</p>
}
@if (TempData["Error"] is string error)
{
    <p class="notice error">@error</p>
}
@if (TempData["Warning"] is string warning)
{
    <p class="notice warning">@warning</p>
}
@if (Model.DataWarning is not null)
{
    <p class="notice warning">@Model.DataWarning</p>
}

@if (Model.Summary is not null)
{
    var dominant = Model.Summary.VarietyColorSegments.FirstOrDefault();
    <section class="panel room-detail-hero @(Model.Summary.IsMajorityOrganic ? "majority-organic" : "")" style="--room-variety-bg: @(dominant?.HexColor ?? VarietyColorService.NeutralFallbackColor)">
        <div class="room-detail-hero-content">
        <div class="room-card-header">
            <div>
                <h2>@Model.Summary.Warehouse / @Model.Summary.RoomCode</h2>
                <p>@Model.Summary.RoomName</p>
            </div>
            <span class="status @RoomStatusClass(Model.Summary.Status)">@Model.Summary.Status</span>
        </div>
        <div class="notice @(Model.Summary.IsSealed ? "warning" : Model.Summary.IsSealScheduled ? "info" : "success") room-seal-state">
            <strong>@(Model.Summary.IsSealed ? "SEALED" : Model.Summary.IsSealScheduled ? "SCHEDULED TO SEAL" : "UNSEALED")</strong>
            @if (Model.Summary.IsSealed)
            {
                <span><strong>Sealed Since:</strong> @BusinessTime.FormatPacific(Model.Summary.SealedAt)</span>
                <span><strong>Recorded By:</strong> @(Model.Summary.SealedBy ?? "unknown user")</span>
                <span><strong>Recorded At:</strong> @BusinessTime.FormatPacific(Model.Summary.SealRecordedAt)</span>
                <span>Physical inventory movement is blocked.</span>
            }
            else if (Model.Summary.IsSealScheduled)
            {
                <span><strong>Scheduled to Seal:</strong> @BusinessTime.FormatPacific(Model.Summary.SealedAt)</span>
                <span><strong>Scheduled By:</strong> @(Model.Summary.SealedBy ?? "unknown user")</span>
                <span><strong>Scheduled At:</strong> @BusinessTime.FormatPacific(Model.Summary.SealRecordedAt)</span>
                <span>Physical inventory movement remains available until the effective seal time.</span>
            }
            else
            {
                <span>Physical inventory movement is allowed.</span>
            }
            @if (Model.CanManageRoomSeals)
            {
                <a class="button @(Model.Summary.IsSealed || Model.Summary.IsSealScheduled ? "secondary-button" : "danger-button")" href="/Rooms/@Model.Summary.RoomId/Seal">@(Model.Summary.IsSealed ? "Unseal Room" : Model.Summary.IsSealScheduled ? "Edit Scheduled Seal" : "Seal Room")</a>
            }
        </div>
        <p class="room-capacity"><strong>@FormatBins(Model.Summary.CurrentBinsCount ?? 0) bins</strong> / @(Model.Summary.IsCapacityConfigured ? $"{FormatBins(Model.Summary.RoomCapacityBins)} capacity" : "capacity not configured") · @(Model.Summary.PercentFull is null ? "percent full unavailable" : $"{Model.Summary.PercentFull:0.#}% full")</p>
        <h2>Combined QC</h2>
        <p class="muted">Current room balances are the weight. Lots missing a metric are excluded from that metric's denominator.</p>
        <dl class="room-metrics room-qc-metrics combined-qc-grid">
            <div><dt>Weighted receiving pressure</dt><dd>@FormatLbs(Model.Summary.AveragePressureLbs)</dd><small>@Coverage(Model.Summary.ReceivingPressureRepresentedBins, Model.Summary.CurrentBinsCount ?? 0)</small></div>
            <div><dt>Weighted latest pressure</dt><dd>@FormatLbs(Model.Summary.LatestPressureLbs)</dd><small>@Coverage(Model.Summary.LatestPressureRepresentedBins, Model.Summary.CurrentBinsCount ?? 0)</small></div>
            <div><dt>Weighted starch</dt><dd>@Format(Model.Summary.AverageStarch)</dd><small>@Coverage(Model.Summary.ReceivingStarchRepresentedBins, Model.Summary.CurrentBinsCount ?? 0)</small></div>
            <div><dt>30-day pressure change</dt><dd>@FormatChange(Model.Summary.MonthOverMonthPressureChangeLbs)</dd><small>@Coverage(Model.Summary.PressureChangeRepresentedBins, Model.Summary.CurrentBinsCount ?? 0)</small></div>
            <div><dt>Pressure standard deviation</dt><dd>@FormatLbs(Model.Summary.PressureStdDevLbs)</dd><small>@Coverage(Model.Summary.PressureStandardDeviationRepresentedBins, Model.Summary.CurrentBinsCount ?? 0)</small></div>
            <div><dt>Latest applicable sample</dt><dd>@BusinessTime.FormatPacific(Model.Summary.LatestPressureDate ?? Model.Summary.LastSampleDate, empty: "Unavailable")</dd></div>
            <div><dt>Defect summary</dt><dd>@(string.IsNullOrWhiteSpace(Model.Summary.DefectSummary) ? "Unavailable" : Model.Summary.DefectSummary)</dd></div>
            <div><dt>Grade coverage</dt><dd>@Coverage(Model.BaselineProjection.GradeRepresentedBins, Model.Summary.CurrentBinsCount ?? 0)</dd></div>
            <div><dt>Size coverage</dt><dd>@Coverage(Model.BaselineProjection.SizeRepresentedBins, Model.Summary.CurrentBinsCount ?? 0)</dd></div>
        </dl>
        <h3>Current variety composition</h3>
        <div class="variety-legend room-detail-varieties">
            @foreach (var segment in Model.Summary.VarietyColorSegments)
            {
                <span class="@(segment.IsOrganic == true ? "organic" : "")" style="--variety-color: @segment.HexColor"><i></i>@segment.VarietyName · @IdentityLabel(segment.ProductionType, segment.OrganicLabel) — @FormatBins(segment.CurrentBins) bins (@segment.Percent.ToString("0.#")%)</span>
            }
        </div>
        @if (Model.Summary.IsMajorityOrganic) { <p><strong>Majority organic</strong></p> }
        <div class="action-bar">
            <a class="button" href="/BinsRun?RoomId=@Model.Summary.RoomId&amp;Section=Planner&amp;Facility=@Model.Summary.Warehouse">Open in Bins Run &amp; Transfers</a>
            <a class="button secondary-button" href="/Rooms/@Model.Summary.RoomId/CountBreakdown">View Count Breakdown</a>
            @if (Model.CanApplyTreatment)
            {
                <a class="button" href="/Rooms/@Model.Summary.RoomId/Treatments/Apply">Apply Treatment</a>
            }
        </div>
        @if (Model.Summary.ReviewFlags.Count > 0)
        {
            <h3>Review Flags</h3>
            <ul class="compact-list">
            @foreach (var flag in Model.Summary.ReviewFlags)
            {
                <li>@flag</li>
            }
            </ul>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Summary.WeakestLotLabel))
        {
            <p class="notice warning">
                <strong>Weakest lot:</strong>
                @if (Model.Summary.WeakestLotReceiptId is not null)
                {
                    <a href="/Receipts/@Model.Summary.WeakestLotReceiptId">@Model.Summary.WeakestLotLabel</a>
                }
                else
                {
                    <span>@Model.Summary.WeakestLotLabel</span>
                }
                <span>@Model.Summary.WeakestLotReason</span>
            </p>
        }
        </div>
    </section>
}

@if (Model.SealHistory.Count > 0)
{
    <section class="panel" id="room-seal-history">
        <h2>Room Seal History</h2>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Action</th><th>Effective</th><th>Previous Effective</th><th>Recorded</th><th>By</th><th>Note</th></tr></thead>
                <tbody>
                @foreach (var item in Model.SealHistory)
                {
                    <tr><td>@item.Action</td><td>@BusinessTime.FormatPacific(item.EffectiveAt)</td><td>@BusinessTime.FormatPacific(item.PreviousEffectiveAt)</td><td>@BusinessTime.FormatPacific(item.RecordedAt)</td><td>@item.ChangedBy</td><td>@(item.Note ?? "—")</td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}

@if (Model.HarvestWatch.IsEligible)
{
    <section class="panel" id="harvestwatch">
        <h2>HarvestWatch</h2>
        @if (Model.HarvestWatch.Deployments.Count == 0)
        {
            <p class="muted">No HarvestWatch devices deployed.</p>
        }
        else
        {
            <div class="table-wrap"><table><thead><tr><th>Code</th><th>Status</th><th>Deployed</th><th>Verified</th><th>Action</th></tr></thead><tbody>
            @foreach (var deployment in Model.HarvestWatch.Deployments)
            {
                var statusClass = deployment.Status is "ErrorFailedToRead" or "ErrorLowReading" ? "error" : deployment.Status == "PendingVerification" ? "warning" : "ready";
                <tr><td><strong>@deployment.Code</strong></td><td><span class="status @statusClass">@HarvestWatchDisplay.Status(deployment.Status)</span>@if (!string.IsNullOrWhiteSpace(deployment.VerificationEmailWarning)) { <br /><small class="notice warning">Verification email pending: @deployment.VerificationEmailWarning</small> }</td><td>@BusinessTime.FormatPacific(deployment.DeployedAt)<br /><small>@deployment.DeployedBy</small></td><td>@BusinessTime.FormatPacific(deployment.VerifiedAt)</td><td>@if (Model.HarvestWatch.CanManage) { <form method="post" action="/Rooms/@Model.Summary?.RoomId/HarvestWatch/@deployment.Id/Retire" onsubmit="return confirm('Retire this HarvestWatch deployment? Its history will remain available.');">@Html.AntiForgeryToken()<button class="danger-button" type="submit">Retire</button></form> }</td></tr>
            }
            </tbody></table></div>
        }
        @if (Model.HarvestWatch.CanManage)
        {
            <form method="post" action="/Rooms/@Model.Summary?.RoomId/HarvestWatch/Deploy" class="stack-form" id="harvestwatch-deploy-form" data-active-deployments="@Model.HarvestWatch.ActiveDeploymentCount">
                @Html.AntiForgeryToken()
                <input type="hidden" name="RoomId" value="@Model.HarvestWatch.Form.RoomId" />
                <div id="harvestwatch-code-rows">
                @for (var index = 0; index < Model.HarvestWatch.Form.Codes.Count; index++)
                {
                    <label>HarvestWatch code @(index + 1) <input name="Codes[@index]" value="@Model.HarvestWatch.Form.Codes[index]" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" /></label>
                }
                </div>
                <button class="secondary-button" type="button" id="harvestwatch-add-code">Add another</button>
                <label id="harvestwatch-warning" class="notice warning" hidden><input type="checkbox" name="ConfirmMoreThanThree" value="true" /> More than 3 HarvestWatch devices are being deployed in this room. Confirm that this is intentional.</label>
                <button class="button" type="submit">Deploy HarvestWatch</button>
            </form>
            <script>
            (() => { const form = document.getElementById('harvestwatch-deploy-form'); const rows = document.getElementById('harvestwatch-code-rows'); const add = document.getElementById('harvestwatch-add-code'); const warning = document.getElementById('harvestwatch-warning'); const confirmation = warning?.querySelector('input[type="checkbox"]'); if (!form || !rows || !add || !warning || !confirmation) return; const active = Number(form.dataset.activeDeployments || 0); const update = () => { const validNew = [...rows.querySelectorAll('input')].filter(input => /^\d{5}$/.test(input.value.trim())).length; const requiresConfirmation = active + validNew > 3; warning.hidden = !requiresConfirmation; if (!requiresConfirmation) confirmation.checked = false; }; add.addEventListener('click', () => { const index = rows.querySelectorAll('input').length; const label = document.createElement('label'); label.textContent = `HarvestWatch code ${index + 1} `; const input = document.createElement('input'); input.name = `Codes[${index}]`; input.inputMode = 'numeric'; input.pattern = '[0-9]{5}'; input.maxLength = 5; input.addEventListener('input', update); label.append(input); rows.append(label); update(); }); rows.querySelectorAll('input').forEach(input => input.addEventListener('input', update)); update(); })();
            </script>
        }
    </section>
}

<section class="panel" id="current-treatment-status">
    <h2>Current Treatment Status</h2>
    <p class="muted">This follows the fruit currently in the room. It is separate from treatments historically applied in this room.</p>
    @if (Model.CurrentTreatmentStatus.Count == 0)
    {
        <p class="muted">No current fruit treatment segments are available.</p>
    }
    else
    {
        <div class="responsive-card-grid treatment-segment-grid">
        @foreach (var segment in Model.CurrentTreatmentStatus)
        {
            <article class="subpanel treatment-segment-card">
                <h3>@segment.GrowerNumber — @segment.GrowerName</h3>
                <p>@segment.Variety · @segment.ProductionType · <strong>@segment.Bins.ToString("N0") bins</strong></p>
                @if (segment.TreatmentState == TreatmentLineageStates.Untreated)
                {
                    <p><span class="status pending">Untreated</span></p>
                }
                else
                {
                    <p><span class="status @(segment.TreatmentState == TreatmentLineageStates.Unknown ? "review" : "ready")">@(segment.TreatmentState == TreatmentLineageStates.Unknown ? "Treatment status unknown / unconfirmed" : "Treated")</span></p>
                    @if (segment.Treatments.Count > 0)
                    {
                        <ol class="compact-list treatment-list">
                        @foreach (var treatment in segment.Treatments.OrderBy(x => x.AppliedAt))
                        {
                            <li>@BusinessTime.FormatPacific(treatment.AppliedAt) — @(treatment.CommonName ?? treatment.ProductName)</li>
                        }
                        </ol>
                    }
                }
            </article>
        }
        </div>
    }
</section>

<section class="panel" id="treatment-history">
    <h2>Treatment Application History</h2>
    <p class="muted">These are treatments physically applied in this room. Fruit carrying them may now be in another room or packed.</p>
    @if (Model.TreatmentApplicationHistory.Count == 0)
    {
        <p class="muted">No treatment applications have been recorded for this room.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Applied</th><th>Treatment</th><th>Bins</th><th>Applied by</th><th>Estimated cost</th><th>Status / notes</th><th>Action</th></tr></thead>
                <tbody>
                @foreach (var treatment in Model.TreatmentApplicationHistory)
                {
                    <tr id="treatment-@treatment.Id">
                        <td>@BusinessTime.FormatPacific(treatment.AppliedAt)</td>
                        <td>@if (!string.IsNullOrWhiteSpace(treatment.CommonName)) { <strong>@treatment.CommonName</strong><br /> }@treatment.ProductName</td>
                        <td>@treatment.BinsAffected.ToString("N0")</td>
                        <td>@treatment.AppliedBy</td>
                        <td>@treatment.EstimatedCost.ToString("C2") @treatment.Currency</td>
                        <td><span class="status @(treatment.IsReversed ? "pending" : "ready")">@(treatment.IsReversed ? "Reversed" : "Active")</span>@if (!string.IsNullOrWhiteSpace(treatment.Notes)) { <br /><span>@treatment.Notes</span> }@if (treatment.IsReversed) { <br /><span class="muted">@treatment.ReversalReason</span> }</td>
                        <td>
                        <div class="treatment-report-history">
                            <strong>Treatment Report</strong>
                            @if (treatment.Attachments.Count == 0)
                            {
                                <p class="muted">No treatment report attached.</p>
                            }
                            else
                            {
                                <div class="treatment-report-attachment-list">
                                @foreach (var attachment in treatment.Attachments)
                                {
                                    <article class="treatment-report-attachment-card">
                                        @if (attachment.IsImage)
                                        {
                                            <a href="/RoomTreatments/@treatment.Id/Reports/@attachment.Id/Content" target="_blank" rel="noopener">
                                                <img src="/RoomTreatments/@treatment.Id/Reports/@attachment.Id/Content" alt="Treatment report @attachment.FileName" loading="lazy" />
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="treatment-report-pdf" aria-hidden="true">PDF</span>
                                        }
                                        <div><a href="/RoomTreatments/@treatment.Id/Reports/@attachment.Id/Content" target="_blank" rel="noopener">@attachment.FileName</a><br /><small>@FormatFileSize(attachment.FileSizeBytes)</small></div>
                                        @if (Model.CanReverseTreatment)
                                        {
                                            <form method="post" action="/Rooms/@Model.Summary?.RoomId/Treatments/@treatment.Id/Reports/@attachment.Id/Remove" class="stack-form" onsubmit="return confirm('Remove this treatment report attachment? The treatment application will remain unchanged.');">
                                                @Html.AntiForgeryToken()
                                                <label>Removal reason <input name="Reason" required maxlength="1000" /></label>
                                                <button type="submit" class="danger-button">Remove Treatment Report</button>
                                            </form>
                                        }
                                    </article>
                                }
                                </div>
                            }
                            @if (Model.CanApplyTreatment && Model.Summary is not null)
                            {
                                <details class="treatment-report-add-later">
                                    <summary>Add Treatment Report</summary>
                                    <form method="post" enctype="multipart/form-data" action="/Rooms/@Model.Summary.RoomId/Treatments/@treatment.Id/Reports" class="stacked-form treatment-report-form" data-treatment-report-form>
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="OperationKey" value="@Guid.NewGuid().ToString("N")" />
                                        <div class="treatment-report-picker-actions">
                                            <label class="button secondary-button file-picker-button">Scan / Take Photo<input type="file" name="Files" accept="image/jpeg,image/png,image/webp" capture="environment" multiple data-treatment-report-input /></label>
                                            <label class="button secondary-button file-picker-button">Choose File<input type="file" name="Files" accept=".pdf,.jpg,.jpeg,.png,.webp,application/pdf,image/jpeg,image/png,image/webp" multiple data-treatment-report-input /></label>
                                        </div>
                                        <p class="field-validation" data-treatment-report-validation role="status"></p>
                                        <p class="muted" data-treatment-report-empty>No treatment report selected.</p>
                                        <div class="treatment-report-preview-grid" data-treatment-report-previews></div>
                                        <button type="submit" data-treatment-report-submit disabled>Upload Treatment Report</button>
                                    </form>
                                </details>
                            }
                        </div>
                        @if (Model.CanReverseTreatment && !treatment.IsReversed && Model.Summary is not null)
                        {
                            <form method="post" action="/Rooms/@Model.Summary.RoomId/Treatments/@treatment.Id/Reverse" class="stack-form" onsubmit="return confirm('This removes the treatment from current lineage calculations for the affected fruit but preserves the original application and audit history. Continue?');">
                                @Html.AntiForgeryToken()
                                <label>Reversal reason <input name="Reason" required maxlength="1000" /></label>
                                <button type="submit" class="danger-button">Reverse Treatment Application</button>
                            </form>
                        }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@if (Model.Summary?.Status == "Empty")
{
    <p class="notice">Room is empty. Historical/depleted lots remain listed below when available.</p>
}

<section class="panel">
    <h2>Current fruit by grower</h2>
    <p class="muted">Room → Grower → Variety → Lot → QC samples and inventory evidence</p>
    @if (Model.CurrentGrowers.Count == 0)
    {
        <p class="muted">No active lots are currently assigned to this room.</p>
    }
    else
    {
        <div class="room-grower-grid">
        @foreach (var grower in Model.CurrentGrowers)
        {
            <details class="room-grower-card">
                <summary>
                    <span><strong>Grower @grower.GrowerNumber</strong> — @grower.GrowerName</span>
                    <span>@FormatBins(grower.CurrentBins) bins · @grower.CurrentLotCount lots</span>
                </summary>
                <dl class="room-metrics">
                    <div><dt>Weighted pressure</dt><dd>@FormatLbs(grower.WeightedPressureLbs)</dd><small>@Coverage(grower.PressureRepresentedBins, grower.CurrentBins)</small></div>
                    <div><dt>Weighted starch</dt><dd>@Format(grower.WeightedStarch)</dd><small>@Coverage(grower.StarchRepresentedBins, grower.CurrentBins)</small></div>
                </dl>
                <div class="variety-legend">
                @foreach (var variety in grower.Varieties)
                {
                    <span class="@(variety.IsOrganic == true ? "organic" : "")" style="--variety-color: @variety.HexColor"><i></i>@variety.DisplayName · @variety.OrganicLabel — @FormatBins(variety.BinCount) bins</span>
                }
                </div>
                <div class="responsive-card-grid room-grower-lots">
                @foreach (var lot in grower.Lots)
                {
                    <article class="subpanel">
                        <h3>@lot.CanonicalVarietyName — Lot @lot.LotCode</h3>
                        <p>@IdentityLabel(lot.ProductionType, lot.IsOrganic == true ? "Organic" : lot.IsOrganic == false ? "Conventional" : "Organic status unavailable")</p>
                        <dl class="summary-list">
                            <dt>Current bins in this room</dt><dd>@FormatBins(lot.CurrentBins)</dd>
                            <dt>Receiving date</dt><dd>@BusinessTime.FormatPacific(lot.FirstReceivedAt, empty: "Unavailable")</dd>
                            <dt>Latest QC</dt><dd>@BusinessTime.FormatPacific(lot.LastSampleDate, empty: "Unavailable")</dd>
                            <dt>Receiving/latest pressure</dt><dd>@FormatLbs(lot.AveragePressureLbs)</dd>
                            <dt>Starch</dt><dd>@Format(lot.AverageStarch)</dd>
                            <dt>Grade</dt><dd>@lot.GradeSummary</dd>
                            <dt>Size</dt><dd>@lot.SizeSummary</dd>
                            <dt>Defects</dt><dd>@lot.DefectSummary</dd>
                        </dl>
                        <div class="action-bar">
                            @foreach (var receipt in lot.ReceiptEvidence.Take(4)) { <a class="button secondary-button" href="/Receipts/@receipt.ReceiptId">Receipt @receipt.DisplayReceiptId (@receipt.EvidenceType)</a> }
                            @if (lot.ReceiptEvidenceCount > 4) { <span class="station-code">+ @(lot.ReceiptEvidenceCount - 4) more receipt evidence</span> }
                            @if (lot.GrowerLotId is int growerLotId) { <a class="button secondary-button" href="/MasterData/grower-lots?Search=@growerLotId">Grower Lot</a> }
                            @foreach (var sample in lot.Samples.Take(4)) { <a class="button secondary-button" href="/Samples/@sample.SampleId">@sample.DisplayReceiptId QC</a> }
                            @if (lot.SampleEvidenceCount > 4) { <span class="station-code">+ @(lot.SampleEvidenceCount - 4) more QC evidence</span> }
                            <a class="button secondary-button" href="/Rooms/@lot.RoomId/CountBreakdown">Inventory evidence</a>
                        </div>
                    </article>
                }
                </div>
            </details>
        }
        </div>
    }
</section>

<section class="panel" aria-labelledby="likely-source-receipts-heading">
    <h2 id="likely-source-receipts-heading">Likely Source Receipts</h2>
    <p class="muted">Receipts are inferred from matching fruit identity and transfer history. A receipt may appear in more than one room after a partial transfer.</p>
    @if (Model.LikelySourceReceipts.Count == 0)
    {
        <p class="muted">No likely source receipts were found for fruit currently in this room.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Receipt</th><th>Grower</th><th>Received</th><th>Original receiving room</th><th>Original receipt bins (historical)</th><th>Evidence</th></tr></thead>
                <tbody>
                @foreach (var receipt in Model.LikelySourceReceipts)
                {
                    <tr>
                        <td><a href="/Receipts/@receipt.ReceiptId">@receipt.DisplayReceiptId</a></td>
                        <td>@receipt.GrowerNumber - @receipt.GrowerName</td>
                        <td>@BusinessTime.FormatPacific(receipt.ReceivedAt)</td>
                        <td>@receipt.OriginalWarehouse / @receipt.OriginalRoom</td>
                        <td>@receipt.OriginalBins.ToString("N0")</td>
                        <td><span class="status">@receipt.EvidenceType</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@if (Model.CanRecordInventoryLoss && Model.Summary is not null)
{
    <section class="panel">
        <h2>Mark bins dropped</h2>
        <p class="muted">Record bins that were legitimately received but later became unavailable for packing. This does not change the receipt or create a run, transfer, or true-up.</p>
        @if (Model.InventoryLossOptions.Count == 0)
        {
            <p class="muted">No packable inventory identity is currently available in this room.</p>
        }
        else
        {
            <form class="form-grid" method="post" action="/Rooms/@Model.Summary.RoomId/DroppedBins" id="dropped-bins-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="OperationKey" value="@Model.InventoryLossForm.OperationKey" />
                <input type="hidden" name="ExpectedCurrentBins" id="dropped-expected-current" value="0" />
                <input type="hidden" name="TreatmentSignature" id="dropped-treatment-signature" value="" />
                <input type="hidden" name="TreatmentSegmentId" id="dropped-treatment-segment-id" value="" />
                <label class="field wide">Exact current inventory identity
                    <select name="InventoryAdjustmentId" id="dropped-inventory-identity" required>
                        <option value="">Select current inventory</option>
                        @foreach (var option in Model.InventoryLossOptions)
                        {
                            <option value="@option.InventoryAdjustmentId"
                                    data-facility="@option.Facility"
                                    data-room="@option.Room"
                                    data-grower="@option.Grower"
                                    data-lot="@option.Lot"
                                    data-variety="@option.Variety"
                                    data-production="@option.ProductionType"
                                    data-treatment-signature="@option.TreatmentSignature"
                                    data-treatment-segment-id="@option.TreatmentSegmentId"
                                    data-organic="@(option.IsOrganic == true ? "Organic" : option.IsOrganic == false ? "Conventional" : "Organic status unavailable")"
                                    data-current="@option.CurrentBins">@option.Label</option>
                        }
                    </select>
                </label>
                <div class="subpanel wide" id="dropped-identity-summary" hidden>
                    <dl class="summary-list">
                        <dt>Facility</dt><dd data-loss-field="facility"></dd>
                        <dt>Room</dt><dd data-loss-field="room"></dd>
                        <dt>Grower</dt><dd data-loss-field="grower"></dd>
                        <dt>Lot</dt><dd data-loss-field="lot"></dd>
                        <dt>Variety</dt><dd data-loss-field="variety"></dd>
                        <dt>Organic / Conventional</dt><dd data-loss-field="organic"></dd>
                        <dt>Current packable bins</dt><dd data-loss-field="current"></dd>
                    </dl>
                </div>
                <label class="field">Bins dropped
                    <input type="number" min="1" name="BinCount" id="dropped-bin-count" required />
                </label>
                <label class="field">Loss time
                    <input type="datetime-local" name="OccurredAt" value="@BusinessTime.FormatPacificInput(Model.InventoryLossForm.OccurredAt ?? BusinessTime.UtcNow)" />
                    <small>For real-time entries, use now. Leave blank when the exact historical occurrence time is genuinely unknown.</small>
                </label>
                <label class="field wide">Optional notes
                    <textarea name="Notes" maxlength="1000"></textarea>
                </label>
                <button type="submit">Mark bins dropped</button>
            </form>
        }
    </section>
}

@if (Model.InventoryLosses.Count > 0)
{
    <section class="panel">
        <h2>Dropped Bin History</h2>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Status</th><th>Quantity</th><th>Identity</th><th>Occurred / recorded</th><th>User</th><th>Reason / notes</th><th>Action</th></tr></thead>
                <tbody>
                @foreach (var loss in Model.InventoryLosses)
                {
                    <tr>
                        <td><span class="status @(loss.IsReversed ? "pending" : "review")">@(loss.IsReversed ? "Restored" : "Dropped")</span></td>
                        <td>@loss.BinCount</td>
                        <td>@loss.Facility / @loss.Room<br />@loss.Grower / @loss.Lot / @loss.Variety / @(loss.IsOrganic == true ? "Organic" : loss.IsOrganic == false ? "Conventional" : loss.ProductionType)<br />@if (loss.ReceiptId is not null) { <a href="/Receipts/@loss.ReceiptId">Receipt @loss.ReceiptReference</a> }</td>
                        <td>@BusinessTime.FormatPacific(loss.OccurredAt, empty: "Exact occurrence time unavailable")<br /><span class="muted">Recorded @BusinessTime.FormatPacific(loss.CreatedAt)</span></td>
                        <td>@loss.CreatedBy@if (loss.IsReversed) { <br /><span class="muted">Restored by @(loss.ReversedBy ?? "Unknown")</span> }</td>
                        <td>@loss.Reason@if (!string.IsNullOrWhiteSpace(loss.Notes)) { <br /><span class="muted">@loss.Notes</span> }@if (loss.IsReversed) { <br /><strong>Reversal:</strong> @loss.ReverseReason }</td>
                        <td>
                            @if (Model.CanReverseInventoryLoss && !loss.IsReversed)
                            {
                                <form method="post" action="/Rooms/@Model.Summary!.RoomId/DroppedBins/@loss.Id/Reverse" class="stack-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="OperationKey" value="@(Guid.NewGuid().ToString("N"))" />
                                    <label>Reversal reason <input name="Reason" required maxlength="1000" /></label>
                                    <button type="submit" class="secondary-button">Restore / Reverse Dropped Bins</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}

@if (Model.CanManageDepletions && Model.Summary is not null)
{
    <section class="panel">
        <h2>Record Bins Sent to Line</h2>
        <p class="muted">Use depletion to remove fruit from current room summaries without deleting receipts, samples, photos, or email history.</p>
        <form class="form-grid" method="post" action="/Dashboard/Rooms/@Model.Summary.RoomId/Deplete">
            <label class="field">Lot / Receipt
                <select name="ReceiptId" required>
                    <option value="">Select current lot</option>
                    @foreach (var option in Model.DepletionReceiptOptions)
                    {
                        <option value="@option.ReceiptId">@option.Label</option>
                    }
                </select>
            </label>
            <label class="field">Bins sent to line
                <input type="number" min="1" name="BinCount" required />
            </label>
            <label class="field">Date/time
                <input type="datetime-local" name="DepletedAt" value="@BusinessTime.FormatPacificInput(BusinessTime.UtcNow)" required />
            </label>
            <label class="field">Destination / line
                <input name="Destination" maxlength="100" />
            </label>
            <label class="field wide">Notes
                <textarea name="Notes" maxlength="1000"></textarea>
            </label>
            <label class="checkbox-field wide">
                <input type="checkbox" name="ConfirmOverDepletion" value="true" />
                Allow override if current bin count is unknown or correction is needed
            </label>
            <button type="submit">Record Depletion</button>
        </form>
    </section>
}

<section class="panel">
    <h2>Change Over Time</h2>
    @if (Model.SampleTimeline.Count == 0)
    {
        <p class="muted">No QC sample history is available for this room yet.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Sample date</th><th>Lot</th><th>Variety</th><th>Type</th><th>Rows</th><th>Avg pressure</th><th>Starch</th><th>Top sizes</th><th>Grades</th></tr></thead>
                <tbody>
                @foreach (var item in Model.SampleTimeline)
                {
                    <tr>
                        <td>@BusinessTime.FormatPacific(item.SampleDate)</td>
                        <td>@item.Lot</td>
                        <td>@item.Variety</td>
                        <td>@item.SampleType</td>
                        <td>@item.EnteredFruitCount</td>
                        <td>@Format(item.AveragePressureLbs)</td>
                        <td>@Format(item.AverageStarch)</td>
                        <td>@item.SizeSummary</td>
                        <td>@item.GradeSummary</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel">
    <h2>Other Historical Linked Receipts</h2>
    @if (otherLinkedReceipts.Count == 0)
    {
        <p class="muted">No additional historical receipt links are available for this room.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Receipt</th><th>Type</th><th>Grower/Lot</th><th>Variety</th><th>Bins</th><th>Received</th></tr></thead>
                <tbody>
                @foreach (var receipt in otherLinkedReceipts)
                {
                    <tr>
                        <td><a href="/Receipts/@receipt.Id">@receipt.CompuTechReceiptId</a></td>
                        <td>@receipt.ReceiptType</td>
                        <td>@receipt.GrowerName @receipt.LotCode</td>
                        <td>@receipt.VarietyCode</td>
                        <td>@receipt.BinCount</td>
                        <td>@BusinessTime.FormatPacific(receipt.ReceivedAt)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel">
    <h2>Room Transaction History</h2>
    @if (Model.InventoryAdjustments.Count == 0)
    {
        <p class="muted">No bin count adjustments have been recorded for this room.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>When</th><th>Lot</th><th>Type</th><th>Old</th><th>Change</th><th>New</th><th>User</th><th>Reason</th></tr></thead>
                <tbody>
                @foreach (var adjustment in Model.InventoryAdjustments)
                {
                    <tr>
                        <td>@BusinessTime.FormatPacific(adjustment.AdjustmentAt)</td>
                        <td>@adjustment.Lot</td>
                        <td>@adjustment.AdjustmentType</td>
                        <td>@(adjustment.OldBinCount?.ToString() ?? "-")</td>
                        <td>@FormatSigned(adjustment.ChangeAmount)</td>
                        <td>@adjustment.NewBinCount</td>
                        <td>@(string.IsNullOrWhiteSpace(adjustment.CreatedBy) ? "-" : adjustment.CreatedBy)</td>
                        <td>@(adjustment.Reason ?? adjustment.Notes ?? "-")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel">
    <h2>Depletion History</h2>
    @if (Model.Depletions.Count == 0)
    {
        <p class="muted">No depletion records yet.</p>
    }
    else
    {
        <div class="responsive-card-grid">
        @foreach (var depletion in Model.Depletions)
        {
            <article class="station-card">
                <div class="station-card-header">
                    <div><h3>@depletion.Lot</h3><p class="station-code">@depletion.DisplayReceiptId | @depletion.Variety</p></div>
                    <span class="status @(depletion.IsVoided ? "missing" : "sent")">@(depletion.IsVoided ? "Voided" : "Active")</span>
                </div>
                <dl class="station-meta">
                    <dt>Bins</dt><dd>@depletion.BinCount</dd>
                    <dt>Depleted</dt><dd>@BusinessTime.FormatPacific(depletion.DepletedAt)</dd>
                    <dt>Destination</dt><dd>@(depletion.Destination ?? "-")</dd>
                    <dt>User</dt><dd>@(string.IsNullOrWhiteSpace(depletion.CreatedBy) ? "-" : depletion.CreatedBy)</dd>
                    <dt>Notes</dt><dd>@(depletion.Notes ?? "-")</dd>
                </dl>
                <div class="action-bar">
                    <a class="button secondary-button" href="/Receipts/@depletion.ReceiptId">View Receipt</a>
                    @if (Model.CanManageDepletions && !depletion.IsVoided && Model.Summary is not null)
                    {
                        <form method="post" action="/Dashboard/Rooms/@Model.Summary.RoomId/Depletions/@depletion.Id/Void" class="stack-form">
                            <label>Void reason <input name="Reason" required maxlength="1000" /></label>
                            <button type="submit" class="secondary-button">Void</button>
