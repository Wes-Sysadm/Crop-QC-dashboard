@model RoomsPageViewModel
@{
    ViewData["Title"] = "Rooms";
}

<h1>Rooms</h1>
@await Html.PartialAsync("_PageRefreshControls")
@if (Model.DataWarning is not null)
{
    <p class="notice warning">@Model.DataWarning</p>
}

<form class="toolbar" method="get" action="/Rooms">
    <label class="field">Facility
        <select name="Facility">
            @foreach (var facility in Model.FacilityOptions)
            {
                <option value="@facility" selected="@IsSelected(Model.Filter.Facility, facility)">@facility</option>
            }
        </select>
    </label>
    @if (Model.Filter.Facility is "All" or "EBS")
    {
        <label class="field">EBS location
            <select name="EbsLocation">
                @foreach (var location in Model.EbsLocationOptions)
                {
                    <option value="@location" selected="@IsSelected(Model.Filter.EbsLocation, location)">@location</option>
                }
            </select>
        </label>
    }
    <label class="field">Rooms
        <select name="RoomStatus">
            <option value="All" selected="@IsSelected(Model.Filter.RoomStatus, "All")">All rooms</option>
            <option value="WithFruit" selected="@IsSelected(Model.Filter.RoomStatus, "WithFruit")">Rooms with fruit</option>
            <option value="Empty" selected="@IsSelected(Model.Filter.RoomStatus, "Empty")">Empty rooms</option>
        </select>
    </label>
    <button type="submit">Apply</button>
</form>

@if (Model.Rooms.Count == 0)
{
    <p class="notice">No rooms match the selected filters.</p>
}
else
{
    <div class="room-card-grid dedicated-room-grid">
    @foreach (var room in Model.Rooms.OrderBy(x => x.Warehouse).ThenBy(x => x.LocationGroup).ThenBy(x => x.RoomCode))
    {
        var dominant = room.VarietyColorSegments.FirstOrDefault();
        var isEmpty = (room.CurrentBinsCount ?? 0) == 0;
        var cardColor = isEmpty ? "#E7ECEF" : dominant?.HexColor ?? "#607D8B";
        <article class="room-card dedicated-room-card variety-colored @(room.IsMajorityOrganic ? "majority-organic" : "") @(isEmpty ? "empty-room-card" : "") @(room.IsSealed ? "sealed-room" : room.IsSealScheduled ? "scheduled-seal-room" : "")" style="--room-variety-bg: @cardColor">
            <div class="room-card-content">
                <header class="room-card-header">
                    <div>
                        <p class="room-location">@room.Facility@(string.IsNullOrWhiteSpace(room.LocationGroup) ? "" : $" · {room.LocationGroup}")</p>
                        <h2><a class="card-stretched-link" href="/Rooms/@room.RoomId?Facility=@Model.Filter.Facility&amp;EbsLocation=@Model.Filter.EbsLocation&amp;RoomStatus=@Model.Filter.RoomStatus" aria-label="Open @room.Facility room @room.RoomCode">@room.RoomCode</a></h2>
                        <p>@room.RoomName</p>
                    </div>
                    <span class="status @RoomStatusClass(room.Status)">@(isEmpty ? "Empty" : room.Status)</span>
                </header>
                <p><span class="status @(room.IsSealed ? "review" : room.IsSealScheduled ? "pending" : "ready")">@(room.IsSealed ? "SEALED" : room.IsSealScheduled ? "SCHEDULED TO SEAL" : "UNSEALED")</span>@if (room.IsSealed) { <span class="muted"> Sealed since @BusinessTime.FormatPacific(room.SealedAt) by @(room.SealedBy ?? "unknown user")</span> } else if (room.IsSealScheduled) { <span class="muted"> Scheduled @BusinessTime.FormatPacific(room.SealedAt) by @(room.SealedBy ?? "unknown user")</span> }</p>
                <p class="room-capacity"><strong>@FormatBins(room.CurrentBinsCount ?? 0) bins</strong> / @(room.IsCapacityConfigured ? $"{FormatBins(room.RoomCapacityBins)} capacity" : "capacity not configured")</p>
                <p class="room-percent">@(room.PercentFull is null ? "Percent full unavailable" : $"{room.PercentFull:0.#}% full")</p>
                <dl class="room-metrics compact-room-metrics">
                    <div><dt>Current grower lots</dt><dd>@room.CurrentLotsCount</dd></div>
                    <div><dt>Last inventory activity</dt><dd>@BusinessTime.FormatPacific(room.LastActivityAt, empty: "No activity")</dd></div>
                </dl>
                @if (isEmpty)
                {
                    <p class="room-lots"><strong>Empty</strong> — no current variety balances.</p>
                }
                else
                {
                    <div class="room-variety-breakdown" aria-label="Current variety composition">
                    @foreach (var variety in room.VarietyColorSegments.Take(4))
                    {
                        <span class="variety-bin-chip @(variety.IsOrganic == true ? "organic" : "")" style="--variety-color: @variety.HexColor">
                            <i aria-hidden="true"></i>
                            <strong>@variety.VarietyName</strong>
                            <small>@IdentityLabel(variety.ProductionType, variety.OrganicLabel)</small>
                            <b>@FormatBins(variety.CurrentBins) bins</b>
                        </span>
                    }
                    </div>
                    @if (room.VarietyColorSegments.Count > 4)
                    {
                        <details class="card-interactive room-more-varieties">
                            <summary>+ @(room.VarietyColorSegments.Count - 4) more varieties</summary>
                            <ul class="compact-list">
                            @foreach (var variety in room.VarietyColorSegments.Skip(4))
                            {
                                <li>@variety.VarietyName — @variety.OrganicLabel — @FormatBins(variety.CurrentBins) bins</li>
                            }
                            </ul>
                        </details>
                    }
                    @if (room.IsMajorityOrganic)
                    {
                        <p class="room-lots"><strong>Majority organic</strong> — @FormatBins(room.OrganicBins) of @FormatBins(room.CurrentBinsCount ?? 0) bins</p>
                    }
                }
                <footer class="room-card-actions card-interactive">
                    <a class="button secondary-button" href="/Rooms/@room.RoomId/CountBreakdown?Facility=@Model.Filter.Facility">Count Breakdown</a>
                    @if (Model.CanApplyTreatment)
                    {
                        <a class="button" href="/Rooms/@room.RoomId/Treatments/Apply">Apply Treatment</a>
                    }
                    @if (Model.CanManageRoomSeals)
                    {
                        <a class="button @(room.IsSealed || room.IsSealScheduled ? "secondary-button" : "danger-button")" href="/Rooms/@room.RoomId/Seal">@(room.IsSealed ? "Unseal Room" : room.IsSealScheduled ? "Edit Scheduled Seal" : "Seal Room")</a>
                        @if (room.IsSealScheduled)
                        {
                            <a class="button danger-button" href="/Rooms/@room.RoomId/Seal#cancel-scheduled-seal">Cancel Scheduled Seal</a>
                        }
                    }
                </footer>
            </div>
        </article>
    }
    </div>
}

@functions {
    private static string IdentityLabel(string? productionType, string organicLabel) =>
        string.IsNullOrWhiteSpace(productionType) || string.Equals(productionType, organicLabel, StringComparison.OrdinalIgnoreCase)
            ? organicLabel
            : $"{productionType} · {organicLabel}";

    private static bool IsSelected(string current, string option) => string.Equals(current, option, StringComparison.OrdinalIgnoreCase);
    private static string FormatBins(int value) => value.ToString("N0");
    private static string RoomStatusClass(string status) => status.ToLowerInvariant() switch
    {
        "stable" or "active" => "ready",
        "empty" => "pending",
        _ => "review"
    };
}
