@model CurrentGrowerLotsPageViewModel
@{
    ViewData["Title"] = "Grower Lots In Storage";
    ViewData["AutoRefresh"] = "true";
}

<h1>Grower Lots In Storage</h1>
@await Html.PartialAsync("_MasterDataNavigation", "grower-lots")
<p><a href="/RunReporting/Growers?Facility=@Model.Filter.Facility">Open Grower &amp; Lot Progress reporting</a></p>
@await Html.PartialAsync("_PageRefreshControls")
@if (Model.DataWarning is not null)
{
    <p class="notice warning">@Model.DataWarning</p>
}

<form class="toolbar" method="get">
    <div class="field">
        <label>Facility</label>
        <select name="Facility">
            @foreach (var facility in new[] { "WP", "EBS", "All" })
            {
                <option value="@facility" selected="@(Model.Filter.Facility == facility ? "selected" : null)">@facility</option>
            }
        </select>
    </div>
    <div class="field">
        <label>Crop Year</label>
        <select name="CropYear">
            <option value="">All</option>
            @foreach (var year in Model.CropYears)
            {
                <option value="@year" selected="@(Model.Filter.CropYear == year ? "selected" : null)">@year</option>
            }
        </select>
    </div>
    <div class="field">
        <label>Warehouse</label>
        <select name="WarehouseId">
            <option value="">All</option>
            @foreach (var warehouse in Model.Warehouses)
            {
                <option value="@warehouse.Id" selected="@(Model.Filter.WarehouseId == warehouse.Id ? "selected" : null)">@warehouse.Code</option>
            }
        </select>
    </div>
    <div class="field">
        <label>Room</label>
        <select name="RoomId">
            <option value="">All</option>
            @foreach (var room in Model.Rooms)
            {
                <option value="@room.Id" selected="@(Model.Filter.RoomId == room.Id ? "selected" : null)">@((room.CropQcRoomName ?? room.DisplayName ?? room.Code))</option>
            }
        </select>
    </div>
    <div class="field"><label>Grower</label><input name="Grower" value="@Model.Filter.Grower" list="grower-options" /></div>
    <datalist id="grower-options">@foreach (var grower in Model.GrowerOptions){<option value="@grower"></option>}</datalist>
    <div class="field"><label>Variety</label><input name="Variety" value="@Model.Filter.Variety" list="variety-options" /></div>
    <datalist id="variety-options">@foreach (var variety in Model.Varieties){<option value="@variety"></option>}</datalist>
    <div class="field"><label>Lot/Search</label><input name="Search" value="@Model.Filter.Search" /></div>
    <button type="submit">Apply</button>
</form>

<section class="metric-grid storage-metrics" aria-label="Current storage totals">
    <div><strong>@Model.Growers.Count</strong><span>Growers</span></div>
    <div><strong>@Model.Growers.Sum(x => x.CurrentLotCount)</strong><span>Current lots</span></div>
    <div><strong>@Model.Growers.Sum(x => x.CurrentRoomCount)</strong><span>Grower-room groups</span></div>
    <div><strong>@Model.TotalCurrentBins.ToString("N0")</strong><span>Bins in storage</span></div>
</section>

@if (Model.Growers.Count == 0)
{
    <p class="notice">No current grower lots match the selected filters.</p>
}
else
{
    <div class="storage-grower-grid">
    @foreach (var grower in Model.Growers)
    {
        <details class="storage-grower-card" open="@(Model.Growers.Count <= 4 ? "open" : null)">
            <summary>
                <span><strong>Grower @grower.GrowerNumber — @grower.GrowerName</strong></span>
                <span>@grower.CurrentBins.ToString("N0") bins · @grower.CurrentLotCount lots in @grower.CurrentRoomCount rooms</span>
            </summary>
            <div class="variety-legend storage-variety-legend">
            @foreach (var variety in grower.Varieties)
            {
                <span class="@(variety.IsOrganic == true ? "organic" : "")"><i style="background: @variety.HexColor"></i>@variety.DisplayName · @IdentityLabel(variety.ProductionType, variety.OrganicLabel) — @variety.BinCount.ToString("N0") bins</span>
            }
            </div>
            <dl class="room-metrics storage-qc-metrics">
                <div><dt>Weighted pressure</dt><dd>@FormatLbs(grower.WeightedPressureLbs)</dd><small>@Coverage(grower.PressureRepresentedBins, grower.CurrentBins)</small></div>
                <div><dt>Weighted starch</dt><dd>@Format(grower.WeightedStarch)</dd><small>@Coverage(grower.StarchRepresentedBins, grower.CurrentBins)</small></div>
            </dl>
            <div class="table-wrap operational-table-wrap">
                <table class="operational-table current-storage-table">
                    <thead><tr><th>Lot</th><th>Variety</th><th>Facility</th><th>Room</th><th class="bins-in-storage-column">Bins Currently In Storage</th><th>Likely source receipts</th><th>First received</th><th>Last QC sample</th><th>Latest QC source</th><th>Latest avg pressure</th><th>Latest starch</th></tr></thead>
                    <tbody>
                    @foreach (var lot in grower.Lots)
                    {
                        <tr>
                            <td>@lot.Lot</td>
                            <td><span class="variety-inline-label @(lot.IsOrganic == true ? "organic" : "")" style="--variety-color: @lot.VarietyHexColor"><i></i>@lot.Variety · @(lot.IsOrganic == true ? "Organic" : lot.IsOrganic == false ? "Conventional" : "Status unavailable")</span></td>
                            <td>@lot.Warehouse</td>
                            <td>@lot.Room</td>
                            <td class="bins-in-storage-column">@lot.CurrentBins.ToString("N0")</td>
                            <td>
                                @if (lot.ReceiptEvidence.Count == 0)
                                {
                                    <span class="muted">-</span>
                                }
                                else
                                {
                                    @foreach (var receipt in lot.ReceiptEvidence.Take(4))
                                    {
                                        <a href="/Receipts/@receipt.ReceiptId">@receipt.DisplayReceiptId</a><br />
                                        <span class="muted">@receipt.EvidenceType</span><br />
                                    }
                                    @if (lot.ReceiptEvidenceCount > 4)
                                    {
                                        <span class="muted">+ @(lot.ReceiptEvidenceCount - 4) more</span>
                                    }
                                }
                            </td>
                            <td>@BusinessTime.FormatPacific(lot.FirstReceivedAt, empty: "Current inventory baseline")</td>
                            <td>@BusinessTime.FormatPacific(lot.LastQcSampleAt, empty: "-")</td>
                            <td>@(string.IsNullOrWhiteSpace(lot.LatestQcSource) ? "-" : lot.LatestQcSource)</td>
                            <td>@FormatLbs(lot.LatestAveragePressure)</td>
                            <td>@Format(lot.LatestStarch)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </details>
    }
    </div>
}

@functions {
    private static string IdentityLabel(string? productionType, string organicLabel) =>
        string.IsNullOrWhiteSpace(productionType) || string.Equals(productionType, organicLabel, StringComparison.OrdinalIgnoreCase)
            ? organicLabel
            : $"{productionType} · {organicLabel}";

    private static string Format(decimal? value) => value?.ToString("0.##") ?? "-";
    private static string FormatLbs(decimal? value) => value is null ? "Unavailable" : $"{value:0.##} lb";
    private static string Coverage(int represented, int total) => total <= 0
        ? "Coverage unavailable"
        : $"Coverage: {represented:N0} of {total:N0} bins ({decimal.Round(represented / (decimal)total * 100m, 1):0.#}%)";
}
