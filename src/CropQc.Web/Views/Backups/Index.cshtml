@model BackupStatusViewModel
@{
    ViewData["Title"] = "Admin Backups";
}

<h1>Admin Backups</h1>

@if (TempData["Success"] is not null)
{
    <p class="notice success">@TempData["Success"]</p>
}
@if (TempData["Error"] is not null)
{
    <p class="notice error">@TempData["Error"]</p>
}

@if (Model.Warnings.Count > 0)
{
    <section class="panel">
        <h2>Production Safety Warnings</h2>
        <ul class="list">
            @foreach (var warning in Model.Warnings)
            {
                <li>@warning</li>
            }
        </ul>
    </section>
}

<section class="grid-two">
    <div class="panel">
        <h2>Backup Status</h2>
        <dl class="summary-list">
            <dt>Enabled</dt>
            <dd>@(Model.Enabled ? "Yes" : "No")</dd>
            <dt>Provider</dt>
            <dd>@Model.Provider</dd>
            <dt>Google Drive folder</dt>
            <dd>@(Model.GoogleDriveFolderConfigured ? $"Configured ({Model.GoogleDriveFolderDisplay})" : "Missing")</dd>
            <dt>Database backup</dt>
            <dd>@(Model.DatabaseBackupEnabled ? "Enabled" : "Disabled")</dd>
            <dt>Config backup</dt>
            <dd>@(Model.ConfigBackupEnabled ? "Enabled" : "Disabled")</dd>
            <dt>Photo manifest</dt>
            <dd>@(Model.PhotoManifestEnabled ? "Enabled" : "Disabled")</dd>
            <dt>Retention</dt>
            <dd>@Model.DailyRetentionDays daily days; @Model.WeeklyRetentionWeeks weekly recovery points</dd>
            <dt>Schedule setting</dt>
            <dd>@($"{Model.ScheduleUtcHour:00}:{Model.ScheduleUtcMinute:00} UTC") nightly through Render Cron (@Model.BusinessTimeZone business timezone).</dd>
        </dl>
        <div class="action-bar">
            <form method="post" action="/Admin/Backups/RunNow">
                <button type="submit">Run Backup Now</button>
            </form>
            <form method="post" action="/Admin/Backups/TestAccess">
                <button class="secondary-button" type="submit">Test Google Drive Backup Access</button>
            </form>
        </div>
    </div>

    <div class="panel">
        <h2>Last Results</h2>
        <dl class="summary-list">
            <dt>Last attempted</dt>
            <dd>@(Model.LastAttempt is null ? "No attempt recorded" : $"{Model.LastAttempt.StartedAt:u} — {Model.LastAttempt.BackupType} — {Model.LastAttempt.Status}")</dd>
            <dt>Last successful</dt>
            <dd>@(Model.LastSuccessful?.VerifiedAt?.ToString("u") ?? "No verified backup yet")<br /><span class="muted text-wrap-anywhere">@Model.LastSuccessful?.PackageFileName</span></dd>
            <dt>Size / SHA-256</dt>
            <dd>@(Model.LastSuccessful?.FileSizeBytes?.ToString("N0") ?? "—") bytes<br /><span class="muted text-wrap-anywhere">@(Model.LastSuccessful?.Sha256 ?? "—")</span></dd>
            <dt>Last error</dt>
            <dd class="text-wrap-normal">@(string.IsNullOrWhiteSpace(Model.LastError) ? "None" : Model.LastError)</dd>
        </dl>
    </div>
</section>

<section class="panel">
    <h2>Backup Location</h2>
    <p class="muted">Set the Google Drive backup folder from the site. You may paste either a Drive folder URL or the folder ID.</p>
    <form class="form-grid" method="post" action="/Admin/Backups/Settings">
        <label class="checkbox-field wide"><input type="checkbox" name="Enabled" value="true" @(Model.SettingsForm.Enabled ? "checked" : "") /> Backups enabled</label><input type="hidden" name="Enabled" value="false" />
        <div class="field">
            <label>Backup provider</label>
            <select name="Provider">
                <option value="GoogleDrive" selected>Google Drive</option>
            </select>
        </div>
        <div class="field wide">
            <label>Google Drive Backup Folder</label>
            <input id="googleDriveBackupFolder" name="GoogleDriveFolder" value="@Model.GoogleDriveFolderId" placeholder="Google Drive folder URL or folder ID" />
            <span class="help-text">Paste the full Google Drive folder link or just the folder ID. For example, from <code>https://drive.google.com/drive/folders/0AJIU41AM__WNUk9PVA?...</code> the folder ID is <code>0AJIU41AM__WNUk9PVA</code>.</span>
            <span id="parsedBackupFolderId" class="muted">Parsed folder ID: @(Model.GoogleDriveFolderId ?? "none")</span>
        </div>
        <div class="field"><label>Daily retention days</label><input name="DailyRetentionDays" type="number" min="30" max="3650" value="@Model.SettingsForm.DailyRetentionDays" /></div>
        <div class="field"><label>Weekly retention weeks</label><input name="WeeklyRetentionWeeks" type="number" min="52" max="520" value="@Model.SettingsForm.WeeklyRetentionWeeks" /></div>
        <p class="muted wide">Every backup always includes the database dump, safe configuration snapshot, schema state, and photo inventory.</p>
        <input type="hidden" name="DatabaseBackupEnabled" value="true" />
        <input type="hidden" name="ConfigBackupEnabled" value="true" />
        <input type="hidden" name="PhotoManifestEnabled" value="true" />
        <button type="submit">Save Backup Settings</button>
    </form>
</section>

<section class="panel">
    <h2>Recent Backup History</h2>
    @if (Model.RecentRuns.Count == 0)
    {
        <p class="muted">No backup runs have been recorded.</p>
    }
    else
    {
        <div class="table-scroll">
            <table>
                <thead><tr><th>Started</th><th>Type</th><th>Status</th><th>Duration</th><th>Provider / Commit</th><th>Package</th><th>Verification</th><th>Error</th></tr></thead>
                <tbody>
                @foreach (var run in Model.RecentRuns)
                {
                    <tr>
                        <td>@run.StartedAt.ToString("u")</td>
                        <td>@run.BackupType<br /><span class="muted">@run.RetentionCategory</span></td>
                        <td>@run.Status</td>
                        <td>@(run.DurationMilliseconds is null ? "—" : $"{TimeSpan.FromMilliseconds(run.DurationMilliseconds.Value):g}")</td>
                        <td>@run.DatabaseProvider<br /><span class="muted">@(run.DeployedCommit is null ? "Unknown commit" : run.DeployedCommit[..Math.Min(12, run.DeployedCommit.Length)])</span></td>
                        <td class="text-wrap-anywhere">
                            @if (!string.IsNullOrWhiteSpace(run.PackageWebUrl))
                            {
                                <a href="@run.PackageWebUrl" target="_blank" rel="noopener noreferrer">@run.PackageFileName</a>
                            }
                            else
                            {
                                @run.PackageFileName
                            }
                            <br />@(run.FileSizeBytes?.ToString("N0") ?? "—") bytes
                        </td>
                        <td>@(run.VerifiedAt?.ToString("u") ?? "Not verified")<br /><span class="muted text-wrap-anywhere">@run.Sha256</span></td>
                        <td class="text-wrap-normal">@run.ErrorSummary</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="form-section">
    <h2>What Backups Include</h2>
    <ul class="list">
        <li>A consistent PostgreSQL logical database dump created by <code>pg_dump</code>.</li>
        <li>Non-secret app configuration snapshot.</li>
        <li>Schema/migration state and key row counts.</li>
        <li>Google Drive photo/storage inventory with accessibility checks.</li>
        <li>An internal manifest plus component and package SHA-256 checksums.</li>
    </ul>
    <p class="notice warning">Photo binaries already live in Google Drive. This backup stores a manifest so files can be verified and located during restore.</p>
</section>

<script>
    (() => {
        const input = document.getElementById("googleDriveBackupFolder");
        const output = document.getElementById("parsedBackupFolderId");
        if (!input || !output) return;

        function parseFolderId(value) {
            const trimmed = (value || "").trim();
            if (!trimmed) return "";
            try {
                const url = new URL(trimmed);
                const parts = url.pathname.split("/").filter(Boolean);
                const folderIndex = parts.findIndex(part => part.toLowerCase() === "folders");
                if (folderIndex >= 0 && parts[folderIndex + 1]) {
                    return parts[folderIndex + 1];
                }
            } catch {
                return trimmed;
            }

            return trimmed;
        }

        function updatePreview() {
            const parsed = parseFolderId(input.value);
            output.textContent = parsed ? `Parsed folder ID: ${parsed}` : "Parsed folder ID: none";
        }

        input.addEventListener("input", updatePreview);
        updatePreview();
    })();
</script>
