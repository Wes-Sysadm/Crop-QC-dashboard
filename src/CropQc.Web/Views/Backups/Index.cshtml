@model BackupStatusViewModel
@{
    ViewData["Title"] = "Admin Backups";
}

<h1>Admin Backups</h1>

@if (TempData["Success"] is not null)
{
    <p class="notice success">@TempData["Success"]</p>
}
@if (TempData["Error"] is not null)
{
    <p class="notice error">@TempData["Error"]</p>
}

@if (Model.Warnings.Count > 0)
{
    <section class="panel">
        <h2>Production Safety Warnings</h2>
        <ul class="list">
            @foreach (var warning in Model.Warnings)
            {
                <li>@warning</li>
            }
        </ul>
    </section>
}

<section class="grid-two">
    <div class="panel">
        <h2>Backup Status</h2>
        <dl class="summary-list">
            <dt>Enabled</dt>
            <dd>@(Model.Enabled ? "Yes" : "No")</dd>
            <dt>Provider</dt>
            <dd>@Model.Provider</dd>
            <dt>Google Drive folder</dt>
            <dd>@(Model.GoogleDriveFolderConfigured ? $"Configured ({Model.GoogleDriveFolderDisplay})" : "Missing")</dd>
            <dt>Database backup</dt>
            <dd>@(Model.DatabaseBackupEnabled ? "Enabled" : "Disabled")</dd>
            <dt>Config backup</dt>
            <dd>@(Model.ConfigBackupEnabled ? "Enabled" : "Disabled")</dd>
            <dt>Photo manifest</dt>
            <dd>@(Model.PhotoManifestEnabled ? "Enabled" : "Disabled")</dd>
            <dt>Retention</dt>
            <dd>@Model.RetentionDays days</dd>
            <dt>Schedule setting</dt>
            <dd>@Model.ScheduleUtcHour:00 UTC daily target. Use Run Backup Now or an external scheduler until an in-app scheduler is enabled.</dd>
        </dl>
        <div class="action-bar">
            <form method="post" action="/Admin/Backups/RunNow">
                <button type="submit">Run Backup Now</button>
            </form>
            <form method="post" action="/Admin/Backups/TestAccess">
                <button class="secondary-button" type="submit">Test Google Drive Backup Access</button>
            </form>
        </div>
    </div>

    <div class="panel">
        <h2>Last Results</h2>
        <dl class="summary-list">
            <dt>Database</dt>
            <dd>@(Model.LastDatabaseBackupAt?.ToString("u") ?? "No successful backup yet")<br /><span class="muted text-wrap-anywhere">@Model.LastDatabaseBackupFileName</span></dd>
            <dt>Config</dt>
            <dd>@(Model.LastConfigBackupAt?.ToString("u") ?? "No successful backup yet")<br /><span class="muted text-wrap-anywhere">@Model.LastConfigBackupFileName</span></dd>
            <dt>Photo manifest</dt>
            <dd>@(Model.LastPhotoManifestBackupAt?.ToString("u") ?? "No successful backup yet")<br /><span class="muted text-wrap-anywhere">@Model.LastPhotoManifestBackupFileName</span></dd>
            <dt>Last error</dt>
            <dd class="text-wrap-normal">@(string.IsNullOrWhiteSpace(Model.LastError) ? "None" : Model.LastError)</dd>
        </dl>
    </div>
</section>

<section class="panel">
    <h2>Backup Location</h2>
    <p class="muted">Set the Google Drive backup folder from the site. You may paste either a Drive folder URL or the folder ID.</p>
    <form class="form-grid" method="post" action="/Admin/Backups/Settings">
        <label class="checkbox-field wide"><input type="checkbox" name="Enabled" value="true" @(Model.SettingsForm.Enabled ? "checked" : "") /> Backups enabled</label><input type="hidden" name="Enabled" value="false" />
        <div class="field">
            <label>Backup provider</label>
            <select name="Provider">
                <option value="GoogleDrive" selected>Google Drive</option>
            </select>
        </div>
        <div class="field wide">
            <label>Google Drive Backup Folder</label>
            <input name="GoogleDriveFolder" value="@Model.GoogleDriveFolderId" placeholder="Google Drive folder URL or folder ID" />
        </div>
        <div class="field"><label>Retention days</label><input name="RetentionDays" type="number" min="1" max="3650" value="@Model.SettingsForm.RetentionDays" /></div>
        <div class="field"><label>Schedule UTC hour</label><input name="ScheduleUtcHour" type="number" min="0" max="23" value="@Model.SettingsForm.ScheduleUtcHour" /></div>
        <label class="checkbox-field"><input type="checkbox" name="DatabaseBackupEnabled" value="true" @(Model.SettingsForm.DatabaseBackupEnabled ? "checked" : "") /> Database backup</label><input type="hidden" name="DatabaseBackupEnabled" value="false" />
        <label class="checkbox-field"><input type="checkbox" name="ConfigBackupEnabled" value="true" @(Model.SettingsForm.ConfigBackupEnabled ? "checked" : "") /> Config snapshot</label><input type="hidden" name="ConfigBackupEnabled" value="false" />
        <label class="checkbox-field"><input type="checkbox" name="PhotoManifestEnabled" value="true" @(Model.SettingsForm.PhotoManifestEnabled ? "checked" : "") /> Photo manifest</label><input type="hidden" name="PhotoManifestEnabled" value="false" />
        <button type="submit">Save Backup Settings</button>
    </form>
</section>

<section class="form-section">
    <h2>What Backups Include</h2>
    <ul class="list">
        <li>PostgreSQL logical database dump when <code>pg_dump</code> is available in the runtime.</li>
        <li>Non-secret app configuration snapshot.</li>
        <li>Google Drive photo/storage manifest with receipt, sample, photo type, file ID, and uploaded date references.</li>
    </ul>
    <p class="notice warning">Photo binaries already live in Google Drive. This backup stores a manifest so files can be verified and located during restore.</p>
</section>
