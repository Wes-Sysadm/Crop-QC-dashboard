@model QcStationsPageViewModel
@{
    ViewData["Title"] = "QC Stations";
}

<h1>QC Stations</h1>
@if (TempData["Error"] is not null)
{
    <p class="notice warning">@TempData["Error"]</p>
}
@if (TempData["Success"] is not null)
{
    <p class="notice success">@TempData["Success"]</p>
}

<section class="panel">
    <h2>Add QC Station</h2>
    <p class="muted">Creating a station generates a unique API key and immediately downloads that station's config JSON. The raw key is not stored and cannot be shown again.</p>
    <p class="notice">Station Name is a friendly label and can be reused. Station Code must be unique and is what the QC Station app uses to authenticate.</p>
    <p class="notice">After installing Crop QC Station, open the app and choose Import / Replace Station Config. Select the JSON file you downloaded here. The app will install it into ProgramData automatically. Confirm the Station Name and Station Code shown in the app match this station. The MSI contains no station secrets.</p>
    <p class="notice warning">Station codes for new stations may use only letters, numbers, dashes, and underscores. Use dashes instead of spaces, for example <code>MCD-12</code>.</p>
    <form class="toolbar" method="post" action="/Admin/QcStations/Create">
        <div class="field"><label>Station name</label><input id="new-station-name" name="StationName" placeholder="WP QC Station 1" required /></div>
        <div class="field"><label>Station code</label><input id="new-station-code" name="StationCode" placeholder="WP-QC-01" pattern="[A-Za-z0-9_-]+" title="Use letters, numbers, dashes, and underscores only. Use dashes instead of spaces." required /></div>
        <div class="field">
            <label>Warehouse</label>
            <select name="WarehouseCode" required>
                <option value="">Select warehouse</option>
                @foreach (var warehouse in Model.Warehouses)
                {
                    <option value="@warehouse.Code">@warehouse.Code - @warehouse.Name</option>
                }
            </select>
        </div>
        <div class="field"><label>Description</label><input name="Description" /></div>
        <label class="checkbox-field"><input type="checkbox" name="IsActive" value="true" checked /> Active</label><input type="hidden" name="IsActive" value="false" />
        <button type="submit">Add Station and Download Config JSON</button>
    </form>
</section>

<section class="panel">
    <h2>Filters</h2>
    <form class="toolbar" method="get" action="/Admin/QcStations">
        <div class="field"><label>Search</label><input name="search" value="@Model.Search" /></div>
        <div class="field">
            <label>Warehouse</label>
            <select name="warehouseCode">
                <option value="">All warehouses</option>
                @foreach (var warehouse in Model.Warehouses)
                {
                    <option value="@warehouse.Code" selected="@(warehouse.Code == Model.WarehouseCode ? "selected" : null)">@warehouse.Code</option>
                }
            </select>
        </div>
        <div class="field">
            <label>Status</label>
            <select name="activeFilter">
                @foreach (var filter in new[] { "Active", "Inactive", "All" })
                {
                    <option value="@filter" selected="@(filter == Model.ActiveFilter ? "selected" : null)">@filter</option>
                }
            </select>
        </div>
        <button type="submit">Apply</button>
    </form>
</section>

<section class="panel">
    <h2>Station List</h2>
    <p class="notice">If a station receives 401/403, rotate the key, download the new config, and import it into the station app. Confirm the station is active before retrying.</p>
    <div class="responsive-card-grid station-card-grid">
    @foreach (var station in Model.Stations)
    {
        <article class="station-card">
            <header class="station-card-header">
                <div>
                    <h3>@station.StationName</h3>
                    <p class="station-code">@station.StationCode</p>
                    <p class="muted">@station.Description</p>
                </div>
                <span class="status @(station.IsActive ? "ready" : "missing")">@(station.IsActive ? "Active" : "Inactive")</span>
            </header>
            <dl class="station-meta">
                <dt>Warehouse</dt><dd>@station.WarehouseCode</dd>
                <dt>Key</dt><dd>@(station.ApiKeyLastFour is null ? "Not generated" : $"...{station.ApiKeyLastFour}")</dd>
                <dt>Last Seen</dt><dd>@BusinessTime.FormatPacific(station.LastSeenAt, empty: "Never") <span class="muted">@station.LastSeenIp</span></dd>
                <dt>Last Sync</dt><dd>@BusinessTime.FormatPacific(station.LastSyncAt, empty: "Never")</dd>
            </dl>
            <div class="station-config-note">
                @if (station.ApiKeyLastFour is null)
                {
                    <span class="muted">Rotate key to generate a downloadable config JSON.</span>
                }
                else
                {
                    <span class="muted">Raw key is no longer available. Rotate key to generate a new station config JSON.</span>
                }
                @if (station.StationCode.Contains(' '))
                {
                    <div class="notice warning">This existing station code contains spaces. It can keep working, but rotate/import a new config after renaming it with dashes.</div>
                }
            </div>
            <div class="action-bar">
                <form method="post" action="/Admin/QcStations/RotateKey">
                    <input type="hidden" name="id" value="@station.Id" />
                    <button class="secondary-button" type="submit">Rotate Key and Download Config JSON</button>
                </form>
                <form method="post" action="/Admin/QcStations/DownloadConfig">
                    <input type="hidden" name="id" value="@station.Id" />
                    <button class="secondary-button" type="submit">Download Config</button>
                </form>
                @if (station.IsActive)
                {
                    <form method="post" action="/Admin/QcStations/Deactivate"><input type="hidden" name="id" value="@station.Id" /><button class="secondary-button" type="submit">Deactivate</button></form>
                }
                else
                {
                    <form method="post" action="/Admin/QcStations/Reactivate"><input type="hidden" name="id" value="@station.Id" /><button class="secondary-button" type="submit">Reactivate</button></form>
                }
            </div>
            @if (!station.IsActive)
            {
                <p class="muted">If this is the same computer, reactivate it. If this is a replacement computer or the config may be exposed, create a new Station Code or rotate the key.</p>
            }
            <details>
                <summary>Edit</summary>
                <form class="stack-form" method="post" action="/Admin/QcStations/Update">
                    <input type="hidden" name="Id" value="@station.Id" />
                    <label>Station name <input name="StationName" value="@station.StationName" required /></label>
                    <label>Station code <input name="StationCode" value="@station.StationCode" title="Use letters, numbers, dashes, and underscores only for new station codes. Existing codes with spaces can be saved unchanged." required /></label>
                    <label>Warehouse
                        <select name="WarehouseCode" required>
                        @foreach (var warehouse in Model.Warehouses)
                        {
                            <option value="@warehouse.Code" selected="@(warehouse.Code == station.WarehouseCode ? "selected" : null)">@warehouse.Code - @warehouse.Name</option>
                        }
                        </select>
                    </label>
                    <label>Description <input name="Description" value="@station.Description" /></label>
                    <label class="checkbox-field"><input type="checkbox" name="IsActive" value="true" checked="@station.IsActive" /> Active</label><input type="hidden" name="IsActive" value="false" />
                    <button class="secondary-button" type="submit">Save</button>
                </form>
            </details>
        </article>
    }
    </div>
</section>

<script>
(() => {
    const nameInput = document.getElementById('new-station-name');
    const codeInput = document.getElementById('new-station-code');
    if (!nameInput || !codeInput) {
        return;
    }

    nameInput.addEventListener('input', () => {
        if (codeInput.value.trim().length > 0) {
            return;
        }

        codeInput.value = nameInput.value
            .trim()
            .replace(/\s+/g, '-')
            .replace(/[^A-Za-z0-9_-]+/g, '-')
            .replace(/-+/g, '-')
            .replace(/^-|-$/g, '')
            .toUpperCase();
    });
})();
</script>
