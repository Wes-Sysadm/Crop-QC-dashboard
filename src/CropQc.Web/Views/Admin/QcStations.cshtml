@model QcStationsPageViewModel
@{
    ViewData["Title"] = "QC Stations";
}

<h1>QC Stations</h1>
@if (TempData["Error"] is not null)
{
    <p class="notice warning">@TempData["Error"]</p>
}
@if (TempData["Success"] is not null)
{
    <p class="notice success">@TempData["Success"]</p>
}

<section class="panel">
    <h2>Add QC Station</h2>
    <p class="muted">Creating a station generates a unique API key and immediately downloads that station's config. The raw key is not stored and cannot be shown again.</p>
    <form class="toolbar" method="post" action="/Admin/QcStations/Create">
        <div class="field"><label>Station name</label><input name="StationName" placeholder="WP QC Station 1" required /></div>
        <div class="field"><label>Station code</label><input name="StationCode" placeholder="WP-QC-01" required /></div>
        <div class="field">
            <label>Warehouse</label>
            <select name="WarehouseCode" required>
                <option value="">Select warehouse</option>
                @foreach (var warehouse in Model.Warehouses)
                {
                    <option value="@warehouse.Code">@warehouse.Code - @warehouse.Name</option>
                }
            </select>
        </div>
        <div class="field"><label>Description</label><input name="Description" /></div>
        <label class="checkbox-field"><input type="checkbox" name="IsActive" value="true" checked /> Active</label><input type="hidden" name="IsActive" value="false" />
        <button type="submit">Add Station and Download Config</button>
    </form>
</section>

<section class="panel">
    <h2>Filters</h2>
    <form class="toolbar" method="get" action="/Admin/QcStations">
        <div class="field"><label>Search</label><input name="search" value="@Model.Search" /></div>
        <div class="field">
            <label>Warehouse</label>
            <select name="warehouseCode">
                <option value="">All warehouses</option>
                @foreach (var warehouse in Model.Warehouses)
                {
                    <option value="@warehouse.Code" selected="@(warehouse.Code == Model.WarehouseCode ? "selected" : null)">@warehouse.Code</option>
                }
            </select>
        </div>
        <div class="field">
            <label>Status</label>
            <select name="activeFilter">
                @foreach (var filter in new[] { "Active", "Inactive", "All" })
                {
                    <option value="@filter" selected="@(filter == Model.ActiveFilter ? "selected" : null)">@filter</option>
                }
            </select>
        </div>
        <button type="submit">Apply</button>
    </form>
</section>

<section class="panel">
    <h2>Station List</h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Station</th>
                    <th>Code</th>
                    <th>Warehouse</th>
                    <th>Active</th>
                    <th>Key</th>
                    <th>Last Seen</th>
                    <th>Last Sync</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var station in Model.Stations)
            {
                <tr>
                    <td>
                        <strong>@station.StationName</strong>
                        <div class="muted">@station.Description</div>
                    </td>
                    <td>@station.StationCode</td>
                    <td>@station.WarehouseCode</td>
                    <td>@(station.IsActive ? "Yes" : "No")</td>
                    <td>@(station.ApiKeyLastFour is null ? "Not generated" : $"...{station.ApiKeyLastFour}")</td>
                    <td>
                        @station.LastSeenAt?.LocalDateTime
                        <div class="muted">@station.LastSeenIp</div>
                    </td>
                    <td>@station.LastSyncAt?.LocalDateTime</td>
                    <td>
                        <details>
                            <summary>Edit</summary>
                            <form class="stack-form" method="post" action="/Admin/QcStations/Update">
                                <input type="hidden" name="Id" value="@station.Id" />
                                <label>Station name <input name="StationName" value="@station.StationName" required /></label>
                                <label>Station code <input name="StationCode" value="@station.StationCode" required /></label>
                                <label>Warehouse
                                    <select name="WarehouseCode" required>
                                    @foreach (var warehouse in Model.Warehouses)
                                    {
                                        <option value="@warehouse.Code" selected="@(warehouse.Code == station.WarehouseCode ? "selected" : null)">@warehouse.Code - @warehouse.Name</option>
                                    }
                                    </select>
                                </label>
                                <label>Description <input name="Description" value="@station.Description" /></label>
                                <label class="checkbox-field"><input type="checkbox" name="IsActive" value="true" checked="@station.IsActive" /> Active</label><input type="hidden" name="IsActive" value="false" />
                                <button class="secondary-button" type="submit">Save</button>
                            </form>
                        </details>
                        <form class="button-row" method="post" action="/Admin/QcStations/RotateKey">
                            <input type="hidden" name="id" value="@station.Id" />
                            <button class="secondary-button" type="submit">Rotate Key and Download Config</button>
                        </form>
                        <form class="button-row" method="post" action="/Admin/QcStations/DownloadConfig">
                            <input type="hidden" name="id" value="@station.Id" />
                            <button class="secondary-button" type="submit">Download Config</button>
                        </form>
                        @if (station.IsActive)
                        {
                            <form class="button-row" method="post" action="/Admin/QcStations/Deactivate"><input type="hidden" name="id" value="@station.Id" /><button class="secondary-button" type="submit">Deactivate</button></form>
                        }
                        else
                        {
                            <form class="button-row" method="post" action="/Admin/QcStations/Reactivate"><input type="hidden" name="id" value="@station.Id" /><button class="secondary-button" type="submit">Reactivate</button></form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
