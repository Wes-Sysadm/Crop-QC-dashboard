@model UserAdminPageViewModel
@{
    ViewData["Title"] = "User Administration";
}

<h1>User Administration</h1>
@if (TempData["Error"] is not null)
{
    <p class="notice warning">@TempData["Error"]</p>
}
@if (TempData["Success"] is not null)
{
    <p class="notice success">@TempData["Success"]</p>
}

<section class="panel">
    <h2>Add User</h2>
    <form class="toolbar" method="post" action="/Admin/Users/Add">
        <div class="field"><label>Email</label><input name="Email" type="email" required /></div>
        <div class="field"><label>Display Name</label><input name="DisplayName" /></div>
        <div class="field">
            <label>Role</label>
            <select name="RoleId">
                @foreach (var role in Model.Roles)
                {
                    <option value="@role.Id" selected="@(role.Name == "Viewer" ? "selected" : null)">@role.Name - @role.Summary</option>
                }
            </select>
        </div>
        <label class="checkbox-field"><input type="checkbox" name="IsActive" value="true" checked /> Active</label><input type="hidden" name="IsActive" value="false" />
        <button type="submit">Add User</button>
    </form>
</section>

<section class="panel">
    <h2>Access Matrix</h2>
    <p class="muted">Each functional area uses View, Create, or Admin. Create includes normal editing; only Admin permits delete, protected import/export, or configuration. No access removes the area. Master Data Admin is effective Site Admin for every current and future Admin area. Roles are retained as migration metadata. Wes (wes@fruitandland.com) always has emergency Owner/Admin access.</p>
    <div class="access-matrix">
        @foreach (var user in Model.AccessMatrix)
        {
            <form class="access-user-card" method="post" action="/Admin/Users/Matrix">
                <input type="hidden" name="UserId" value="@user.Id" />
                <div class="access-user-header">
                    <div>
                        <h3>@user.DisplayName</h3>
                        <div class="muted">@user.Email</div>
                        <span class="status">@user.Role</span>
                    </div>
                    <label class="checkbox-field"><input type="checkbox" name="IsActive" value="true" checked="@user.IsActive" /> Active</label><input type="hidden" name="IsActive" value="false" />
                </div>
                @foreach (var group in Model.Areas.GroupBy(x => x.Group))
                {
                    <section class="access-group">
                        <h4>@group.Key</h4>
                        <div class="access-grid">
                            @foreach (var area in group)
                            {
                                var current = user.Access.TryGetValue(area.Key, out var level) ? level : PageAccessLevel.None;
                                <label class="field">
                                    <span>@area.Name</span>
                                    <select name="Access[@area.Key]" disabled="@(user.Email.Equals("wes@fruitandland.com", StringComparison.OrdinalIgnoreCase) ? "disabled" : null)">
                                        @foreach (var option in new[] { PageAccessLevel.None, PageAccessLevel.View, PageAccessLevel.Create, PageAccessLevel.Admin })
                                        {
                                            <option value="@option" selected="@(option == current ? "selected" : null)">@option</option>
                                        }
                                    </select>
                                </label>
                            }
                        </div>
                    </section>
                }
                <button class="secondary-button" type="submit" disabled="@(user.Email.Equals("wes@fruitandland.com", StringComparison.OrdinalIgnoreCase) ? "disabled" : null)">Save Matrix</button>
            </form>
        }
    </div>
</section>

<h2>Users</h2>
<div class="user-admin-list">
    <table class="responsive-admin-table">
        <thead>
            <tr>
                <th>Email</th>
                <th>Display Name</th>
                <th>Role</th>
                <th>Active</th>
                <th>Last Login</th>
                <th>Employment</th>
                <th>End of Day Fill</th>
                <th>Update</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.DisplayName</td>
                <td>
                    <span class="status">@user.Role</span>
                    <div class="muted">@user.RoleSummary</div>
                </td>
                <td>@(user.IsActive ? "Yes" : "No")</td>
                <td>@BusinessTime.FormatPacific(user.LastLoginAt, empty: "Never")</td>
                <td>
                    <section class="employment-card" aria-label="Employment for @user.DisplayName">
                        <strong>@(user.EmploymentFacility == CropQc.Data.Entities.EmploymentFacilities.Shared ? "Shared / Management" : user.EmploymentFacility)</strong>
                        <div class="muted">Effective @BusinessTime.FormatPacific(user.EmploymentEffectiveAt, empty: "Not assigned")</div>
                        <div class="muted">Changed by @user.EmploymentChangedBy @BusinessTime.FormatPacific(user.EmploymentChangedAt, empty: "")</div>
                        <form class="form-grid compact-form" method="post" action="/Admin/Users/Employment">
                            <input type="hidden" name="UserId" value="@user.Id" />
                            <label class="field">Assignment
                                <select name="EmploymentFacility" required>
                                    @foreach (var option in Model.EmploymentOptions)
                                    {
                                        <option value="@option" selected="@(option == user.EmploymentFacility)">@(option == CropQc.Data.Entities.EmploymentFacilities.Shared ? "Shared / Management" : option)</option>
                                    }
                                </select>
                            </label>
                            <label class="field">Effective date/time (ISO 8601 with offset)
                                <input type="text" name="EffectiveAt" placeholder="2026-08-03T08:00:00-07:00" value="@(user.EmploymentEffectiveAt is null ? "" : BusinessTime.ToPacific(user.EmploymentEffectiveAt.Value).ToString("yyyy-MM-ddTHH:mm:sszzz"))" />
                            </label>
                            <button class="secondary-button" type="submit">Save Employment</button>
                        </form>
                        <details>
                            <summary>Employment audit history (@user.EmploymentHistory.Count)</summary>
                            @if (user.EmploymentHistory.Count == 0)
                            {
                                <p class="muted">No employment changes recorded.</p>
                            }
                            else
                            {
                                <ul>
                                    @foreach (var history in user.EmploymentHistory)
                                    {
                                        <li>@history.PreviousEmploymentFacility → @history.EmploymentFacility, effective @BusinessTime.FormatPacific(history.EffectiveAt), changed by @history.ChangedBy @BusinessTime.FormatPacific(history.ChangedAt)</li>
                                    }
                                </ul>
                            }
                        </details>
                    </section>
                </td>
                <td>
                    <form method="post" action="/Admin/Users/EndOfDayFillGroups" class="stack-form compact-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="UserId" value="@user.Id" />
                        @foreach (var group in Model.EndOfDayFillGroups)
                        {
                            <label class="checkbox-field"><input type="checkbox" name="GroupIds" value="@group.Id" checked="@user.EndOfDayFillGroupIds.Contains(group.Id)" /> @group.Name (@group.Facility)</label>
                        }
                        <button class="secondary-button" type="submit">Save report groups</button>
                    </form>
                </td>
                <td>
                    <form class="button-row" method="post" action="/Admin/Users/Update">
                        <input type="hidden" name="UserId" value="@user.Id" />
                        <select name="RoleId">
                            @foreach (var role in Model.Roles)
                            {
                                <option value="@role.Id" selected="@(role.Name == user.Role ? "selected" : null)">@role.Name - @role.Summary</option>
                            }
                        </select>
                        <label class="checkbox-field"><input type="checkbox" name="IsActive" value="true" checked="@user.IsActive" /> Active</label><input type="hidden" name="IsActive" value="false" />
                        <button class="secondary-button" type="submit">Save</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
