@model UserAdminPageViewModel
@{
    ViewData["Title"] = "User Administration";
}

<h1>User Administration</h1>
@if (TempData["Error"] is not null)
{
    <p class="notice warning">@TempData["Error"]</p>
}
@if (TempData["Success"] is not null)
{
    <p class="notice success">@TempData["Success"]</p>
}

<section class="panel">
    <h2>Add User</h2>
    <form class="toolbar" method="post" action="/Admin/Users/Add">
        <div class="field"><label>Email</label><input name="Email" type="email" required /></div>
        <div class="field"><label>Display Name</label><input name="DisplayName" /></div>
        <div class="field"><label>Role</label><select name="RoleId">@foreach (var role in Model.Roles){<option value="@role.Id" selected="@(role.Name == "Viewer" ? "selected" : null)">@role.Name</option>}</select></div>
        <label class="checkbox-field"><input type="checkbox" name="IsActive" value="true" checked /> Active</label><input type="hidden" name="IsActive" value="false" />
        <button type="submit">Add User</button>
    </form>
</section>

<h2>Users</h2>
<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Email</th>
                <th>Display Name</th>
                <th>Domain</th>
                <th>Role</th>
                <th>Active</th>
                <th>Last Login</th>
                <th>Update</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.DisplayName</td>
                <td>@user.Domain</td>
                <td>@user.Role</td>
                <td>@(user.IsActive ? "Yes" : "No")</td>
                <td>@user.LastLoginAt?.LocalDateTime</td>
                <td>
                    <form class="button-row" method="post" action="/Admin/Users/Update">
                        <input type="hidden" name="UserId" value="@user.Id" />
                        <select name="RoleId">
                            @foreach (var role in Model.Roles)
                            {
                                <option value="@role.Id" selected="@(role.Name == user.Role ? "selected" : null)">@role.Name</option>
                            }
                        </select>
                        <label class="checkbox-field"><input type="checkbox" name="IsActive" value="true" checked="@user.IsActive" /> Active</label><input type="hidden" name="IsActive" value="false" />
                        <button class="secondary-button" type="submit">Save</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
