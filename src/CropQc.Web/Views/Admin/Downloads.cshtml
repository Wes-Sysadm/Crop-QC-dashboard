@model AdminDownloadsViewModel
@{
    ViewData["Title"] = "Admin Downloads";
}

<h1>Admin Downloads</h1>

<p class="notice warning">Internal installer files are for company QC computers only. This page does not allow uploads or arbitrary file downloads.</p>

@if (TempData["Error"] is not null)
{
    <p class="notice warning">@TempData["Error"]</p>
}

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>File</th>
                <th>Description</th>
                <th>Notes</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var download in Model.Downloads)
        {
            <tr>
                <td>@download.Name</td>
                <td>@download.FileName</td>
                <td>@download.Description</td>
                <td class="wrap-cell">@download.Notes</td>
                <td><span class="status @(download.IsAvailable ? "ready" : "missing")">@(download.IsAvailable ? "Available" : "Not deployed")</span></td>
                <td>
                    @if (download.IsAvailable)
                    {
                        <a class="button" href="/Admin/Downloads/@download.FileName">Download</a>
                    }
                    else
                    {
                        <span class="muted">Place the file in App_Data/Downloads on the web server.</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
