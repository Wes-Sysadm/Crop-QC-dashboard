@model AdminDownloadsViewModel
@{
    ViewData["Title"] = "Admin Downloads";
}

<h1>Admin Downloads</h1>

<p class="notice warning">Internal installer links are for company QC computers only. Google Drive sharing controls access to this installer and should be limited to company users when possible. Install this on FTA-connected QC Station computers before using RealDll mode.</p>
<p class="notice">Each QC Station computer needs its own station record and generated API key. Manage station configs from <a href="/Admin/QcStations">Admin QC Stations</a>; do not use one shared API key for every computer.</p>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>File</th>
                <th>Description</th>
                <th>Notes</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var download in Model.Downloads)
        {
            <tr>
                <td>@download.Name</td>
                <td>@download.FileName</td>
                <td>@download.Description</td>
                <td class="wrap-cell">@download.Notes</td>
                <td>
                    @if (download.Url.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                    {
                        <a class="button" href="@download.Url" target="_blank" rel="noopener noreferrer">Open Google Drive Download</a>
                    }
                    else
                    {
                        <a class="button" href="@download.Url">Open</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
