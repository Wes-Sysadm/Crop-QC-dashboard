@model AdminDownloadsViewModel
@{
    ViewData["Title"] = "Admin Downloads";
}

<h1>Admin Downloads</h1>
@if (TempData["Error"] is not null)
{
    <p class="notice warning">@TempData["Error"]</p>
}

<p class="notice warning">Internal installer links are for company QC computers only. Google Drive sharing controls access to the FTA DLL installer and should be limited to company users when possible.</p>
<section class="form-section">
    <h2>QC Station setup workflow</h2>
    <ol>
        <li>Install Crop QC Station App Installer from this page.</li>
        <li>Create or select a station under Admin &rarr; QC Stations.</li>
        <li>Download the station config JSON from Admin &rarr; QC Stations.</li>
        <li>Open Crop QC Station and use <strong>Import / Replace Station Config</strong>.</li>
        <li>Install FTADLL.exe only on FTA-connected computers.</li>
    </ol>
    <p>Station configs are generated and downloaded from Admin &rarr; QC Stations. Downloads is only for shared installer/support files; the MSI contains no station API keys.</p>
    <p><a class="button secondary-button" href="/Admin/QcStations">Manage QC Stations</a></p>
</section>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>File</th>
                <th>Description</th>
                <th>Notes</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var download in Model.Downloads)
        {
            <tr>
                <td>@download.Name</td>
                <td>@download.FileName</td>
                <td>@download.Description</td>
                <td class="wrap-cell">@download.Notes</td>
                <td>
                    @if (!download.IsAvailable || string.IsNullOrWhiteSpace(download.Url))
                    {
                        <span class="badge warn">Not deployed</span>
                    }
                    else if (download.OpensInNewTab)
                    {
                        <a class="button" href="@download.Url" target="_blank" rel="noopener noreferrer">@download.ActionText</a>
                    }
                    else
                    {
                        <a class="button" href="@download.Url">@download.ActionText</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
