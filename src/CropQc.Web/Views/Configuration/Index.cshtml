@model ConfigurationPageViewModel
@{
    ViewData["Title"] = "Configuration";
}

<h1>Configuration</h1>
<p class="notice">Only safe, non-secret runtime settings are editable here. OAuth secrets, database strings, Gmail secrets, and Drive secrets must stay in environment variables.</p>
<section class="panel">
    <h2>Retention Policy</h2>
    <dl class="summary-list">
        <dt>Database retention</dt>
        <dd>Indefinite. Receipts, samples, fruit readings, defects, audit logs, email logs, users, roles, rooms, varieties, and master data are not automatically deleted.</dd>
        <dt>Photo retention</dt>
        <dd>At least 3 crop years after the current crop year.</dd>
        <dt>Automatic deletion</dt>
        <dd>Disabled. Admin-reviewed archive/delete workflow is future work.</dd>
    </dl>
</section>
<section class="panel">
    <h2>Email Status</h2>
    <dl class="summary-list">
        <dt>Email provider</dt>
        <dd><span class="status @(Model.EmailStatus.GmailUserEnabled ? "ready" : "missing")">@Model.EmailStatus.Provider</span></dd>
        <dt>Expected Render env var</dt>
        <dd><code>@Model.EmailStatus.ExpectedProviderEnvironmentVariable=GmailUser</code></dd>
        <dt>GmailUser enabled</dt>
        <dd>@(Model.EmailStatus.GmailUserEnabled ? "Yes" : "No")</dd>
        <dt>Default QC recipients configured</dt>
        <dd>@(Model.EmailStatus.DefaultQcRecipientsConfigured ? "Yes" : "No")</dd>
        <dt>Current user email</dt>
        <dd>@(Model.EmailStatus.CurrentUserEmail ?? "Unknown")</dd>
        <dt>Current user domain</dt>
        <dd>@(Model.EmailStatus.CurrentUserDomain ?? "Unknown") (@(Model.EmailStatus.CurrentUserDomainAllowed ? "allowed" : "not allowed"))</dd>
        <dt>Gmail credential present</dt>
        <dd>@(Model.EmailStatus.GmailCredentialPresent ? "Yes" : "No")</dd>
        <dt>gmail.send permission granted</dt>
        <dd>@(Model.EmailStatus.GmailSendPermissionGranted ? "Yes" : "No")</dd>
        <dt>Current user needs reconnect</dt>
        <dd><span class="status @(Model.EmailStatus.CurrentUserNeedsReconnect ? "missing" : "ready")">@(Model.EmailStatus.CurrentUserNeedsReconnect ? "Yes" : "No")</span></dd>
    </dl>
    @if (!Model.EmailStatus.GmailUserEnabled)
    {
        <p class="notice warning">QC Summary sending is disabled. Set <code>Email__Provider=GmailUser</code> in Render for production Gmail sending.</p>
    }
    else if (Model.EmailStatus.CurrentUserNeedsReconnect)
    {
        <p class="notice warning">Reconnect Google/Gmail to grant send permission. Sign out and sign back in with Google so the app can request <code>https://www.googleapis.com/auth/gmail.send</code>.</p>
        <form method="post" action="/Login/Google" class="button-row">
            <button type="submit">Reconnect Google/Gmail</button>
        </form>
    }
</section>
@if (TempData["Error"] is not null)
{
    <p class="notice warning">@TempData["Error"]</p>
}
@if (TempData["Success"] is not null)
{
    <p class="notice success">@TempData["Success"]</p>
}

<form method="post" action="/Admin/Configuration/Save">
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Setting</th><th>Value</th><th>Description</th><th>Type</th></tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                var description = item.Key == "PhotoRetentionCropYearsAfterCurrent" && !item.Description.Contains("Planning value only", StringComparison.OrdinalIgnoreCase)
                    ? $"{item.Description} Planning value only. No automatic photo deletion currently runs."
                    : item.Description;
                <tr>
                    <td>@item.Key</td>
                    <td><input name="Values[@item.Id]" value="@item.Value" /></td>
                    <td>@description</td>
                    <td>@item.ValueType</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <p class="button-row"><button type="submit">Save Configuration</button></p>
</form>
