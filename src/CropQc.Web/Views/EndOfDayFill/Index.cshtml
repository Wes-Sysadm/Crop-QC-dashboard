@model EndOfDayFillPreviewViewModel
@{
    ViewData["Title"] = "End of Day Fill";
}

<div class="page-heading-row">
    <div><h1>End of Day Fill</h1><p class="muted">Manual current-room fill report after a physical count.</p></div>
    <a class="secondary-button" href="/EndOfDayFill/History">Send History</a>
</div>

@if (TempData["Error"] is not null) { <p class="notice warning">@TempData["Error"]</p> }
@if (TempData["Success"] is not null) { <p class="notice success">@TempData["Success"]</p> }

@if (Model.Groups.Count > 1)
{
    <form class="toolbar" method="get" action="/EndOfDayFill">
        <label class="field">Report group
            <select name="groupId" onchange="this.form.submit()">
                <option value="">Select a report group</option>
                @foreach (var group in Model.Groups)
                {
                    <option value="@group.Id" selected="@(group.Id == Model.SelectedGroupId)">@group.Name</option>
                }
            </select>
        </label>
        <noscript><button type="submit">Preview</button></noscript>
    </form>
}

@if (Model.SelectedGroupId is not null)
{
    <section class="panel">
        <h2>@Model.GroupName</h2>
        <p class="muted">Warehouse @Model.WarehouseLabel · Operating Facility @Model.Facility</p>
        <p><strong>Recipients:</strong> @string.Join(", ", Model.Recipients)</p>
        <p class="muted">Empty configured rooms are validated but omitted from the email.</p>
        <a class="secondary-button" href="/EndOfDayFill?groupId=@Model.SelectedGroupId">Refresh Preview</a>
    </section>

    @if (Model.Issues.Count > 0)
    {
        <section class="panel notice warning" role="alert">
            <h2>Send blocked</h2>
            <ul>
                @foreach (var issue in Model.Issues)
                {
                    <li>@issue.Message @if (issue.RoomId is not null) { <a href="/Rooms/@issue.RoomId">Open room</a> }</li>
                }
            </ul>
        </section>
    }

    @if (Model.PendingAttempt is not null)
    {
        var pending = Model.PendingAttempt;
        <section class="panel notice warning" role="alert">
            <h2>@(pending.IsStale ? "Previous send has an uncertain outcome" : "Previous send is still being processed")</h2>
            <p>Do not resend. @(pending.IsStale ? "Ask a Master Data administrator to verify the sender's Gmail Sent folder and resolve the pending attempt." : "Wait for the current send to finish, then refresh.")</p>
            <dl><dt>Report group</dt><dd>@pending.GroupName</dd><dt>Sender</dt><dd>@pending.Sender</dd><dt>Attempted</dt><dd>@pending.AttemptedAt</dd><dt>Subject</dt><dd>@pending.Subject</dd><dt>Recipients</dt><dd>@pending.Recipients</dd><dt>Revision candidate</dt><dd>@(pending.RevisionNumber == 0 ? "Original" : $"REVISION {pending.RevisionNumber}")</dd><dt>Snapshot</dt><dd><code>@pending.SnapshotHash</code></dd></dl>
            <a href="/EndOfDayFill/History/@pending.SendAttemptId">View exact candidate report</a>
        </section>
    }

    @if (Model.RoomSummaryRows.Count == 0)
    {
        <p class="empty-state">No active rooms are currently configured for this report group.</p>
    }
    else
    {
        var summary = Model.RoomSummary;
        <section class="panel end-of-day-fill-summary">
            <h2>Room Summary</h2>
            <div class="table-wrap contained-table">
                <table>
                    <thead>
                        <tr><th>Room</th><th class="numeric-cell">Current Bins</th><th class="numeric-cell">Capacity</th><th class="numeric-cell">Full</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var room in summary.Rooms)
                    {
                        <tr>
                            <td>@room.RoomCode</td>
                            <td class="numeric-cell">@room.CurrentBins.ToString("N0")</td>
                            <td class="numeric-cell">@room.CapacityBins.ToString("N0")</td>
                            <td class="numeric-cell">@(room.PercentFull is decimal summaryRoomPercent ? $"{summaryRoomPercent:N1}%" : "Unavailable")</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>Total</th>
                            <th class="numeric-cell">@summary.TotalCurrentBins.ToString("N0")</th>
                            <th class="numeric-cell">@summary.TotalCapacityBins.ToString("N0")</th>
                            <th class="numeric-cell">@(summary.TotalPercentFull is decimal totalPercent ? $"{totalPercent:N1}%" : "Unavailable")</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </section>

        @if (Model.Rooms.Count == 0)
        {
            <h2>Detailed Room Breakdown</h2>
            <p class="empty-state">No configured rooms currently contain fruit.</p>
        }
        else
        {
            <h2>Detailed Room Breakdown</h2>
            <div class="end-of-day-fill-grid">
            @foreach (var room in Model.Rooms)
            {
                <article class="panel end-of-day-fill-room">
                    <h2>@room.RoomCode — @room.RoomName</h2>
                    <p class="room-fill-total"><strong>@room.CurrentBins.ToString("N0") / @room.CapacityBins.ToString("N0") bins — @(room.PercentFull is decimal detailRoomPercent ? $"{detailRoomPercent:N1}%" : "Unavailable") full</strong></p>
                    @foreach (var variety in room.Varieties)
                    {
                        <section class="end-of-day-fill-variety @(variety.IsOrganic ? "organic-stripe" : "")" style="--variety-color: @variety.HexColor">
                            <h3>@variety.DisplayIdentity</h3>
                            <p><strong>@variety.Bins.ToString("N0") bins</strong></p>
                            <ul>
                            @foreach (var grower in variety.Growers)
                            {
                                <li>Grower @grower.GrowerNumber@(string.IsNullOrWhiteSpace(grower.GrowerName) ? "" : $" — {grower.GrowerName}") — @grower.Bins.ToString("N0") bins</li>
                            }
                            </ul>
                        </section>
                    }
                </article>
            }
            </div>
        }
    }

    <section class="panel">
        <form method="post" action="/EndOfDayFill/Send" id="end-of-day-fill-send-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="GroupId" value="@Model.SelectedGroupId" />
            <input type="hidden" name="PreviewToken" value="@Model.PreviewToken" />
            <label class="checkbox-field physical-count-confirmation">
                <input id="physical-count-confirmed" type="checkbox" name="PhysicalCountConfirmed" value="true" disabled="@(!Model.CanSend)" />
                I confirm that a physical count has been completed and that the room inventory shown above is correct.
            </label>
            <input type="hidden" name="PhysicalCountConfirmed" value="false" />
            <button id="send-end-of-day-fill" type="submit" disabled>Send End of Day Fill Report</button>
        </form>
    </section>
}

<script>
(() => {
    const confirmation = document.getElementById('physical-count-confirmed');
    const send = document.getElementById('send-end-of-day-fill');
    if (!confirmation || !send) return;
    const sync = () => send.disabled = !confirmation.checked || confirmation.disabled;
    confirmation.addEventListener('change', sync);
    sync();
})();
</script>
