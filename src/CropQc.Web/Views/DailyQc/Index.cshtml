@model DailyQcDashboardViewModel
@inject IUserAccessService UserAccess
@{
    ViewData["Title"] = "Daily QC";
    var canSendQcSummary = await UserAccess.HasAccessAsync(User, ApplicationAreas.DailyQc, PageAccessLevel.Edit, Context.RequestAborted);
    var canOverrideQcSummary = await UserAccess.HasAccessAsync(User, ApplicationAreas.DailyQc, PageAccessLevel.Admin, Context.RequestAborted);
}

<h1>Daily QC Dashboard</h1>
@await Html.PartialAsync("_PageRefreshControls")
@if (Model.DataWarning is not null)
{
    <p class="notice warning">@Model.DataWarning</p>
}
@if (!string.IsNullOrWhiteSpace(Model.StatusDescription))
{
    <p class="notice">@Model.StatusDescription</p>
}

<form class="toolbar" method="get">
    <div class="field">
        <label>Facility</label>
        <select name="facility">
            @foreach (var facility in new[] { "WP", "EBS", "All" })
            {
                <option value="@facility" selected="@(Model.Facility == facility)">@facility</option>
            }
        </select>
    </div>
    <div class="field">
        <label>Warehouse</label>
        <select name="warehouseId">
            <option value="">All</option>
            @foreach (var warehouse in Model.Warehouses)
            {
                <option value="@warehouse.Id" selected="@(Model.WarehouseId == warehouse.Id)">@warehouse.Code</option>
            }
        </select>
    </div>
    <div class="field">
        <label>Status</label>
        <select name="status">
            <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Status))">All</option>
            <option value="ReadyToSend" selected="@(Model.Status == "ReadyToSend")">Ready to Email</option>
            <option value="MissingData" selected="@(Model.Status == "MissingData")">Missing Data</option>
            <option value="NeedsReview" selected="@(Model.Status == "NeedsReview")">Needs Review</option>
            <option value="Sent" selected="@(Model.Status == "Sent")">Sent</option>
        </select>
    </div>
    <button type="submit">Refresh</button>
</form>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Sample</th>
                <th>Warehouse</th>
                <th>Status</th>
                <th>Starch</th>
                <th>Ready</th>
                <th>Missing Items</th>
                <th>Review Reasons</th>
                <th>Email</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var sample in Model.Samples)
        {
            <tr>
                <td><a href="/Samples/@sample.Id">@sample.DisplayReceiptId</a></td>
                <td>@sample.Warehouse</td>
                <td><span class="status @StatusClass(sample.Status)">@sample.Status</span></td>
                <td>
                    <span class="status @StatusClass(sample.StarchStatus)">@sample.StarchStatus</span>
                    @if (!sample.StarchStatus.Contains("complete", StringComparison.OrdinalIgnoreCase))
                    {
                        <a class="inline-action" href="/Samples/@sample.Id/Starch">Starch Input</a>
                    }
                </td>
                <td><span class="status @(sample.IsReady ? "ready" : "missing")">@(sample.IsReady ? "Ready" : "Missing")</span></td>
                <td>
                    @if (sample.MissingItems.Count == 0)
                    {
                        <span class="muted">None</span>
                    }
                    else
                    {
                        @await Html.PartialAsync("_ReadinessChecklist", sample.Checklist)
                        <ul class="list">
                        @foreach (var item in sample.MissingItems)
                        {
                            <li>@item</li>
                        }
                        </ul>
                    }
                </td>
                <td>
                    @if (sample.ReviewReasons.Count == 0)
                    {
                        <span class="muted">None</span>
                    }
                    else
                    {
                        <ul class="list">
                        @foreach (var reason in sample.ReviewReasons)
                        {
                            <li>@reason</li>
                        }
                        </ul>
                    }
                </td>
                <td>
                    <span class="status @StatusClass(sample.EmailStatus)">@sample.EmailStatus</span>
                    @if (sample.EmailSentAt is not null)
                    {
                        <div class="muted">Sent @BusinessTime.FormatPacific(sample.EmailSentAt.Value) by @(sample.EmailSentBy ?? "unknown")</div>
                    }
                </td>
                <td>
                    <a class="inline-action" href="cropqcstation://sample/@sample.Id">Open in QC Station</a>
                    @if (CanSendEmail(sample))
                    {
                        @if (canSendQcSummary)
                        {
                            <form method="post" action="/Samples/@sample.Id/Send" class="inline-form">
                                <button type="submit">Send QC Summary</button>
                            </form>
                        }
                    }
                    else
                    {
                        <button type="button" disabled>Send QC Summary</button>
                        @if (canOverrideQcSummary)
                        {
                            <a class="inline-action" href="/Samples/@sample.Id/OverrideSend">Override Send</a>
                        }
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@functions {
    private static string StatusClass(string status) =>
        status.Contains("review", StringComparison.OrdinalIgnoreCase) ? "review" :
        status.Contains("resend", StringComparison.OrdinalIgnoreCase) ? "review" :
        status.Contains("ready", StringComparison.OrdinalIgnoreCase) ? "ready" :
        status.Contains("sent", StringComparison.OrdinalIgnoreCase) ? "sent" :
        status.Contains("pending", StringComparison.OrdinalIgnoreCase) ? "pending" : "";

    private static bool CanSendEmail(SampleListItemViewModel sample) =>
        sample.IsReady
        && !sample.EmailStatus.Equals("Sent", StringComparison.OrdinalIgnoreCase);
}
