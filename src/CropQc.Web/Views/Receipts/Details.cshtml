@model ReceiptDetailViewModel
@inject IUserAccessService UserAccess
@{
    ViewData["Title"] = "Receipt Detail";
    ViewData["AutoRefresh"] = "true";
    var canEditReceipt = await UserAccess.HasAccessAsync(User, ApplicationAreas.ReceiptEdit, PageAccessLevel.Edit, Context.RequestAborted);
    var canCreateSample = await UserAccess.HasAccessAsync(User, ApplicationAreas.DailyQc, PageAccessLevel.Edit, Context.RequestAborted);
}

<h1>Receipt Detail</h1>
@await Html.PartialAsync("_PageRefreshControls")
@if (TempData["Success"] is string success)
{
    <p class="notice success">@success</p>
}
@if (TempData["Warning"] is string warning)
{
    <p class="notice warning">@warning</p>
}
@if (TempData["Error"] is string error)
{
    <p class="notice error">@error</p>
}
@if (Model.DataWarning is not null)
{
    <p class="notice warning">@Model.DataWarning</p>
}
@if (Model.Receipt is not null)
{
    <section class="panel">
        <h2>@Model.Receipt.CompuTechReceiptId</h2>
        <p>@Model.Receipt.CropYear | @Model.Receipt.ReceivedAt.LocalDateTime | @Model.Receipt.ReceiptType | @Model.Receipt.Warehouse / @Model.Receipt.Room | Lot # @(string.IsNullOrWhiteSpace(Model.Receipt.GrowerNumber) ? "-" : Model.Receipt.GrowerNumber) | @Model.Receipt.GrowerName | @Model.Receipt.VarietyCode | @Model.Receipt.BinCount bins</p>
        <div class="action-bar">
            <a class="button secondary-button" href="/Dashboard/Rooms/@Model.Receipt.RoomId">View Room Summary</a>
            @if (canEditReceipt)
            {
                <a class="button secondary-button" href="/Receipts/@Model.Receipt.Id/Edit">Edit Receipt</a>
            }
        </div>
        @if (Model.Samples.Any())
        {
            <p class="notice warning">This receipt already has a QC sample. Creating another sample of the same type will assign the next sample sequence, such as @(Model.Receipt.CompuTechReceiptId)(2), and mark it Needs Review.</p>
        }
        @if (canCreateSample)
        {
        <form id="add-sample" method="post" action="/Receipts/@Model.Receipt.Id/samples">
            <label class="field">
                Sample type
                <select name="SampleTypeId" required>
                    @foreach (var sampleType in Model.SampleTypes)
                    {
                        <option value="@sampleType.Id">@sampleType.Name</option>
                    }
                </select>
            </label>
            <button type="submit">Create QC Sample</button>
            <p class="muted">Sample types come from Master Data. Use Receiving Sample, Door Sample, or Lot Sample for receipt QC.</p>
        </form>
        }
    </section>
}

<div class="grid-two">
    <section id="samples">
        <h2>Linked Samples</h2>
        <p class="muted">Use Open in QC Station to capture FTA pressures for a sample. Weight, grade, defects, and other QC details can still be entered on the sample page. Requires Crop QC Station to be installed and station config imported.</p>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Sample</th><th>Type</th><th>Status</th><th>Fruit</th><th>Avg Pressure</th><th>Starch</th><th>Photos</th><th>Email</th><th>Ready</th><th>Missing</th><th>Time</th><th>Actions</th></tr></thead>
                <tbody>
                @foreach (var sample in Model.Samples)
                {
                    <tr>
                        <td><a href="/Samples/@sample.Id">@sample.DisplayReceiptId</a></td>
                        <td>@sample.SampleType</td>
                        <td>@sample.Status</td>
                        <td>@sample.CompletedFruitCount</td>
                        <td>@(sample.AveragePressureLbs?.ToString("0.##") ?? "-")</td>
                        <td>
                            @if (sample.StarchStatus.Contains("complete", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="status ready">Starch Complete</span>
                            }
                            else
                            {
                                <span class="status pending">@sample.StarchStatus</span>
                                <a class="button secondary-button" href="/Samples/@sample.Id/Starch">Starch Input</a>
                            }
                        </td>
                        <td>@sample.PhotoStatus</td>
                        <td>@sample.EmailStatus</td>
                        <td><span class="status @(sample.IsReady ? "ready" : "missing")">@(sample.IsReady ? "Ready" : "Missing")</span></td>
                        <td>
                            @if (sample.MissingItems.Count == 0)
                            {
                                <span class="muted">None</span>
                            }
                            else
                            {
                                <span>@sample.MissingItems.Count item@(sample.MissingItems.Count == 1 ? "" : "s")</span>
                                <ul class="compact-list">
                                @foreach (var item in sample.MissingItems.Take(3))
                                {
                                    <li>@item</li>
                                }
                                </ul>
                            }
                        </td>
                        <td>@sample.SampleTakenAt.LocalDateTime</td>
                        <td>
                            <a class="inline-action" href="/Samples/@sample.Id">View Sample</a>
                            <a class="inline-action" href="cropqcstation://sample/@sample.Id">Open in QC Station</a>
                            @if (sample.IsReady)
                            {
                                <form class="inline-form" method="post" action="/Samples/@sample.Id/Send"><button class="link-button" type="submit">Send QC Email</button></form>
                            }
                            @if (Model.CanDeleteSamples)
                            {
                                <a class="inline-action danger-link" href="/Samples/@sample.Id/Delete">Delete Sample</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
    <section>
        <h2>Receipt Photos</h2>
        @await Html.PartialAsync("_PhotoGroups", Model.PhotoGroups)
        @if (Model.Receipt is not null)
        {
            @await Html.PartialAsync("_PhotoPlaceholderForm", new PhotoPlaceholderFormViewModel
            {
                FormAction = $"/Receipts/{Model.Receipt.Id}/photos",
                Title = "Add Receipt Photo",
                DefaultPhotoType = "BinTruck",
                PhotoTypes = ["BinTruck", "TopOfTruck", "Other"],
                CropYear = Model.Receipt.CropYear,
                Warehouse = Model.Receipt.Warehouse,
                ReceiptId = Model.Receipt.CompuTechReceiptId
            })
        }
    </section>
</div>
