@model ReceiptDetailViewModel
@using CropQc.Data
@inject IUserAccessService UserAccess
@{
    ViewData["Title"] = "Receipt Detail";
    ViewData["AutoRefresh"] = "true";
    var canEditReceipt = await UserAccess.HasAccessAsync(User, ApplicationAreas.ReceiptEdit, PageAccessLevel.Edit, Context.RequestAborted);
    var canDeleteReceipt = await UserAccess.HasAccessAsync(User, ApplicationAreas.ReceiptDelete, PageAccessLevel.Admin, Context.RequestAborted);
    var canViewReceiptQc = await UserAccess.HasAccessAsync(User, ApplicationAreas.DailyQc, PageAccessLevel.View, Context.RequestAborted);
}

<h1>Receipt Summary</h1>
@await Html.PartialAsync("_PageRefreshControls")
@if (TempData["Success"] is string success)
{
    <p class="notice success">@success</p>
}
@if (TempData["Warning"] is string warning)
{
    <p class="notice warning">@warning</p>
}
@if (TempData["Error"] is string error)
{
    <p class="notice error">@error</p>
}
@if (Model.DataWarning is not null)
{
    <p class="notice warning">@Model.DataWarning</p>
}
@if (Model.Receipt is not null)
{
    <section class="panel">
        <h2>@Model.Receipt.CompuTechReceiptId</h2>
        <p>@Model.Receipt.CropYear | @BusinessTime.FormatPacific(Model.Receipt.ReceivedAt) | @Model.Receipt.ReceiptType | @Model.Receipt.Warehouse / @Model.Receipt.Room | Lot # @(string.IsNullOrWhiteSpace(Model.Receipt.GrowerNumber) ? "-" : Model.Receipt.GrowerNumber) | @Model.Receipt.GrowerName | @Model.Receipt.VarietyCode | @Model.Receipt.BinCount bins</p>
        <div class="metric-grid">
            <div><strong>@Model.Receipt.BinCount</strong><span>Received bins</span></div>
            <div><strong>@Model.ActiveDroppedBins</strong><span>Dropped after receiving</span></div>
            <div><strong>@(Model.CurrentPackableBins?.ToString() ?? "-")</strong><span>Current packable inventory</span></div>
        </div>
        <div class="action-bar">
            @if (canViewReceiptQc && Model.Samples.Count <= 1)
            {
                <form method="post" action="/Receipts/@Model.Receipt.Id/receiving/open" class="inline-form">
                    @Html.AntiForgeryToken()
                    <button type="submit">Open Receiving</button>
                </form>
            }
            <a class="button secondary-button" href="/Dashboard/Rooms/@Model.Receipt.RoomId">View Room Summary</a>
            @if (canEditReceipt)
            {
                <a class="button secondary-button" href="/Receipts/@Model.Receipt.Id/Edit">Edit Receipt</a>
            }
            @if (canDeleteReceipt)
            {
                <a class="button danger-button" href="/Receipts/@Model.Receipt.Id/Delete">Admin Void Receipt</a>
            }
        </div>
        @if (Model.Samples.Count > 1)
        {
            <p class="notice warning">@ReceiptQcSampleCoordinator.HistoricalConflictMessage</p>
        }
    </section>

    @if (Model.InventoryOverrides.Count > 0)
    {
        <section class="panel">
            <h2>Receipt Admin Override History</h2>
            <table class="data-table"><thead><tr><th>ID / Time</th><th>Action</th><th>Administrator</th><th>Receipt bins</th><th>Inventory</th><th>Reason / Audit</th></tr></thead><tbody>
            @foreach (var item in Model.InventoryOverrides)
            {
                <tr>
                    <td><code>@item.Id</code><br />@BusinessTime.FormatPacific(item.CreatedAt)</td>
                    <td>@item.Action</td><td>@item.Administrator</td>
                    <td>@item.OldReceiptBins → @item.NewReceiptBins</td>
                    <td>@item.CurrentInventoryBefore → @item.CurrentInventoryAfter (@item.InventoryDelta)<br />@item.LedgerAdjustmentCount ledger row(s)</td>
                    <td>@item.Reason@if (item.NegativeInventoryAcknowledged) { <br /><strong>Negative inventory acknowledged</strong> }</td>
                </tr>
            }
            </tbody></table>
            <a class="button secondary-button" href="/Admin/RoomInventory/Reconciliation">Open Inventory Reconciliation</a>
        </section>
    }

    @if (Model.InventoryLosses.Count > 0)
    {
        <section class="panel">
            <h2>Dropped Bin History</h2>
            <table class="data-table"><thead><tr><th>Status</th><th>Bins</th><th>Room</th><th>Occurred / recorded</th><th>User</th><th>Reason / notes</th></tr></thead><tbody>
            @foreach (var item in Model.InventoryLosses)
            {
                <tr>
                    <td>@(item.IsReversed ? "Restored" : "Dropped")</td>
                    <td>@item.BinCount</td>
                    <td>@item.Facility / @item.Room</td>
                    <td>@BusinessTime.FormatPacific(item.OccurredAt, empty: "Exact occurrence time unavailable")<br /><span class="muted">Recorded @BusinessTime.FormatPacific(item.CreatedAt)</span></td>
                    <td>@item.CreatedBy@if (item.IsReversed) { <br /><span class="muted">Restored by @(item.ReversedBy ?? "Unknown")</span> }</td>
                    <td>@item.Reason@if (!string.IsNullOrWhiteSpace(item.Notes)) { <br /><span class="muted">@item.Notes</span> }@if (item.IsReversed) { <br /><strong>Reversal:</strong> @item.ReverseReason }</td>
                </tr>
            }
            </tbody></table>
        </section>
    }

    <section class="panel" id="receiving-treatment-history">
        <h2>Receiving Treatment History</h2>
        <p class="muted">Receiving treatments apply only to the exact bins from this Receipt and follow those bins through room transfers and packing.</p>
        @if (Model.TreatmentApplications.Count == 0)
        {
            <p class="muted">No Receiving treatments have been recorded for this Receipt.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Applied</th><th>Treatment</th><th>Bins</th><th>Applied by</th><th>Status / notes</th><th>Treatment report / action</th></tr></thead>
                    <tbody>
                    @foreach (var treatment in Model.TreatmentApplications)
                    {
                        <tr id="receiving-treatment-@treatment.Id">
                            <td>@BusinessTime.FormatPacific(treatment.AppliedAt)</td>
                            <td>@if (!string.IsNullOrWhiteSpace(treatment.CommonName)) { <strong>@treatment.CommonName</strong><br /> }@treatment.ProductName</td>
                            <td>@treatment.BinsAffected.ToString("N0")</td>
                            <td>@treatment.AppliedBy</td>
                            <td><span class="status @(treatment.IsReversed ? "pending" : "ready")">@(treatment.IsReversed ? "Reversed" : "Active")</span>@if (!string.IsNullOrWhiteSpace(treatment.Notes)) { <br /><span>@treatment.Notes</span> }@if (treatment.IsReversed) { <br /><span class="muted">@treatment.ReversalReason</span> }</td>
                            <td>
                                @if (treatment.Attachments.Count == 0)
                                {
                                    <p class="muted">No treatment report attached.</p>
                                }
                                else
                                {
                                    <ul class="compact-list">
                                    @foreach (var attachment in treatment.Attachments)
                                    {
                                        <li>
                                            <a href="/RoomTreatments/@treatment.Id/Reports/@attachment.Id/Content" target="_blank" rel="noopener">@attachment.FileName</a> (@FormatFileSize(attachment.FileSizeBytes))
                                            @if (Model.CanReverseReceivingTreatment)
                                            {
                                                <form method="post" action="/Receipts/@Model.Receipt.Id/Treatments/@treatment.Id/Reports/@attachment.Id/Remove" class="inline-form" onsubmit="return confirm('Remove this treatment report attachment? The treatment application will be retained.');">
                                                    @Html.AntiForgeryToken()
                                                    <label class="sr-only" for="remove-treatment-report-reason-@attachment.Id">Removal reason</label>
                                                    <input id="remove-treatment-report-reason-@attachment.Id" name="Reason" required maxlength="1000" placeholder="Removal reason" />
                                                    <button type="submit" class="danger-button">Remove Report</button>
                                                </form>
                                            }
                                        </li>
                                    }
                                    </ul>
                                }
                                @if (Model.CanApplyReceivingTreatment)
                                {
                                    <details>
                                        <summary>Add Treatment Report</summary>
                                        <form method="post" enctype="multipart/form-data" action="/Receipts/@Model.Receipt.Id/Treatments/@treatment.Id/Reports" class="stacked-form treatment-report-form" data-treatment-report-form>
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="OperationKey" value="@Guid.NewGuid().ToString("N")" />
                                            <label>Report files <input type="file" name="Files" accept=".pdf,.jpg,.jpeg,.png,.webp,application/pdf,image/jpeg,image/png,image/webp" multiple data-treatment-report-input /></label>
                                            <p class="field-validation" data-treatment-report-validation role="status"></p>
                                            <p class="muted" data-treatment-report-empty>No treatment report selected.</p>
                                            <div class="treatment-report-preview-grid" data-treatment-report-previews></div>
                                            <button type="submit" data-treatment-report-submit disabled>Upload Treatment Report</button>
                                        </form>
                                    </details>
                                }
                                @if (Model.CanReverseReceivingTreatment && !treatment.IsReversed)
                                {
                                    <form method="post" action="/Receipts/@Model.Receipt.Id/Treatments/@treatment.Id/Reverse" class="stack-form" onsubmit="return confirm('Reverse this Receiving treatment? Original evidence and reports will be retained.');">
                                        @Html.AntiForgeryToken()
                                        <label>Reversal reason <input name="Reason" required maxlength="1000" /></label>
                                        <button type="submit" class="danger-button">Reverse Treatment</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

}

<div class="grid-two">
    <section id="samples">
        <h2>QC Summary</h2>
        <p class="muted">Receiving QC is entered on the single QC Sample workspace. This table preserves the complete historical sample record for review.</p>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Sample</th><th>Type</th><th>Status</th><th>Fruit</th><th>Avg Pressure</th><th>Starch</th><th>Photos</th><th>Email</th><th>Ready</th><th>Missing</th><th>Time</th><th>Actions</th></tr></thead>
                <tbody>
                @foreach (var sample in Model.Samples)
                {
                    <tr>
                        <td><a href="/Samples/@sample.Id">@sample.DisplayReceiptId</a></td>
                        <td>@sample.SampleType</td>
                        <td>@sample.Status</td>
                        <td>@sample.CompletedFruitCount</td>
                        <td>@(sample.AveragePressureLbs?.ToString("0.##") ?? "-")</td>
                        <td>
                            @if (sample.StarchStatus.Contains("complete", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="status ready">Starch Complete</span>
                            }
                            else
                            {
                                <span class="status pending">@sample.StarchStatus</span>
                                <a class="button secondary-button" href="/Samples/@sample.Id/Starch">Starch Input</a>
                            }
                        </td>
                        <td>@sample.PhotoStatus</td>
                        <td>
                            <span class="status @StatusClass(sample.EmailStatus)">@sample.EmailStatus</span>
                            @if (sample.EmailSentAt is not null)
                            {
                                <div class="muted">Sent @BusinessTime.FormatPacific(sample.EmailSentAt.Value) by @(sample.EmailSentBy ?? "unknown")</div>
                            }
                        </td>
                        <td><span class="status @(sample.IsReady ? "ready" : "missing")">@(sample.IsReady ? "Ready" : "Missing")</span></td>
                        <td>
                            @if (sample.MissingItems.Count == 0)
                            {
                                <span class="muted">None</span>
                            }
                            else
                            {
                                <span>@sample.MissingItems.Count item@(sample.MissingItems.Count == 1 ? "" : "s")</span>
                                <ul class="compact-list">
                                @foreach (var item in sample.MissingItems.Take(3))
                                {
                                    <li>@item</li>
                                }
                                </ul>
                            }
                        </td>
                        <td>@BusinessTime.FormatPacific(sample.SampleTakenAt)</td>
                        <td>
                            <a class="inline-action" href="/Samples/@sample.Id">View Sample</a>
                            <a class="inline-action" href="cropqcstation://sample/@sample.Id">Open in QC Station</a>
                            @if (CanSendEmail(sample))
                            {
                                <form class="inline-form" method="post" action="/Samples/@sample.Id/Send"><button class="link-button" type="submit">Send QC Email</button></form>
                            }
                            @if (Model.CanDeleteSamples)
                            {
                                <a class="inline-action danger-link" href="/Samples/@sample.Id/Delete">Delete Sample</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
    <section>
        <h2>Receipt &amp; QC Photos</h2>
        <p class="muted">Receipt-level and linked QC Sample photos are grouped together for review.</p>
        @await Html.PartialAsync("_PhotoGroups", Model.PhotoGroups)
        @if (Model.Receipt is not null)
        {
            @await Html.PartialAsync("_PhotoPlaceholderForm", new PhotoPlaceholderFormViewModel
            {
                FormAction = $"/Receipts/{Model.Receipt.Id}/photos",
                Title = "Add Receipt Photo",
                DefaultPhotoType = "BinTruck",
                PhotoTypes = ["BinTruck", "TopOfTruck", "Other"],
                CropYear = Model.Receipt.CropYear,
                Warehouse = Model.Receipt.Warehouse,
                ReceiptId = Model.Receipt.CompuTechReceiptId
            })
        }
    </section>
</div>

@functions {
    private static string StatusClass(string status) =>
        status.Contains("review", StringComparison.OrdinalIgnoreCase) ? "review" :
        status.Contains("resend", StringComparison.OrdinalIgnoreCase) ? "review" :
        status.Contains("ready", StringComparison.OrdinalIgnoreCase) ? "ready" :
        status.Contains("sent", StringComparison.OrdinalIgnoreCase) ? "sent" :
        status.Contains("pending", StringComparison.OrdinalIgnoreCase) ? "pending" : "";

    private static bool CanSendEmail(SampleListItemViewModel sample) =>
        sample.IsReady
        && !sample.EmailStatus.Equals("Sent", StringComparison.OrdinalIgnoreCase);

    private static string FormatFileSize(long bytes) => bytes >= 1024 * 1024
        ? $"{bytes / (1024d * 1024d):0.0} MB"
        : $"{Math.Max(1, bytes / 1024d):0} KB";
}

<script src="~/js/treatment-reports.js" asp-append-version="true"></script>
