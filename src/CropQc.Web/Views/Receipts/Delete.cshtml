@model ReceiptDeletionConfirmationViewModel
@{
    ViewData["Title"] = "Delete Receipt";
}

<h1>Delete Receipt</h1>

@if (TempData["Error"] is string error)
{
    <p class="notice error">@error</p>
}

<section class="panel danger-zone">
    <h2>@Model.ReceiptNumber — Crop Year @Model.CropYear</h2>
    <p class="notice warning">Receipt deletion is restricted to administrators. Operational history is never silently cascade-deleted.</p>
    <dl class="summary-list">
        <dt>Received</dt><dd>@BusinessTime.FormatPacific(Model.ReceivedAt)</dd>
        <dt>Grower</dt><dd>@Model.Grower</dd>
        <dt>Grower number</dt><dd>@(string.IsNullOrWhiteSpace(Model.GrowerNumber) ? "—" : Model.GrowerNumber)</dd>
        <dt>Variety</dt><dd>@Model.Variety</dd>
        <dt>Lot</dt><dd>@Model.Lot</dd>
        <dt>Warehouse / room</dt><dd>@Model.Warehouse / @Model.Room</dd>
        <dt>Gross bins</dt><dd>@Model.GrossBins</dd>
    </dl>
</section>

<section class="panel">
    <h2>Dependent Data</h2>
    <div class="stat-grid">
        <div class="stat-card"><strong>@Model.Dependencies.QcSamples</strong><span>QC samples</span></div>
        <div class="stat-card"><strong>@Model.Dependencies.FruitReadings</strong><span>Fruit rows</span></div>
        <div class="stat-card"><strong>@Model.Dependencies.Defects</strong><span>Defects</span></div>
        <div class="stat-card"><strong>@Model.Dependencies.Photos</strong><span>Photos</span></div>
        <div class="stat-card"><strong>@Model.Dependencies.EmailLogs</strong><span>Email logs</span></div>
        <div class="stat-card"><strong>@Model.Dependencies.InventoryAdjustments</strong><span>Inventory records</span></div>
        <div class="stat-card"><strong>@Model.Dependencies.Transfers</strong><span>Transfers</span></div>
        <div class="stat-card"><strong>@Model.Dependencies.DepletionsAndTrueUps</strong><span>Depletion / true-up</span></div>
        <div class="stat-card"><strong>@Model.Dependencies.BinsRun</strong><span>Bins Run</span></div>
        <div class="stat-card"><strong>@Model.Dependencies.OfflineSyncItems</strong><span>Sync records</span></div>
        <div class="stat-card"><strong>@Model.Dependencies.AuditRecords</strong><span>Audit records preserved</span></div>
    </div>

    @if (Model.HasBlockingOperationalHistory)
    {
        <p class="notice error"><strong>Normal deletion is blocked.</strong> This receipt has operational history:</p>
        <ul class="list">
            @foreach (var reason in Model.BlockingReasons)
            {
                <li>@reason</li>
            }
        </ul>
        <p>Use only a separately reviewed, verified-backup-gated purge operation when removal of that history is explicitly authorized.</p>
    }
    else
    {
        <p>This action soft-deletes the receipt from active workflows. The immutable deletion audit and existing audit records remain.</p>
        <form method="post" action="/Receipts/@Model.Id/Delete" data-prevent-double-submit="true">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id" />
            <input type="hidden" name="OperationToken" value="@Model.Form.OperationToken" />
            <div class="field">
                <label for="confirmationValue">Type receipt number <strong>@Model.ReceiptNumber</strong></label>
                <input id="confirmationValue" name="ConfirmationValue" autocomplete="off" required />
            </div>
            <div class="field">
                <label for="deletionReason">Deletion reason</label>
                <textarea id="deletionReason" name="Reason" maxlength="1000" required></textarea>
            </div>
            <label class="checkbox-field">
                <input type="checkbox" name="ConfirmDeletion" value="true" required />
                I confirm that the displayed receipt identity and crop year are correct.
            </label>
            <input type="hidden" name="ConfirmDeletion" value="false" />
            <div class="button-row">
                <button type="submit">Delete Receipt</button>
                <a class="button secondary-button" href="/Receipts/@Model.Id">Cancel</a>
            </div>
        </form>
    }
</section>

<script>
    document.querySelector("form[data-prevent-double-submit]")?.addEventListener("submit", event => {
        const button = event.currentTarget.querySelector("button[type='submit']");
        if (!button || button.disabled) {
            event.preventDefault();
            return;
        }
        button.disabled = true;
        button.textContent = "Deleting…";
    });
</script>
