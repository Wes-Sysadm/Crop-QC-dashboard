@model ReceiptListViewModel
@using System.Text.Json
@inject IUserAccessService UserAccess
@{
    ViewData["Title"] = "Receipts";
    var roomOptionsJson = JsonSerializer.Serialize(Model.Rooms.Select(x => new { id = x.Id, warehouseId = x.WarehouseId, code = x.CropQcRoomName ?? x.DisplayName ?? x.Code, name = x.DisplayName ?? x.Name, subLocation = x.SubLocation ?? "", compuTech = x.CompuTechRoomCode ?? "" }));
    var growerLotsJson = JsonSerializer.Serialize(Model.GrowerLots.Select(x => new { id = x.Id, grower = x.Grower, lot = x.LotNumber, label = $"{x.Grower} - {x.LotNumber}" }));
    var hasRequiredMasterData = Model.Warehouses.Count > 0 && Model.Rooms.Count > 0 && Model.FruitProfiles.Count > 0;
    var canEditReceipts = await UserAccess.HasAccessAsync(User, ApplicationAreas.Receipts, PageAccessLevel.Edit, Context.RequestAborted);
    var canAdminReceipts = await UserAccess.HasAccessAsync(User, ApplicationAreas.Receipts, PageAccessLevel.Admin, Context.RequestAborted);
}

<h1>Receipts</h1>
@if (canAdminReceipts)
{
    <p><a class="button secondary-button" href="/Receipts/Admin/Voided">Voided Receipt Administration</a></p>
}
@await Html.PartialAsync("_PageRefreshControls")
@if (Model.DataWarning is not null)
{
    <p class="notice warning">@Model.DataWarning</p>
}
@if (TempData["Error"] is not null)
{
    <p class="notice warning">@TempData["Error"]</p>
}
@if (!hasRequiredMasterData)
{
    <p class="notice warning">Core master data is missing. Enable Database__SeedMasterDataOnStartup=true for the Render staging service, redeploy, and verify warehouses, rooms, and fruit profiles appear here.</p>
}

<form class="toolbar" method="get">
    <input type="hidden" name="DateFilter" value="@Model.Search.DateFilter" />
    <input type="hidden" name="SampleType" value="@Model.Search.SampleType" />
    <input type="hidden" name="ReceiptType" value="@Model.Search.ReceiptType" />
    <div class="field">
        <label>Facility</label>
        <select name="Facility">
            @foreach (var facility in new[] { "WP", "EBS", "All" })
            {
                <option value="@facility" selected="@(Model.Search.Facility == facility ? "selected" : null)">@facility</option>
            }
        </select>
    </div>
    @if (string.Equals(Model.Search.DateFilter, "today", StringComparison.OrdinalIgnoreCase) || !string.IsNullOrWhiteSpace(Model.Search.SampleType))
    {
        <div class="notice">
            Showing @Model.Search.SampleType receipts for @Model.Search.DateFilter.
            <a class="inline-action" href="/Receipts?Facility=@Model.Search.Facility">Clear dashboard filter</a>
        </div>
    }
    <div class="field">
        <label>Crop Year</label>
        <select name="CropYear">
            @foreach (var year in Model.AvailableCropYears)
            {
                <option value="@year" selected="@(!Model.Search.AllCropYears && Model.Search.CropYear == year ? "selected" : null)">@year</option>
            }
        </select>
    </div>
    @if (canEditReceipts)
    {
        <label class="checkbox-field"><input type="checkbox" name="AllCropYears" value="true" checked="@Model.Search.AllCropYears" /> All crop years</label><input type="hidden" name="AllCropYears" value="false" />
    }
    <div class="field"><label>Receipt ID</label><input name="ReceiptId" value="@Model.Search.ReceiptId" /></div>
    <div class="field"><label>Grower</label><input name="Grower" value="@Model.Search.Grower" /></div>
    <div class="field"><label>Lot</label><input name="Lot" value="@Model.Search.Lot" /></div>
    <div class="field">
        <label>Warehouse</label>
        <select id="searchWarehouseId" name="WarehouseId">
            <option value="">All</option>
            @foreach (var item in Model.Warehouses)
            {
                <option value="@item.Id" selected="@(Model.Search.WarehouseId == item.Id ? "selected" : null)">@item.Code</option>
            }
        </select>
    </div>
    <div class="field">
        <label>Room</label>
        <select id="searchRoomId" name="RoomId" data-selected-room-id="@Model.Search.RoomId">
            <option value="">All</option>
        </select>
    </div>
    <button type="submit">Search</button>
    <a class="button secondary-button" href="/Receipts/Export">Export Receiving Data to Excel</a>
</form>
<p class="muted">@Model.CropYearHelpText</p>

<nav class="type-tabs" aria-label="Receipt type filter">
    @foreach (var tab in Model.ReceiptTypeCounts)
    {
        var isActive = string.Equals(Model.Search.ReceiptType, tab.Key, StringComparison.OrdinalIgnoreCase)
            || (tab.Key == "All" && string.IsNullOrWhiteSpace(Model.Search.ReceiptType));
        <a class="type-tab @(isActive ? "active" : "")" href="@tab.Href">
            <span>@tab.Label</span>
            <strong>@tab.Count</strong>
        </a>
    }
</nav>

@if (canEditReceipts)
{
<h2>Add Receipt</h2>
<form class="toolbar" method="post" action="/Receipts/Create">
    <div class="field"><label>Crop Year</label><input name="CropYear" value="@Model.CurrentCropYear" required /></div>
    <div class="field"><label>Received At (Pacific)</label><input name="ReceivedAt" type="datetime-local" value="@BusinessTime.FormatPacificInput(BusinessTime.UtcNow)" required /></div>
    <div class="field"><label>Receipt ID</label><input name="CompuTechReceiptId" required /></div>
    <div class="field"><label>Receipt Type</label><select name="ReceiptType"><option selected="@IsReceiptTypeSelected("Truck receipt")">Truck receipt</option><option selected="@IsReceiptTypeSelected("Door sample")">Door sample</option><option selected="@IsReceiptTypeSelected("Lot sample")">Lot sample</option></select></div>
    <div class="field"><label>Warehouse</label><select id="addWarehouseId" name="WarehouseId" required><option value="">Select</option>@foreach (var item in Model.Warehouses){<option value="@item.Id">@item.Code</option>}</select></div>
    <div class="field"><label>Room</label><select id="addRoomId" name="RoomId" required disabled><option value="">Select warehouse first</option></select></div>
    <div class="field wide">
        <label for="receiptVarietySearch">Variety code or name</label>
        <input id="receiptVarietySearch" type="search" autocomplete="off" placeholder="Type BART, ORBA, or a variety name" />
        <select id="receiptFruitProfileId" name="FruitProfileId" required>
            <option value="">Select a variety</option>
            @foreach (var item in Model.FruitProfiles.OrderBy(x => x.VarietyCode))
            {
                var organic = item.IsOrganic ? "Organic" : "Conventional";
                var identity = string.Equals(item.ProductionType?.Trim(), organic, StringComparison.OrdinalIgnoreCase) || string.IsNullOrWhiteSpace(item.ProductionType)
                    ? organic : $"{item.ProductionType.Trim()} - {organic}";
                <option value="@item.Id" data-search="@($"{item.VarietyCode} {item.Name} {item.ProductionType} {organic}".ToLowerInvariant())">@item.VarietyCode - @item.Name - @identity</option>
            }
        </select>
        <small>Search is case-insensitive and active profiles are shown code-first.</small>
    </div>
    <div class="field wide"><label>Grower Lot</label><select id="addGrowerLotId" name="GrowerLotId"><option value="">Manual entry</option>@foreach (var lot in Model.GrowerLots){<option value="@lot.Id" data-grower="@lot.Grower" data-lot="@lot.LotNumber">@lot.Grower - @lot.LotNumber</option>}</select></div>
    <div class="field"><label>Grower</label><input name="GrowerName" required /></div>
    <div class="field"><label>Lot #</label><input id="addGrowerNumber" name="GrowerNumber" maxlength="50" list="growerLotOptions" required /></div>
    <datalist id="growerLotOptions">
        @foreach (var lot in Model.GrowerLots)
        {
            <option value="@lot.LotNumber" label="@lot.Grower - @lot.LotNumber"></option>
        }
    </datalist>
    <div class="field"><label>Bin Count</label><input name="BinCount" type="number" min="0" required /></div>
    <label class="checkbox-field"><input type="checkbox" name="ConfirmCropYear" value="true" /> Confirm Crop Year</label><input type="hidden" name="ConfirmCropYear" value="false" />
    <button type="submit" disabled="@(!hasRequiredMasterData)">Add Receipt</button>
</form>

@if (Model.CanQuickAddVariety)
{
    <details class="notice" id="quickAddVarietyPanel">
        <summary><strong>Add Variety</strong></summary>
        <form class="toolbar" id="quickAddVarietyForm" method="post" action="/Receipts/Varieties/QuickAdd">
            @Html.AntiForgeryToken()
            <div class="field"><label>Variety Code</label><input name="Code" maxlength="50" required /></div>
            <div class="field"><label>Variety Name</label><input name="Name" maxlength="200" required /></div>
            <div class="field"><label>Commodity / Fruit Type</label><input name="FruitType" maxlength="100" required /></div>
            <div class="field"><label>Production Type</label><select name="ProductionType"><option>Conventional</option><option>Organic</option></select></div>
            <label class="checkbox-field"><input type="checkbox" name="IsActive" value="true" checked /> Active</label><input type="hidden" name="IsActive" value="false" />
            <button type="submit">Create and select variety</button>
            <span id="quickAddVarietyStatus" class="muted" role="status"></span>
        </form>
    </details>
}

@await Html.PartialAsync("_DeviceCapturePanel", new DeviceCapturePanelViewModel(
    Model.DeviceCapture,
    ShowTruckPhotos: true,
    ShowApplePhotos: true,
    ShowScale: true,
    RequiresSavedTargetMessage: "Save the receipt first to attach photos."))
}
<p class="muted">If the received date falls in an overlap window, confirm the crop year before saving.</p>
<p id="growerLotWarning" class="notice warning" hidden>Lot # not found in Master Data. Add it under Master Data &rarr; Grower Lots or continue as manual entry.</p>

<h2>Receipt Results</h2>
<div class="receipt-result-grid">
@foreach (var receipt in Model.Receipts)
{
    var receiptVarieties = receipt.Varieties ?? Array.Empty<VarietyBinPresentationViewModel>();
    <article class="receipt-card receipt-card-colored @(receipt.IsOrganic == true ? "organic" : "")" style="--receipt-variety-bg: @BuildVarietyBandBackground(receiptVarieties)">
        <div class="receipt-card-content">
        <div class="receipt-card-main">
            <div>
                <h3><a href="/Receipts/@receipt.Id">@receipt.CompuTechReceiptId</a></h3>
                <p class="muted">@BusinessTime.FormatPacific(receipt.ReceivedAt) | Crop Year @receipt.CropYear | @receipt.Warehouse / @receipt.Room</p>
            </div>
            <div class="action-bar receipt-actions">
                <a class="button secondary-button" href="/Receipts/@receipt.Id">View receipt</a>
                <a class="button secondary-button" href="/Receipts/@receipt.Id#add-sample">Add sample</a>
                <a class="button secondary-button" href="/Receipts/@receipt.Id#samples">View samples</a>
            </div>
        </div>
        <dl class="receipt-card-meta">
            <dt>Grower</dt><dd>@receipt.GrowerName</dd>
            <dt>Receipt Type</dt><dd>@receipt.ReceiptType</dd>
            <dt>Lot #</dt><dd>@(string.IsNullOrWhiteSpace(receipt.GrowerNumber) ? "-" : receipt.GrowerNumber)</dd>
            <dt>Variety</dt><dd>
                @foreach (var variety in receiptVarieties)
                {
                    <span class="receipt-variety-label"><i style="background: @variety.HexColor"></i>@variety.DisplayName — @IdentityLabel(variety.ProductionType, variety.OrganicLabel)@($" · {variety.BinCount:N0} bins")</span>
                }
            </dd>
            <dt>Bins</dt><dd>@receipt.BinCount</dd>
            <dt>Samples</dt><dd>@receipt.SampleCount</dd>
            <dt>QC Status</dt><dd>@receipt.QcStatus</dd>
            <dt>Last Updated</dt><dd>@BusinessTime.FormatPacific(receipt.LastUpdatedAt, empty: "-")</dd>
        </dl>
        </div>
    </article>
}
</div>

@functions {
    private static string IdentityLabel(string? productionType, string organicLabel) =>
        string.IsNullOrWhiteSpace(productionType) || string.Equals(productionType, organicLabel, StringComparison.OrdinalIgnoreCase)
            ? organicLabel
            : $"{productionType} · {organicLabel}";

    private bool IsReceiptTypeSelected(string receiptType)
    {
        var selected = string.IsNullOrWhiteSpace(Model.Search.ReceiptType) ? "Truck receipt" : Model.Search.ReceiptType;
        return string.Equals(selected, receiptType, StringComparison.OrdinalIgnoreCase);
    }

    private static string BuildVarietyBandBackground(IReadOnlyList<VarietyBinPresentationViewModel> varieties)
    {
        if (varieties.Count == 0) return "#E7ECEF";
        if (varieties.Count == 1) return varieties[0].HexColor;
        var total = varieties.Sum(x => Math.Max(0, x.BinCount));
        var offset = 0m;
        var stops = new List<string>();
        foreach (var variety in varieties)
        {
            var share = total > 0 ? Math.Max(0, variety.BinCount) / (decimal)total * 100m : 100m / varieties.Count;
            var end = offset + share;
            stops.Add($"{variety.HexColor} {offset:0.###}% {end:0.###}%");
            offset = end;
        }
        return $"linear-gradient(110deg, {string.Join(", ", stops)})";
    }
}

<script>
    (() => {
        const rooms = @Html.Raw(roomOptionsJson);
        const growerLots = @Html.Raw(growerLotsJson);
        const varietySearch = document.getElementById("receiptVarietySearch");
        const varietySelect = document.getElementById("receiptFruitProfileId");
        if (varietySearch && varietySelect) {
            const allOptions = Array.from(varietySelect.options).slice(1);
            varietySearch.addEventListener("input", () => {
                const query = varietySearch.value.trim().toLowerCase();
                for (const option of allOptions) {
                    option.hidden = query.length > 0 && !option.dataset.search.includes(query);
                }
                const matches = allOptions.filter(option => !option.hidden);
                if (matches.length === 1) varietySelect.value = matches[0].value;
            });
        }

        const quickAddForm = document.getElementById("quickAddVarietyForm");
        if (quickAddForm && varietySelect && varietySearch) {
            quickAddForm.addEventListener("submit", async event => {
                event.preventDefault();
                const status = document.getElementById("quickAddVarietyStatus");
                status.textContent = "Creating...";
                const response = await fetch(quickAddForm.action, {
                    method: "POST",
                    body: new FormData(quickAddForm),
                    credentials: "same-origin"
                });
                const result = await response.json().catch(() => ({}));
                if (!response.ok) {
                    status.textContent = result.error || "Variety could not be created.";
                    return;
                }
                const option = new Option(result.label, result.id, true, true);
                option.dataset.search = result.label.toLowerCase();
                varietySelect.add(option);
                varietySearch.value = result.label.split(" - ")[0];
                status.textContent = result.label + " was created and selected.";
                quickAddForm.reset();
            });
        }

        function configureRoomFilter(warehouseSelectId, roomSelectId, emptyText, resetOnWarehouseChange) {
            const warehouseSelect = document.getElementById(warehouseSelectId);
            const roomSelect = document.getElementById(roomSelectId);
            if (!warehouseSelect || !roomSelect) {
                return;
            }

            function populateRoomOptions(keepSelection) {
                const warehouseId = Number(warehouseSelect.value);
                const selectedRoomId = keepSelection ? roomSelect.dataset.selectedRoomId : "";
                roomSelect.innerHTML = "";

                const defaultOption = document.createElement("option");
                defaultOption.value = "";
                defaultOption.textContent = warehouseId ? emptyText : "Select warehouse first";
                roomSelect.appendChild(defaultOption);

                if (!warehouseId) {
                    roomSelect.value = "";
                    roomSelect.disabled = true;
                    roomSelect.dataset.selectedRoomId = "";
                    return;
                }

                for (const room of rooms.filter(item => item.warehouseId === warehouseId)) {
                    const option = document.createElement("option");
                    option.value = room.id;
                    const prefix = room.subLocation ? `${room.subLocation} — ` : "";
                    const legacy = room.compuTech ? ` (Compu-Tech: ${room.compuTech})` : "";
                    option.textContent = `${prefix}${room.code}${legacy}`;
                    if (selectedRoomId && Number(selectedRoomId) === room.id) {
                        option.selected = true;
                    }

                    roomSelect.appendChild(option);
                }

                roomSelect.disabled = false;
                if (!keepSelection || !Array.from(roomSelect.options).some(option => option.selected && option.value)) {
                    roomSelect.value = "";
                }

                roomSelect.dataset.selectedRoomId = roomSelect.value;
            }

            populateRoomOptions(true);
            warehouseSelect.addEventListener("change", () => {
                if (resetOnWarehouseChange) {
                    roomSelect.dataset.selectedRoomId = "";
                }

                populateRoomOptions(false);
            });
        }

        configureRoomFilter("searchWarehouseId", "searchRoomId", "All", true);
        configureRoomFilter("addWarehouseId", "addRoomId", "Select", true);
        const growerLotSelect = document.getElementById("addGrowerLotId");
        const growerLotWarning = document.getElementById("growerLotWarning");
        const growerNumberInput = document.getElementById("addGrowerNumber");
        const growerNameInput = document.querySelector("input[name='GrowerName']");

        function fillGrowerLot(lot) {
            if (!lot) {
                return;
            }

            growerNameInput.value = lot.grower || "";
            growerNumberInput.value = lot.lot || "";
            growerLotSelect.value = lot.id || "";
            growerLotWarning.hidden = true;
        }

        growerLotSelect?.addEventListener("change", () => {
            const selected = growerLotSelect.selectedOptions[0];
            if (!selected || !selected.value) return;
            fillGrowerLot({ id: selected.value, grower: selected.dataset.grower || "", lot: selected.dataset.lot || "" });
        });
        growerNumberInput?.addEventListener("change", () => {
            const value = growerNumberInput.value.trim();
            if (!value) {
                growerLotWarning.hidden = true;
                return;
            }

            const matches = growerLots.filter(lot => (lot.lot || "").toLowerCase() === value.toLowerCase());
            if (matches.length === 1) {
                fillGrowerLot(matches[0]);
                return;
            }

            growerLotSelect.value = "";
            growerLotWarning.textContent = matches.length > 1
                ? `Lot # ${value} matches multiple Grower Lots. Select the correct Grower Lot from the dropdown.`
                : "Lot # not found in Master Data. Add it under Master Data -> Grower Lots or continue as manual entry.";
            growerLotWarning.hidden = false;
        });
    })();
</script>
