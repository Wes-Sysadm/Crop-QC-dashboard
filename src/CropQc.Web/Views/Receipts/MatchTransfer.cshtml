@model TruckReceiptPage
@using CropQc.Data.Entities
@{
    ViewData["Title"] = "Truck Receipt reconciliation";
    var receipt = Model.Receipt;
    var transfer = Model.Transfer;
    var receiptLines = receipt?.VarietyLines.OrderBy(x => x.Id).ToList() ?? [];
}
<h1>Truck Receipt reconciliation</h1>
@if (!Model.WritesEnabled && transfer is not { RequiresTruckReceipt: false }) { <p class="notice warning">@TruckReceiptOptions.DisabledMessage</p> }
@if (TempData["Error"] is string error) { <p class="notice warning" role="alert">@error</p> }
@if (TempData["Success"] is string success) { <p class="notice success" role="status">@success</p> }
@if (Model.Error is not null) { <p class="notice warning">@Model.Error</p> }
@if (receipt is not null)
{
    <p><a href="/Receipts/@receipt.Id">Truck Receipt @receipt.CompuTechReceiptId</a> · @receipt.Warehouse.Code · @receipt.BinCount bins</p>
}
@if (transfer is not null)
{
    <h2><a href="/BinsRun/InterCrewTransfers/@transfer.Id">Transfer #@transfer.Id</a></h2>
    <p>@transfer.SourceWarehouse.Code → @(transfer.DestinationCustodyGroup == TransferCustodyGroups.WpDh ? "WP side (WP / DH / McDougall)" : "EBS") · @BusinessTime.FormatPacific(transfer.LoadedAt) · @transfer.BinsLoaded bins</p>
}
<p class="notice"><strong>@Model.Status</strong></p>
@if (receipt is { IsTransferReceipt: true, TransferCompletedAt: null } && transfer is null)
{
    <h2>Match Transfer</h2>
    <p>Select the correct load yourself. Quantities may differ; reconciliation follows selection.</p>
    @if (Model.Candidates.Count == 0) { <p>No compatible pending transfers for this destination and crop/variety. Correct the receipt varieties if needed.</p> }
    @foreach (var candidate in Model.Candidates)
    {
        <form method="post" action="/Receipts/@receipt.Id/MatchTransfer" class="subpanel">
            @Html.AntiForgeryToken()
            <input type="hidden" name="TransferId" value="@candidate.Id" />
            <input type="hidden" name="TransferVersion" value="@candidate.ConcurrencyVersion" />
            <input type="hidden" name="ReceiptVersion" value="@receipt.ConcurrencyVersion" />
            <p><a href="/BinsRun/InterCrewTransfers/@candidate.Id/Reconciliation">Transfer #@candidate.Id</a> · @candidate.SourceWarehouse.Code / @candidate.SourceRoom.Code → @(candidate.DestinationCustodyGroup == TransferCustodyGroups.WpDh ? "WP side (WP / DH / McDougall)" : "EBS") · @BusinessTime.FormatPacific(candidate.LoadedAt) · @Model.CandidateVarieties.GetValueOrDefault(candidate.Id) · @candidate.BinsLoaded bins · @candidate.TruckLoadBolNumber</p>
            <button type="submit" disabled="@(!Model.CanEditReceipt)">Select Transfer #@candidate.Id</button>
        </form>
    }
}
@if (receipt is not null && transfer is not null)
{
    <div class="table-wrap"><table><thead><tr><th>Variety</th><th>Transfer</th><th>Receipt</th><th>Difference (receipt − transfer)</th></tr></thead><tbody>
        @foreach (var row in Model.Comparison) { <tr><td>@row.Variety</td><td>@row.Transfer</td><td>@row.Receipt</td><td>@row.Difference.ToString("+#;-#;0")</td></tr> }
        <tr><th>Total</th><th>@Model.Comparison.Sum(x => x.Transfer)</th><th>@Model.Comparison.Sum(x => x.Receipt)</th><th>@Model.Comparison.Sum(x => x.Difference).ToString("+#;-#;0")</th></tr>
    </tbody></table></div>
    @if (!Model.IsReconciled)
    {
        <p class="notice warning">@(Model.Comparison.Sum(x => x.Difference) == 0 ? "Totals match, but varieties do not." : "Transfer and receipt totals differ.") Receipt cannot be completed until the transfer and receipt match exactly. Correct the underlying record; no override is available.</p>
    }
    @if (receipt.TransferCompletedAt is null && Model.CanEditReceipt && Model.Acknowledgments.Count == 0)
    {
        <form method="post" action="/Receipts/@receipt.Id/CompleteTransfer">
            @Html.AntiForgeryToken()
            <input type="hidden" name="TransferId" value="@transfer.Id" /><input type="hidden" name="TransferVersion" value="@transfer.ConcurrencyVersion" /><input type="hidden" name="ReceiptVersion" value="@receipt.ConcurrencyVersion" />
            <button type="submit" disabled="@(!Model.IsReconciled)">Complete Receipt</button>
        </form>
    }
    @if (receipt.TransferCompletedAt is null && Model.CanEditReceipt && Model.SupportsReceiptCustody)
    {
        <h2>Acknowledge arrived allocations</h2>
        <p>Identify the original allocations that arrived. Acknowledged bins remain held by this receipt until room placement. Missing bins stay unresolved under this transfer.</p>
        <form method="post" action="/Receipts/@receipt.Id/AcknowledgeTransfer">
            @Html.AntiForgeryToken()
            <input type="hidden" name="TransferId" value="@transfer.Id" /><input type="hidden" name="TransferVersion" value="@transfer.ConcurrencyVersion" /><input type="hidden" name="ReceiptVersion" value="@receipt.ConcurrencyVersion" />
            @for (var i = 0; i < Model.Allocations.Count; i++)
            {
                var allocation = Model.Allocations[i];
                var source = allocation.Movement.SourceSegment!;
                <div class="subpanel">
                    <input type="hidden" name="Allocations[@i].Id" value="@allocation.Movement.Id" />
                    <label>Allocation @allocation.Movement.Id · Origin receipt @allocation.Movement.ReceiptId · @(allocation.Canonical?.Identity.Lot ?? source.LotNumberSnapshot) / @(allocation.Canonical?.Identity.Variety ?? source.VarietyCodeSnapshot) / @(allocation.Canonical?.TreatmentState ?? source.TreatmentState) · @allocation.Bins unresolved
                        <input type="number" name="Allocations[@i].Quantity" min="0" max="@allocation.Bins" value="0" />
                    </label>
                    @foreach (var link in source.Applications.OrderBy(x => x.Sequence))
                    {
                        <p>@link.RoomTreatmentApplication.ProductNameSnapshot · @BusinessTime.FormatPacific(link.RoomTreatmentApplication.AppliedAt) @(link.RoomTreatmentApplication.ReversedAt != null ? "(reversed)" : "")</p>
                    }
                </div>
            }
            <label>Receiving evidence / note<input name="Reason" required maxlength="1000" /></label>
            <button type="submit" disabled="@(Model.Allocations.Count == 0)">Acknowledge selected bins</button>
        </form>
        @if (Model.ReceiptHeldBins > 0)
        {
            <h2>Place receipt-held bins</h2>
            <p>Place only the selected held quantity in the receipt's destination room. Prior placements will not be repeated.</p>
            var held = Model.Acknowledgments.Where(x => x.HeldQuantity > 0).ToList();
            <form method="post" action="/Receipts/@receipt.Id/PlaceTransferCustody">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TransferId" value="@transfer.Id" /><input type="hidden" name="TransferVersion" value="@transfer.ConcurrencyVersion" /><input type="hidden" name="ReceiptVersion" value="@receipt.ConcurrencyVersion" />
                @for (var i = 0; i < held.Count; i++)
                {
                    var allocation = held[i];
                    var remaining = allocation.HeldQuantity;
                    <input type="hidden" name="Allocations[@i].Id" value="@allocation.Id" />
                    <label>Acknowledgement @allocation.Id · Original dispatch lot/variety @allocation.DispatchMovement.SourceSegment!.LotNumberSnapshot / @allocation.DispatchMovement.SourceSegment.VarietyCodeSnapshot · @remaining held
                        <input type="number" name="Allocations[@i].Quantity" min="0" max="@remaining" value="0" />
                    </label>
                }
                <label>Destination room<select name="DestinationRoomId" required>
                    @foreach (var room in Model.PlacementRooms) { <option value="@room.Id" selected="@(room.Id == receipt.RoomId)">@room.Code</option> }
                </select></label>
                <label>Placement note<input name="Reason" required maxlength="1000" /></label>
                <button type="submit">Place selected bins</button>
            </form>
        }
    }
    @if (Model.SupportsReceiptCustody && Model.Acknowledgments.Count > 0)
    {
        <h2>Custody and corrections</h2>
        <p>@transfer.BinsLoaded dispatched · @Model.AcknowledgedBins acknowledged · @Model.PlacedBins placed · @Model.ReceiptHeldBins held · @Model.UnresolvedBins unresolved</p>
        <p>Reversing an acknowledgement records bins as unresolved on this load. It does not return physical inventory to the source. To correct an allocation, reverse its held acknowledgement, then select the exact allocation that arrived.</p>
        @foreach (var ack in Model.Acknowledgments)
        {
            <details class="subpanel"><summary>Acknowledgement @ack.Id · original @ack.Quantity · current @ack.NetQuantity · held @ack.HeldQuantity</summary>
            <p>Dispatch allocation @ack.DispatchMovementId · lot @ack.DispatchMovement.SourceSegment?.LotNumberSnapshot · @ack.DispatchMovement.TreatmentStateSnapshot · @ack.DispatchMovement.TreatmentSignatureSnapshot</p>
            @if (Model.CanEditReceipt && ack.HeldQuantity > 0)
            {
                <form method="post" action="/Receipts/@receipt.Id/ReverseAcknowledgment">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="TransferId" value="@transfer.Id" /><input type="hidden" name="TransferVersion" value="@transfer.ConcurrencyVersion" /><input type="hidden" name="ReceiptVersion" value="@receipt.ConcurrencyVersion" />
                    <input type="hidden" name="Allocations[0].Id" value="@ack.Id" />
                    <label>Held bins recorded in error<input type="number" name="Allocations[0].Quantity" min="1" max="@ack.HeldQuantity" required /></label>
                    <label>Correction reason<input name="Reason" required maxlength="1000" /></label>
                    <button type="submit">Reverse held acknowledgement</button>
                </form>
            }
            @foreach (var placement in ack.Placements)
            {
                var remaining = placement.Quantity - ack.Reversals.Where(x => x.PlacementId == placement.Id).Sum(x => x.Quantity);
                <p>Placement @placement.Id · room @placement.InventoryAdjustment.RoomId · original @placement.Quantity · current @remaining</p>
                @if (Model.CanEditReceipt && remaining > 0)
                {
                    <form method="post" action="/Receipts/@receipt.Id/ReversePlacement">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TransferId" value="@transfer.Id" /><input type="hidden" name="TransferVersion" value="@transfer.ConcurrencyVersion" /><input type="hidden" name="ReceiptVersion" value="@receipt.ConcurrencyVersion" />
                        <input type="hidden" name="Allocations[0].Id" value="@placement.Id" />
                        <label>Untouched bins to return to receipt-held custody<input type="number" name="Allocations[0].Quantity" min="1" max="@remaining" required /></label>
                        <label>Correction reason<input name="Reason" required maxlength="1000" /></label>
                        <p>This requires proven custody in the original placement room. Later movement, treatment or consumption blocks this action; use the corresponding inventory resolution workflow first.</p>
                        <button type="submit">Undo proven placement</button>
                    </form>
                }
            }
            @foreach (var correction in ack.Reversals)
            { <p>Correction @correction.Id · @(correction.PlacementId == null ? "acknowledgement" : $"placement {correction.PlacementId}") · @correction.Quantity bins · @BusinessTime.FormatPacific(correction.ReversedAt) · @correction.Reason</p> }
            </details>
        }
    }
    @if (Model.CanAdmin && Model.Acknowledgments.Count == 0)
    {
        <details><summary>Reopen / Unlink Transfer Receipt</summary><p>Completed inventory returns to In Transit only if no subsequent activity makes reversal unsafe. Original history is retained.</p>
        <form method="post" action="/Receipts/@receipt.Id/ReopenTransfer">
            @Html.AntiForgeryToken()
            <input type="hidden" name="TransferId" value="@transfer.Id" /><input type="hidden" name="TransferVersion" value="@transfer.ConcurrencyVersion" /><input type="hidden" name="ReceiptVersion" value="@receipt.ConcurrencyVersion" />
            <label>Reason<input name="Reason" required maxlength="1000" /></label><button type="submit">Reopen / Unlink Transfer Receipt</button>
        </form></details>
    }
}
@if (receipt is { IsTransferReceipt: true, TransferCompletedAt: null } && Model.CanEditReceipt)
{
    <h2>Edit receipt varieties</h2>
    <p>Enter the received quantity for each variety. Use zero and an empty variety only for unused rows.</p>
    <form method="post" action="/Receipts/@receipt.Id/TransferVarieties">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ReceiptVersion" value="@receipt.ConcurrencyVersion" />
        <div class="table-wrap"><table><thead><tr><th>Variety</th><th>Receipt bins</th></tr></thead><tbody>
        @for (var i = 0; i < receiptLines.Count + 3; i++)
        {
            var line = i < receiptLines.Count ? receiptLines[i] : null;
            <tr><td><select name="Lines[@i].FruitProfileId" aria-label="Variety @(i + 1)"><option value="0">Unused</option>@foreach (var profile in Model.Profiles) { <option value="@profile.Id" selected="@(line?.FruitProfileId == profile.Id)">@profile.VarietyCode — @profile.Name (@profile.ProductionType)</option> }</select></td><td><input type="number" min="0" name="Lines[@i].BinCount" value="@(line?.BinCount ?? 0)" aria-label="Received bins @(i + 1)" /></td></tr>
        }
        </tbody></table></div><button type="submit">Save receipt quantities</button>
    </form>
}
@if (transfer?.Status == InterCrewTransferStatuses.InTransit && Model.CanEditTransfer && Model.Acknowledgments.Count == 0)
{
    <h2>In Transit allocations</h2>
    <p>Adding bins removes available source inventory. Removing bins restores only the selected allocation to its original source.</p>
    @foreach (var allocation in Model.Allocations)
    {
        var source = allocation.Movement.SourceSegment!;
        <form method="post" action="/BinsRun/InterCrewTransfers/@transfer.Id/EditTransit" class="subpanel">
            @Html.AntiForgeryToken()
            <input type="hidden" name="TransferVersion" value="@transfer.ConcurrencyVersion" /><input type="hidden" name="DispatchMovementId" value="@allocation.Movement.Id" />
            <p>@(allocation.CurrentGrowerName ?? source.GrowerNameSnapshot) / @(allocation.Canonical?.Identity.Lot ?? source.LotNumberSnapshot) / @(allocation.Canonical?.Identity.Variety ?? source.VarietyCodeSnapshot) / @(allocation.Canonical?.TreatmentState ?? source.TreatmentState) — @allocation.Bins bins</p>
            <label>Bins to return<input type="number" name="Bins" min="1" max="@allocation.Bins" required /></label><label>Reason<input name="Reason" required maxlength="1000" /></label><button type="submit">Return selected bins to source</button>
        </form>
    }
    <details><summary>Add source inventory to this load</summary>
    @foreach (var item in Model.Available)
    {
        <form method="post" action="/BinsRun/InterCrewTransfers/@transfer.Id/EditTransit" class="subpanel">
            @Html.AntiForgeryToken()
            <input type="hidden" name="TransferVersion" value="@transfer.ConcurrencyVersion" /><input type="hidden" name="SourceKey" value="@item.SourceKey" /><input type="hidden" name="ExpectedAvailableBins" value="@item.AvailableBins" />
            <p>@item.GrowerName / @item.LotNumber / @item.VarietyCode — @item.AvailableBins available</p>
            <label>Bins to add<input type="number" name="Bins" min="1" max="@item.AvailableBins" required /></label><label>Reason<input name="Reason" required maxlength="1000" /></label><button type="submit">Add bins to In Transit</button>
        </form>
    }
    </details>
}
