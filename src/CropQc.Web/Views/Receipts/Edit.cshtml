@model EditReceiptPageViewModel
@using System.Text.Json
@inject CropQc.Data.Inventory.CanonicalInventoryMode CanonicalMode
@{
    ViewData["Title"] = "Edit Receipt";
    var form = Model.Form;
    var original = Model.OriginalForm ?? form;
    var submitted = form as AdminReceiptInventoryOverrideForm;
    string FieldValue(string name, object? value) => ViewData.ModelState.TryGetValue(name, out var entry) && entry.AttemptedValue != null
        ? entry.AttemptedValue : Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture) ?? "";
    var roomOptionsJson = JsonSerializer.Serialize(Model.Rooms.Select(x => new { id = x.Id, warehouseId = x.WarehouseId, code = x.CropQcRoomName ?? x.DisplayName ?? x.Code, name = x.DisplayName ?? x.Name, subLocation = x.SubLocation ?? "", compuTech = x.CompuTechRoomCode ?? "", isSealed = x.IsSealed }));
    var growerLotsJson = JsonSerializer.Serialize(Model.GrowerLots.Select(x => new { id = x.Id, grower = x.Grower, lot = x.LotNumber, label = $"{x.Grower} - {x.LotNumber}" }));
}

<h1>Edit Receipt</h1>
@if (Model.DataWarning is not null)
{
    <p class="notice warning">@Model.DataWarning</p>
}
@if (TempData["Error"] is string error)
{
    <p class="notice warning">@error</p>
}

<section class="panel">
    <form class="form-grid" method="post" action="/Receipts/@form.Id/Edit">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@form.Id" />
        <input type="hidden" name="ReceiptVersion" value="@form.ReceiptVersion" />
        <input type="hidden" name="OperationKey" value="@form.OperationKey" />
        <input type="hidden" name="ConfirmInventoryChange" value="true" />
        @Html.ValidationSummary(false, "", new { @class = "notice warning wide" })
        <div class="field wide"><label for="editReason">Reason</label><textarea id="editReason" name="Reason" required maxlength="1000">@form.Reason</textarea></div>
        <div class="field"><label>Crop Year</label><input name="CropYear" value="@FieldValue("CropYear", form.CropYear)" required /></div>
        <div class="field"><label>Received At (Pacific)</label><input name="ReceivedAt" type="datetime-local" value="@FieldValue("ReceivedAt", BusinessTime.FormatPacificInput(form.ReceivedAt))" required /></div>
        <div class="field"><label>Receipt ID</label><input name="CompuTechReceiptId" value="@FieldValue("CompuTechReceiptId", form.CompuTechReceiptId)" required /></div>
        <div class="field">
            <label>Receipt Type</label>
            <select name="ReceiptType">
                @if (!new[] { "Truck receipt", "Door sample", "Lot sample" }.Contains(form.ReceiptType))
                {
                    <option selected="selected">@form.ReceiptType</option>
                }
                @foreach (var type in new[] { "Truck receipt", "Door sample", "Lot sample" })
                {
                    <option selected="@(form.ReceiptType == type ? "selected" : null)">@type</option>
                }
            </select>
        </div>
        <div class="field">
            <label>Warehouse</label>
            <select id="editWarehouseId" name="WarehouseId" required>
                @foreach (var item in Model.Warehouses)
                {
                    <option value="@item.Id" selected="@(form.WarehouseId == item.Id ? "selected" : null)">@item.Code</option>
                }
            </select>
        </div>
        <div class="field">
            <label>Room</label>
            <select id="editRoomId" name="RoomId" data-selected-room-id="@form.RoomId" required></select>
        </div>
        <div class="field">
            <label>Variety</label>
            <select name="FruitProfileId" required>
                @foreach (var item in Model.FruitProfiles)
                {
                    <option value="@item.Id" selected="@(form.FruitProfileId == item.Id ? "selected" : null)">@item.VarietyCode - @item.Name</option>
                }
            </select>
        </div>
        <div class="field wide">
            <label>Grower Lot</label>
            <select id="editGrowerLotId" name="GrowerLotId">
                <option value="">Manual entry</option>
                @foreach (var lot in Model.GrowerLots)
                {
                    <option value="@lot.Id" data-grower="@lot.Grower" data-lot="@lot.LotNumber" selected="@(form.GrowerLotId == lot.Id ? "selected" : null)">@lot.LotNumber - @lot.Grower</option>
                }
            </select>
        </div>
        <div class="field"><label>Grower</label><input name="GrowerName" value="@FieldValue("GrowerName", form.GrowerName)" required /></div>
        <div class="field"><label>Lot #</label><input id="editGrowerNumber" name="GrowerNumber" value="@FieldValue("GrowerNumber", form.GrowerNumber)" maxlength="50" list="editGrowerLotOptions" required /></div>
        <datalist id="editGrowerLotOptions">
            @foreach (var lot in Model.GrowerLots)
            {
                <option value="@lot.LotNumber" label="@lot.LotNumber - @lot.Grower"></option>
            }
        </datalist>
        <div class="field"><label>Bin Count</label><input id="editBinCount" name="BinCount" type="number" min="0" inputmode="numeric" value="@FieldValue("BinCount", form.BinCount)" data-saved-bin-count="@form.BinCount" required /></div>
        <label class="checkbox-field"><input type="checkbox" name="ConfirmCropYear" value="true" checked /> Confirm Crop Year</label><input type="hidden" name="ConfirmCropYear" value="false" />
        @if (Model.CanAdminOverride && Model.AdminOverridePreview is not null)
        {
            var preview = Model.AdminOverridePreview;
            @if (preview.CanonicalBlocker is not null)
            {
                <p class="notice warning">@preview.CanonicalBlocker</p>
            }
            <p class="notice wide">Save records your reason and the audited correction. Historical consumption, transfers and treatments remain unchanged. Different correction types must be saved separately.</p>
            <section id="adminInventoryOverride" class="panel wide receipt-bin-override-review"
                     data-original-bins="@original.BinCount" data-original-warehouse="@original.WarehouseId"
                     data-original-room="@original.RoomId" data-original-crop-year="@original.CropYear"
                     data-original-grower-lot="@original.GrowerLotId" data-original-grower-number="@original.GrowerNumber"
                     data-original-fruit-profile="@original.FruitProfileId">
                <h2 id="overrideReviewTitle">Current receipt evidence</h2>
                <p id="savedReceiptBinCountWarning" class="notice warning" hidden>The quantity change will be recorded as an audited correction.</p>
                <p id="savedReceiptIdentityWarning" class="notice warning" hidden>Changing the Grower/Lot identity of a saved Receipt requires an audited identity correction. Historical inventory operations will be retained, and the correction will proceed only when current inventory is safe.</p>
                @if (preview.HistoricalIdentityCorrectionIsZeroCurrent)
                {
                    <p class="notice">The original receipt position is already at zero. An identity correction will update the Receipt only and will not create, move, or restore inventory.</p>
                }
                @if (CanonicalMode.Enabled)
                {
                    var locations = preview.Balances.Where(x => x.RoomId > 0).GroupBy(x => new { x.WarehouseId, x.Warehouse, x.RoomId, x.Room }).ToArray();
                    <section id="receiptLocationReview">
                        <h3>Correct current inventory location</h3>
                        <p>Only the remaining bins at the selected source will move. Consumed bins, other rooms and external custody stay unchanged. Original receipt and movement evidence remains in the correction history.</p>
                        @if (locations.Length == 0)
                        {
                            <p class="notice warning">No current receipt inventory remains in a room. A location correction cannot create or recall inventory.</p>
                        }
                        else
                        {
                            <label for="correctionSourceRoom">Current receipt inventory to relocate</label>
                            <select id="correctionSourceRoom" name="CorrectionSourceRoomId">
                                <option value="">Use the only proven current room, or select a source</option>
                                @foreach (var location in locations)
                                {
                                    <option value="@location.Key.RoomId" selected="@(submitted?.CorrectionSourceRoomId == location.Key.RoomId ? "selected" : null)" data-bins="@location.Sum(x => x.CurrentBins)">@location.Key.Warehouse / @location.Key.Room — @location.Sum(x => x.CurrentBins) bins (@string.Join(", ", location.Select(x => x.InventoryStatus).Distinct()))</option>
                                }
                            </select>
                        }
                        <p><strong>Quantity to relocate:</strong> <span id="locationRelocatedBins">Select a source</span>. The Room field above is the destination.</p>
                    </section>
                }
                <p class="notice warning">This is an audited inventory operation, not a normal receipt edit. Historical runs and transfers will not be rewritten.</p>
                <dl class="summary-list">
                    <dt>Receipt</dt><dd id="overrideReceipt">@form.CompuTechReceiptId</dd>
                    <dt>Grower</dt><dd id="overrideGrower">@form.GrowerNumber - @form.GrowerName</dd>
                    <dt>Room</dt><dd id="overrideRoom">@(Model.Rooms.FirstOrDefault(x => x.Id == form.RoomId)?.CropQcRoomName ?? Model.Rooms.FirstOrDefault(x => x.Id == form.RoomId)?.DisplayName ?? Model.Rooms.FirstOrDefault(x => x.Id == form.RoomId)?.Code ?? "-")</dd>
                    <dt>Current bin count</dt><dd>@preview.ReceiptBinCount bins</dd>
                    <dt>New bin count</dt><dd><span id="overrideProposedBins">@preview.ReceiptBinCount</span> bins</dd>
                    <dt>Inventory adjustment</dt><dd><span id="overrideBinDelta">0</span> bins</dd>
                    <dt>Removed from selected current inventory</dt><dd><span id="overrideRemovedBins">0</span> bins</dd>
                    <dt>Current attributable inventory</dt><dd>@preview.CurrentInventory bins</dd>
                    @if (preview.OriginalRecordedBins is int originalRecorded)
                    { <dt>Original recorded receipt quantity</dt><dd>@originalRecorded bins</dd> }
                    <dt>Receipt quantity outside proven current custody (review history below)</dt><dd>@preview.ConsumedBins bins</dd>
                    <dt>Current receipt inventory in other rooms/custody (already moved, not consumed)</dt><dd>@preview.Balances.Where(x => x.RoomId != form.RoomId).Sum(x => x.CurrentBins) bins</dd>
                    <dt>Operational history</dt><dd>@preview.BinsRunCount Bins Run line(s), @preview.ActualRunCount Actual Run(s), @preview.TransferCount transfer(s)</dd>
                </dl>
                @if (preview.Balances.Count > 0)
                {
                    <table class="data-table"><thead><tr><th>Facility</th><th>Room</th><th>Crop year</th><th>Lot</th><th>Variety</th><th>Current bins</th></tr></thead><tbody>
                    @foreach (var balance in preview.Balances)
                    {
                        <tr><td>@balance.Warehouse</td><td>@balance.Room</td><td>@balance.CropYear</td><td>@balance.Lot</td><td>@balance.Variety</td><td>@balance.CurrentBins</td></tr>
                    }
                    </tbody></table>
                }
                @if (preview.RecordedMovements.Count > 0)
                {
                    <details><summary>Recorded receipt movements and consumption</summary>
                        <p>Business time and recorded time can differ. These events remain unchanged by a new quantity correction. Unassigned movements are not attributed to this receipt without proof.</p>
                        <table class="data-table"><thead><tr><th>Movement</th><th>Event</th><th>Bins</th><th>From room ID</th><th>To room ID</th><th>Treatment</th><th>Effective (UTC)</th><th>Recorded (UTC)</th></tr></thead><tbody>
                        @foreach (var movement in preview.RecordedMovements)
                        {
                            <tr><td>@movement.Id</td><td>@movement.Kind</td><td>@movement.Bins</td><td>@movement.SourceRoomId</td><td>@movement.DestinationRoomId</td><td>@movement.Treatment</td><td>@movement.EffectiveAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@movement.RecordedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td></tr>
                        }
                        </tbody></table>
                    </details>
                }
                <section id="positiveTrueUpAllocation" class="wide" hidden>
                    <h3>@(CanonicalMode.Enabled ? "Which current inventory should be corrected?" : "Where is the additional inventory now?")</h3>
                    <p>Allocate the quantity change to current inventory below. The original receiving room and historical movements will not be rewritten.</p>
                    <div id="additionalBinsTreatment" hidden>
                        <p>Added bins are recorded as untreated at the correction time. Selecting a treated allocation chooses its current location; its past treatments are not applied to the added bins.</p>
                        <label class="checkbox-field"><input type="checkbox" name="ConfirmAdditionalBinsUntreated" value="true" checked="@(submitted?.ConfirmAdditionalBinsUntreated == true ? "checked" : null)" /> I have verified that the additional bins are untreated. Their prior treatment history is not uncertain.</label>
                        <input type="hidden" name="ConfirmAdditionalBinsUntreated" value="false" />
                        <p class="muted">If these bins need an earlier treatment attribution, request evidence review before applying this correction.</p>
                    </div>
                    <p><strong>Current canonical inventory:</strong> @preview.CurrentCanonicalInventory bins</p>
                    @if (preview.TrueUpPositions.Count == 0)
                    {
                        <p class="notice warning">No current matching inventory or custody position was found. This true-up cannot be placed automatically.</p>
                        @if (preview.AdditionalStockTargets.Count > 0)
                        {
                            <div id="additionalStockDestination">
                            <p>An increase can record additional stock without recalling consumed bins. Existing dumps, movements and treatment applications stay unchanged. A decrease still requires proven current stock or a separately reviewed compensating operation.</p>
                            <label>Where are the additional bins now?
                                <select name="AdditionalStockTarget"><option value="">Select the actual current room</option>
                                    @foreach (var target in preview.AdditionalStockTargets)
                                    { <option value="@target.Key" selected="@(submitted?.AdditionalStockTarget == target.Key ? "selected" : null)">@target.RoomName</option> }
                                </select>
                            </label>
                            <label class="checkbox-field"><input type="checkbox" name="ConfirmAdditionalStockPresent" value="true" checked="@(submitted?.ConfirmAdditionalStockPresent == true ? "checked" : null)" /> These additional bins belong to this receipt and are physically present in the selected room. They are not bins already recorded as consumed or in another custody location.</label>
                            <input type="hidden" name="ConfirmAdditionalStockPresent" value="false" />
                            </div>
                        }
                    }
                    else
                    {
                        var eligiblePositions = preview.TrueUpPositions.Where(x => x.IsEligible).ToList();
                        var requiresExplicitAllocation = preview.TrueUpPositions.Count > 1;
                        var allocationIndex = 0;
                        @if (eligiblePositions.Count == 1 && !requiresExplicitAllocation)
                        {
                            var position = eligiblePositions[0];
                            <p class="notice"><strong>Automatic destination:</strong> @position.Facility / @position.Location — @position.Treatment</p>
                        }
                        else if (eligiblePositions.Count > 0)
                        {
                            <p class="notice warning">Inventory is split across current positions or treatment segments. Select the current allocations to correct and allocate the full absolute difference below. Previously moved stock stays in its current location unless explicitly selected.</p>
                        }
                        <table class="data-table">
                            <thead><tr><th>Custody</th><th>Facility</th><th>Location</th><th>Current bins</th><th>Treatment</th><th>Bins to correct</th></tr></thead>
                            <tbody>
                            @for (var index = 0; index < preview.TrueUpPositions.Count; index++)
                            {
                                var position = preview.TrueUpPositions[index];
                                <tr>
                                    <td>@position.PositionType</td>
                                    <td>@position.Facility</td>
                                    <td>@position.Location</td>
                                    <td>@position.CurrentBins</td>
                                    <td>@position.Treatment@if (!position.IsEligible && position.UnavailableReason is not null) { <br /><span class="muted">@position.UnavailableReason</span> }</td>
                                    <td>
                                        @if (position.IsEligible && requiresExplicitAllocation)
                                        {
                                            var bindingIndex = allocationIndex++;
                                            <input type="hidden" name="TrueUpAllocations[@bindingIndex].TargetKey" value="@position.TargetKey" />
                                            <input class="true-up-allocation" name="TrueUpAllocations[@bindingIndex].Bins" type="number" min="0" inputmode="numeric" value="@(submitted?.TrueUpAllocations.FirstOrDefault(x => x.TargetKey == position.TargetKey)?.Bins ?? 0)" aria-label="Bins to correct at @position.Facility @position.Location @position.Treatment" />
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </section>
                <input type="hidden" name="ExpectedConcurrencyVersion" value="@(submitted?.ExpectedConcurrencyVersion ?? preview.ConcurrencyVersion)" />
                <input type="hidden" name="ExpectedInventoryStateToken" value="@(submitted?.ExpectedInventoryStateToken ?? preview.InventoryStateToken)" />
                <input type="hidden" name="ExpectedPositiveTrueUpStateToken" value="@(submitted?.ExpectedPositiveTrueUpStateToken ?? preview.PositiveTrueUpStateToken)" />
                <p id="negativeInventoryAcknowledgment" class="notice warning wide" hidden>This reduction exceeds current receipt custody and cannot be saved. Review transferred or consumed bins before correcting the count.</p>
            </section>
        }
        <div class="button-row">
            <button id="saveReceiptButton" type="submit">Save Receipt</button>
            <a class="button secondary-button" href="/Receipts/@form.Id">Cancel</a>
        </div>
    </form>
</section>

<script>
    (() => {
        const rooms = @Html.Raw(roomOptionsJson);
        const growerLots = @Html.Raw(growerLotsJson);

        const warehouseSelect = document.getElementById("editWarehouseId");
        const roomSelect = document.getElementById("editRoomId");
        function populateRooms(keepSelection) {
            const warehouseId = Number(warehouseSelect.value);
            const selectedRoomId = keepSelection ? roomSelect.dataset.selectedRoomId : "";
            roomSelect.innerHTML = "";
            for (const room of rooms.filter(item => item.warehouseId === warehouseId)) {
                const option = document.createElement("option");
                option.value = room.id;
                const prefix = room.subLocation ? `${room.subLocation} - ` : "";
                const legacy = room.compuTech ? ` (Compu-Tech: ${room.compuTech})` : "";
                option.textContent = `${prefix}${room.code}${legacy}${room.isSealed ? " (Sealed)" : ""}`;
                if (room.isSealed && (!selectedRoomId || Number(selectedRoomId) !== room.id)) {
                    option.disabled = true;
                }
                if (selectedRoomId && Number(selectedRoomId) === room.id) {
                    option.selected = true;
                }

                roomSelect.appendChild(option);
            }

            roomSelect.dataset.selectedRoomId = roomSelect.value;
        }

        populateRooms(true);
        warehouseSelect?.addEventListener("change", () => {
            roomSelect.dataset.selectedRoomId = "";
            populateRooms(false);
        });

        const growerLotSelect = document.getElementById("editGrowerLotId");
        const growerNumberInput = document.getElementById("editGrowerNumber");
        const growerNameInput = document.querySelector("input[name='GrowerName']");
        function fillGrowerLot(lot) {
            growerNameInput.value = lot.grower || "";
            growerNumberInput.value = lot.lot || "";
            growerLotSelect.value = lot.id || "";
        }

        growerLotSelect?.addEventListener("change", () => {
            const selected = growerLotSelect.selectedOptions[0];
            if (!selected || !selected.value) return;
            fillGrowerLot({ id: selected.value, grower: selected.dataset.grower || "", lot: selected.dataset.lot || "" });
        });
        growerNumberInput?.addEventListener("change", () => {
            const value = growerNumberInput.value.trim();
            const matches = growerLots.filter(lot => (lot.lot || "").toLowerCase() === value.toLowerCase());
            if (matches.length === 1) {
                fillGrowerLot(matches[0]);
            } else {
                growerLotSelect.value = "";
            }
        });

        const original = @Html.Raw(JsonSerializer.Serialize(new { bins = original.BinCount, room = original.RoomId, warehouse = original.WarehouseId }));
        const value = name => document.querySelector(`[name='${name}']`)?.value ?? "";
        function showEvidence() {
            const delta = Number(value("BinCount")) - original.bins;
            const location = Number(value("RoomId")) !== original.room || Number(value("WarehouseId")) !== original.warehouse;
            const section = document.getElementById("positiveTrueUpAllocation");
            if (section) section.hidden = delta === 0;
            const treatment = document.getElementById("additionalBinsTreatment");
            if (treatment) treatment.hidden = delta <= 0;
            const destination = document.getElementById("additionalStockDestination");
            if (destination) destination.hidden = delta <= 0;
            const source = document.getElementById("correctionSourceRoom");
            const locations = document.getElementById("receiptLocationReview");
            const needsSource = @JsonSerializer.Serialize(Model.AdminOverridePreview?.Balances.Any(x => x.RoomId > 0 && x.RoomId != original.RoomId) == true);
            if (locations) locations.hidden = !location && !needsSource && !source?.value;
            // Keep explicit evidence on validation failure. Empty source is safe: the
            // canonical command auto-selects only a unique proven room allocation.
            if (source) source.disabled = !location && !needsSource && !source.value;
            const proposed = document.getElementById("overrideProposedBins");
            if (proposed) proposed.textContent = value("BinCount");
            const change = document.getElementById("overrideBinDelta");
            if (change) change.textContent = `${delta > 0 ? "+" : ""}${delta}`;
            const removed = document.getElementById("overrideRemovedBins");
            if (removed) removed.textContent = Math.max(0, -delta);
            const warning = document.getElementById("negativeInventoryAcknowledgment");
            if (warning) warning.hidden = delta >= 0 || -delta <= @(Model.AdminOverridePreview?.CurrentInventory ?? 0);
        }
        document.querySelector("form[action$='/Edit']")?.addEventListener("input", showEvidence);
        document.querySelector("form[action$='/Edit']")?.addEventListener("change", showEvidence);
        showEvidence();
    })();
</script>
