@model EditReceiptPageViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Edit Receipt";
    var form = Model.Form;
    var roomOptionsJson = JsonSerializer.Serialize(Model.Rooms.Select(x => new { id = x.Id, warehouseId = x.WarehouseId, code = x.CropQcRoomName ?? x.DisplayName ?? x.Code, name = x.DisplayName ?? x.Name, subLocation = x.SubLocation ?? "", compuTech = x.CompuTechRoomCode ?? "", isSealed = x.IsSealed }));
    var growerLotsJson = JsonSerializer.Serialize(Model.GrowerLots.Select(x => new { id = x.Id, grower = x.Grower, lot = x.LotNumber, label = $"{x.Grower} - {x.LotNumber}" }));
}

<h1>Edit Receipt</h1>
@if (Model.DataWarning is not null)
{
    <p class="notice warning">@Model.DataWarning</p>
}
@if (TempData["Error"] is string error)
{
    <p class="notice warning">@error</p>
}

<section class="panel">
    <form class="form-grid" method="post" action="/Receipts/@form.Id/Edit">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@form.Id" />
        <div class="field"><label>Crop Year</label><input name="CropYear" value="@form.CropYear" required /></div>
        <div class="field"><label>Received At (Pacific)</label><input name="ReceivedAt" type="datetime-local" value="@BusinessTime.FormatPacificInput(form.ReceivedAt)" required /></div>
        <div class="field"><label>Receipt ID</label><input name="CompuTechReceiptId" value="@form.CompuTechReceiptId" required /></div>
        <div class="field">
            <label>Receipt Type</label>
            <select name="ReceiptType">
                @foreach (var type in new[] { "Truck receipt", "Door sample", "Lot sample" })
                {
                    <option selected="@(form.ReceiptType == type ? "selected" : null)">@type</option>
                }
            </select>
        </div>
        <div class="field">
            <label>Warehouse</label>
            <select id="editWarehouseId" name="WarehouseId" required>
                @foreach (var item in Model.Warehouses)
                {
                    <option value="@item.Id" selected="@(form.WarehouseId == item.Id ? "selected" : null)">@item.Code</option>
                }
            </select>
        </div>
        <div class="field">
            <label>Room</label>
            <select id="editRoomId" name="RoomId" data-selected-room-id="@form.RoomId" required></select>
        </div>
        <div class="field">
            <label>Variety</label>
            <select name="FruitProfileId" required>
                @foreach (var item in Model.FruitProfiles)
                {
                    <option value="@item.Id" selected="@(form.FruitProfileId == item.Id ? "selected" : null)">@item.VarietyCode - @item.Name</option>
                }
            </select>
        </div>
        <div class="field wide">
            <label>Grower Lot</label>
            <select id="editGrowerLotId" name="GrowerLotId">
                <option value="">Manual entry</option>
                @foreach (var lot in Model.GrowerLots)
                {
                    <option value="@lot.Id" data-grower="@lot.Grower" data-lot="@lot.LotNumber" selected="@(form.GrowerLotId == lot.Id ? "selected" : null)">@lot.LotNumber - @lot.Grower</option>
                }
            </select>
        </div>
        <div class="field"><label>Grower</label><input name="GrowerName" value="@form.GrowerName" required /></div>
        <div class="field"><label>Lot #</label><input id="editGrowerNumber" name="GrowerNumber" value="@form.GrowerNumber" maxlength="50" list="editGrowerLotOptions" required /></div>
        <datalist id="editGrowerLotOptions">
            @foreach (var lot in Model.GrowerLots)
            {
                <option value="@lot.LotNumber" label="@lot.LotNumber - @lot.Grower"></option>
            }
        </datalist>
        <div class="field"><label>Bin Count</label><input id="editBinCount" name="BinCount" type="number" min="0" inputmode="numeric" value="@form.BinCount" data-saved-bin-count="@form.BinCount" required /></div>
        <label class="checkbox-field"><input type="checkbox" name="ConfirmCropYear" value="true" checked /> Confirm Crop Year</label><input type="hidden" name="ConfirmCropYear" value="false" />
        @if (!Model.CanAdminOverride)
        {
            <p id="binCountOverridePermissionWarning" class="notice warning wide" hidden>You do not have permission to override the bin count on a saved Receipt. Restore the current bin count to save other Receipt changes.</p>
        }
        @if (Model.CanAdminOverride && Model.AdminOverridePreview is not null)
        {
            var preview = Model.AdminOverridePreview;
            <button id="reviewBinCountOverride" type="button" class="wide" hidden>Review Bin Count Override</button>
            <section id="adminInventoryOverride" class="panel danger-zone wide receipt-bin-override-review" hidden
                     data-original-bins="@form.BinCount" data-original-warehouse="@form.WarehouseId"
                     data-original-room="@form.RoomId" data-original-crop-year="@form.CropYear"
                     data-original-grower-lot="@form.GrowerLotId" data-original-grower-number="@form.GrowerNumber"
                     data-original-fruit-profile="@form.FruitProfileId">
                <h2 id="overrideReviewTitle">Admin Inventory Override</h2>
                <p id="savedReceiptBinCountWarning" class="notice warning" hidden>Changing the bin count of a saved Receipt requires an override.</p>
                <p class="notice warning">This is an audited inventory operation, not a normal receipt edit. Historical runs and transfers will not be rewritten.</p>
                <dl class="summary-list">
                    <dt>Receipt</dt><dd id="overrideReceipt">@form.CompuTechReceiptId</dd>
                    <dt>Grower</dt><dd id="overrideGrower">@form.GrowerNumber - @form.GrowerName</dd>
                    <dt>Room</dt><dd id="overrideRoom">@(Model.Rooms.FirstOrDefault(x => x.Id == form.RoomId)?.CropQcRoomName ?? Model.Rooms.FirstOrDefault(x => x.Id == form.RoomId)?.DisplayName ?? Model.Rooms.FirstOrDefault(x => x.Id == form.RoomId)?.Code ?? "-")</dd>
                    <dt>Current bin count</dt><dd>@preview.ReceiptBinCount bins</dd>
                    <dt>New bin count</dt><dd><span id="overrideProposedBins">@preview.ReceiptBinCount</span> bins</dd>
                    <dt>Inventory adjustment</dt><dd><span id="overrideBinDelta">0</span> bins</dd>
                    <dt>Current attributable inventory</dt><dd>@preview.CurrentInventory bins</dd>
                    <dt>Net already run or consumed</dt><dd>@preview.ConsumedBins bins</dd>
                    <dt>Operational history</dt><dd>@preview.BinsRunCount Bins Run line(s), @preview.ActualRunCount Actual Run(s), @preview.TransferCount transfer(s)</dd>
                </dl>
                @if (preview.Balances.Count > 0)
                {
                    <table class="data-table"><thead><tr><th>Facility</th><th>Room</th><th>Crop year</th><th>Lot</th><th>Variety</th><th>Current bins</th></tr></thead><tbody>
                    @foreach (var balance in preview.Balances)
                    {
                        <tr><td>@balance.Warehouse</td><td>@balance.Room</td><td>@balance.CropYear</td><td>@balance.Lot</td><td>@balance.Variety</td><td>@balance.CurrentBins</td></tr>
                    }
                    </tbody></table>
                }
                <section id="positiveTrueUpAllocation" class="wide" hidden>
                    <h3>Where is the additional inventory now?</h3>
                    <p>The additional bins will be added to the current canonical inventory position. The original receiving room and historical movements will not be rewritten.</p>
                    <p><strong>Current canonical inventory:</strong> @preview.CurrentCanonicalInventory bins</p>
                    @if (preview.TrueUpPositions.Count == 0)
                    {
                        <p class="notice warning">No current matching inventory or custody position was found. This true-up cannot be placed automatically.</p>
                    }
                    else
                    {
                        var eligiblePositions = preview.TrueUpPositions.Where(x => x.IsEligible).ToList();
                        var requiresExplicitAllocation = preview.TrueUpPositions.Count > 1;
                        var allocationIndex = 0;
                        @if (eligiblePositions.Count == 1 && !requiresExplicitAllocation)
                        {
                            var position = eligiblePositions[0];
                            <p class="notice"><strong>Automatic destination:</strong> @position.Facility / @position.Location — @position.Treatment</p>
                        }
                        else if (eligiblePositions.Count > 0)
                        {
                            <p class="notice warning">Inventory is split across current positions or treatment segments. Allocate the full positive change below.</p>
                        }
                        <table class="data-table">
                            <thead><tr><th>Custody</th><th>Facility</th><th>Location</th><th>Current bins</th><th>Treatment</th><th>Added bins</th></tr></thead>
                            <tbody>
                            @for (var index = 0; index < preview.TrueUpPositions.Count; index++)
                            {
                                var position = preview.TrueUpPositions[index];
                                <tr>
                                    <td>@position.PositionType</td>
                                    <td>@position.Facility</td>
                                    <td>@position.Location</td>
                                    <td>@position.CurrentBins</td>
                                    <td>@position.Treatment@if (!position.IsEligible && position.UnavailableReason is not null) { <br /><span class="muted">@position.UnavailableReason</span> }</td>
                                    <td>
                                        @if (position.IsEligible && requiresExplicitAllocation)
                                        {
                                            var bindingIndex = allocationIndex++;
                                            <input type="hidden" name="TrueUpAllocations[@bindingIndex].TargetKey" value="@position.TargetKey" />
                                            <input class="true-up-allocation" name="TrueUpAllocations[@bindingIndex].Bins" type="number" min="0" inputmode="numeric" value="0" aria-label="Additional bins at @position.Facility @position.Location @position.Treatment" />
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </section>
                <input type="hidden" name="ExpectedConcurrencyVersion" value="@preview.ConcurrencyVersion" />
                <input type="hidden" name="ExpectedInventoryStateToken" value="@preview.InventoryStateToken" />
                <input type="hidden" name="ExpectedPositiveTrueUpStateToken" value="@preview.PositiveTrueUpStateToken" />
                <input type="hidden" name="OperationKey" value="@preview.OperationKey" />
                <div class="field wide"><label for="adminOverrideReason">Required override reason</label><textarea id="adminOverrideReason" name="Reason" maxlength="1000"></textarea></div>
                <label class="checkbox-field wide"><input type="checkbox" name="ConfirmInventoryChange" value="true" /> I confirm that this correction will change inventory and create a durable Receipt Admin Override.</label>
                <input type="hidden" name="ConfirmInventoryChange" value="false" />
                <label id="negativeInventoryAcknowledgment" class="checkbox-field wide" hidden><input type="checkbox" name="AcknowledgeNegativeInventory" value="true" /> I understand this correction will create a negative inventory balance that requires review.</label>
                <input type="hidden" name="AcknowledgeNegativeInventory" value="false" />
                <button id="applyBinCountOverride" type="submit" formaction="/Receipts/@form.Id/AdminInventoryOverride">Apply Override</button>
            </section>
        }
        <div class="button-row">
            <button id="saveReceiptButton" type="submit">Save Receipt</button>
            <a class="button secondary-button" href="/Receipts/@form.Id">Cancel</a>
        </div>
    </form>
</section>

<script>
    (() => {
        const rooms = @Html.Raw(roomOptionsJson);
        const growerLots = @Html.Raw(growerLotsJson);

        const warehouseSelect = document.getElementById("editWarehouseId");
        const roomSelect = document.getElementById("editRoomId");
        function populateRooms(keepSelection) {
            const warehouseId = Number(warehouseSelect.value);
            const selectedRoomId = keepSelection ? roomSelect.dataset.selectedRoomId : "";
            roomSelect.innerHTML = "";
            for (const room of rooms.filter(item => item.warehouseId === warehouseId)) {
                const option = document.createElement("option");
                option.value = room.id;
                const prefix = room.subLocation ? `${room.subLocation} - ` : "";
                const legacy = room.compuTech ? ` (Compu-Tech: ${room.compuTech})` : "";
                option.textContent = `${prefix}${room.code}${legacy}${room.isSealed ? " (Sealed)" : ""}`;
                if (room.isSealed && (!selectedRoomId || Number(selectedRoomId) !== room.id)) {
                    option.disabled = true;
                }
                if (selectedRoomId && Number(selectedRoomId) === room.id) {
                    option.selected = true;
                }

                roomSelect.appendChild(option);
            }

            roomSelect.dataset.selectedRoomId = roomSelect.value;
        }

        populateRooms(true);
        warehouseSelect?.addEventListener("change", () => {
            roomSelect.dataset.selectedRoomId = "";
            populateRooms(false);
        });

        const growerLotSelect = document.getElementById("editGrowerLotId");
        const growerNumberInput = document.getElementById("editGrowerNumber");
        const growerNameInput = document.querySelector("input[name='GrowerName']");
        function fillGrowerLot(lot) {
            growerNameInput.value = lot.grower || "";
            growerNumberInput.value = lot.lot || "";
            growerLotSelect.value = lot.id || "";
        }

        growerLotSelect?.addEventListener("change", () => {
            const selected = growerLotSelect.selectedOptions[0];
            if (!selected || !selected.value) return;
            fillGrowerLot({ id: selected.value, grower: selected.dataset.grower || "", lot: selected.dataset.lot || "" });
        });
        growerNumberInput?.addEventListener("change", () => {
            const value = growerNumberInput.value.trim();
            const matches = growerLots.filter(lot => (lot.lot || "").toLowerCase() === value.toLowerCase());
            if (matches.length === 1) {
                fillGrowerLot(matches[0]);
            } else {
                growerLotSelect.value = "";
            }
        });

        const editForm = document.querySelector("form[action$='/Edit']");
        const binCountInput = document.getElementById("editBinCount");
        const saveReceiptButton = document.getElementById("saveReceiptButton");
        const permissionWarning = document.getElementById("binCountOverridePermissionWarning");
        const originalBins = Number(binCountInput?.dataset.savedBinCount);
        const quantityChanged = () => Number(binCountInput?.value) !== originalBins;
        const overrideSection = document.getElementById("adminInventoryOverride");
        const reviewOverrideButton = document.getElementById("reviewBinCountOverride");
        let overrideReviewRequested = false;
        if (overrideSection) {
            const watched = ["BinCount", "WarehouseId", "RoomId", "CropYear", "GrowerLotId", "GrowerNumber", "FruitProfileId"];
            const currentValue = name => document.querySelector(`[name='${name}']`)?.value ?? "";
            const normalize = value => (value || "").trim().toLowerCase();
            function updateOverrideVisibility() {
                const proposed = Number(currentValue("BinCount"));
                const original = Number(overrideSection.dataset.originalBins);
                const binCountChanged = proposed !== original;
                const identityChanged = Number(currentValue("WarehouseId")) !== Number(overrideSection.dataset.originalWarehouse)
                    || Number(currentValue("RoomId")) !== Number(overrideSection.dataset.originalRoom)
                    || Number(currentValue("CropYear")) !== Number(overrideSection.dataset.originalCropYear)
                    || normalize(currentValue("GrowerLotId")) !== normalize(overrideSection.dataset.originalGrowerLot)
                    || normalize(currentValue("GrowerNumber")) !== normalize(overrideSection.dataset.originalGrowerNumber)
                    || Number(currentValue("FruitProfileId")) !== Number(overrideSection.dataset.originalFruitProfile);
                reviewOverrideButton.hidden = !binCountChanged;
                saveReceiptButton.hidden = binCountChanged || identityChanged;
                overrideSection.hidden = binCountChanged ? !overrideReviewRequested : !identityChanged;
                document.getElementById("overrideReviewTitle").textContent = binCountChanged ? "Bin Count Override Review" : "Admin Inventory Override";
                document.getElementById("savedReceiptBinCountWarning").hidden = !binCountChanged;
                document.getElementById("overrideProposedBins").textContent = Number.isFinite(proposed) ? proposed : "n/a";
                const delta = Number.isFinite(proposed) ? proposed - original : null;
                document.getElementById("overrideBinDelta").textContent = delta === null ? "n/a" : `${delta > 0 ? "+" : ""}${delta}`;
                const positiveTrueUp = document.getElementById("positiveTrueUpAllocation");
                if (positiveTrueUp) positiveTrueUp.hidden = !(delta > 0);
                for (const allocation of document.querySelectorAll(".true-up-allocation")) {
                    allocation.disabled = !(delta > 0);
                }
                document.getElementById("overrideReceipt").textContent = currentValue("CompuTechReceiptId") || "-";
                const growerNumber = currentValue("GrowerNumber").trim();
                const growerName = currentValue("GrowerName").trim();
                document.getElementById("overrideGrower").textContent = [growerNumber, growerName].filter(Boolean).join(" - ") || "-";
                document.getElementById("overrideRoom").textContent = roomSelect?.selectedOptions[0]?.textContent?.trim() || "-";
                const negativeAcknowledgment = document.getElementById("negativeInventoryAcknowledgment");
                negativeAcknowledgment.hidden = @(Model.AdminOverridePreview?.CurrentInventory ?? 0) + (delta ?? 0) >= 0;
                if (negativeAcknowledgment.hidden) negativeAcknowledgment.querySelector("input[type='checkbox']").checked = false;
            }
            for (const name of watched) {
                const field = document.querySelector(`[name='${name}']`);
                const changed = () => {
                    overrideReviewRequested = false;
                    updateOverrideVisibility();
                };
                field?.addEventListener("change", changed);
                field?.addEventListener("input", changed);
            }
            reviewOverrideButton?.addEventListener("click", () => {
                if (!binCountInput?.reportValidity()) return;
                overrideReviewRequested = true;
                updateOverrideVisibility();
                overrideSection.scrollIntoView({ behavior: "smooth", block: "nearest" });
            });
            updateOverrideVisibility();
        } else if (binCountInput) {
            const updatePermissionState = () => {
                const changed = quantityChanged();
                if (permissionWarning) permissionWarning.hidden = !changed;
                saveReceiptButton.disabled = changed;
            };
            binCountInput.addEventListener("input", updatePermissionState);
            binCountInput.addEventListener("change", updatePermissionState);
            updatePermissionState();
        }

        editForm?.addEventListener("submit", event => {
            if (!quantityChanged()) return;
            if (event.submitter?.id === "applyBinCountOverride" && !overrideSection?.hidden) return;
            event.preventDefault();
            reviewOverrideButton?.click();
        });
    })();
</script>
