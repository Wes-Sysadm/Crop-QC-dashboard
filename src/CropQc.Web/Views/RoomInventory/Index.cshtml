@model RoomInventoryImportPageViewModel
@{
    ViewData["Title"] = "Current Lots / Room Inventory";
}

<h1>Current Inventory Baseline</h1>
@await Html.PartialAsync("_PageRefreshControls")
@if (TempData["Success"] is string success)
{
    <p class="notice success">@success</p>
}
@if (TempData["Error"] is string error)
{
    <p class="notice error">@error</p>
}
@{
    ViewData["CanManageInventoryDiagnostics"] = Model.CanManageInventoryDiagnostics;
}
<partial name="_InventoryDiagnosticOverview" model="Model.InventoryDiagnostics" view-data="ViewData" />

<section class="panel">
    <h2>Import Current Inventory Baseline</h2>
    <p class="muted">One row equals one current baseline lot balance in one room. Required columns: CropYear, Warehouse, RoomCode, Lot, Variety, Bins, EffectiveDate. Optional columns: Grower, Status, Notes.</p>
    <div class="action-bar">
        <a class="button secondary-button" href="/Admin/RoomInventory/Template">Download CSV Template</a>
        <form method="post" action="/Admin/RoomInventory/ImportEbsStartingInventory">
            <button type="submit">Import EBS Current Baseline</button>
        </form>
    </div>
    <details class="notice info">
        <summary>Show Example</summary>
        <p class="muted">Supported CSV columns: @Model.CsvTemplateHeader</p>
        <p class="muted">RoomCode maps to a room Compu-Tech code or room code, such as EVANCA12 or BLUECA06. EffectiveDate accepts YYYY-MM-DD. Status accepts blank, Sealed, or Open.</p>
        <pre><code>@Model.CsvExample</code></pre>
        <p class="muted">This example previews EVANCA12 as 1,022 FUJI Sealed from lots 1560=118, 1570=819, and 1030=85.</p>
    </details>
    <form class="form-grid" method="post" enctype="multipart/form-data" action="/Admin/RoomInventory/Preview">
        <label class="field wide">Upload room inventory CSV
            <input type="file" name="CsvFile" accept=".csv,text/csv" />
        </label>
        <button type="submit" class="secondary-button">Preview CSV Import</button>
    </form>
</section>

@if (Model.ImportPreview is not null)
{
    <section class="panel">
        <h2>Import Preview</h2>
        <div class="metric-grid">
            <div><strong>@Model.ImportPreview.AddCount</strong><span>Add</span></div>
            <div><strong>@Model.ImportPreview.UpdateCount</strong><span>Update</span></div>
            <div><strong>@Model.ImportPreview.ReplaceBatchCount</strong><span>Replace</span></div>
            <div><strong>@Model.ImportPreview.UnchangedCount</strong><span>Unchanged</span></div>
            <div><strong>@Model.ImportPreview.WarningCount</strong><span>Warnings</span></div>
            <div><strong>@Model.ImportPreview.DuplicateCount</strong><span>Duplicates</span></div>
            <div><strong>@Model.ImportPreview.InvalidCount</strong><span>Invalid</span></div>
        </div>
        @if (Model.ImportPreview.RoomTotals.Count > 0)
        {
            <h3>Room Totals Preview</h3>
            <div class="table-wrap contained-table">
                <table class="responsive-table">
                    <thead>
                    <tr>
                        <th>Crop Year</th>
                        <th>Warehouse</th>
                        <th>Room</th>
                        <th>Variety</th>
                        <th>Status</th>
                        <th>Effective</th>
                        <th class="numeric-cell">Lots</th>
                        <th class="numeric-cell">Bins</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var total in Model.ImportPreview.RoomTotals)
                    {
                        <tr>
                            <td>@total.CropYear</td>
                            <td>@total.Warehouse</td>
                            <td>@total.RoomCode</td>
                            <td>@total.Variety</td>
                            <td>@total.Status</td>
                            <td>@BusinessTime.FormatPacific(total.EffectiveDate, "d", includeZone: false)</td>
                            <td class="numeric-cell">@total.LotCount</td>
                            <td class="numeric-cell">@total.BinCount</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        @if (Model.ImportPreview.RequiresReplaceConfirmation)
        {
            <p class="notice warning">This preview includes rows from an existing baseline batch. Confirm replacement to apply a new audited baseline row for the same crop year, room, lot, variety, and effective date.</p>
        }
        @if (Model.ImportPreview.Rows.Count == 0)
        {
            <p class="muted">No rows were found in the import file.</p>
        }
        else
        {
            <div class="table-wrap contained-table">
                <table class="responsive-table">
                    <thead>
                    <tr>
                        <th class="compact-cell">Row</th>
                        <th>Column</th>
                        <th>Crop Year</th>
                        <th>Action</th>
                        <th>Facility</th>
                        <th>Location</th>
                        <th>Crop QC Room</th>
                        <th>Compu-Tech Code</th>
                        <th>Lot #</th>
                        <th>Grower</th>
                        <th>Pool</th>
                        <th>Variety</th>
                        <th>Status</th>
                        <th>Effective</th>
                        <th class="numeric-cell">Old</th>
                        <th class="numeric-cell">New</th>
                        <th class="wide-cell">Message</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.ImportPreview.Rows)
                    {
                        <tr>
                            <td class="compact-cell">@row.RowNumber</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Column) ? "-" : row.Column)</td>
                            <td>@row.CropYear</td>
                            <td><span class="status @StatusClass(row.Action, row.IsWarning)">@row.Action</span></td>
                            <td>@row.Facility</td>
                            <td>@row.SubLocation</td>
                            <td>@row.CropQcRoomName <span class="muted">(@row.NormalizedRoomCode)</span></td>
                            <td>@row.CompuTechRoomCode</td>
                            <td>@row.LotNumber</td>
                            <td class="wrap-cell">@(string.IsNullOrWhiteSpace(row.Grower) ? "-" : row.Grower)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.PoolStart) ? "-" : row.PoolStart)</td>
                            <td>@row.Variety</td>
                            <td>@(string.IsNullOrWhiteSpace(row.InventoryStatus) ? "-" : row.InventoryStatus)</td>
                            <td>@BusinessTime.FormatPacific(row.EffectiveDate)</td>
                            <td class="numeric-cell">@(row.OldBinCount?.ToString() ?? "-")</td>
                            <td class="numeric-cell">@(row.NewBinCount?.ToString() ?? "-")</td>
                            <td class="wide-cell">@row.Message</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        <form method="post" action="/Admin/RoomInventory/Apply" class="action-bar">
            <input type="hidden" name="CsvText" value="@Model.ImportPreview.CsvText" />
            <input type="hidden" name="UseBuiltInSeed" value="@(Model.ImportPreview.IsBuiltInSeed ? "true" : "false")" />
            @if (Model.ImportPreview.RequiresReplaceConfirmation)
            {
                <label class="checkbox-field"><input type="checkbox" name="ConfirmReplaceExistingBatch" value="true" /> Confirm replacement of existing baseline batch rows</label><input type="hidden" name="ConfirmReplaceExistingBatch" value="false" />
            }
            <button type="submit" @(Model.ImportPreview.CanApply ? "" : "disabled")>Import Current Baseline</button>
            @if (!Model.ImportPreview.CanApply)
            {
                <span class="muted">Resolve invalid or duplicate rows before applying.</span>
            }
        </form>
    </section>
}

<section class="panel">
    <h2>Current Baseline Lots</h2>
    @if (Model.CurrentLotWarning is not null)
    {
        <p class="notice warning">@Model.CurrentLotWarning</p>
    }
    <form class="toolbar" method="get" action="/Admin/RoomInventory">
        <label class="field">Facility
            <select name="Facility">
                @foreach (var option in Model.FacilityOptions)
                {
                    if (option.Equals(Model.Form.Facility, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@option" selected>@option</option>
                    }
                    else
                    {
                        <option value="@option">@option</option>
                    }
                }
            </select>
        </label>
        <label class="field">EBS location
            <select name="EbsLocation">
                @foreach (var option in Model.EbsLocationOptions)
                {
                    if (option.Equals(Model.Form.EbsLocation, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@option" selected>@option</option>
                    }
                    else
                    {
                        <option value="@option">@option</option>
                    }
                }
            </select>
        </label>
        <label class="field">Room
            <input name="RoomCode" value="@Model.Form.RoomCode" />
        </label>
        <label class="field">Lot #
            <input name="LotNumber" value="@Model.Form.LotNumber" />
        </label>
        <label class="field">Grower
            <input name="Grower" value="@Model.Form.Grower" />
        </label>
        <label class="field">Variety
            <input name="Variety" value="@Model.Form.Variety" />
        </label>
        <button type="submit" class="secondary-button">Filter</button>
    </form>

    @if (Model.CurrentLots.Count == 0)
    {
        <p class="muted">No current inventory baseline rows match the selected filters.</p>
    }
    else
    {
        <div class="responsive-card-grid">
        @foreach (var lot in Model.CurrentLots)
        {
            <article class="station-card">
                <div class="station-card-header">
                    <div>
                        <h3>@lot.CropQcRoomName | Lot # @lot.LotNumber</h3>
                        <p class="station-code">Crop Year @(lot.CropYear?.ToString() ?? "-") / @lot.Facility / @lot.SubLocation / Compu-Tech @lot.CompuTechRoomCode / master room @lot.MasterRoomCode</p>
                    </div>
                    <span class="status ready">@lot.CurrentBins bins</span>
                </div>
                <dl class="station-meta">
                    <dt>Grower</dt><dd>@(string.IsNullOrWhiteSpace(lot.Grower) ? "Grower not found in Master Data" : lot.Grower)</dd>
                    <dt>Crop QC Room</dt><dd>@lot.CropQcRoomName</dd>
                    <dt>Compu-Tech Code</dt><dd>@lot.CompuTechRoomCode</dd>
                    <dt>Pool Start</dt><dd>@(string.IsNullOrWhiteSpace(lot.PoolStart) ? "-" : lot.PoolStart)</dd>
                    <dt>Variety</dt><dd>@lot.Variety</dd>
                    <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(lot.InventoryStatus) ? "-" : lot.InventoryStatus)</dd>
                    <dt>Source</dt><dd>@lot.Source</dd>
                    <dt>Last adjustment</dt><dd>@BusinessTime.FormatPacific(lot.LastAdjustmentAt)</dd>
                </dl>
                <div class="action-bar">
                    <a class="button secondary-button" href="/Dashboard/Rooms/@lot.RoomId">View Room</a>
                </div>
            </article>
        }
        </div>
    }
</section>

@if (Model.CurrentLotBreakdown.Count > 0)
{
    <section class="panel">
        <h2>Current Inventory Source Breakdown</h2>
        <p class="muted">Included rows contribute to Current Lots. Excluded rows show bad room mappings, invalid baseline values, older duplicate/current-balance rows, or other source conflicts.</p>
        <div class="table-wrap contained-table">
            <table class="responsive-table">
                <thead>
                <tr>
                    <th>Included</th>
                    <th>Source</th>
                    <th>Source ID</th>
                    <th>Room</th>
                    <th>Compu-Tech Code</th>
                    <th>Grower</th>
                    <th>Lot</th>
                    <th>Variety</th>
                    <th>Status</th>
                    <th class="numeric-cell">Bins</th>
                    <th>Date</th>
                    <th class="wide-cell">Reason</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.CurrentLotBreakdown)
                {
                    <tr>
                        <td><span class="status @(row.IsIncluded ? "ready" : "missing")">@(row.IsIncluded ? "Included" : "Excluded")</span></td>
                        <td>@row.SourceType</td>
                        <td>@(row.SourceId?.ToString() ?? "-")</td>
                        <td>@(string.IsNullOrWhiteSpace(row.RoomCode) ? "-" : row.RoomCode)</td>
                        <td>@(string.IsNullOrWhiteSpace(row.CompuTechRoomCode) ? "-" : row.CompuTechRoomCode)</td>
                        <td class="wrap-cell">@(string.IsNullOrWhiteSpace(row.Grower) ? "-" : row.Grower)</td>
                        <td>@(string.IsNullOrWhiteSpace(row.Lot) ? "-" : row.Lot)</td>
                        <td>@(string.IsNullOrWhiteSpace(row.Variety) ? "-" : row.Variety)</td>
                        <td>@(string.IsNullOrWhiteSpace(row.Status) ? "-" : row.Status)</td>
                        <td class="numeric-cell">@row.Bins</td>
                        <td>@BusinessTime.FormatPacific(row.Date, empty: "-")</td>
                        <td class="wide-cell">@row.DecisionReason</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}

@functions {
    private static string StatusClass(string action, bool warning) =>
        action == "Invalid" || action == "Duplicate" ? "missing" :
        warning ? "review" :
        action == "Unchanged" ? "pending" : "ready";
}
