@model FieldSampleDetailViewModel
@{
    ViewData["Title"] = "Field Sample Detail";
    var pressureChange = Model.CurrentSummary.AveragePressureChangeFromPriorLbs;
    var orderedTrend = Model.Trend.OrderBy(x => x.SampleTakenAt).ThenBy(x => x.SampleId).ToList();
    var currentTrend = orderedTrend.SingleOrDefault(x => x.SampleId == Model.SampleId);
    var priorTrend = orderedTrend.Where(x => x.SampleTakenAt < Model.SampleTakenAt).OrderByDescending(x => x.SampleTakenAt).ThenByDescending(x => x.SampleId).FirstOrDefault();
    var earliestTrend = orderedTrend.FirstOrDefault(x => x.SampleId != Model.SampleId) ?? currentTrend;
    var sizeTrend = orderedTrend.Where(x => x.SizeDistribution.Count > 0).ToList();
    var trendSizes = sizeTrend.SelectMany(x => x.SizeDistribution.Select(point => point.Size)).Distinct().OrderBy(x => x).ToList();
}

<h1>Field Sample Detail</h1>
@if (TempData["Success"] is string success)
{
    <p class="notice success">@success</p>
}
@if (TempData["Error"] is string error)
{
    <p class="notice error">@error</p>
}
@if (Model.DataWarning is not null)
{
    <p class="notice warning">@Model.DataWarning</p>
}

@if (Model.SampleId > 0)
{
    <section class="panel">
        <div class="section-heading-row">
            <div>
                <h2>@Model.OrchardName - @Model.CanonicalBlockName</h2>
                <p>Field Sample | @Model.Variety | @Model.SampleTakenAt.LocalDateTime.ToString("g") | Target sample size: @Model.TargetSampleSize fruit</p>
            </div>
            @if (Model.CanEdit && !Model.IsEditingMetadata)
            {
                <a class="button secondary-button" href="/FieldSamples/@Model.SampleId/Edit">Edit Field Sample</a>
            }
        </div>
        @if (!string.Equals(Model.CanonicalBlockName, Model.OriginalBlockName, StringComparison.OrdinalIgnoreCase))
        {
            <p class="muted">Original entered block: @Model.OriginalBlockName</p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <p>@Model.Notes</p>
        }
    </section>

    @if (Model.IsEditingMetadata && Model.CanEdit)
    {
        <form method="post" action="/FieldSamples/@Model.SampleId/metadata" class="panel stack-form">
            <h2>Edit Field Sample Details</h2>
            <input type="hidden" name="SampleId" value="@Model.SampleId" />
            <div class="grid-two">
                <label>Orchard <input name="OrchardName" value="@Model.MetadataForm.OrchardName" maxlength="200" required /></label>
                <label>Grower number <input name="GrowerNumber" value="@Model.MetadataForm.GrowerNumber" maxlength="50" /></label>
                <label>Block name entered <input name="BlockName" value="@Model.MetadataForm.BlockName" maxlength="150" required /></label>
                <label>
                    Existing block
                    <select name="CanonicalOrchardBlockId">
                        <option value="">Resolve automatically or create a new block</option>
                        @foreach (var block in Model.Blocks)
                        {
                            <option value="@block.Id" selected="@(Model.MetadataForm.CanonicalOrchardBlockId == block.Id ? "selected" : null)">@block.OrchardName - @block.CanonicalBlockName</option>
                        }
                    </select>
                </label>
                <label>
                    Variety
                    <select name="FruitProfileId" required>
                        @foreach (var fruit in Model.FruitProfiles)
                        {
                            <option value="@fruit.Id" selected="@(Model.MetadataForm.FruitProfileId == fruit.Id ? "selected" : null)">@fruit.Name</option>
                        }
                    </select>
                </label>
                <label>Sample date/time <input name="SampleTakenAt" type="datetime-local" value="@Model.MetadataForm.SampleTakenAt.LocalDateTime.ToString("yyyy-MM-ddTHH:mm")" required /></label>
            </div>
            <label>Notes <textarea name="Notes" maxlength="1000">@Model.MetadataForm.Notes</textarea></label>
            <label class="checkbox-line">
                <input name="ConfirmCreateNewBlock" type="checkbox" value="true" checked="@Model.MetadataForm.ConfirmCreateNewBlock" />
                Create new block if no exact block or alias matches
            </label>
            <div class="button-row">
                <button type="submit">Save Field Sample Details</button>
                <a href="/FieldSamples/@Model.SampleId">Cancel</a>
            </div>
        </form>
    }

    <section class="panel">
        <h2>Current Sample Overview</h2>
        <div class="summary-grid">
            <div><span class="metric-label">Average weight</span><strong>@Format(Model.CurrentSummary.AverageWeightGrams) g</strong><span class="muted">Peak @Format(Model.CurrentSummary.PeakWeightGrams) g | Min @Format(Model.CurrentSummary.MinimumWeightGrams) g | @Model.CurrentSummary.WeightRepresentedFruitCount represented</span></div>
            <div><span class="metric-label">Average starch</span><strong>@Format(Model.CurrentSummary.AverageStarch)</strong><span class="muted">@Model.CurrentSummary.StarchRepresentedFruitCount represented | @Model.CurrentSummary.MissingStarchCount missing</span></div>
            <div><span class="metric-label">Average pressure</span><strong>@Format(Model.CurrentSummary.AveragePressureLbs) lb</strong><span class="muted">Peak @Format(Model.CurrentSummary.PeakPressureLbs) lb | Min @Format(Model.CurrentSummary.MinimumPressureLbs) lb</span></div>
            <div><span class="metric-label">Pressure variation</span><strong>@(Model.CurrentSummary.PressureStandardDeviationLbs?.ToString("0.##") ?? "Insufficient readings")</strong><span class="muted">@Model.CurrentSummary.PressureReadingCount represented fruit</span></div>
            <div><span class="metric-label">Fruit represented</span><strong>@Model.CurrentSummary.EnteredFruitCount / @Model.TargetSampleSize</strong><span class="muted">Blank values remain missing, not zero</span></div>
        </div>
        <p class="notice @(pressureChange is null ? "warning" : pressureChange < 0 ? "warning" : "success")">
            @if (pressureChange is null)
            {
                <span>No earlier pressure sample in the last 30 days.</span>
            }
            else if (pressureChange < 0)
            {
                <span>Down @Math.Abs(pressureChange.Value).ToString("0.##") lb since @Model.CurrentSummary.PriorPressureSampleDate?.LocalDateTime.ToString("MMM d").</span>
            }
            else if (pressureChange > 0)
            {
                <span>Up @pressureChange.Value.ToString("0.##") lb since @Model.CurrentSummary.PriorPressureSampleDate?.LocalDateTime.ToString("MMM d").</span>
            }
            else
            {
                <span>No meaningful pressure change since @Model.CurrentSummary.PriorPressureSampleDate?.LocalDateTime.ToString("MMM d").</span>
            }
        </p>
    </section>

    <section class="panel">
        <h2>Current Size Distribution</h2>
        @if (Model.SizeDistribution.Count == 0)
        {
            <p class="muted">No sizing data is available for this Field Sample.</p>
        }
        else
        {
            <div class="size-chart compact-chart">
                @foreach (var point in Model.SizeDistribution)
                {
                    <div class="size-bar">
                        <div class="bar" style="height:@Math.Max(4, (int)point.Percentage)%"></div>
                        <span>@point.Size</span>
                        <small>@point.Percentage.ToString("0.#")%</small>
                    </div>
                }
            </div>
            <p class="muted">Percentages use fruit rows with a valid size. Missing sizes are unclassified.</p>
        }
    </section>

    <section class="panel">
        <h2>Weight Trend</h2>
        @if (Model.Trend.Count <= 1)
        {
            <p class="muted">No earlier Field Sample for this block in the last 30 days.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Variety</th>
                            <th>Avg weight</th>
                            <th>Peak weight</th>
                            <th>Rows represented</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var point in orderedTrend)
                        {
                            <tr class="@(point.SampleId == Model.SampleId ? "selected-row" : null)">
                                <td>@point.SampleTakenAt.LocalDateTime.ToString("MMM d, h:mm tt")</td>
                                <td>@point.Variety</td>
                                <td>@Format(point.Summary.AverageWeightGrams) g</td>
                                <td>@Format(point.Summary.PeakWeightGrams) g</td>
                                <td>@point.Summary.WeightRepresentedFruitCount / @Model.TargetSampleSize</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="muted">Average weight change since prior sample: @FormatChange(Change(currentTrend?.Summary.AverageWeightGrams, priorTrend?.Summary.AverageWeightGrams), "g"). Change from earliest sample in window: @FormatChange(Change(currentTrend?.Summary.AverageWeightGrams, earliestTrend?.Summary.AverageWeightGrams), "g").</p>
        }
    </section>

    <section class="panel">
        <h2>Starch Trend</h2>
        @if (Model.Trend.Count <= 1)
        {
            <p class="muted">No earlier starch history for this block in the last 30 days.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Date</th><th>Avg starch</th><th>Represented fruit</th></tr></thead>
                    <tbody>
                        @foreach (var point in orderedTrend)
                        {
                            <tr class="@(point.SampleId == Model.SampleId ? "selected-row" : null)">
                                <td>@point.SampleTakenAt.LocalDateTime.ToString("MMM d, h:mm tt")</td>
                                <td>@Format(point.Summary.AverageStarch)</td>
                                <td>@point.Summary.StarchRepresentedFruitCount / @Model.TargetSampleSize</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="muted">Starch change since prior sample: @FormatChange(Change(currentTrend?.Summary.AverageStarch, priorTrend?.Summary.AverageStarch), ""). Change from earliest sample in window: @FormatChange(Change(currentTrend?.Summary.AverageStarch, earliestTrend?.Summary.AverageStarch), "").</p>
        }
    </section>

    <section class="panel">
        <h2>Pressure Trend</h2>
        @if (Model.Trend.Count <= 1)
        {
            <p class="muted">No earlier pressure history for this block in the last 30 days.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Date</th><th>Avg pressure</th><th>Peak pressure</th><th>Pressure SD</th><th>Represented fruit</th></tr></thead>
                    <tbody>
                        @foreach (var point in orderedTrend)
                        {
                            <tr class="@(point.SampleId == Model.SampleId ? "selected-row" : null)">
                                <td>@point.SampleTakenAt.LocalDateTime.ToString("MMM d, h:mm tt")</td>
                                <td>@Format(point.Summary.AveragePressureLbs) lb</td>
                                <td>@Format(point.Summary.PeakPressureLbs) lb</td>
                                <td>@(point.Summary.PressureStandardDeviationLbs?.ToString("0.##") ?? "Insufficient")</td>
                                <td>@point.Summary.PressureReadingCount / @Model.TargetSampleSize</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="muted">Average pressure change from earliest sample in window: @FormatChange(Change(currentTrend?.Summary.AveragePressureLbs, earliestTrend?.Summary.AveragePressureLbs), "lb").</p>
        }
    </section>

    <section class="panel">
        <h2>Size Trend</h2>
        @if (sizeTrend.Count <= 1 || trendSizes.Count == 0)
        {
            <p class="muted">No earlier size distribution for this block in the last 30 days.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            @foreach (var size in trendSizes)
                            {
                                <th>@size</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var point in sizeTrend)
                        {
                            <tr class="@(point.SampleId == Model.SampleId ? "selected-row" : null)">
                                <td>@point.SampleTakenAt.LocalDateTime.ToString("MMM d")</td>
                                @foreach (var size in trendSizes)
                                {
                                    <td>@(point.SizeDistribution.SingleOrDefault(x => x.Size == size)?.Percentage.ToString("0.#") ?? "0")%</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="muted">Size trend values are percentage-point distributions by represented size rows.</p>
        }
    </section>

    @if (Model.CanEdit)
    {
        <section class="panel">
            <h2>FTA Pressure Capture</h2>
            <p>FTA pressure capture is done through the local QC Station app. The browser does not connect directly to the physical FTA DLL.</p>
            <p>Selected sample: <strong>@Model.OrchardName - @Model.CanonicalBlockName</strong> | Field Sample ID: <code>@Model.SampleId</code></p>
            <p>Click Open in QC Station to launch the local WinForms app for this Field Sample. Use the station app for FTA pressure readings, then save/retry pressures from the station. Manual pressure entry remains available here.</p>
            <p>
                <button type="button" class="secondary-button" data-copy-sample-id="@Model.SampleId">Copy Sample ID</button>
                <a class="button secondary-button" href="cropqcstation://sample/@Model.SampleId">Open in QC Station</a>
                <button type="button" class="secondary-button" data-refresh-field-sample>Refresh readings</button>
            </p>
            <div class="notice" data-qc-station-state="@Model.QcStationStatus.State">
                <strong>QC Station: <span data-qc-station-label>@Model.QcStationStatus.State</span></strong>
                <span data-qc-station-message>@Model.QcStationStatus.Message</span>
            </div>
            <p class="notice warning" data-field-server-update hidden>New readings are available, but refresh is paused to protect unsaved Field Sample changes. Save or discard those changes, then retry.</p>
            <p class="muted">The installed QC Station reads its enrolled workstation configuration, opens this exact sample ID, and synchronizes pressure-only changes through the dashboard API. This page checks for returned readings automatically.</p>
        </section>

        @await Html.PartialAsync("_DeviceCapturePanel", new DeviceCapturePanelViewModel(
            Model.DeviceCapture,
            SamplePhotoAction: $"/FieldSamples/{Model.SampleId}/photos",
            ShowApplePhotos: true,
            ShowScale: true,
            RequiresSavedTargetMessage: "Field Sample rows are saved on this page. Scale capture fills the selected weight input; save the Field Sample to persist it."))

        <form method="post" action="/FieldSamples/@Model.SampleId/rows" class="panel" id="field-sample-rows-form">
            <input type="hidden" name="SampleId" value="@Model.SampleId" />
            <input type="hidden" name="TargetSampleSize" value="@Model.TargetSampleSize" data-field-target-size />
            <h2>Fruit Rows</h2>
            <p class="muted">Field Samples save partially. Weight, starch, and pressure are optional per row until the sample is complete. Scale capture writes to the selected row's weight field; FTA capture uses QC Station and the same pressure fields.</p>
            <div class="table-wrap">
                <table class="qc-grid">
                    <thead>
                        <tr>
                            <th>Row</th>
                            <th>P1 lbs</th>
                            <th>P2 lbs</th>
                            <th>Avg lbs</th>
                            <th>Weight g</th>
                            <th>Size</th>
                            <th>Starch</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.FruitRows.Count; i++)
                        {
                            var row = Model.FruitRows[i];
                            <tr class="fruit-row" data-row-index="@i" data-row-number="@row.RowNumber">
                                <td>@row.RowNumber<input type="hidden" name="Rows[@i].RowNumber" value="@row.RowNumber" /></td>
                                <td><input class="number-input" name="Rows[@i].Pressure1Lbs" type="number" step="0.01" min="0" value="@row.Pressure1Lbs" /><input type="hidden" name="Rows[@i].OriginalPressure1Lbs" value="@row.Pressure1Lbs" /></td>
                                <td><input class="number-input" name="Rows[@i].Pressure2Lbs" type="number" step="0.01" min="0" value="@row.Pressure2Lbs" /><input type="hidden" name="Rows[@i].OriginalPressure2Lbs" value="@row.Pressure2Lbs" /></td>
                                <td data-pressure-average>@row.PressureAverageLbs</td>
                                <td><input class="number-input" name="Rows[@i].WeightGrams" type="number" step="0.0001" min="0" value="@row.WeightGrams" /></td>
                                <td data-size-category>@row.SizeCategory</td>
                                <td>
                                    <select name="Rows[@i].StarchScaleValueId">
                                        <option value="">--</option>
                                        @foreach (var starch in Model.StarchScaleValues)
                                        {
                                            <option value="@starch.Id" selected="@(row.StarchScaleValueId == starch.Id ? "selected" : null)">@starch.Value.ToString("0.0")</option>
                                        }
                                    </select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="button-row">
                <button type="submit">Save Field Sample</button>
                <button type="button" class="secondary-button" data-add-field-row>Add fruit row</button>
            </div>
        </form>
    }
    else
    {
        <section class="panel">
            <h2>Fruit Rows</h2>
            <p class="muted">View-only users cannot edit Field Sample rows.</p>
            <div class="table-wrap">
                <table class="qc-grid">
                    <thead><tr><th>Row</th><th>P1 lbs</th><th>P2 lbs</th><th>Avg lbs</th><th>Weight g</th><th>Size</th><th>Starch</th></tr></thead>
                    <tbody>
                        @foreach (var row in Model.FruitRows)
                        {
                            <tr>
                                <td>@row.RowNumber</td>
                                <td>@Format(row.Pressure1Lbs)</td>
                                <td>@Format(row.Pressure2Lbs)</td>
                                <td>@Format(row.PressureAverageLbs)</td>
                                <td>@Format(row.WeightGrams)</td>
                                <td>@(row.SizeCategory?.ToString() ?? "Missing")</td>
                                <td>@(row.Starch ?? "Missing")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <section>
        <h2>Field Sample Photos</h2>
        <div class="grid-two">
            <div class="panel">
                <h3>Saved Photos</h3>
                @await Html.PartialAsync("_PhotoGroups", Model.PhotoGroups)
            </div>
            @if (Model.CanEdit)
            {
                @await Html.PartialAsync("_PhotoPlaceholderForm", new PhotoPlaceholderFormViewModel
                {
                    FormAction = $"/FieldSamples/{Model.SampleId}/photos",
                    Title = "Add Field Sample Photo",
                    DefaultPhotoType = "SampleBeforeCutting",
                    PhotoTypes = ["SampleBeforeCutting", "CutFruit", "FruitAfterStarch", "Other"],
                    CropYear = Model.SampleTakenAt.Year,
                    Warehouse = "FIELD",
                    ReceiptId = $"FieldSample-{Model.SampleId}"
                })
            }
        </div>
    </section>
}

<script>
    (() => {
        document.querySelector("[data-copy-sample-id]")?.addEventListener("click", async event => {
            const sampleId = event.currentTarget.dataset.copySampleId;
            try {
                await navigator.clipboard.writeText(sampleId);
                event.currentTarget.textContent = "Copied Sample ID";
                setTimeout(() => event.currentTarget.textContent = "Copy Sample ID", 2000);
            } catch {
                window.prompt("Copy Field Sample ID", sampleId);
            }
        });

        const form = document.querySelector("#field-sample-rows-form");
        const addButton = document.querySelector("[data-add-field-row]");
        let dirty = false;
        const updateWarning = document.querySelector("[data-field-server-update]");

        function markDirty() {
            dirty = true;
        }

        form?.addEventListener("input", markDirty);
        form?.addEventListener("change", markDirty);

        function updateStationStatus(station) {
            const state = document.querySelector("[data-qc-station-state]");
            const label = document.querySelector("[data-qc-station-label]");
            const message = document.querySelector("[data-qc-station-message]");
            if (state) state.dataset.qcStationState = station?.state || "Error";
            if (label) label.textContent = station?.state || "Error";
            if (message) message.textContent = station?.message || "QC Station status could not be checked. Use Retry after confirming network access.";
        }

        function updateRows(rows) {
            for (const row of rows || []) {
                const tr = document.querySelector(`.fruit-row[data-row-number='${row.rowNumber}']`);
                if (!tr) continue;
                for (const slot of [1, 2]) {
                    const value = row[`pressure${slot}Lbs`] ?? "";
                    const input = tr.querySelector(`[name$='.Pressure${slot}Lbs']`);
                    const original = tr.querySelector(`[name$='.OriginalPressure${slot}Lbs']`);
                    if (input) input.value = value;
                    if (original) original.value = value;
                }
                tr.querySelector("[data-pressure-average]")?.replaceChildren(document.createTextNode(row.pressureAverageLbs ?? ""));
                tr.querySelector("[data-size-category]")?.replaceChildren(document.createTextNode(row.sizeCategory ?? ""));
            }
        }

        async function refreshFieldSample(manual = false) {
            if (dirty) {
                if (updateWarning) updateWarning.hidden = false;
                return;
            }
            try {
                const response = await fetch(`/FieldSamples/@Model.SampleId/refresh`, { credentials: "same-origin", cache: "no-store" });
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                const data = await response.json();
                updateRows(data.rows);
                updateStationStatus(data.qcStation);
                if (updateWarning) updateWarning.hidden = true;
            } catch (error) {
                updateStationStatus({ state: "Error", message: `QC Station status check failed (${error.message}). Check dashboard connectivity, then retry.` });
            }
        }

        document.querySelector("[data-refresh-field-sample]")?.addEventListener("click", () => refreshFieldSample(true));
        window.setInterval(() => refreshFieldSample(false), 3000);

        if (!form || !addButton) return;

        const targetSizeInput = form.querySelector("[data-field-target-size]");
        const tbody = form.querySelector("tbody");
        const maxRows = 50;
        const starchOptions = Array.from(form.querySelectorAll("select[name$='.StarchScaleValueId'] option"))
            .map(option => `<option value="${option.value}">${option.textContent}</option>`)
            .join("");

        addButton.addEventListener("click", () => {
            markDirty();
            const rows = Array.from(tbody.querySelectorAll("tr.fruit-row"));
            if (rows.length >= maxRows) {
                addButton.disabled = true;
                return;
            }

            const index = rows.length;
            const rowNumber = index + 1;
            const tr = document.createElement("tr");
            tr.className = "fruit-row device-selected-row";
            tr.dataset.rowIndex = String(index);
            tr.dataset.rowNumber = String(rowNumber);
            tr.innerHTML = `
                <td>${rowNumber}<input type="hidden" name="Rows[${index}].RowNumber" value="${rowNumber}" /></td>
                <td><input class="number-input" name="Rows[${index}].Pressure1Lbs" type="number" step="0.01" min="0" /><input type="hidden" name="Rows[${index}].OriginalPressure1Lbs" /></td>
                <td><input class="number-input" name="Rows[${index}].Pressure2Lbs" type="number" step="0.01" min="0" /><input type="hidden" name="Rows[${index}].OriginalPressure2Lbs" /></td>
                <td data-pressure-average></td>
                <td><input class="number-input" name="Rows[${index}].WeightGrams" type="number" step="0.0001" min="0" /></td>
                <td data-size-category></td>
                <td><select name="Rows[${index}].StarchScaleValueId">${starchOptions}</select></td>`;
            tbody.querySelectorAll("tr.fruit-row").forEach(row => row.classList.remove("device-selected-row"));
            tbody.appendChild(tr);
            targetSizeInput.value = String(rowNumber);
            if (rowNumber >= maxRows) {
                addButton.disabled = true;
            }
        });
    })();
</script>

@functions {
    private static string Format(decimal? value) => value?.ToString("0.##") ?? "Missing";
    private static decimal? Change(decimal? current, decimal? prior) => current is null || prior is null ? null : decimal.Round(current.Value - prior.Value, 2);
    private static string FormatChange(decimal? change, string unit) => change is null ? "Not available" : $"{(change.Value > 0 ? "+" : "")}{change.Value:0.##}{(string.IsNullOrWhiteSpace(unit) ? "" : " " + unit)}";
}
