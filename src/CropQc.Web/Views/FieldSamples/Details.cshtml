@model FieldSampleDetailViewModel
@{
    ViewData["Title"] = "Field Sample Detail";
    var pressureChange = Model.CurrentSummary.AveragePressureChangeFromPriorLbs;
    var orderedTrend = Model.Trend.OrderBy(x => x.SampleTakenAt).ThenBy(x => x.SampleId).ToList();
    var currentTrend = orderedTrend.SingleOrDefault(x => x.SampleId == Model.SampleId);
    var priorTrend = orderedTrend.Where(x => x.SampleTakenAt < Model.SampleTakenAt).OrderByDescending(x => x.SampleTakenAt).ThenByDescending(x => x.SampleId).FirstOrDefault();
    var earliestTrend = orderedTrend.FirstOrDefault(x => x.SampleId != Model.SampleId) ?? currentTrend;
    var sizeTrend = orderedTrend.Where(x => x.SizeDistribution.Count > 0).ToList();
    var trendSizes = sizeTrend.SelectMany(x => x.SizeDistribution.Select(point => point.Size)).Distinct().OrderBy(x => x).ToList();
    var sizeThresholdJson = System.Text.Json.JsonSerializer.Serialize(Model.SizeThresholds.Select(x => new { sizeCategory = x.SizeCategory, minimumWeightGrams = x.MinimumWeightGrams }));
}

<h1>Field Sample Detail</h1>
@if (Model.CanEdit && Model.SampleId > 0)
{
    <div class="field-autosave-status" data-field-autosave-status aria-live="polite">
        <strong data-autosave-label>Saved</strong>
        <span class="muted" data-autosave-time>@(Model.UpdatedAt is null ? "" : $"Last saved {BusinessTime.FormatPacific(Model.UpdatedAt.Value, "h:mm:ss tt zzz")}")</span>
        <button type="button" class="secondary-button" data-save-now>Save Now</button>
    </div>
    <div class="notice warning" data-autosave-errors hidden></div>
}
@if (TempData["Success"] is string success)
{
    <p class="notice success">@success</p>
}
@if (TempData["Error"] is string error)
{
    <p class="notice error">@error</p>
}
@if (Model.DataWarning is not null)
{
    <p class="notice warning">@Model.DataWarning</p>
}

@if (Model.SampleId > 0)
{
    <section class="panel">
        <div class="section-heading-row">
            <div>
                <h2>@Model.OrchardName - @Model.CanonicalBlockName</h2>
                <p>Field Sample | @Model.Variety | @BusinessTime.FormatPacific(Model.SampleTakenAt) | Target sample size: @Model.TargetSampleSize fruit</p>
            </div>
            @if (Model.CanEdit && !Model.IsEditingMetadata)
            {
                <div class="button-row">
                    <a class="button secondary-button" href="/FieldSamples/@Model.SampleId/Edit">Edit Field Sample</a>
                    <a class="button secondary-button" href="#sample-photos">Sample Photos</a>
                    <a class="button secondary-button" href="/FieldSamples/@Model.SampleId/report" data-requires-autosave>Preview Report</a>
                </div>
            }
        </div>
        @if (!string.Equals(Model.CanonicalBlockName, Model.OriginalBlockName, StringComparison.OrdinalIgnoreCase))
        {
            <p class="muted">Original entered block: @Model.OriginalBlockName</p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <p>@Model.Notes</p>
        }
    </section>

    @if (Model.IsEditingMetadata && Model.CanEdit)
    {
        <form method="post" action="/FieldSamples/@Model.SampleId/metadata" class="panel stack-form" data-field-metadata-form>
            <h2>Edit Field Sample Details</h2>
            <input type="hidden" name="SampleId" value="@Model.SampleId" />
            <div class="grid-two">
                <label>Orchard <input name="OrchardName" data-autosave-field="OrchardName" value="@Model.MetadataForm.OrchardName" maxlength="200" required /></label>
                <label>Grower number <input name="GrowerNumber" data-autosave-field="GrowerNumber" value="@Model.MetadataForm.GrowerNumber" maxlength="50" /></label>
                <label>Block name entered <input name="BlockName" data-autosave-field="BlockName" value="@Model.MetadataForm.BlockName" maxlength="150" required /></label>
                <label>
                    Existing block
                    <select name="CanonicalOrchardBlockId" data-autosave-field="CanonicalOrchardBlockId">
                        <option value="">Resolve automatically or create a new block</option>
                        @foreach (var block in Model.Blocks)
                        {
                            <option value="@block.Id" selected="@(Model.MetadataForm.CanonicalOrchardBlockId == block.Id ? "selected" : null)">@block.OrchardName - @block.CanonicalBlockName</option>
                        }
                    </select>
                </label>
                <label>
                    Variety
                    <select name="FruitProfileId" data-autosave-field="FruitProfileId" data-fruit-profile required>
                        @foreach (var fruit in Model.FruitProfiles)
                        {
                            <option value="@fruit.Id" data-fruit-type="@fruit.FruitType" selected="@(Model.MetadataForm.FruitProfileId == fruit.Id ? "selected" : null)">@fruit.Name</option>
                        }
                    </select>
                </label>
                <label>Sample date/time <input name="SampleTakenAt" data-autosave-field="SampleTakenAt" type="datetime-local" value="@BusinessTime.FormatPacificInput(Model.MetadataForm.SampleTakenAt)" required /></label>
            </div>
            <label>Notes <textarea name="Notes" data-autosave-field="Notes" maxlength="1000">@Model.MetadataForm.Notes</textarea></label>
            <label class="checkbox-line">
                <input name="ConfirmCreateNewBlock" data-autosave-field="ConfirmCreateNewBlock" type="checkbox" value="true" checked="@Model.MetadataForm.ConfirmCreateNewBlock" />
                Create new block if no exact block or alias matches
            </label>
            <div class="button-row">
                <button type="submit">Save Now</button>
                <a href="/FieldSamples/@Model.SampleId">Cancel</a>
            </div>
        </form>
    }

    <section class="panel">
        <div class="section-heading-row">
            <div>
                <h2>Field Sample Lifecycle</h2>
                <p><strong>Status:</strong> @Model.LifecycleStatus | <strong>Email:</strong> @Model.EmailStatus</p>
                @if (Model.LastSentAt is not null)
                {
                    <p class="muted">Last sent @BusinessTime.FormatPacific(Model.LastSentAt.Value) by @Model.LastSentBy to @Model.LastRecipientSnapshot</p>
                }
            </div>
            @if (Model.CanEdit)
            {
                <div class="button-row">
                    @if (Model.CanMarkComplete)
                    {
                        <form method="post" action="/FieldSamples/@Model.SampleId/complete" data-requires-autosave>
                            <button type="submit">Mark Complete</button>
                        </form>
                    }
                    <a class="button secondary-button" href="/FieldSamples/@Model.SampleId/report" data-requires-autosave>Preview Report</a>
                </div>
            }
        </div>
        @if (Model.ChangedSinceLastSend)
        {
            <p class="notice warning">This Field Sample changed after its most recent send. Preview and explicitly resend the corrected report when ready.</p>
        }
        @if (Model.CompletionMissingItems.Count > 0)
        {
            <p class="muted">Before this sample can be completed or sent:</p>
            <ul>
                @foreach (var item in Model.CompletionMissingItems)
                {
                    <li>@item</li>
                }
            </ul>
        }
    </section>

    <section class="panel">
        <h2>Defect Summary and 30-Day Trend</h2>
        @if (Model.CurrentSummary.DefectInspectedFruitCount == 0)
        {
            <p class="muted">Defect entry has not been performed for this sample. This is distinct from inspecting fruit and finding no defects.</p>
        }
        else if (Model.CurrentSummary.DefectDistribution.Count == 0)
        {
            <p>No defects found in @Model.CurrentSummary.DefectInspectedFruitCount inspected fruit.</p>
        }
        else
        {
            <ul class="compact-list">
                @foreach (var defect in Model.CurrentSummary.DefectDistribution)
                {
                    <li><strong>@defect.Defect:</strong> @defect.FruitCount fruit (@defect.PercentageOfInspectedFruit.ToString("0.#")% of inspected fruit)</li>
                }
            </ul>
        }
        <div class="table-wrap">
            <table>
                <thead><tr><th>Date</th><th>Inspected</th><th>Affected</th><th>Percent affected</th><th>Most common defects</th></tr></thead>
                <tbody>
                    @foreach (var point in orderedTrend.Where(x => x.Summary.DefectInspectedFruitCount > 0))
                    {
                        <tr class="@(point.SampleId == Model.SampleId ? "selected-row" : null)">
                            <td>@BusinessTime.FormatPacific(point.SampleTakenAt, "MMM d")</td>
                            <td>@point.Summary.DefectInspectedFruitCount</td>
                            <td>@point.Summary.DefectAffectedFruitCount</td>
                            <td>@point.Summary.DefectAffectedPercentage?.ToString("0.#")%</td>
                            <td>@string.Join(", ", point.Summary.DefectDistribution.OrderByDescending(x => x.FruitCount).Take(3).Select(x => $"{x.Defect} {x.FruitCount}"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="panel">
        <h2>Current Size Distribution</h2>
        @if (Model.SizeDistribution.Count == 0)
        {
            <p class="muted">No sizing data is available for this Field Sample.</p>
        }
        else
        {
            <div class="size-chart compact-chart">
                @foreach (var point in Model.SizeDistribution)
                {
                    <div class="size-bar">
                        <div class="bar" style="height:@Math.Max(4, (int)point.Percentage)%"></div>
                        <span>@point.Size</span>
                        <small>@point.Percentage.ToString("0.#")%</small>
                    </div>
                }
            </div>
            <p class="muted">Percentages use fruit rows with a valid size. Missing sizes are unclassified.</p>
        }
    </section>

    <section class="panel">
        <h2>Weight Trend</h2>
        @if (Model.Trend.Count <= 1)
        {
            <p class="muted">No earlier Field Sample for this block in the last 30 days.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Variety</th>
                            <th>Avg weight</th>
                            <th>Peak weight</th>
                            <th>Rows represented</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var point in orderedTrend)
                        {
                            <tr class="@(point.SampleId == Model.SampleId ? "selected-row" : null)">
                                <td>@BusinessTime.FormatPacific(point.SampleTakenAt, "MMM d, h:mm tt")</td>
                                <td>@point.Variety</td>
                                <td>@Format(point.Summary.AverageWeightGrams) g</td>
                                <td>@Format(point.Summary.PeakWeightGrams) g</td>
                                <td>@point.Summary.WeightRepresentedFruitCount / @point.TargetSampleSize</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="muted">Average weight change since prior sample: @FormatChange(Change(currentTrend?.Summary.AverageWeightGrams, priorTrend?.Summary.AverageWeightGrams), "g"). Change from earliest sample in window: @FormatChange(Change(currentTrend?.Summary.AverageWeightGrams, earliestTrend?.Summary.AverageWeightGrams), "g").</p>
        }
    </section>

    <section class="panel">
        <h2>Starch Trend</h2>
        @if (Model.Trend.Count <= 1)
        {
            <p class="muted">No earlier starch history for this block in the last 30 days.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Date</th><th>Avg starch</th><th>Represented fruit</th></tr></thead>
                    <tbody>
                        @foreach (var point in orderedTrend)
                        {
                            <tr class="@(point.SampleId == Model.SampleId ? "selected-row" : null)">
                                <td>@BusinessTime.FormatPacific(point.SampleTakenAt, "MMM d, h:mm tt")</td>
                                <td>@Format(point.Summary.AverageStarch)</td>
                                <td>@point.Summary.StarchRepresentedFruitCount / @point.TargetSampleSize</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="muted">Starch change since prior sample: @FormatChange(Change(currentTrend?.Summary.AverageStarch, priorTrend?.Summary.AverageStarch), ""). Change from earliest sample in window: @FormatChange(Change(currentTrend?.Summary.AverageStarch, earliestTrend?.Summary.AverageStarch), "").</p>
        }
    </section>

    <section class="panel">
        <h2>Pressure Trend</h2>
        @if (Model.Trend.Count <= 1)
        {
            <p class="muted">No earlier pressure history for this block in the last 30 days.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Date</th><th>Average Pressure</th><th>Peak pressure</th><th>Pressure SD</th><th>Valid side readings</th></tr></thead>
                    <tbody>
                        @foreach (var point in orderedTrend)
                        {
                            <tr class="@(point.SampleId == Model.SampleId ? "selected-row" : null)">
                                <td>@BusinessTime.FormatPacific(point.SampleTakenAt, "MMM d, h:mm tt")</td>
                                <td>@Format(point.Summary.AveragePressureLbs) lb</td>
                                <td>@Format(point.Summary.PeakPressureLbs) lb</td>
                                <td>@(point.Summary.PressureStandardDeviationLbs?.ToString("0.##") ?? "Insufficient")</td>
                                <td>@point.Summary.PressureReadingCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="muted">Average pressure change from earliest sample in window: @FormatChange(Change(currentTrend?.Summary.AveragePressureLbs, earliestTrend?.Summary.AveragePressureLbs), "lb").</p>
        }
    </section>

    <section class="panel">
        <h2>Size Trend</h2>
        @if (sizeTrend.Count <= 1 || trendSizes.Count == 0)
        {
            <p class="muted">No earlier size distribution for this block in the last 30 days.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            @foreach (var size in trendSizes)
                            {
                                <th>@size</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var point in sizeTrend)
                        {
                            <tr class="@(point.SampleId == Model.SampleId ? "selected-row" : null)">
                                <td>@BusinessTime.FormatPacific(point.SampleTakenAt, "MMM d")</td>
                                @foreach (var size in trendSizes)
                                {
                                    <td>@(point.SizeDistribution.SingleOrDefault(x => x.Size == size)?.Percentage.ToString("0.#") ?? "0")%</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="muted">Size trend values are percentage-point distributions by represented size rows.</p>
        }
    </section>

    @if (Model.CanEdit)
    {
        <section class="panel">
            <h2>FTA Pressure Capture</h2>
            <p>FTA pressure capture is done through the local QC Station app. The browser does not connect directly to the physical FTA DLL.</p>
            <p>Selected sample: <strong>@Model.OrchardName - @Model.CanonicalBlockName</strong> | Field Sample ID: <code>@Model.SampleId</code></p>
            <p>Click Open in QC Station to launch the local WinForms app for this Field Sample. Use the station app for FTA pressure readings, then save/retry pressures from the station. Manual pressure entry remains available here.</p>
            <p>
                <button type="button" class="secondary-button" data-copy-sample-id="@Model.SampleId">Copy Sample ID</button>
                <a class="button secondary-button" href="cropqcstation://sample/@Model.SampleId">Open in QC Station</a>
                <button type="button" class="secondary-button" data-refresh-field-sample>Refresh readings</button>
            </p>
            <div class="notice" data-qc-station-state="@Model.QcStationStatus.State">
                <strong>QC Station: <span data-qc-station-label>@Model.QcStationStatus.State</span></strong>
                <span data-qc-station-message>@Model.QcStationStatus.Message</span>
            </div>
            <p class="notice warning" data-field-server-update hidden>New readings are available, but refresh is paused to protect unsaved Field Sample changes. Save or discard those changes, then retry.</p>
            <p class="muted">The installed QC Station reads its enrolled workstation configuration, opens this exact sample ID, and synchronizes pressure-only changes through the dashboard API. This page checks for returned readings automatically.</p>
        </section>

        @await Html.PartialAsync("_DeviceCapturePanel", new DeviceCapturePanelViewModel(
            Model.DeviceCapture,
            SamplePhotoAction: $"/FieldSamples/{Model.SampleId}/photos",
            ShowApplePhotos: true,
            ShowScale: true,
            RequiresSavedTargetMessage: "Scale capture fills the selected weight input, calculates size, and autosaves the row immediately.",
            FruitCameraLabel: Model.Terminology.CameraLabel,
            WholeSampleLabel: Model.Terminology.WholeSampleLabel,
            CutFruitLabel: Model.Terminology.CutFruitLabel))

        <form method="post" action="/FieldSamples/@Model.SampleId/rows" class="panel" id="field-sample-rows-form" data-field-rows-form
              data-autosave-url="/FieldSamples/@Model.SampleId/autosave" data-sample-id="@Model.SampleId" data-autosave-version="@Model.AutosaveVersion">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SampleId" value="@Model.SampleId" />
            <input type="hidden" name="TargetSampleSize" value="@Model.TargetSampleSize" data-field-target-size />
            <h2>Fruit Rows</h2>
            <p class="muted">Changes autosave after a short pause. Weight is the only sizing input; size is calculated from grams and cannot be edited. Mark each fruit as defect-inspected even when no defect is found.</p>
            <div class="table-wrap">
                <table class="qc-grid">
                    <thead>
                        <tr>
                            <th>Row</th>
                            <th>P1 lbs</th>
                            <th>P2 lbs</th>
                            <th>Avg lbs</th>
                            <th>Weight g</th>
                            <th>Size</th>
                            <th>Starch</th>
                            <th>Grade</th>
                            <th>Defects</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.FruitRows.Count; i++)
                        {
                            var row = Model.FruitRows[i];
                            <tr class="fruit-row" data-row-index="@i" data-row-number="@row.RowNumber" data-field-version="@row.FieldVersion">
                                <td>@row.RowNumber<input type="hidden" name="Rows[@i].RowNumber" value="@row.RowNumber" /></td>
                                <td><input class="number-input" name="Rows[@i].Pressure1Lbs" data-autosave-row-field="Pressure1Lbs" type="number" step="0.01" min="0" value="@row.Pressure1Lbs" /><input type="hidden" name="Rows[@i].OriginalPressure1Lbs" value="@row.Pressure1Lbs" /></td>
                                <td><input class="number-input" name="Rows[@i].Pressure2Lbs" data-autosave-row-field="Pressure2Lbs" type="number" step="0.01" min="0" value="@row.Pressure2Lbs" /><input type="hidden" name="Rows[@i].OriginalPressure2Lbs" value="@row.Pressure2Lbs" /></td>
                                <td data-pressure-average>@row.PressureAverageLbs</td>
                                <td>
                                    <input class="number-input" name="Rows[@i].WeightGrams" data-field-weight data-autosave-row-field="WeightGrams" type="number" step="0.0001" min="0" value="@row.WeightGrams" />
                                    <input type="hidden" name="Rows[@i].OriginalWeightGrams" value="@row.WeightGrams" />
                                </td>
                                <td><output data-size-category aria-label="Calculated size for fruit @row.RowNumber">@(row.SizeCategory?.ToString() ?? "Not calculated")</output></td>
                                <td>
                                    <select name="Rows[@i].StarchScaleValueId" data-autosave-row-field="StarchScaleValueId">
                                        <option value="">--</option>
                                        @foreach (var starch in Model.StarchScaleValues)
                                        {
                                            <option value="@starch.Id" selected="@(row.StarchScaleValueId == starch.Id ? "selected" : null)">@starch.Value.ToString("0.0")</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select name="Rows[@i].GradeId" data-autosave-row-field="GradeId">
                                        <option value="">--</option>
                                        @foreach (var grade in Model.Grades)
                                        {
                                            <option value="@grade.Id" selected="@(row.GradeId == grade.Id ? "selected" : null)">@grade.Code</option>
                                        }
                                    </select>
                                </td>
                                <td class="field-defect-cell">
                                    <details>
                                        <summary><span data-defect-indicator>@(row.DefectsInspected ? row.Defects.Count == 0 ? "Inspected — none" : $"{row.Defects.Count} defect(s)" : "Not inspected")</span></summary>
                                        <label class="checkbox-line"><input type="checkbox" name="Rows[@i].DefectsInspected" value="true" data-autosave-row-field="DefectsInspected" checked="@(row.DefectsInspected ? "checked" : null)" /> Inspected for defects</label>
                                        <div class="selected-defects" data-selected-defects>
                                            @foreach (var defectName in row.Defects)
                                            {
                                                <span class="chip">@defectName</span>
                                            }
                                        </div>
                                        <div data-defect-hidden-inputs>
                                            @foreach (var defectId in row.DefectTypeIds)
                                            {
                                                <input type="hidden" name="Rows[@i].DefectTypeIds" value="@defectId" />
                                            }
                                        </div>
                                        <div class="defect-palette">
                                            @foreach (var defect in Model.DefectTypes)
                                            {
                                                <button type="button" class="chip chip-action" data-field-defect-id="@defect.Id" data-defect-name="@defect.Name">@defect.Name</button>
                                            }
                                        </div>
                                        <label>Other notes <input name="Rows[@i].OtherDefectNotes" data-autosave-row-field="OtherDefectNotes" value="@row.OtherDefectNotes" maxlength="500" disabled="@(!row.Defects.Contains("Other") ? "disabled" : null)" /></label>
                                    </details>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="button-row">
                <button type="submit">Save Now</button>
                <button type="button" class="secondary-button" data-add-field-row>Add fruit row</button>
            </div>
        </form>
    }
    else
    {
        <section class="panel">
            <h2>Fruit Rows</h2>
            <p class="muted">View-only users cannot edit Field Sample rows.</p>
            <div class="table-wrap">
                <table class="qc-grid">
                    <thead><tr><th>Row</th><th>P1 lbs</th><th>P2 lbs</th><th>Avg lbs</th><th>Weight g</th><th>Size</th><th>Starch</th><th>Grade</th><th>Defects</th></tr></thead>
                    <tbody>
                        @foreach (var row in Model.FruitRows)
                        {
                            <tr>
                                <td>@row.RowNumber</td>
                                <td>@Format(row.Pressure1Lbs)</td>
                                <td>@Format(row.Pressure2Lbs)</td>
                                <td>@Format(row.PressureAverageLbs)</td>
                                <td>@Format(row.WeightGrams)</td>
                                <td>@(row.SizeCategory?.ToString() ?? "Missing")</td>
                                <td>@(row.Starch ?? "Missing")</td>
                                <td>@(row.Grade ?? "Missing")</td>
                                <td>@(row.DefectsInspected ? row.Defects.Count == 0 ? "Inspected — none" : string.Join(", ", row.Defects) : "Not inspected")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <section id="sample-photos" class="panel">
        <h2>Sample Photos</h2>
        <p>Add one or more JPG, PNG, or WEBP pictures. You can choose files or use the browser camera where supported.</p>
        <div class="grid-two">
            <div>
                <h3>Saved Photos</h3>
                @await Html.PartialAsync("_PhotoGroups", Model.PhotoGroups, new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData)
                {
                    ["WholeSampleLabel"] = Model.Terminology.WholeSampleLabel,
                    ["CutFruitLabel"] = Model.Terminology.CutFruitLabel,
                    ["Commodity"] = Model.Terminology.Commodity
                })
            </div>
            @if (Model.CanEdit)
            {
                @await Html.PartialAsync("_PhotoPlaceholderForm", new PhotoPlaceholderFormViewModel
                {
                    FormAction = $"/FieldSamples/{Model.SampleId}/photos",
                    Title = "Add Field Sample Photo",
                    DefaultPhotoType = "SampleBeforeCutting",
                    PhotoTypes = ["SampleBeforeCutting", "CutFruit", "FruitAfterStarch", "Other"],
                    CropYear = Model.SampleTakenAt.Year,
                    Warehouse = "FIELD",
                    ReceiptId = $"FieldSample-{Model.SampleId}",
                    AllowMultiple = true,
                    FileInputName = "photoFiles",
                    WholeSampleLabel = Model.Terminology.WholeSampleLabel,
                    CutFruitLabel = Model.Terminology.CutFruitLabel
                })
            }
        </div>
    </section>

    <section class="panel" id="final-sample-summary">
        <h2>Final Sample Summary</h2>
        <div class="summary-grid">
            <div><span class="metric-label">Average weight</span><strong>@Format(Model.CurrentSummary.AverageWeightGrams) g</strong><span class="muted">Peak @Format(Model.CurrentSummary.PeakWeightGrams) g | Min @Format(Model.CurrentSummary.MinimumWeightGrams) g | @Model.CurrentSummary.WeightRepresentedFruitCount represented</span></div>
            <div><span class="metric-label">Average starch</span><strong>@Format(Model.CurrentSummary.AverageStarch)</strong><span class="muted">@Model.CurrentSummary.StarchRepresentedFruitCount represented | @Model.CurrentSummary.MissingStarchCount missing</span></div>
            <div><span class="metric-label">Average Pressure</span><strong>@Format(Model.CurrentSummary.AveragePressureLbs) lb</strong><span class="muted">Peak @Format(Model.CurrentSummary.PeakPressureLbs) lb | Min @Format(Model.CurrentSummary.MinimumPressureLbs) lb</span></div>
            <div><span class="metric-label">Pressure variation</span><strong>@(Model.CurrentSummary.PressureStandardDeviationLbs?.ToString("0.##") ?? "Insufficient readings")</strong><span class="muted">@Model.CurrentSummary.PressureReadingCount valid side readings</span></div>
            <div><span class="metric-label">Fruit represented</span><strong>@Model.CurrentSummary.EnteredFruitCount / @Model.TargetSampleSize</strong><span class="muted">Blank values remain missing, not zero</span></div>
            <div><span class="metric-label">Defects</span><strong>@(Model.CurrentSummary.DefectAffectedPercentage?.ToString("0.#") ?? "Not inspected")@(Model.CurrentSummary.DefectAffectedPercentage is null ? "" : "% affected")</strong><span class="muted">@Model.CurrentSummary.DefectAffectedFruitCount affected / @Model.CurrentSummary.DefectInspectedFruitCount inspected</span></div>
        </div>
        <p class="notice @(pressureChange is null ? "warning" : pressureChange < 0 ? "warning" : "success")">
            @if (pressureChange is null)
            {
                <span>No earlier pressure sample in the last 30 days.</span>
            }
            else if (pressureChange < 0)
            {
                <span>Down @Math.Abs(pressureChange.Value).ToString("0.##") lb since @(Model.CurrentSummary.PriorPressureSampleDate is null ? "the prior sample" : BusinessTime.FormatPacific(Model.CurrentSummary.PriorPressureSampleDate.Value, "MMM d")).</span>
            }
            else if (pressureChange > 0)
            {
                <span>Up @pressureChange.Value.ToString("0.##") lb since @(Model.CurrentSummary.PriorPressureSampleDate is null ? "the prior sample" : BusinessTime.FormatPacific(Model.CurrentSummary.PriorPressureSampleDate.Value, "MMM d")).</span>
            }
            else
            {
                <span>No meaningful pressure change since @(Model.CurrentSummary.PriorPressureSampleDate is null ? "the prior sample" : BusinessTime.FormatPacific(Model.CurrentSummary.PriorPressureSampleDate.Value, "MMM d")).</span>
            }
        </p>
    </section>

    @if (Model.SendHistory.Count > 0)
    {
        <section class="panel">
            <h2>Report Send History</h2>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Status</th><th>Sent</th><th>Sender</th><th>Recipients</th><th>Subject</th></tr></thead>
                    <tbody>
                        @foreach (var send in Model.SendHistory)
                        {
                            <tr>
                                <td>@send.Status@(send.IsResend ? " (corrected report)" : "")</td>
                                <td>@(send.SentAt is null ? "Not sent" : BusinessTime.FormatPacific(send.SentAt.Value))</td>
                                <td>@send.SentBy</td>
                                <td>@send.Recipients</td>
                                <td>@send.Subject</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}

<script src="/js/field-sample-autosave.js"></script>
<script>
    window.initializeFieldSampleAutosave?.({
        sampleId: @Model.SampleId,
        refreshUrl: "/FieldSamples/@Model.SampleId/refresh",
        debounceMilliseconds: 1000,
        sizeThresholds: @Html.Raw(sizeThresholdJson)
    });
</script>

@functions {
    private static string Format(decimal? value) => value?.ToString("0.##") ?? "Missing";
    private static decimal? Change(decimal? current, decimal? prior) => current is null || prior is null ? null : decimal.Round(current.Value - prior.Value, 2);
    private static string FormatChange(decimal? change, string unit) => change is null ? "Not available" : $"{(change.Value > 0 ? "+" : "")}{change.Value:0.##}{(string.IsNullOrWhiteSpace(unit) ? "" : " " + unit)}";
}
