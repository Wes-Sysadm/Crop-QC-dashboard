@model FieldSampleIndexViewModel
@{
    ViewData["Title"] = "Field Samples";
}

<h1>Field Samples</h1>
@if (TempData["Success"] is string success)
{
    <p class="notice success">@success</p>
}
@if (TempData["Error"] is string error)
{
    <p class="notice error">@error</p>
}
@if (Model.DataWarning is not null)
{
    <p class="notice warning">@Model.DataWarning</p>
}

<section class="panel">
    <div class="section-heading-row">
        <div>
            <h2>Preharvest samples</h2>
            <p class="muted">Field Samples keep orchard, grower number, and canonical block as separate values. They do not add inventory or require receiving photos.</p>
        </div>
        @if (Model.CanCreate)
        {
            <a class="button" href="/FieldSamples/Create">New Field Sample</a>
        }
    </div>
    <form method="get" class="filter-bar">
        <label>Search <input name="Search" value="@Model.Search.Search" placeholder="Orchard, block, alias, grower #" /></label>
        <label>
            Variety
            <select name="FruitProfileId">
                <option value="">All</option>
                @foreach (var fruit in Model.FruitProfiles)
                {
                    <option value="@fruit.Id" selected="@(Model.Search.FruitProfileId == fruit.Id ? "selected" : null)">@fruit.Name</option>
                }
            </select>
        </label>
        <label>Start <input type="date" name="StartDate" value="@Model.Search.StartDate?.ToString("yyyy-MM-dd")" /></label>
        <label>End <input type="date" name="EndDate" value="@Model.Search.EndDate?.ToString("yyyy-MM-dd")" /></label>
        <label>
            Crop year
            <select name="CropYear">
                <option value="">All</option>
                @foreach (var year in Model.CropYears)
                {
                    <option value="@year" selected="@(Model.Search.CropYear == year ? "selected" : null)">@year</option>
                }
            </select>
        </label>
        <label>
            Completion
            <select name="CompletionStatus">
                <option value="">All</option>
                <option value="In Progress" selected="@(Model.Search.CompletionStatus == "In Progress" ? "selected" : null)">In Progress</option>
                <option value="Complete" selected="@(Model.Search.CompletionStatus == "Complete" ? "selected" : null)">Complete</option>
                <option value="Sent" selected="@(Model.Search.CompletionStatus == "Sent" ? "selected" : null)">Sent</option>
                <option value="Changed Since Last Send" selected="@(Model.Search.CompletionStatus == "Changed Since Last Send" ? "selected" : null)">Changed Since Last Send</option>
            </select>
        </label>
        @if (Model.CanAdminister)
        {
            <label>
                Records
                <select name="DeletionStatus">
                    <option value="Active" selected="@(Model.Search.DeletionStatus == "Active" ? "selected" : null)">Active</option>
                    <option value="Deleted" selected="@(Model.Search.DeletionStatus == "Deleted" ? "selected" : null)">Deleted</option>
                    <option value="All" selected="@(Model.Search.DeletionStatus == "All" ? "selected" : null)">All</option>
                </select>
            </label>
        }
        <button type="submit">Filter</button>
    </form>
</section>

<section class="panel">
    <h2>Recent Field Samples</h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Sample date</th>
                    <th>Orchard</th>
                    <th>Grower number</th>
                    <th>Block</th>
                    <th>Variety</th>
                    <th>Entered fruit</th>
                    <th>Avg weight</th>
                    <th>Avg starch</th>
                    <th>Avg pressure</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Samples.Count == 0)
                {
                    <tr>
                        <td colspan="11" class="muted">No Field Samples match these filters.</td>
                    </tr>
                }
                @foreach (var sample in Model.Samples)
                {
                    <tr class="@(sample.IsDeleted ? "deleted-row" : null)">
                        <td>@BusinessTime.FormatPacific(sample.SampleTakenAt)</td>
                        <td>@sample.OrchardName</td>
                        <td>@(string.IsNullOrWhiteSpace(sample.GrowerNumber) ? "—" : sample.GrowerNumber)</td>
                        <td>
                            <strong>@sample.BlockName</strong>
                            @if (!string.Equals(sample.BlockName, sample.OriginalBlockName, StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="muted">entered as @sample.OriginalBlockName</span>
                            }
                        </td>
                        <td>@sample.Variety</td>
                        <td>@sample.EnteredFruitCount / @sample.TargetSampleSize</td>
                        <td>@(sample.AverageWeightGrams?.ToString("0.##") ?? "Missing") g</td>
                        <td>@(sample.AverageStarch?.ToString("0.##") ?? "Missing")</td>
                        <td>@(sample.AveragePressureLbs?.ToString("0.##") ?? "Missing") lb</td>
                        <td>
                            @if (sample.IsDeleted)
                            {
                                <span class="status-badge error">Deleted</span>
                            }
                            else
                            {
                                @sample.CompletionStatus
                            }
                        </td>
                        <td>
                            <a class="button" href="/FieldSamples/@sample.Id">@(sample.CanEdit ? "Open / Edit" : "View")</a>
                            @if (!sample.IsDeleted)
                            {
                                var reportAction = sample.CompletionStatus switch
                                {
                                    "Sent" => "Preview / Resend",
                                    "Changed Since Last Send" => "Preview / Resend",
                                    "Complete" => "Preview / Send",
                                    _ => "Preview Report"
                                };
                                <a class="button secondary-button" href="/FieldSamples/@sample.Id/report">@reportAction</a>
                            }
                            @if (sample.CanEdit)
                            {
                                <a class="button secondary-button" href="/FieldSamples/@sample.Id/Edit">Edit details</a>
                            }
                            @if (sample.CanDelete)
                            {
                                <a class="button danger-button" href="/FieldSamples/@sample.Id/Delete">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="panel" id="block-trends">
    <div class="section-heading-row">
        <div>
            <h2>Confirmed-block trends</h2>
            <p class="muted">One card per confirmed canonical block in the filtered active samples. Each card uses the 30 days ending with that block's latest matching sample. Deleted samples and unconfirmed block text are excluded.</p>
        </div>
    </div>
    @if (Model.BlockTrends.Count == 0)
    {
        <p class="muted">No confirmed-block trends match the current filters.</p>
    }
    else
    {
        <div class="field-sample-trend-cards">
            @foreach (var trend in Model.BlockTrends)
            {
                @await Html.PartialAsync("_BlockTrendCard", trend)
            }
        </div>
    }
</section>
