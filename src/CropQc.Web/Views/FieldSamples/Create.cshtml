@model FieldSampleCreatePageViewModel
@{
    ViewData["Title"] = "Create Field Sample";
}

<h1>Create Field Sample</h1>
@if (TempData["Error"] is string error)
{
    <p class="notice error">@error</p>
}

<section class="panel">
    <h2>Orchard and block</h2>
    <p class="muted">Field Samples use exactly 10 fruit and do not add inventory. Select an existing canonical block when available, or type a new block name.</p>
    <form method="post" class="stack-form" id="field-sample-create-form">
        <div class="grid-two">
            <label>
                Orchard / grower
                <input name="OrchardName" value="@Model.Form.OrchardName" maxlength="200" required />
            </label>
            <label>
                Grower number
                <input name="GrowerNumber" value="@Model.Form.GrowerNumber" maxlength="50" />
            </label>
            <label>
                Block name entered
                <input name="BlockName" value="@Model.Form.BlockName" maxlength="150" required />
            </label>
            <label>
                Existing block
                <select name="CanonicalOrchardBlockId">
                    <option value="">Resolve automatically or create a new block</option>
                    @foreach (var block in Model.Blocks)
                    {
                        <option value="@block.Id" selected="@(Model.Form.CanonicalOrchardBlockId == block.Id ? "selected" : null)">@block.OrchardName - @block.CanonicalBlockName</option>
                    }
                </select>
            </label>
            <label>
                Variety
                <select name="FruitProfileId" required>
                    <option value="">Select variety</option>
                    @foreach (var fruit in Model.FruitProfiles)
                    {
                        <option value="@fruit.Id" selected="@(Model.Form.FruitProfileId == fruit.Id ? "selected" : null)">@fruit.Name</option>
                    }
                </select>
            </label>
            <label>
                Sample date/time
                <input name="SampleTakenAt" type="datetime-local" value="@Model.Form.SampleTakenAt.LocalDateTime.ToString("yyyy-MM-ddTHH:mm")" required />
            </label>
        </div>
        <label>
            Notes
            <textarea name="Notes" maxlength="1000">@Model.Form.Notes</textarea>
        </label>
        <label class="checkbox-line">
            <input name="ConfirmCreateNewBlock" type="checkbox" value="true" checked="@Model.Form.ConfirmCreateNewBlock" />
            Create new block if no exact block or alias matches
        </label>
        <p class="muted">Suggested block matches require selection. Choosing a suggestion maps this sample to that block and saves this spelling as an alias.</p>
        <div class="button-row">
            <button type="submit">Create 10-fruit Field Sample</button>
            <a href="/FieldSamples">Cancel</a>
        </div>
    </form>
</section>

<section class="panel">
    <h2>Block matching</h2>
    <p class="muted">Exact block names and known aliases are used automatically. Similar block names are suggestions only and require you to choose the block.</p>
    <div id="block-suggestions" class="compact-list" aria-live="polite">Enter orchard and block to review suggestions.</div>
</section>

<script>
(() => {
    const form = document.querySelector("#field-sample-create-form");
    const target = document.querySelector("#block-suggestions");
    if (!form || !target) return;
    let timer = null;
    async function loadSuggestions() {
        const orchardName = form.querySelector("[name='OrchardName']").value;
        const blockName = form.querySelector("[name='BlockName']").value;
        if (!orchardName.trim() || !blockName.trim()) {
            target.textContent = "Enter orchard and block to review suggestions.";
            return;
        }
        const response = await fetch(`/FieldSamples/Suggestions?orchardName=${encodeURIComponent(orchardName)}&blockName=${encodeURIComponent(blockName)}`);
        const suggestions = await response.json();
        if (!suggestions.length) {
            target.textContent = "No close existing blocks found for this orchard. Saving will create a new canonical block.";
            return;
        }
        target.replaceChildren(...suggestions.map(item => {
            const button = document.createElement("button");
            button.type = "button";
            button.className = "chip chip-action";
            button.dataset.blockId = item.blockId;
            button.textContent = `Suggested block: ${item.canonicalBlockName} - Use this block`;
            return button;
        }));
        target.querySelectorAll("[data-block-id]").forEach(button => {
            button.addEventListener("click", () => {
                form.querySelector("[name='CanonicalOrchardBlockId']").value = button.dataset.blockId;
            });
        });
    }
    form.addEventListener("input", event => {
        if (!event.target.matches("[name='OrchardName'], [name='BlockName']")) return;
        clearTimeout(timer);
        timer = setTimeout(loadSuggestions, 250);
    });
})();
</script>
