@model BinsRunPageViewModel
@{
    ViewData["Title"] = "Bins Run & Transfers";
    var activeSection = string.IsNullOrWhiteSpace(Model.Filter.Section) ? "Planner" : Model.Filter.Section;
    var selected = Model.Planner.SelectedProjection;
    var conversionSource = selected?.Sources.FirstOrDefault(x => x.Id == Model.Filter.ProjectionSourceId);
    var conversionInventory = Model.AvailableInventory.FirstOrDefault(x => x.InventoryKey == conversionSource?.InventoryKey);
    var plannerFacility = Model.Planner.SelectedFacility;
    var plannerVisibility = Model.Planner.SelectedDeletionStatus;
    var plannerSort = Model.Planner.SelectedSort;
    var plannerTodayUrl = $"/BinsRun?Section=Planner&PlannedDate={Model.Planner.PacificToday:yyyy-MM-dd}&RoomId={Model.Filter.RoomId}&Facility={plannerFacility}&ProjectionVisibility={plannerVisibility}&ProjectionSort={plannerSort}";
}

<h1>Bins Run &amp; Transfers</h1>
<p class="muted">Plan future runs, record actual runs, move bins, correct counts, and review audited activity.</p>

@if (TempData["Error"] is string error)
{
    <p class="notice error">@error</p>
}
@if (TempData["Success"] is string success)
{
    <p class="notice success">@success</p>
}

<nav class="operation-tabs" aria-label="Bins Run and Transfers sections">
    <a class="@(activeSection.Equals("Planner", StringComparison.OrdinalIgnoreCase) ? "active" : "")" href="/BinsRun?Section=Planner&amp;RoomId=@Model.Filter.RoomId">Run Planner</a>
    <a class="@(activeSection.Equals("Actual", StringComparison.OrdinalIgnoreCase) ? "active" : "")" href="/BinsRun?Section=Actual&amp;RoomId=@Model.Filter.RoomId">Record Actual Run</a>
    <a class="@(activeSection.Equals("Transfer", StringComparison.OrdinalIgnoreCase) ? "active" : "")" href="/BinsRun?Section=Transfer&amp;RoomId=@Model.Filter.RoomId">Transfer</a>
    <a class="@(activeSection.Equals("TrueUp", StringComparison.OrdinalIgnoreCase) ? "active" : "")" href="/BinsRun?Section=TrueUp&amp;RoomId=@Model.Filter.RoomId">True Up</a>
    <a class="@(activeSection.Equals("Activity", StringComparison.OrdinalIgnoreCase) ? "active" : "")" href="/BinsRun?Section=Activity&amp;RoomId=@Model.Filter.RoomId">Recent Activity</a>
</nav>

@if (activeSection.Equals("Planner", StringComparison.OrdinalIgnoreCase))
{
    @if (!string.IsNullOrWhiteSpace(Model.Planner.PlannerWarning))
    {
        <p class="notice warning">@Model.Planner.PlannerWarning</p>
    }

    <section class="panel">
        <div class="room-card-header">
            <div>
                <h2>Planning Facility</h2>
                <p class="muted">WP and EBS plans stay separate. A Preharvest source identifies where fruit comes from; the facility identifies where it is planned to be packed.</p>
            </div>
            <form method="get" class="inline-form" data-run-planner-preserve-date>
                <input type="hidden" name="Section" value="Planner" />
                <input type="hidden" name="PlannedDate" value="@Model.Planner.SelectedDate.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="Facility" value="@plannerFacility" />
                <label>Show
                    <select name="ProjectionVisibility" onchange="this.form.submit()" disabled="@(!Model.Planner.CanViewDeleted)">
                        <option value="Active" selected="@(plannerVisibility == "Active")">Active</option>
                        <option value="Deleted" selected="@(plannerVisibility == "Deleted")">Deleted</option>
                        <option value="All" selected="@(plannerVisibility == "All")">Active + deleted</option>
                    </select>
                </label>
                @if (!Model.Planner.CanViewDeleted)
                {
                    <input type="hidden" name="ProjectionVisibility" value="Active" />
                }
                <label>Sort
                    <select name="ProjectionSort" onchange="this.form.submit()">
                        <option value="Facility" selected="@(plannerSort == "Facility")">Facility</option>
                        <option value="RunDate" selected="@(plannerSort == "RunDate")">Run date</option>
                        <option value="Status" selected="@(plannerSort == "Status")">Status</option>
                        <option value="Updated" selected="@(plannerSort == "Updated")">Recently updated</option>
                        <option value="PlannedBins" selected="@(plannerSort == "PlannedBins")">Planned bins</option>
                    </select>
                </label>
            </form>
        </div>
        <nav class="operation-tabs facility-selector" aria-label="Planning facility">
            @foreach (var facilityCode in new[] { "WP", "EBS", "All" })
            {
                <a class="@(plannerFacility == facilityCode ? "active" : "")"
                   data-run-planner-preserve-date
                   href="/BinsRun?Section=Planner&amp;PlannedDate=@Model.Planner.SelectedDate.ToString("yyyy-MM-dd")&amp;Facility=@facilityCode&amp;ProjectionVisibility=@plannerVisibility&amp;ProjectionSort=@plannerSort">@facilityCode</a>
            }
            @if (Model.Planner.CanAdmin && Model.Planner.UnassignedProjectionCount > 0)
            {
                <a class="@(plannerFacility == "Unassigned" ? "active" : "")"
                   data-run-planner-preserve-date
                   href="/BinsRun?Section=Planner&amp;PlannedDate=@Model.Planner.SelectedDate.ToString("yyyy-MM-dd")&amp;Facility=Unassigned&amp;ProjectionVisibility=@plannerVisibility&amp;ProjectionSort=@plannerSort">Unassigned (@Model.Planner.UnassignedProjectionCount)</a>
            }
        </nav>
    </section>

    <section class="panel run-planner-calendar"
             data-run-planner-root
             data-pacific-today="@Model.Planner.PacificToday.ToString("yyyy-MM-dd")"
             data-selected-date="@Model.Planner.SelectedDate.ToString("yyyy-MM-dd")"
             data-direct-projection-open="@Model.Planner.IsDirectProjectionOpen.ToString().ToLowerInvariant()"
             data-today-url="@plannerTodayUrl">
        <div class="room-card-header">
            <div>
                <h2>Planned Run Date</h2>
                <p class="muted">Pacific business dates. Opening the planner starts at today and looks forward; saved historical projections remain available.</p>
                <p class="run-calendar-today-summary">
                    <strong>Today</strong>
                    <time datetime="@Model.Planner.PacificToday.ToString("yyyy-MM-dd")">@Model.Planner.PacificToday.ToString("dddd, MMMM d, yyyy") Pacific</time>
                </p>
            </div>
            <div class="action-bar">
                <form method="get" class="inline-form" data-run-planner-preserve-date>
                    <input type="hidden" name="Section" value="Planner" />
                    <input type="hidden" name="RoomId" value="@Model.Filter.RoomId" />
                    <input type="hidden" name="Facility" value="@plannerFacility" />
                    <input type="hidden" name="ProjectionVisibility" value="@plannerVisibility" />
                    <input type="hidden" name="ProjectionSort" value="@plannerSort" />
                    <label>Open date <input type="date" name="PlannedDate" value="@Model.Planner.SelectedDate.ToString("yyyy-MM-dd")" /></label>
                    <button type="submit" class="secondary-button">Go</button>
                </form>
                <a class="button secondary-button"
                   data-run-planner-today-action
                   href="@plannerTodayUrl">Today</a>
            </div>
        </div>
        <div class="run-calendar-days"
             data-run-calendar-days
             tabindex="0"
             aria-label="Run Planner dates from @Model.Planner.CalendarStartDate.ToString("MMMM d, yyyy") through @Model.Planner.CalendarEndDate.ToString("MMMM d, yyyy") Pacific">
            @foreach (var day in Model.Planner.CalendarDays)
            {
                <a class="run-calendar-day @(day.IsSelected ? "selected" : "") @(day.IsToday ? "today" : "")"
                   data-run-calendar-date="@day.Date.ToString("yyyy-MM-dd")"
                   data-run-planner-preserve-date
                   aria-current="@(day.IsSelected ? "date" : null)"
                   aria-label="@($"{day.Date:dddd, MMMM d, yyyy}{(day.IsToday ? ", Today" : "")}{(day.ProjectionCount > 0 ? $", {day.ProjectionCount} saved projection(s)" : "")}")"
                   href="/BinsRun?Section=Planner&amp;PlannedDate=@day.Date.ToString("yyyy-MM-dd")&amp;RoomId=@Model.Filter.RoomId&amp;Facility=@plannerFacility&amp;ProjectionVisibility=@plannerVisibility&amp;ProjectionSort=@plannerSort">
                    @if (day.IsToday)
                    {
                        <b class="run-calendar-today-label">Today</b>
                    }
                    <small>@day.Date.ToString("ddd")</small>
                    <strong>@day.Date.Day</strong>
                    <span>@day.Date.ToString("MMM")</span>
                    @if (day.ProjectionCount > 0)
                    {
                        <i title="@day.ProjectionCount saved projection(s)">@day.ProjectionCount / @day.TotalPlannedBins bins</i>
                        @if (plannerFacility == "All")
                        {
                            <small>WP @day.WpProjectionCount/@day.WpPlannedBins · EBS @day.EbsProjectionCount/@day.EbsPlannedBins</small>
                        }
                    }
                </a>
            }
        </div>
        <div class="run-calendar-shortcuts">
            @if (Model.Planner.HistoricalProjectionDates.Count > 0)
            {
                <form method="get" class="inline-form" data-run-planner-preserve-date>
                    <input type="hidden" name="Section" value="Planner" />
                    <input type="hidden" name="RoomId" value="@Model.Filter.RoomId" />
                    <input type="hidden" name="Facility" value="@plannerFacility" />
                    <input type="hidden" name="ProjectionVisibility" value="@plannerVisibility" />
                    <input type="hidden" name="ProjectionSort" value="@plannerSort" />
                    <label>Earlier saved projection date
                        <select name="PlannedDate" required>
                            <option value="">Choose a date</option>
                            @foreach (var item in Model.Planner.HistoricalProjectionDates)
                            {
                                <option value="@item.Date.ToString("yyyy-MM-dd")">@item.Date.ToString("MMM d, yyyy") — @item.ProjectionCount projection(s), @item.TotalPlannedBins bins</option>
                            }
                        </select>
                    </label>
                    <button type="submit" class="secondary-button">Open earlier date</button>
                </form>
            }
            @if (Model.Planner.LaterProjectionDates.Count > 0)
            {
                <nav class="projection-date-shortcut-list" aria-label="Later scheduled projection dates">
                    <strong>Later scheduled:</strong>
                    @foreach (var item in Model.Planner.LaterProjectionDates)
                    {
                        <a data-run-planner-preserve-date
                           href="/BinsRun?Section=Planner&amp;PlannedDate=@item.Date.ToString("yyyy-MM-dd")&amp;RoomId=@Model.Filter.RoomId&amp;Facility=@plannerFacility&amp;ProjectionVisibility=@plannerVisibility&amp;ProjectionSort=@plannerSort">
                            @item.Date.ToString("MMM d") (@item.ProjectionCount)
                        </a>
                    }
                </nav>
            }
        </div>
        @if (!Model.Planner.HasUpcomingProjections)
        {
            <p class="empty-state">No projections are scheduled from today forward.</p>
        }
    </section>

    @if (Model.Planner.FacilityTotals.Count > 0)
    {
        <section class="panel">
            <h2>@Model.Planner.SelectedDate.ToString("MMM d") Facility Totals</h2>
            <div class="room-summary-metrics">
                @foreach (var total in Model.Planner.FacilityTotals)
                {
                    <div class="metric-card">
                        <span class="metric-label">@total.FacilityCode · @total.ProjectionCount run(s)</span>
                        <strong>@total.PlannedBins bins</strong>
                        <span>@decimal.Floor(total.PackedBoxes) whole packed boxes · @decimal.Floor(total.CullBoxes) whole cull equivalents</span>
                        <span>@(total.EffectivePackoutPercent is decimal pct ? $"{pct:0.##}% effective packout" : "Packout not calculated")</span>
                    </div>
                }
            </div>
        </section>
    }

    <section class="grid-two run-planner-layout">
        <div class="panel">
            <div class="room-card-header">
                <div>
                    <h2>@Model.Planner.SelectedDate.ToString("dddd, MMMM d")</h2>
                    <p class="muted">Saved projections for this date.</p>
                </div>
            </div>
            @if (Model.Planner.Projections.Count == 0)
            {
                <p class="empty-state">No projections are saved for this date.</p>
            }
            else
            {
                <div class="projection-list">
                @foreach (var item in Model.Planner.Projections)
                {
                    <div class="projection-list-row">
                    <a class="projection-list-item @(selected?.Id == item.Id ? "selected" : "")"
                       href="@(item.IsDeleted
                           ? $"/BinsRun?Section=Planner&PlannedDate={item.PlannedRunDate:yyyy-MM-dd}&ProjectionId={item.Id}&RoomId={Model.Filter.RoomId}&Facility={plannerFacility}&ProjectionVisibility={plannerVisibility}&ProjectionSort={plannerSort}"
                           : $"/BinsRun/Projections/{item.Id}/Outcome")">
                        <span class="status pending">@item.ProjectionMode</span>
                        <span><strong><span class="facility-badge">@item.FacilityCode</span> @item.Name</strong><small>@item.Status · @item.SourceCount source(s) @(item.IsDeleted ? "· Deleted" : "")</small></span>
                        <span><strong>@item.TotalPlannedBins bins</strong><small>@decimal.Floor(item.TotalPackedProjectedBoxes) whole packed boxes · @(item.EffectivePackoutPercent is decimal pct ? $"{pct:0.##}% packout" : "packout n/a") · @BusinessTime.FormatPacific(item.UpdatedAt)</small><small class="projection-card-action">@(item.IsDeleted ? "Inspect deleted record" : "View Outcome")</small></span>
                    </a>
                    @if (!item.IsDeleted)
                    {
                        <a class="button secondary-button projection-print-action" href="/BinsRun/Projections/@item.Id/Outcome#print-report">Print Projection</a>
                    }
                    </div>
                }
                </div>
            }
            @if (Model.Planner.CanEdit)
            {
                <form class="form-grid compact-form" method="post" action="/BinsRun/Projections">
                    <h3 class="wide">Create Projection</h3>
                    <input type="hidden" name="Facility" value="@plannerFacility" />
                    <input type="hidden" name="ProjectionVisibility" value="@plannerVisibility" />
                    <input type="hidden" name="ProjectionSort" value="@plannerSort" />
                    <label class="field wide">Which facility is this run for?
                        <select name="FacilityWarehouseId" required>
                            <option value="">Select WP or EBS</option>
                            @foreach (var facilityOption in Model.Planner.FacilityOptions)
                            {
                                <option value="@facilityOption.WarehouseId" selected="@(facilityOption.WarehouseId == Model.Planner.CreateForm.FacilityWarehouseId)">@facilityOption.Code — @facilityOption.Name</option>
                            }
                        </select>
                    </label>
                    <fieldset class="wide planning-mode-selector">
                        <legend>Planning mode</legend>
                        <label class="choice-card">
                            <input type="radio" name="ProjectionMode" value="Preharvest" required />
                            <span><strong>Preharvest — estimate future harvest and packout</strong><small>No receipt, room, or inventory is required.</small></span>
                        </label>
                        <label class="choice-card">
                            <input type="radio" name="ProjectionMode" value="Inventory" required />
                            <span><strong>Inventory — plan fruit already received</strong><small>Use real received inventory and available-bin safeguards.</small></span>
                        </label>
                    </fieldset>
                    <label class="field">Run date
                        <input type="date" name="PlannedRunDate" value="@Model.Planner.SelectedDate.ToString("yyyy-MM-dd")" required />
                    </label>
                    <label class="field">Name / shift
                        <input name="Name" value="@Model.Planner.CreateForm.Name" maxlength="100" required />
                    </label>
                    <button type="submit">Create Draft</button>
                </form>
            }
        </div>

        <div class="panel">
            @if (selected is null)
            {
                <h2>Projection Detail</h2>
                <p class="empty-state">Select or create a projection to begin planning.</p>
            }
            else
            {
                <div class="room-card-header">
                    <div>
                        <h2><span class="facility-badge">@selected.FacilityCode</span> @selected.Name</h2>
                        <p><strong>@selected.ProjectionMode projection</strong> · crop year @selected.CropYear</p>
                        <p>@selected.PlannedRunDate.ToString("dddd, MMMM d, yyyy") · @selected.Creator · updated @BusinessTime.FormatPacific(selected.UpdatedAt)</p>
                    </div>
                    <span class="status @ProjectionStatusClass(selected.Status)">@selected.Status</span>
                </div>
                @if (selected.IsDeleted)
                {
                    <p class="notice warning"><strong>Deleted planning record.</strong> Removed @BusinessTime.FormatPacific(selected.DeletedAt). Reason: @selected.DeletionReason. The projection is read-only and retained for audit/history.</p>
                }
                <div class="room-summary-metrics" data-projection-summary>
                    <div class="metric-card"><span class="metric-label">@(selected.ProjectionMode == "Preharvest" ? "Total Estimated Bins" : "Planned Bins")</span><strong data-total-planned-bins>@selected.TotalPlannedBins</strong></div>
                    <div class="metric-card"><span class="metric-label">Gross Pounds</span><strong>@selected.TotalProjectedPounds.ToString("0")</strong></div>
                    <div class="metric-card"><span class="metric-label">Gross 40-lb Boxes</span><strong>@selected.TotalRoundedProjectedBoxes</strong><span>whole boxes</span></div>
                    <div class="metric-card"><span class="metric-label">Projected Packed Pounds</span><strong>@selected.TotalPackedProjectedPounds.ToString("0.##")</strong></div>
                    <div class="metric-card"><span class="metric-label">Projected Packed 40-lb Boxes</span><strong>@selected.TotalRoundedPackedProjectedBoxes</strong><span>whole boxes</span></div>
                    <div class="metric-card"><span class="metric-label">Projected Cull/Loss Pounds</span><strong>@selected.TotalCullProjectedPounds.ToString("0.##")</strong></div>
                    <div class="metric-card"><span class="metric-label">Projected Cull 40-lb Equivalents</span><strong>@selected.TotalRoundedCullProjectedBoxes</strong><span>whole equivalents</span></div>
                    <div class="metric-card"><span class="metric-label">Effective Combined Packout</span><strong>@(selected.EffectivePackoutPercent is decimal effectivePackout ? $"{effectivePackout:0.##}%" : "Not calculated")</strong></div>
                </div>
                <p class="notice">
                    This planning estimate uses a human Expected Packout assumption. Defect and grade observations are shown for context and are not deducted again automatically.
                </p>
                @if (selected.ProjectionMode == "Preharvest")
                {
                    <p class="notice warning"><strong>Preharvest estimate — fruit has not yet been received into inventory.</strong> Estimated bins are planning values only and do not create, reserve, or reduce inventory.</p>
                }
                else if (selected.SourceProjectionId is long sourceProjectionId)
                {
                    <p class="notice">Inventory projection mapped from Preharvest projection <a href="/BinsRun?Section=Planner&amp;PlannedDate=@selected.PlannedRunDate.ToString("yyyy-MM-dd")&amp;ProjectionId=@sourceProjectionId">#@sourceProjectionId</a>.</p>
                }
                <p class="muted">Assumptions saved with this projection: apples @selected.ApplePoundsPerBin.ToString("0.##") lb/bin; pears @selected.PearPoundsPerBin.ToString("0.##") lb/bin; @selected.StandardBoxWeightPounds.ToString("0.##") lb/box.</p>

                @if (selected.CanEditRecord)
                {
                    <form class="form-grid compact-form" method="post" action="/BinsRun/Projections/@selected.Id/Header">
                        <input type="hidden" name="ConcurrencyVersion" value="@selected.ConcurrencyVersion" />
                        <input type="hidden" name="Facility" value="@plannerFacility" />
                        <input type="hidden" name="ProjectionVisibility" value="@plannerVisibility" />
                        <input type="hidden" name="ProjectionSort" value="@plannerSort" />
                        <label class="field">Facility
                            <select name="FacilityWarehouseId" required>
                                @foreach (var facilityOption in Model.Planner.FacilityOptions)
                                {
                                    <option value="@facilityOption.WarehouseId" selected="@(facilityOption.WarehouseId == selected.FacilityWarehouseId)">@facilityOption.Code</option>
                                }
                            </select>
                        </label>
                        <label class="field">Run date
                            <input type="date" name="PlannedRunDate" value="@selected.PlannedRunDate.ToString("yyyy-MM-dd")" required />
                        </label>
                        <label class="field">Name / shift
                            <input name="Name" value="@selected.Name" maxlength="100" required />
                        </label>
                        <button type="submit">Save Draft</button>
                    </form>

                    <form class="form-grid compact-form run-source-search" method="post" action="/BinsRun/Projections/@selected.Id/Sources"
                          data-projection-mode="@selected.ProjectionMode" data-projection-id="@selected.Id"
                          data-facility-warehouse-id="@selected.FacilityWarehouseId">
                        <input type="hidden" name="ConcurrencyVersion" value="@selected.ConcurrencyVersion" />
                        <input type="hidden" name="plannedDate" value="@selected.PlannedRunDate.ToString("yyyy-MM-dd")" />
                        <h3 class="wide">@(selected.ProjectionMode == "Preharvest" ? "Add Field Sample Block" : "Add Grower Lot")</h3>
                        <label class="field wide">@(selected.ProjectionMode == "Preharvest"
                            ? "Search by orchard, grower, grower number, block, or variety"
                            : "Search by room, lot, grower, orchard, block, variety, or receipt")
                            <input type="search" data-run-source-search value="@Model.Filter.SourceKey" autocomplete="off" />
                        </label>
                        <label class="field wide">@(selected.ProjectionMode == "Preharvest" ? "Confirmed block and variety" : "Received grower lot")
                            <select name="SourceKey" data-run-source-results required>
                                <option value="">Search for a source</option>
                            </select>
                        </label>
                        @if (selected.ProjectionMode == "Preharvest")
                        {
                            <label class="field wide">Field Sample
                                <select name="SelectedQcSource" data-field-sample-results required>
                                    <option value="">Select a block and variety first</option>
                                </select>
                                <a data-field-sample-preview hidden target="_blank" rel="noopener">Preview selected Field Sample report</a>
                            </label>
                        }
                        <label class="field">@(selected.ProjectionMode == "Preharvest" ? "Estimated Bins to Harvest/Pack" : "Total Projected Bins")
                            <input type="number" min="1" name="PlannedBins" value="1" required />
                        </label>
                        @if (selected.ProjectionMode == "Inventory")
                        {
                            <input type="hidden" name="SelectedQcSource" value="Automatic" />
                            <p class="field muted">All completed eligible receipt-backed samples for the grower lot are combined and weighted by each receipt's bins received.</p>
                        }
                        <label class="field">Expected Packout %
                            <input type="number" min="0" max="100" step="0.01" name="ExpectedPackoutPercent"
                                   data-add-packout-input required />
                            <input type="hidden" name="ExpectedPackoutUsedDefault" value="false" data-packout-default-flag />
                            <small>Review and confirm this value before adding the source. Expected Cull/Loss: <span data-add-cull-output>—</span></small>
                        </label>
                        <button type="submit">@(selected.ProjectionMode == "Preharvest" ? "Add Field Sample Block" : "Add Grower Lot")</button>
                    </form>
                }
                @if (selected.Sources.Count > 0)
                {
                    <form class="inline-form" method="post" action="/BinsRun/Projections/@selected.Id/Packout/ApplyAll">
                        <input type="hidden" name="ConcurrencyVersion" value="@selected.ConcurrencyVersion" />
                        <input type="hidden" name="plannedDate" value="@selected.PlannedRunDate.ToString("yyyy-MM-dd")" />
                        <label>Apply Expected Packout % to all current sources
                            <input type="number" min="0" max="100" step="0.01" name="ExpectedPackoutPercent" required />
                        </label>
                        <button type="submit" class="secondary-button">Apply to All</button>
                    </form>
                }
            }
        </div>
    </section>

    @if (selected is not null)
    {
        <section class="panel">
            <h2>Projection Sources</h2>
            @if (selected.Sources.Count == 0)
            {
                <p class="empty-state">Add one or more inventory lots or confirmed Field Sample blocks.</p>
            }
            else
            {
                <div class="projection-source-grid">
                @foreach (var source in selected.Sources.OrderBy(x => x.SortOrder))
                {
                    <article class="station-card" data-projection-source-card="@source.Id">
                        <div class="station-card-header">
                            <div>
                                <h3>@source.SourceLabel</h3>
                                <p class="station-code">@source.SourceType · @source.Variety · @source.Commodity</p>
                            </div>
                            <span class="status @(source.ActualBinsRunEntryId is null ? "pending" : "ready")">@(source.ActualBinsRunEntryId is null ? "Planned" : "Actual linked")</span>
                        </div>
                        <dl class="station-meta">
                            <dt>Location</dt><dd>@(source.Room ?? "Planning-only block")</dd>
                            <dt>Lot / block</dt><dd>@(source.Lot ?? source.Block ?? "-")</dd>
                            <dt>Orchard / grower</dt><dd>@(source.Orchard ?? source.Grower ?? "-")</dd>
                            <dt>Grower number</dt><dd>@(source.GrowerNumber ?? "-")</dd>
                            <dt>Available snapshot</dt><dd>@(source.AvailableBinsSnapshot?.ToString() ?? "Not inventory-backed")</dd>
                            @if (source.SourceType == "GrowerLot")
                            {
                                <dt>Received Bins to Date</dt><dd>@source.ReceivedBinsToDate</dd>
                                <dt>Additional Expected Bins</dt><dd>@source.AdditionalExpectedBins</dd>
                                <dt>Total Projected Bins</dt><dd>@source.PlannedBins</dd>
                                <dt>Last receipt refresh</dt><dd>@BusinessTime.FormatPacific(source.LastRefreshedAt, empty: "Saved at creation")</dd>
                            }
                            else
                            {
                                <dt>@(selected.ProjectionMode == "Preharvest" ? "Estimated bins" : "Planned bins")</dt><dd>@source.PlannedBins</dd>
                            }
                            <dt>QC basis</dt><dd>@source.QcBasis</dd>
                            <dt>Sample status</dt><dd>@(source.QcSampleStatus ?? "-")</dd>
                            <dt>Sample date</dt>
                            <dd>
                                @BusinessTime.FormatPacific(source.QcSampleDate, empty: "No usable sample")
                                @if (source.QcSampleId is long sampleId)
                                {
                                    var sampleUrl = source.SelectedQcSourceType == "FieldSample"
                                        ? $"/FieldSamples/{sampleId}"
                                        : $"/Samples/{sampleId}";
                                    <a href="@sampleUrl">Open sample</a>
                                }
                            </dd>
                            <dt>Fruit rows</dt><dd>@(source.QcFruitCount?.ToString() ?? "-")</dd>
                            <dt>Distribution basis</dt><dd>Size: @source.SizeBasisFruitCount fruit · Grade: @source.GradeBasisFruitCount fruit · Joint: @source.JointSizeGradeBasisFruitCount fruit</dd>
                            <dt>Average weight</dt><dd>@Format(source.AverageWeightGrams, " g")</dd>
                            <dt>Average pressure</dt><dd>@Format(source.AveragePressureLbs, " lb")</dd>
                            <dt>Grades</dt><dd>@(source.GradeSummary ?? "No data")</dd>
                            <dt>Defects</dt><dd>@(source.DefectSummary ?? "No data")</dd>
                            <dt>Expected Packout %</dt><dd>@(source.ExpectedPackoutPercent is null ? "Not specified" : $"{source.ExpectedPackoutPercent:0.##}%") @(source.ExpectedPackoutUsedDefault ? "(suggested — user confirmation required)" : "")</dd>
                            <dt>Expected Cull/Loss %</dt><dd>@(source.ExpectedCullPercent is null ? "Not calculated" : $"{source.ExpectedCullPercent:0.##}%")</dd>
                            <dt>Gross pounds / whole 40-lb boxes</dt><dd>@source.ProjectedPounds.ToString("0.##") lb / @source.RoundedProjectedBoxes</dd>
                            <dt>Projected packed pounds / whole 40-lb boxes</dt><dd>@source.PackedProjectedPounds.ToString("0.##") lb / @source.RoundedPackedProjectedBoxes</dd>
                            <dt>Projected cull pounds / whole 40-lb equivalents</dt><dd>@source.CullProjectedPounds.ToString("0.##") lb / @source.RoundedCullProjectedBoxes</dd>
                            <dt>Calculation version</dt><dd>@source.CalculationVersion</dd>
                        </dl>
                        @if (source.SourceType == "GrowerLot")
                        {
                            <p class="notice">
                                Additional expected bins use the current receipt-bin-weighted distribution for this grower lot.
                                Received fruit is not biologically grown forward.
                            </p>
                            <details>
                                <summary>Contributing receipts and samples</summary>
                                <div class="table-wrap">
                                    <table>
                                        <thead><tr><th>Receipt</th><th>Received</th><th>Bins</th><th>Receipt weight</th><th>Eligible samples</th></tr></thead>
                                        <tbody>
                                        @foreach (var receipt in source.ReceiptContributions)
                                        {
                                            <tr>
                                                <td>@receipt.ReceiptReference (#@receipt.ReceiptId)</td>
                                                <td>@BusinessTime.FormatPacific(receipt.ReceivedAt, "MMM d, yyyy")</td>
                                                <td>@receipt.BinsReceived</td>
                                                <td>@receipt.WeightPercent.ToString("0.##")%</td>
                                                <td>@(receipt.SampleIds.Count == 0 ? "None" : string.Join(", ", receipt.SampleIds.Select(x => $"#{x}")))</td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            </details>
                        }
                        @if (!string.IsNullOrWhiteSpace(source.Warning))
                        {
                            <p class="notice warning">@source.Warning</p>
                        }
                        @if (source.SizeResults.Count > 0)
                        {
                            <details>
                                <summary>View size distribution and projected boxes</summary>
                            <div class="table-wrap">
                                <table>
                                    <thead><tr><th>Size</th><th>Fruit</th><th>Distribution</th><th>Gross</th><th>Packed</th><th>Cull</th></tr></thead>
                                    <tbody>
                                    @foreach (var size in source.SizeResults)
                                    {
                                        <tr><td>@size.Size</td><td>@size.SampleCount</td><td>@size.Percentage.ToString("0.#")%</td><td>@size.RoundedBoxes</td><td>@size.RoundedPackedBoxes</td><td>@size.RoundedCullBoxes</td></tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                            </details>
                        }
                        @if (source.GradeResults.Count > 0)
                        {
                            <details>
                                <summary>View grade distribution and projected boxes</summary>
                            <div class="table-wrap">
                                <table>
                                    <thead><tr><th>Grade</th><th>Fruit</th><th>Distribution</th><th>Gross</th><th>Packed</th><th>Cull</th></tr></thead>
                                    <tbody>
                                    @foreach (var grade in source.GradeResults)
                                    {
                                        <tr><td>@grade.Grade</td><td>@grade.SampleCount</td><td>@grade.Percentage.ToString("0.#")%</td><td>@grade.RoundedGrossBoxes</td><td>@grade.RoundedPackedBoxes</td><td>@grade.RoundedCullBoxes</td></tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                            </details>
                        }
                        @if (selected.CanEditRecord && source.ActualBinsRunEntryId is null)
                        {
                            <form class="form-grid compact-form" method="post" action="/BinsRun/Projections/@selected.Id/Sources/@source.Id" data-projection-source-form>
                                <input type="hidden" name="ConcurrencyVersion" value="@selected.ConcurrencyVersion" />
                                <input type="hidden" name="plannedDate" value="@selected.PlannedRunDate.ToString("yyyy-MM-dd")" />
                                <label class="field">@(source.SourceType == "GrowerLot" ? "Total Projected Bins" : selected.ProjectionMode == "Preharvest" ? "Estimated Bins to Harvest/Pack" : "Planned bins")
                                    <input type="number" min="@(source.SourceType == "GrowerLot" ? Math.Max(1, source.ReceivedBinsToDate ?? 1) : 1)" name="PlannedBins" value="@source.PlannedBins" data-planned-bins required />
                                    @if (source.SourceType == "GrowerLot")
                                    {
                                        <small>Cannot be below @source.ReceivedBinsToDate received bins.</small>
                                    }
                                </label>
                                <label class="field">Expected Packout %
                                    <input type="number" min="0" max="100" step="0.01" name="ExpectedPackoutPercent" value="@source.ExpectedPackoutPercent" data-packout-input />
                                    <small>Expected Cull/Loss: <span data-cull-output>@(source.ExpectedCullPercent?.ToString("0.##") ?? "-")%</span></small>
                                </label>
                                <label class="field">QC data source
                                    <select name="SelectedQcSource">
                                    @foreach (var choice in source.QcChoices)
                                    {
                                        <option value="@choice.Value" selected="@choice.IsSelected">@choice.Label</option>
                                    }
                                    </select>
                                </label>
                                <label class="field">Priority
                                    <input type="number" min="0" name="SortOrder" value="@source.SortOrder" />
                                </label>
                                <label class="field wide">Notes
                                    <input name="Notes" value="@source.Notes" maxlength="1000" />
                                </label>
                                @if (selected.ProjectionMode == "Inventory" && source.SourceType != "GrowerLot")
                                {
                                    <label class="checkbox-field wide">
                                        <input type="checkbox" name="AvailabilityOverrideAcknowledged" value="true" checked="@source.AvailabilityOverrideAcknowledged" />
                                        Acknowledge planning quantity above available snapshot
                                    </label>
                                }
                                <button type="submit">Save Source</button>
                                <span class="muted" data-autosave-status>Saved</span>
                            </form>
                            <div class="action-bar">
                                <form method="post" action="/BinsRun/Projections/@selected.Id/Sources/@source.Id/Remove">
                                    <input type="hidden" name="ConcurrencyVersion" value="@selected.ConcurrencyVersion" />
                                    <input type="hidden" name="plannedDate" value="@selected.PlannedRunDate.ToString("yyyy-MM-dd")" />
                                    <button type="submit" class="secondary-button">Remove Source</button>
                                </form>
                                <form method="post" action="/BinsRun/Projections/@selected.Id/Sources/@source.Id/Refresh">
                                    <input type="hidden" name="ConcurrencyVersion" value="@selected.ConcurrencyVersion" />
                                    <input type="hidden" name="plannedDate" value="@selected.PlannedRunDate.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="confirmRefresh" value="true" />
                                    <button type="submit" class="secondary-button"
                                            onclick="return confirm('Replace this saved source snapshot with current receipts and eligible QC samples? Total Projected Bins will be preserved and the before/after change will be audited.');">
                                        @(source.SourceType == "GrowerLot" ? "Refresh From Current Grower Lot Receipts" : "Refresh From Current QC Data")
                                    </button>
                                </form>
                                @if (source.SourceType == "Inventory" && source.InventoryKey is not null)
                                {
                                    <a class="button" href="/BinsRun?Section=Actual&amp;WarehouseId=@source.WarehouseId&amp;RoomId=@source.RoomId&amp;SourceKey=@Uri.EscapeDataString(source.InventoryKey)&amp;ProjectionId=@selected.Id&amp;ProjectionSourceId=@source.Id">Review Actual Run</a>
                                }
                                else
                                {
                                    <span class="muted">Map this planning-only block to real inventory before recording an actual run.</span>
                                }
                            </div>
                        }
                    </article>
                }
                </div>
            }
        </section>

        <section class="panel" data-combined-results>
            <h2>Projected Fruit Sizing by Calculated Fruit Size</h2>
            <p class="muted">
                @(selected.ProjectionMode == "Preharvest"
                    ? "What size fruit is expected on the planned date? These are biological sizing estimates, not commercial pack names."
                    : "Received-fruit sizing uses the saved receipt-bin-weighted grower-lot distribution. It does not apply biological growth.")
            </p>
            @if (selected.CombinedSizes.Count == 0)
            {
                <p class="empty-state">No calculated size distribution is available.</p>
            }
            else
            {
                var largestPackedSize = Math.Max(1m, selected.CombinedSizes.Max(x => x.RoundedPackedBoxes));
                <div class="projection-bar-chart" role="img" aria-label="Projected packed box equivalents by calculated fruit size">
                    @foreach (var size in selected.CombinedSizes)
                    {
                        <div class="projection-bar-row">
                            <span>@size.Commodity @size.Size</span>
                            <progress value="@size.RoundedPackedBoxes" max="@largestPackedSize">@size.RoundedPackedBoxes</progress>
                            <strong>@size.RoundedPackedBoxes</strong>
                        </div>
                    }
                </div>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Commodity</th><th>Calculated fruit size</th><th>Gross 40-lb equivalents</th><th>Packed 40-lb equivalents</th><th>Cull equivalents</th></tr></thead>
                        <tbody>
                        @foreach (var size in selected.CombinedSizes)
                        {
                            <tr><td>@size.Commodity</td><td>@size.Size</td><td>@size.RoundedBoxes</td><td>@size.RoundedPackedBoxes</td><td>@size.RoundedCullBoxes</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            }

            <section class="subpanel" aria-labelledby="commercial-pack-heading" hidden aria-hidden="true">
                <h2 id="commercial-pack-heading">Projected Packed Boxes by Pack</h2>
                <p class="muted">What commercial packs are expected under the selected plan? Pack allocation uses the sizing projection above without changing growth, bins, or Expected Packout.</p>

                @if (selected.CanEditRecord)
                {
                    @if (selected.PackPlanOptions.Count == 0)
                    {
                        <p class="notice">No active commercial pack plan is configured for crop year @selected.CropYear. A configuration administrator must create a plan before this projection can be marked Ready.</p>
                    }
                    else
                    {
                        <form class="inline-form" method="post" action="/BinsRun/Projections/@selected.Id/PackPlan/Preview">
                            <input type="hidden" name="ConcurrencyVersion" value="@selected.ConcurrencyVersion" />
                            <input type="hidden" name="PlannedRunDate" value="@selected.PlannedRunDate.ToString("yyyy-MM-dd")" />
                            <label>Pack-plan scenario
                                <select name="CommercialPackPlanId" required>
                                    <option value="">Select a configured scenario</option>
                                    @foreach (var plan in selected.PackPlanOptions)
                                    {
                                        <option value="@plan.Id" selected="@(plan.Id == selected.CommercialPackPlanId)">@plan.DisplayName (@plan.PlanType · @plan.Commodity)</option>
                                    }
                                </select>
                            </label>
                            <button type="submit">@(selected.CommercialPackPlanId is null ? "Preview Pack Scenario" : "Recalculate Using Current Pack Configuration")</button>
                        </form>
                    }
                }

                @if (selected.CommercialPackPlanId is null)
                {
                    <p class="empty-state">No commercial pack scenario has been applied. Fruit remains visible in the sizing projection and is not silently assigned to a pack.</p>
                }
                else
                {
                    <p>
                        <strong>Active scenario: @selected.PackPlanName</strong>
                        <span class="status pending">@selected.PackPlanType</span>
                        @if (selected.PackCalculatedAt is not null)
                        {
                            <span class="muted">Saved @BusinessTime.FormatPacific(selected.PackCalculatedAt.Value) · calculation @selected.PackCalculationVersion</span>
                        }
                    </p>

                    @if (selected.PackWarnings.Count > 0)
                    {
                        <div class="notice warning">
                            <strong>Pack projection needs configuration review</strong>
                            <ul>
                                @foreach (var warning in selected.PackWarnings)
                                {
                                    <li>@warning</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (selected.PackResults.Count == 0)
                    {
                        <p class="empty-state">This scenario produced no completed commercial-pack allocation.</p>
                    }
                    else
                    {
                        var largestPackCount = Math.Max(1m, selected.PackResults.Max(x => x.UnroundedPacks));
                        <div class="projection-bar-chart" role="img" aria-label="Projected commercial packs by configured pack">
                            @foreach (var pack in selected.PackResults)
                            {
                                <div class="projection-bar-row">
                                    <span>@pack.PackName @(pack.IsMixedSize ? "(mixed)" : "")</span>
                                    <progress value="@pack.UnroundedPacks" max="@largestPackCount">@pack.UnroundedPacks.ToString("0.##")</progress>
                                    <strong>@pack.UnroundedPacks.ToString("0.##")</strong>
                                </div>
                            }
                        </div>

                        <div class="table-wrap">
                            <table>
                                <thead><tr><th>Pack</th><th>Type</th><th>Eligible calculated sizes</th><th>Rule</th><th>Gross lb</th><th>Assigned packed lb</th><th>Cull/loss lb</th><th>Pack weight</th><th>Projected packs</th><th>Rounded packs</th><th>Residual lb</th><th>% of projected packout</th></tr></thead>
                                <tbody>
                                @foreach (var pack in selected.PackResults)
                                {
                                    var eligibleLeftover = selected.UnallocatedFruit
                                        .Where(x => x.Commodity.Equals(pack.Commodity, StringComparison.OrdinalIgnoreCase)
                                            && pack.EligibleSizes.Contains(x.SizeCategory))
                                        .Sum(x => x.Pounds);
                                    <tr>
                                        <td>
                                            <details>
                                                <summary><strong>@pack.PackCode · @pack.PackName</strong></summary>
                                                <p>@(pack.IsMixedSize ? "Mixed-size" : "Single-size") pack using @pack.MixRule.</p>
                                                <p>Contributions:
                                                    @(pack.Contributions.Count == 0
                                                        ? "None"
                                                        : string.Join("; ", pack.Contributions
                                                            .GroupBy(x => new { x.SourceId, x.SourceLabel, x.SizeCategory })
                                                            .Select(x => $"{x.Key.SourceLabel}, size {x.Key.SizeCategory}: {x.Sum(y => y.AssignedPounds):0.##} packed lb")))
                                                </p>
                                                <p>Leftover eligible packed fruit: @eligibleLeftover.ToString("0.##") lb.</p>
                                                @if (pack.GradeAllocations.Count > 0)
                                                {
                                                    <p>Observed grade allocation: @string.Join("; ", pack.GradeAllocations.Select(x => $"{x.GradeCode}: {x.AssignedPounds:0.##} lb"))</p>
                                                }
                                                @if (pack.GradeWarning is not null)
                                                {
                                                    <p class="notice warning">@pack.GradeWarning</p>
                                                }
                                            </details>
                                        </td>
                                        <td>@pack.PackType</td>
                                        <td>@string.Join(" + ", pack.EligibleSizes)</td>
                                        <td>@pack.MixRule</td>
                                        <td>@pack.GrossAssignedPounds.ToString("0.##")</td>
                                        <td>@pack.AssignedPounds.ToString("0.##")</td>
                                        <td>@pack.CullPounds.ToString("0.##")</td>
                                        <td>@pack.PackageWeightPounds.ToString("0.####") lb</td>
                                        <td>@pack.UnroundedPacks.ToString("0.##")</td>
                                        <td>@pack.RoundedPacks</td>
                                        <td>@pack.RoundingResidualPounds.ToString("0.##")</td>
                                        <td>@pack.PercentageOfProjectedPackout.ToString("0.##")%</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="metric-grid">
                        <div class="metric-card"><span class="metric-label">Standard packs</span><strong>@selected.PackResults.Where(x => x.PackType == "Standard").Sum(x => x.UnroundedPacks).ToString("0.##")</strong></div>
                        <div class="metric-card"><span class="metric-label">Euro packs</span><strong>@selected.PackResults.Where(x => x.PackType == "Euro").Sum(x => x.UnroundedPacks).ToString("0.##")</strong></div>
                        <div class="metric-card"><span class="metric-label">Other packs</span><strong>@selected.PackResults.Where(x => x.PackType == "Other").Sum(x => x.UnroundedPacks).ToString("0.##")</strong></div>
                        <div class="metric-card"><span class="metric-label">Assigned packed fruit</span><strong>@selected.PackAssignedPounds.ToString("0.##") lb</strong></div>
                        <div class="metric-card"><span class="metric-label">Unallocated packed fruit</span><strong>@selected.PackUnallocatedPounds.ToString("0.##") lb</strong></div>
                    </div>

                    <h3>Unallocated Projected Fruit</h3>
                    @if (selected.UnallocatedFruit.Count == 0)
                    {
                        <p>No projected packed fruit remains unallocated.</p>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table>
                                <thead><tr><th>Source</th><th>Commodity</th><th>Calculated size</th><th>Pounds</th><th>40-lb equivalents</th><th>Reason</th></tr></thead>
                                <tbody>
                                @foreach (var row in selected.UnallocatedFruit)
                                {
                                    <tr><td>@row.SourceLabel</td><td>@row.Commodity</td><td>@row.SizeCategory</td><td>@row.Pounds.ToString("0.##")</td><td>@row.StandardBoxEquivalents.ToString("0.##")</td><td>@row.Reason</td></tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }

                    var reconciliationDifference = selected.TotalProjectedPounds
                        - selected.PackAssignedPounds
                        - selected.PackUnallocatedPounds
                        - selected.TotalCullProjectedPounds;
                    <h3>Projection Reconciliation</h3>
                    <p>
                        Gross @selected.TotalProjectedPounds.ToString("0.##") lb =
                        assigned packed @selected.PackAssignedPounds.ToString("0.##") lb +
                        unallocated packed @selected.PackUnallocatedPounds.ToString("0.##") lb +
                        cull/loss @selected.TotalCullProjectedPounds.ToString("0.##") lb.
                        Difference: @reconciliationDifference.ToString("0.####") lb.
                        Rounded-pack residual: @selected.PackRoundingResidualPounds.ToString("0.##") lb.
                    </p>
                }
            </section>
            <p class="notice"><strong>Commercial Packs are not yet available.</strong> Current production projections use whole 40-pound boxes and do not require commercial-pack configuration.</p>

            <h2>Combined Grade Projection</h2>
            @if (selected.CombinedGrades.Count == 0)
            {
                <p class="empty-state">Grade breakdown unavailable. No grade distribution is invented.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Grade</th><th>Gross</th><th>Packed</th><th>Cull</th></tr></thead>
                        <tbody>
                        @foreach (var grade in selected.CombinedGrades)
                        {
                            <tr><td>@grade.Grade</td><td>@grade.RoundedGrossBoxes</td><td>@grade.RoundedPackedBoxes</td><td>@grade.RoundedCullBoxes</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            <h2>Contribution by Block or Lot</h2>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Source</th><th>Bins</th><th>Packout</th><th>Gross boxes</th><th>Packed boxes</th><th>Cull equivalents</th></tr></thead>
                    <tbody>
                    @foreach (var source in selected.Sources.OrderBy(x => x.SortOrder))
                    {
                        <tr>
                            <td>@(source.Block ?? source.Lot ?? source.SourceLabel)</td>
                            <td>@source.PlannedBins</td>
                            <td>@(source.ExpectedPackoutPercent is null ? "Missing" : $"{source.ExpectedPackoutPercent:0.##}%")</td>
                            <td>@source.RoundedProjectedBoxes</td>
                            <td>@source.RoundedPackedProjectedBoxes</td>
                            <td>@source.RoundedCullProjectedBoxes</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (selected.ProjectionMode == "Preharvest" && selected.Sources.Count > 0)
            {
                <section class="subpanel">
                    <h2>Create Inventory Projection From This Plan</h2>
                    <p class="muted">This preserves the Preharvest estimate and creates a separate Inventory projection only after every block is explicitly mapped to a real received lot.</p>
                    @if (selected.Sources.All(x => x.InventoryMappingChoices.Count > 0) && selected.CanEditRecord)
                    {
                        <form class="form-grid compact-form" method="post" action="/BinsRun/Projections/@selected.Id/CreateInventory">
                            <input type="hidden" name="ConcurrencyVersion" value="@selected.ConcurrencyVersion" />
                            <input type="hidden" name="FacilityWarehouseId" value="@selected.FacilityWarehouseId" />
                            <label class="field">Run date
                                <input type="date" name="PlannedRunDate" value="@selected.PlannedRunDate.ToString("yyyy-MM-dd")" required />
                            </label>
                            <label class="field">Projection name
                                <input name="Name" value="@selected.Name inventory" maxlength="100" required />
                            </label>
                            @for (var mappingIndex = 0; mappingIndex < selected.Sources.Count; mappingIndex++)
                            {
                                var source = selected.Sources[mappingIndex];
                                <fieldset class="wide">
                                    <legend>@(source.Block ?? source.SourceLabel) · @source.Variety · @source.PlannedBins estimated bins</legend>
                                    <input type="hidden" name="Mappings[@mappingIndex].PreharvestSourceId" value="@source.Id" />
                                    <label class="field">Real received inventory
                                        <select name="Mappings[@mappingIndex].InventoryKey" required>
                                            <option value="">Select a matching lot</option>
                                            @foreach (var choice in source.InventoryMappingChoices)
                                            {
                                                <option value="@choice.InventoryKey">@choice.Label</option>
                                            }
                                        </select>
                                    </label>
                                    <label class="checkbox-field">
                                        <input type="checkbox" name="Mappings[@mappingIndex].AvailabilityOverrideAcknowledged" value="true" />
                                        Acknowledge if the copied estimate exceeds current available bins
                                    </label>
                                </fieldset>
                            }
                            <button type="submit">Create Mapped Inventory Projection</button>
                        </form>
                    }
                    else
                    {
                        <p class="notice">This action becomes available when every planning block has a matching real receipt or inventory lot with the same confirmed block and variety.</p>
                    }
                </section>
            }
            <div class="action-bar">
                <a class="button" href="/BinsRun/Projections/@selected.Id/Outcome">View Outcome</a>
                @if (selected.CanEditRecord)
                {
                    <form method="post" action="/BinsRun/Projections/@selected.Id/Ready">
                        <input type="hidden" name="ConcurrencyVersion" value="@selected.ConcurrencyVersion" />
                        <input type="hidden" name="plannedDate" value="@selected.PlannedRunDate.ToString("yyyy-MM-dd")" />
                        <button type="submit">Mark Ready</button>
                    </form>
                }
                <form class="inline-form" method="post" action="/BinsRun/Projections/@selected.Id/Duplicate">
                    <label>Duplicate to <input type="date" name="PlannedRunDate" value="@selected.PlannedRunDate.AddDays(1).ToString("yyyy-MM-dd")" required /></label>
                    <label>Facility
                        <select name="FacilityWarehouseId" required>
                            @foreach (var facilityOption in Model.Planner.FacilityOptions)
                            {
                                <option value="@facilityOption.WarehouseId" selected="@(facilityOption.WarehouseId == selected.FacilityWarehouseId)">@facilityOption.Code</option>
                            }
                        </select>
                    </label>
                    <button type="submit" class="secondary-button">Duplicate</button>
                </form>
                @if (Model.Planner.CanAdmin && selected.Status is "Draft" or "Ready")
                {
                    <form class="inline-form" method="post" action="/BinsRun/Projections/@selected.Id/Cancel">
                        <input type="hidden" name="ConcurrencyVersion" value="@selected.ConcurrencyVersion" />
                        <input type="hidden" name="plannedDate" value="@selected.PlannedRunDate.ToString("yyyy-MM-dd")" />
                        <label>Reason <input name="Reason" maxlength="500" required /></label>
                        <button type="submit" class="secondary-button">Cancel</button>
                    </form>
                }
                <a class="button secondary-button" href="/BinsRun/Projections/@selected.Id/Outcome#print-report">Print Projection</a>
                <a class="button secondary-button" href="/BinsRun/Projections/@selected.Id/Export?plannedDate=@selected.PlannedRunDate.ToString("yyyy-MM-dd")&amp;facility=@plannerFacility&amp;projectionVisibility=@plannerVisibility&amp;projectionSort=@plannerSort">Export CSV</a>
                @if (selected.CanDeleteRecord)
                {
                    <a class="button danger-button" href="/BinsRun/Projections/@selected.Id/Delete">Delete Projection</a>
                }
                else if (!selected.IsDeleted && (selected.Status == "Converted to Actual Run" || selected.ConvertedSourceCount > 0))
                {
                    <span class="muted">Deletion unavailable: an actual Bins Run is linked.</span>
                }
            </div>
        </section>
    }

    @if (Model.Planner.RecentActivity.Count > 0)
    {
        <section class="panel">
            <h2>Recent Projection Activity</h2>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Facility</th><th>Projection</th><th>Mode</th><th>Status</th><th>Run date</th><th>Bins</th><th>Updated</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Planner.RecentActivity)
                    {
                        <tr>
                            <td><span class="facility-badge">@item.FacilityCode</span></td>
                            <td><a href="/BinsRun?Section=Planner&amp;PlannedDate=@item.PlannedRunDate.ToString("yyyy-MM-dd")&amp;ProjectionId=@item.Id&amp;Facility=@plannerFacility&amp;ProjectionVisibility=@plannerVisibility&amp;ProjectionSort=@plannerSort">@item.Name</a></td>
                            <td>@item.ProjectionMode</td>
                            <td>@item.Status @(item.IsDeleted ? "· Deleted" : "")</td>
                            <td>@item.PlannedRunDate</td>
                            <td>@item.TotalPlannedBins</td>
                            <td>@BusinessTime.FormatPacific(item.UpdatedAt)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
}
else
{
    <section class="panel">
        <h2>Select Room</h2>
        <form class="toolbar bins-run-filter" method="get" action="/BinsRun">
            <input type="hidden" name="Section" value="@activeSection" />
            <label>Facility
                <select name="WarehouseId" onchange="this.form.submit()">
                    <option value="">All facilities</option>
                    @foreach (var warehouse in Model.Warehouses)
                    {
                        <option value="@warehouse.Id" selected="@(Model.Filter.WarehouseId == warehouse.Id)">@warehouse.Code</option>
                    }
                </select>
            </label>
            <label>Room
                <select name="RoomId" onchange="this.form.submit()">
                    <option value="">Select room</option>
                    @foreach (var room in Model.Rooms)
                    {
                        <option value="@room.Id" selected="@(Model.Filter.RoomId == room.Id)">@room.Warehouse.Code / @(room.CropQcRoomName ?? room.DisplayName ?? room.Code)</option>
                    }
                </select>
            </label>
            <button type="submit">Open</button>
        </form>
    </section>

    @if (activeSection.Equals("Actual", StringComparison.OrdinalIgnoreCase))
    {
        <section class="panel">
            <h2>Record Actual Bins Run</h2>
            @if (Model.Filter.ProjectionId is not null)
            {
                <p class="notice">This form was opened from projection #@Model.Filter.ProjectionId. Review and confirm the actual quantity; the plan has not changed inventory.</p>
                @if (conversionSource?.AvailableBinsSnapshot is int plannedAvailable
                    && conversionInventory is not null
                    && conversionInventory.CurrentBins != plannedAvailable)
                {
                    <p class="notice warning">Inventory changed since planning: @plannedAvailable bins were available when projected; @conversionInventory.CurrentBins are available now. Enter and confirm the actual bins run.</p>
                }
            }
            @if (!Model.CanRecord)
            {
                <p class="notice warning">Bins Run Edit access is required.</p>
            }
            else if (Model.Filter.RoomId is null || Model.AvailableInventory.Count == 0)
            {
                <p class="empty-state">Select a room with available inventory.</p>
            }
            else
            {
                <form class="form-grid" method="post" action="/BinsRun/Create">
                    <input type="hidden" name="WarehouseId" value="@Model.Form.WarehouseId" />
                    <input type="hidden" name="RoomId" value="@Model.Form.RoomId" />
                    <input type="hidden" name="RunProjectionId" value="@Model.Form.RunProjectionId" />
                    <input type="hidden" name="RunProjectionSourceId" value="@Model.Form.RunProjectionSourceId" />
                    <label class="field wide">Inventory source
                        <select name="InventoryKey" data-inventory-select required>
                        @foreach (var option in Model.AvailableInventory)
                        {
                            <option value="@option.InventoryKey" data-bins="@option.CurrentBins" selected="@(option.InventoryKey == Model.Form.InventoryKey)">@option.Label · @option.Room</option>
                        }
                        </select>
                    </label>
                    <label class="field">Current available bins
                        <input name="ExpectedAvailableBins" value="@Model.Form.ExpectedAvailableBins" data-expected-bins readonly />
                    </label>
                    <label class="field">Actual bins run
                        <input type="number" min="1" name="BinsRun" value="@(Model.Filter.ProjectionSourceId is null ? "" : selected?.Sources.FirstOrDefault(x => x.Id == Model.Filter.ProjectionSourceId)?.PlannedBins)" required />
                    </label>
                    <label class="field">Run date/time
                        <input type="datetime-local" name="RunAt" value="@BusinessTime.FormatPacificInput(BusinessTime.UtcNow)" required />
                    </label>
                    <label class="field wide">Notes
                        <textarea name="Notes" maxlength="1000"></textarea>
                    </label>
                    <button type="submit">Record Actual Bins Run</button>
                </form>
            }
        </section>
    }
    else if (activeSection.Equals("Transfer", StringComparison.OrdinalIgnoreCase))
    {
        <section class="panel">
            <h2>Transfer Bins</h2>
            <p class="muted">Uses the existing audited source-neutral Transfer Out / Transfer In workflow and current quantity safeguards.</p>
            @if (!Model.CanTransfer)
            {
                <p class="notice warning">Room Transactions Edit access is required.</p>
            }
            else if (Model.Filter.RoomId is null)
            {
                <p class="empty-state">Select the source room.</p>
            }
            else
            {
                <form class="form-grid" method="post" action="/BinsRun/Transfer">
                    <input type="hidden" name="FromRoomId" value="@Model.Filter.RoomId" />
                    <label class="field wide">Source lot
                        <select name="SourceLotKey" required>
                            <option value="">Select current lot</option>
                            @foreach (var option in Model.TransferLotOptions)
                            {
                                <option value="@option.LotKey" selected="@(option.LotKey == Model.Filter.SourceKey)">@option.Label</option>
                            }
                        </select>
                    </label>
                    <label class="field">Destination room
                        <select name="ToRoomId" required>
                            <option value="">Select destination</option>
                            @foreach (var option in Model.TransferDestinationOptions)
                            {
                                <option value="@option.RoomId">@option.Label</option>
                            }
                        </select>
                    </label>
                    <label class="field">Bins to transfer <input type="number" min="1" name="BinCount" required /></label>
                    <label class="field">Pacific date/time <input type="datetime-local" name="TransferAt" value="@BusinessTime.FormatPacificInput(BusinessTime.UtcNow)" required /></label>
                    <label class="field wide">Reason <input name="Reason" maxlength="500" required /></label>
                    <label class="field wide">Notes <textarea name="Notes" maxlength="1000"></textarea></label>
                    <label class="checkbox-field wide"><input type="checkbox" name="ConfirmOverTransfer" value="true" /> Allow explicit over-transfer correction override</label>
                    <button type="submit">Record Transfer</button>
                </form>
            }
        </section>
    }
    else if (activeSection.Equals("TrueUp", StringComparison.OrdinalIgnoreCase))
    {
        <section class="panel">
            <h2>True Up Inventory</h2>
            <p class="muted">Uses the existing audited current-count correction workflow. No receipt, sample, photo, or history is deleted.</p>
            @if (!Model.CanTrueUp)
            {
                <p class="notice warning">Room Transactions Admin access is required.</p>
            }
            else if (Model.Filter.RoomId is null)
            {
                <p class="empty-state">Select a room.</p>
            }
            else
            {
                <form class="form-grid" method="post" action="/BinsRun/TrueUp">
                    <input type="hidden" name="RoomId" value="@Model.Filter.RoomId" />
                    <label class="field wide">Current receipt-backed lot
                        <select name="ReceiptId" required>
                            <option value="">Select current lot</option>
                            @foreach (var option in Model.TrueUpReceiptOptions)
                            {
                                <option value="@option.ReceiptId">@option.Label</option>
                            }
                        </select>
                    </label>
                    <label class="field">Verified current bin count <input type="number" min="0" name="NewBinCount" required /></label>
                    <label class="field">Pacific as-of time <input type="datetime-local" name="AdjustmentAt" value="@BusinessTime.FormatPacificInput(BusinessTime.UtcNow)" required /></label>
                    <label class="field wide">Reason <input name="Reason" maxlength="500" required /></label>
                    <label class="field wide">Notes <textarea name="Notes" maxlength="1000"></textarea></label>
                    <button type="submit">Record True-Up</button>
                </form>
            }
        </section>
    }

    @if (activeSection.Equals("Actual", StringComparison.OrdinalIgnoreCase) || activeSection.Equals("Activity", StringComparison.OrdinalIgnoreCase))
    {
        <section class="panel">
            <h2>Recent Bins Run History</h2>
            @if (Model.History.Count == 0)
            {
                <p class="empty-state">No Bins Run transactions match the selected room.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>When</th><th>Room</th><th>Inventory</th><th>Old</th><th>Run</th><th>New</th><th>User</th><th>Status</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.History)
                        {
                            <tr>
                                <td>@BusinessTime.FormatPacific(item.RunAt)</td><td>@item.Room</td><td>@item.Inventory</td>
                                <td>@item.PreviousAvailableBins</td><td>@item.BinsRun</td><td>@item.NewAvailableBins</td>
                                <td>@item.CreatedBy</td><td>@(item.IsReversed ? "Reversed" : "Active")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    @if (activeSection.Equals("Activity", StringComparison.OrdinalIgnoreCase))
    {
        <section class="panel">
            <h2>Recent Transfer / True-Up Activity</h2>
            @if (Model.InventoryActivity.Count == 0)
            {
                <p class="empty-state">Select a room to review inventory adjustments.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>When</th><th>Lot</th><th>Type</th><th>Old</th><th>Delta</th><th>New</th><th>Source</th><th>Reason</th><th>User</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.InventoryActivity)
                        {
                            <tr><td>@BusinessTime.FormatPacific(item.AdjustmentAt)</td><td>@item.Lot</td><td>@item.AdjustmentType</td><td>@(item.OldBinCount?.ToString() ?? "-")</td><td>@item.ChangeAmount</td><td>@item.NewBinCount</td><td>@(item.Source ?? "-")</td><td>@(item.Reason ?? item.Notes ?? "-")</td><td>@item.CreatedBy</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
}

<script>
    (() => {
        const plannerRoot = document.querySelector("[data-run-planner-root]");
        const calendar = plannerRoot?.querySelector("[data-run-calendar-days]");
        const selectedDate = plannerRoot?.dataset.selectedDate;
        const pacificToday = plannerRoot?.dataset.pacificToday;
        const directProjectionOpen = plannerRoot?.dataset.directProjectionOpen === "true";
        const todayUrl = plannerRoot?.dataset.todayUrl;
        const preserveKey = "run-planner-preserve-date-once";
        let plannerFormDirty = false;

        const consumePreservedDate = () => {
            try {
                const raw = sessionStorage.getItem(preserveKey);
                sessionStorage.removeItem(preserveKey);
                if (!raw) return false;
                const marker = JSON.parse(raw);
                return marker.date === selectedDate
                    && Number.isFinite(marker.savedAt)
                    && Date.now() - marker.savedAt < 15000;
            } catch {
                try { sessionStorage.removeItem(preserveKey); } catch { }
                return false;
            }
        };
        const preserveDateOnce = (date = selectedDate) => {
            if (!date) return;
            try {
                sessionStorage.setItem(preserveKey, JSON.stringify({ date, savedAt: Date.now() }));
            } catch {
                // Date preservation is a navigation convenience; the server remains authoritative.
            }
        };
        const preserveCurrentDate = consumePreservedDate();

        if (plannerRoot && selectedDate && pacificToday && todayUrl
            && selectedDate !== pacificToday
            && !directProjectionOpen
            && !preserveCurrentDate) {
            window.location.replace(todayUrl);
            return;
        }

        const initialAnchorDate = preserveCurrentDate || directProjectionOpen ? selectedDate : pacificToday;
        const initialAnchor = initialAnchorDate
            ? calendar?.querySelector(`[data-run-calendar-date="${initialAnchorDate}"]`)
            : null;
        if (initialAnchor) {
            requestAnimationFrame(() => {
                initialAnchor.scrollIntoView({ block: "nearest", inline: "start" });
                calendar.dataset.initialAnchor = initialAnchorDate;
            });
        }

        document.querySelectorAll("[data-run-planner-preserve-date]").forEach((control) => {
            if (control.tagName === "FORM") {
                control.addEventListener("submit", () => {
                    const requestedDate = control.querySelector('[name="PlannedDate"]')?.value || selectedDate;
                    preserveDateOnce(requestedDate);
                });
                return;
            }
            control.addEventListener("click", (event) => {
                if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
                const destination = new URL(control.href, window.location.origin);
                preserveDateOnce(destination.searchParams.get("PlannedDate") || selectedDate);
            });
        });

        document.querySelectorAll('form[method="post"] input, form[method="post"] select, form[method="post"] textarea')
            .forEach((control) => {
                control.addEventListener("input", () => { plannerFormDirty = true; });
                control.addEventListener("change", () => { plannerFormDirty = true; });
            });
        document.querySelectorAll('form[method="post"][action^="/BinsRun/Projections"]:not([data-projection-source-form])')
            .forEach((form) => form.addEventListener("submit", () => preserveDateOnce(selectedDate)));

        document.querySelector("[data-run-planner-today-action]")?.addEventListener("click", (event) => {
            const hasPendingAutosave = Array.from(document.querySelectorAll("[data-autosave-status]"))
                .some((status) => /saving|unsaved/i.test(status.textContent || ""));
            if ((plannerFormDirty || hasPendingAutosave)
                && !window.confirm("Unsaved planner changes may be lost. Return to Today anyway?")) {
                event.preventDefault();
                return;
            }
            sessionStorage.removeItem(preserveKey);
        });

        const plannerState = {
            Facility: "@plannerFacility",
            ProjectionVisibility: "@plannerVisibility",
            ProjectionSort: "@plannerSort"
        };
        document.querySelectorAll('form[method="post"][action^="/BinsRun/Projections"]').forEach((form) => {
            for (const [name, value] of Object.entries(plannerState)) {
                if (form.querySelector(`input[name="${name}"]`)) continue;
                const input = document.createElement("input");
                input.type = "hidden";
                input.name = name;
                input.value = value;
                form.appendChild(input);
            }
        });
        const sourceSearch = document.querySelector("[data-run-source-search]");
        const sourceResults = document.querySelector("[data-run-source-results]");
        const sourceForm = document.querySelector(".run-source-search");
        const projectionMode = sourceForm?.dataset.projectionMode || "Inventory";
        const projectionId = sourceForm?.dataset.projectionId;
        const facilityWarehouseId = sourceForm?.dataset.facilityWarehouseId;
        const fieldSampleResults = document.querySelector("[data-field-sample-results]");
        const fieldSamplePreview = document.querySelector("[data-field-sample-preview]");
        let searchTimer;
        function updateFieldSamplePreview() {
            const sampleId = fieldSampleResults?.selectedOptions[0]?.dataset.sampleId;
            if (!fieldSamplePreview) return;
            fieldSamplePreview.hidden = !sampleId;
            if (sampleId) fieldSamplePreview.href = `/FieldSamples/${sampleId}/report`;
        }
        async function loadFieldSamples() {
            if (!fieldSampleResults || !sourceResults || !projectionId) return;
            const selected = sourceResults.selectedOptions[0];
            const blockId = selected?.dataset.blockId;
            const fruitProfileId = selected?.dataset.fruitProfileId;
            fieldSampleResults.innerHTML = '<option value="">Select a Field Sample</option>';
            if (!blockId || !fruitProfileId) {
                updateFieldSamplePreview();
                return;
            }
            const params = new URLSearchParams({
                canonicalBlockId: blockId,
                fruitProfileId
            });
            const response = await fetch(`/BinsRun/Projections/${projectionId}/FieldSamples?${params}`);
            if (!response.ok) return;
            const rows = await response.json();
            for (const row of rows) {
                const option = document.createElement("option");
                option.value = row.value;
                option.textContent = row.label;
                option.dataset.sampleId = row.sampleId;
                if (row.isSelected) option.selected = true;
                fieldSampleResults.appendChild(option);
            }
            updateFieldSamplePreview();
        }
        async function loadSources() {
            if (!sourceSearch || !sourceResults) return;
            const params = new URLSearchParams({ query: sourceSearch.value || "", mode: projectionMode });
            if (facilityWarehouseId) params.set("facilityWarehouseId", facilityWarehouseId);
            @if (Model.Filter.RoomId is not null)
            {
                <text>params.set("roomId", "@Model.Filter.RoomId");</text>
            }
            const response = await fetch(`/BinsRun/Sources?${params}`);
            if (!response.ok) return;
            const rows = await response.json();
            sourceResults.innerHTML = '<option value="">Select a source</option>';
            for (const row of rows) {
                const option = document.createElement("option");
                option.value = row.sourceKey;
                option.textContent = row.label;
                option.dataset.sourceType = row.sourceType;
                option.dataset.blockId = row.canonicalOrchardBlockId || "";
                option.dataset.fruitProfileId = row.fruitProfileId || "";
                option.dataset.defaultSampleId = row.defaultFieldSampleId || "";
                sourceResults.appendChild(option);
            }
            const requested = "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Filter.SourceKey ?? ""))";
            if (requested) sourceResults.value = requested;
            if (projectionMode === "Preharvest") await loadFieldSamples();
        }
        if (sourceSearch) {
            sourceSearch.addEventListener("input", () => {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(loadSources, 300);
            });
            loadSources();
        }
        sourceResults?.addEventListener("change", loadFieldSamples);
        fieldSampleResults?.addEventListener("change", updateFieldSamplePreview);

        const addPackout = document.querySelector("[data-add-packout-input]");
        const addCull = document.querySelector("[data-add-cull-output]");
        const defaultFlag = document.querySelector("[data-packout-default-flag]");
        addPackout?.addEventListener("input", () => {
            const value = Number(addPackout.value);
            if (addCull) addCull.textContent = Number.isFinite(value) && value >= 0 && value <= 100
                ? `${(100 - value).toFixed(2).replace(/\.?0+$/, "")}%`
                : "-";
            if (defaultFlag) defaultFlag.value = "false";
        });

        const inventory = document.querySelector("[data-inventory-select]");
        const expected = document.querySelector("[data-expected-bins]");
        inventory?.addEventListener("change", () => {
            expected.value = inventory.selectedOptions[0]?.dataset.bins || "0";
        });

        const planned = Array.from(document.querySelectorAll("[data-planned-bins]"));
        const total = document.querySelector("[data-total-planned-bins]");
        for (const input of planned) {
            input.addEventListener("input", () => {
                if (total) total.textContent = planned.reduce((sum, item) => sum + (Number(item.value) || 0), 0);
            });
        }

        function bindProjectionAutosave(form) {
            if (!form || form.dataset.autosaveBound) return;
            form.dataset.autosaveBound = "true";
            const status = form.querySelector("[data-autosave-status]");
            const packout = form.querySelector("[data-packout-input]");
            const cull = form.querySelector("[data-cull-output]");
            let timer;
            let saving = false;
            let queued = false;

            const updateCull = () => {
                const value = Number(packout?.value);
                if (cull) cull.textContent = Number.isFinite(value) && value >= 0 && value <= 100
                    ? `${(100 - value).toFixed(2).replace(/\.?0+$/, "")}%`
                    : "-";
            };
            const save = async () => {
                if (saving) {
                    queued = true;
                    return;
                }
                saving = true;
                if (status) status.textContent = "Saving";
                try {
                    const response = await fetch(form.action, {
                        method: "POST",
                        body: new FormData(form),
                        credentials: "same-origin",
                        headers: { "X-Projection-Autosave": "1" }
                    });
                    const html = await response.text();
                    if (!response.ok) {
                        let message = `Save failed (HTTP ${response.status}).`;
                        try {
                            message = JSON.parse(html).error || message;
                        } catch {
                            // Keep the safe status-only fallback when the response is not JSON.
                        }
                        throw new Error(message);
                    }
                    const documentCopy = new DOMParser().parseFromString(html, "text/html");
                    const card = form.closest("[data-projection-source-card]");
                    const cardId = card?.getAttribute("data-projection-source-card");
                    const replacement = cardId ? documentCopy.querySelector(`[data-projection-source-card="${cardId}"]`) : null;
                    if (!replacement || documentCopy.querySelector(".validation-summary-errors")) {
                        throw new Error("The server did not confirm the projection source update.");
                    }
                    card.replaceWith(replacement);
                    const currentSummary = document.querySelector("[data-projection-summary]");
                    const newSummary = documentCopy.querySelector("[data-projection-summary]");
                    if (currentSummary && newSummary) currentSummary.replaceWith(newSummary);
                    const currentCombined = document.querySelector("[data-combined-results]");
                    const newCombined = documentCopy.querySelector("[data-combined-results]");
                    if (currentCombined && newCombined) currentCombined.replaceWith(newCombined);
                    document.querySelectorAll("input[name='ConcurrencyVersion']").forEach((input) => {
                        const next = documentCopy.querySelector("input[name='ConcurrencyVersion']")?.value;
                        if (next) input.value = next;
                    });
                    bindProjectionAutosave(replacement.querySelector("[data-projection-source-form]"));
                    replacement.querySelector("[data-autosave-status]").textContent = "Saved";
                } catch (error) {
                    console.error("Run projection autosave failed.", error);
                    if (status) {
                        status.textContent = error.message?.includes("changed after the page loaded")
                            ? "Conflict — reload before saving"
                            : "Unsaved — retry";
                        status.title = error.message || "The projection source was not saved.";
                    }
                } finally {
                    saving = false;
                    if (queued) {
                        queued = false;
                        save();
                    }
                }
            };
            const schedule = (immediate) => {
                updateCull();
                if (status) status.textContent = "Unsaved";
                clearTimeout(timer);
                timer = setTimeout(save, immediate ? 0 : 1000);
            };
            form.addEventListener("input", () => schedule(false));
            form.addEventListener("change", () => schedule(true));
            form.addEventListener("submit", (event) => {
                event.preventDefault();
                clearTimeout(timer);
                save();
            });
            updateCull();
        }
        document.querySelectorAll("[data-projection-source-form]").forEach(bindProjectionAutosave);
    })();
</script>

@functions {
    private static string ProjectionStatusClass(string status) => status switch
    {
        "Ready" or "Converted to Actual Run" => "ready",
        "Cancelled" or "Expired" or "Superseded" => "missing",
        _ => "pending"
    };

    private static string Format(decimal? value, string suffix) => value is null ? "No data" : $"{value:0.##}{suffix}";
}
