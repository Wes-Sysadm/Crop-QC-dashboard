@model BinsRunPageViewModel
@{
    ViewData["Title"] = "Bins Run";
    var projection = Model.RoomSummary?.Projection;
    var maxSizeBins = projection?.SizeDistribution.Count > 0 ? projection.SizeDistribution.Max(x => x.EstimatedBins) : 0m;
    var maxGradeBins = projection?.GradeSummary.Count > 0 ? projection.GradeSummary.Max(x => x.EstimatedBins) : 0m;
}

<h1>Bins Run</h1>

@if (TempData["Error"] is string error)
{
    <div class="alert error">@error</div>
}
@if (TempData["Success"] is string success)
{
    <div class="alert success">@success</div>
}

<section class="panel-section">
    <h2>Select Room</h2>
    <form class="toolbar bins-run-filter" method="get" action="/BinsRun">
        <label>Facility
            <select name="WarehouseId" onchange="this.form.submit()">
                <option value="">Select facility</option>
                @foreach (var warehouse in Model.Warehouses)
                {
                    <option value="@warehouse.Id" selected="@(Model.Filter.WarehouseId == warehouse.Id)">@warehouse.Code</option>
                }
            </select>
        </label>
        <label>Room
            <select name="RoomId" onchange="this.form.submit()">
                <option value="">Select room</option>
                @foreach (var room in Model.Rooms)
                {
                    <option value="@room.Id" selected="@(Model.Filter.RoomId == room.Id)">@room.Warehouse.Code / @(room.CropQcRoomName ?? room.DisplayName ?? room.Code)</option>
                }
            </select>
        </label>
        <button type="submit">View Room</button>
    </form>
</section>

@if (Model.RoomSummary is null)
{
    <section class="panel-section">
        <p class="muted">Select a facility and room to review current inventory before recording bins run.</p>
    </section>
}
else
{
    <section class="panel-section bins-run-room-summary">
        <div>
            <h2>@Model.RoomSummary.RoomName</h2>
            <p class="muted">@Model.RoomSummary.Facility / @Model.RoomSummary.Location</p>
        </div>
        <div class="room-summary-metrics">
            <div class="metric-card">
                <span class="metric-label">Available Bins</span>
                <strong data-room-total>@Model.RoomSummary.TotalAvailableBins</strong>
            </div>
            <div class="metric-card">
                <span class="metric-label">Active Lots</span>
                <strong>@Model.RoomSummary.ActiveLotCount</strong>
            </div>
            <div class="metric-card">
                <span class="metric-label">Sizing Data</span>
                <strong>@Model.RoomSummary.SizeDataLotCount</strong>
                <span>lots</span>
            </div>
            <div class="metric-card">
                <span class="metric-label">Grade Data</span>
                <strong>@Model.RoomSummary.GradeDataLotCount</strong>
                <span>lots</span>
            </div>
        </div>
    </section>

    <section class="grid-two">
        <div class="panel-section">
            <h2 data-projection-size-title>Size Distribution</h2>
            <p class="muted" data-projection-size-context>@ProjectionContext(projection, dataKind: "Sizing")</p>
            <p class="empty-state @(projection?.SizeDistribution.Count == 0 ? "" : "hidden")" data-size-empty>No sizing data is available for the current inventory in this room.</p>
            <div class="size-chart @(projection?.SizeDistribution.Count == 0 ? "hidden" : "")" aria-label="Size distribution chart" data-size-chart>
                @if (projection is not null)
                {
                    @foreach (var point in projection.SizeDistribution)
                    {
                        var height = point.EstimatedBins <= 0 || maxSizeBins <= 0 ? 0 : Math.Max(4, (int)Math.Round(point.EstimatedBins / maxSizeBins * 100m));
                        <div class="size-chart-column">
                            <span class="size-bar-value">@(point.EstimatedBins > 0 ? point.EstimatedBins.ToString("0.#") : "")</span>
                            <span class="size-bar" style="height: @height%"></span>
                            <span class="size-label">@point.Size</span>
                        </div>
                    }
                }
            </div>
        </div>
        <div class="panel-section">
            <h2 data-projection-grade-title>Expected Grade</h2>
            <p class="muted" data-projection-grade-context>@ProjectionContext(projection, dataKind: "Grade")</p>
            <p class="empty-state @(projection?.GradeSummary.Count == 0 ? "" : "hidden")" data-grade-empty>No grade information is available for the current inventory in this room.</p>
            <div class="grade-summary @(projection?.GradeSummary.Count == 0 ? "hidden" : "")" data-grade-summary>
                @if (projection is not null)
                {
                    @foreach (var grade in projection.GradeSummary)
                    {
                        var width = maxGradeBins <= 0 ? 0 : Math.Max(4, (int)Math.Round(grade.EstimatedBins / maxGradeBins * 100m));
                        <div class="grade-summary-row">
                            <span class="grade-label">@grade.Grade</span>
                            <span class="grade-bar-track"><span class="grade-bar" style="width: @width%"></span></span>
                            <span class="grade-value">@grade.EstimatedBins.ToString("0.#")</span>
                        </div>
                    }
                }
            </div>
        </div>
    </section>

    <section class="panel-section">
        <h2>Lot Inventory</h2>
        @if (Model.AvailableInventory.Count == 0)
        {
            <p class="muted">No available lots remain in this room.</p>
        }
        else
        {
            <details class="lot-submenu" open>
                <summary>@Model.AvailableInventory.Count active lots currently available</summary>
                <div class="lot-selection-toolbar">
                    <span data-projection-status>No lots selected. Showing whole-room projection.</span>
                    <span class="button-row">
                        <button type="button" class="secondary-button" data-select-all-lots>Select all available lots</button>
                        <button type="button" class="secondary-button" data-clear-lot-selection>Clear selection</button>
                    </span>
                </div>
                <div class="lot-list">
                    <div class="lot-list-header" aria-hidden="true">
                        <span>Grower / Lot</span>
                        <span>Variety</span>
                        <span>Expected grade</span>
                        <span>Source</span>
                        <span>Available</span>
                        <span>Projection</span>
                        <span>Run lot</span>
                    </div>
                    @foreach (var lot in Model.AvailableInventory)
                    {
                        var sourceLabel = lot.ReceiptDate is null ? "Current baseline" : lot.ReceiptDate.Value.ToLocalTime().ToString("g");
                        <div class="lot-option"
                             data-lot-row
                             data-key="@lot.InventoryKey"
                             data-available="@lot.CurrentBins"
                             data-warehouse="@lot.WarehouseId"
                             data-room="@lot.RoomId"
                             data-label="@lot.Grower / @lot.Variety / @lot.Lot"
                             data-grade="@lot.GradeSummary"
                             data-source="@sourceLabel">
                            <span class="lot-cell lot-primary">
                                <strong>@lot.Grower</strong>
                                <span>Lot @lot.Lot</span>
                            </span>
                            <span class="lot-cell" data-label="Variety">@lot.Variety</span>
                            <span class="lot-cell" data-label="Expected grade">@lot.GradeSummary</span>
                            <span class="lot-cell" data-label="Source">@sourceLabel</span>
                            <strong class="lot-cell lot-bins" data-label="Available">@lot.CurrentBins bins</strong>
                            <label class="lot-project-cell" data-label="Projection">
                                <input type="checkbox" data-project-lot value="@lot.InventoryKey" />
                                <span>Selected for projection</span>
                            </label>
                            <label class="lot-run-cell" data-label="Run lot">
                                <input type="radio" name="RunInventoryKey" data-run-lot value="@lot.InventoryKey" />
                                <span>Run this lot</span>
                            </label>
                        </div>
                    }
                </div>
            </details>
        }
    </section>

    <section class="panel-section projection-selection-summary" data-selection-summary>
        <h2>Selection Summary</h2>
        <div class="room-summary-metrics">
            <div class="metric-card">
                <span class="metric-label">Selected Lots</span>
                <strong data-selected-lot-count>0</strong>
            </div>
            <div class="metric-card">
                <span class="metric-label">Selected Bins</span>
                <strong data-selected-bin-total>0</strong>
            </div>
            <div class="metric-card">
                <span class="metric-label">Sizing Coverage</span>
                <strong><span data-size-represented>@(projection?.SizeRepresentedBins ?? 0)</span> / <span data-size-total>@(projection?.AvailableBins ?? 0)</span></strong>
                <span data-size-missing>@(projection?.SizeMissingBins ?? 0) missing</span>
            </div>
            <div class="metric-card">
                <span class="metric-label">Grade Coverage</span>
                <strong><span data-grade-represented>@(projection?.GradeRepresentedBins ?? 0)</span> / <span data-grade-total>@(projection?.AvailableBins ?? 0)</span></strong>
                <span data-grade-missing>@(projection?.GradeMissingBins ?? 0) missing</span>
            </div>
        </div>
    </section>

    <section class="panel-section">
        <h2>Record Bins Run</h2>
        @if (!Model.CanRecord)
        {
            <p class="muted">View-only access. Entries cannot be created, edited, or reversed.</p>
        }
        else if (Model.AvailableInventory.Count == 0)
        {
            <p class="muted">Select a room with available inventory before recording bins run.</p>
        }
        else
        {
            <form class="bins-run-form" method="post" action="/BinsRun/Create">
                <input type="hidden" name="WarehouseId" value="@(Model.Filter.WarehouseId)" data-bins-run-warehouse />
                <input type="hidden" name="RoomId" value="@(Model.Filter.RoomId)" data-bins-run-room />
                <input type="hidden" name="InventoryKey" value="" data-bins-run-inventory />
                <input type="hidden" name="ExpectedAvailableBins" value="0" data-bins-run-expected />
                <div class="selected-lot-summary">
                    <div>
                        <span class="metric-label">Lot being run</span>
                        <strong data-selected-lot>Choose the lot being depleted</strong>
                        <span class="selected-lot-meta">
                            <span data-selected-grade>Select exactly which inventory record this Bins Run will reduce.</span>
                            <span data-selected-source>Projection selection alone does not change inventory.</span>
                        </span>
                    </div>
                    <div class="selected-lot-bins">
                        <span class="metric-label">Available bins</span>
                        <strong data-bins-run-current>0</strong>
                    </div>
                </div>
                <div class="bins-run-form-row">
                    <label>Bins run
                        <input type="number" min="1" name="BinsRun" required />
                    </label>
                    <label>Run date/time
                        <input type="datetime-local" name="RunAt" value="@Model.Form.RunAt.ToString("yyyy-MM-ddTHH:mm")" required />
                    </label>
                </div>
                <label>Notes
                    <input name="Notes" maxlength="1000" />
                </label>
                <div class="button-row">
                    <button type="submit">Save Bins Run</button>
                </div>
            </form>
        }
    </section>
}

<section class="panel-section">
    <h2>Recent Bins Run History</h2>
    @if (Model.History.Count == 0)
    {
        <p class="muted">No Bins Run transactions match the current room.</p>
    }
    else
    {
        <table class="data-table responsive-admin-table">
            <thead>
                <tr>
                    <th>Run At</th>
                    <th>Room</th>
                    <th>Inventory</th>
                    <th>Previous</th>
                    <th>Run</th>
                    <th>Remaining</th>
                    <th>User</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.History)
                {
                    <tr class="@(item.IsReversed ? "muted-row" : "")">
                        <td>@item.RunAt.ToLocalTime().ToString("g")</td>
                        <td>@item.Room</td>
                        <td>@item.Inventory</td>
                        <td>@item.PreviousAvailableBins</td>
                        <td>@item.BinsRun</td>
                        <td>@item.NewAvailableBins</td>
                        <td>@item.CreatedBy</td>
                        <td>@(item.IsReversed ? $"Reversed: {item.ReverseReason}" : "Active")</td>
                        <td>
                            @if (Model.CanRecord && !item.IsReversed)
                            {
                                <form class="inline-form" method="post" action="/BinsRun/@item.Id/Edit">
                                    <input type="hidden" name="WarehouseId" value="@item.WarehouseId" />
                                    <input type="hidden" name="RoomId" value="@item.RoomId" />
                                    <input type="hidden" name="InventoryKey" value="@item.InventoryKey" />
                                    <input type="hidden" name="ExpectedAvailableBins" value="@item.NewAvailableBins" />
                                    <input type="hidden" name="RunAt" value="@item.RunAt.ToString("O")" />
                                    <input type="number" min="1" name="BinsRun" value="@item.BinsRun" aria-label="Bins run" />
                                    <button type="submit" class="secondary-button">Edit</button>
                                </form>
                            }
                            @if (Model.CanAdmin && !item.IsReversed)
                            {
                                <form class="inline-form" method="post" action="/BinsRun/@item.Id/Reverse">
                                    <input name="Reason" maxlength="1000" required placeholder="Reason" />
                                    <button type="submit" class="secondary-button">Reverse</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<script>
    (() => {
        const lotRows = Array.from(document.querySelectorAll("[data-lot-row]"));
        const projectCheckboxes = Array.from(document.querySelectorAll("[data-project-lot]"));
        const runRadios = Array.from(document.querySelectorAll("[data-run-lot]"));
        const selectAll = document.querySelector("[data-select-all-lots]");
        const clearSelection = document.querySelector("[data-clear-lot-selection]");
        const projectionStatus = document.querySelector("[data-projection-status]");
        const inventory = document.querySelector("[data-bins-run-inventory]");
        const expected = document.querySelector("[data-bins-run-expected]");
        const warehouse = document.querySelector("[data-bins-run-warehouse]");
        const room = document.querySelector("[data-bins-run-room]");
        const current = document.querySelector("[data-bins-run-current]");
        const selectedLot = document.querySelector("[data-selected-lot]");
        const selectedGrade = document.querySelector("[data-selected-grade]");
        const selectedSource = document.querySelector("[data-selected-source]");
        let projectionRequestId = 0;
        let projectionAbortController = null;

        function selectedKeys() {
            return projectCheckboxes.filter(x => x.checked).map(x => x.value);
        }

        function rowForKey(key) {
            return lotRows.find(x => x.dataset.key === key);
        }

        function setRunLot(row) {
            if (!row) {
                if (inventory) inventory.value = "";
                if (expected) expected.value = "0";
                if (current) current.textContent = "0";
                if (selectedLot) selectedLot.textContent = "Choose the lot being depleted";
                if (selectedGrade) selectedGrade.textContent = "Select exactly which inventory record this Bins Run will reduce.";
                if (selectedSource) selectedSource.textContent = "Projection selection alone does not change inventory.";
                runRadios.forEach(x => x.checked = false);
                lotRows.forEach(x => x.classList.remove("run-selected"));
                return;
            }

            if (inventory) inventory.value = row.dataset.key || "";
            if (expected) expected.value = row.dataset.available || "0";
            if (warehouse) warehouse.value = row.dataset.warehouse || "";
            if (room) room.value = row.dataset.room || "";
            if (current) current.textContent = row.dataset.available || "0";
            if (selectedLot) selectedLot.textContent = row.dataset.label || "Selected lot";
            if (selectedGrade) selectedGrade.textContent = row.dataset.grade || "Grade not available";
            if (selectedSource) selectedSource.textContent = row.dataset.source || "";
            runRadios.forEach(x => x.checked = x.value === row.dataset.key);
            lotRows.forEach(x => x.classList.toggle("run-selected", x === row));
        }

        function syncLotSelection() {
            const keys = selectedKeys();
            const keySet = new Set(keys);
            lotRows.forEach(row => row.classList.toggle("selected", keySet.has(row.dataset.key)));
            runRadios.forEach(radio => {
                radio.disabled = keys.length > 0 && !keySet.has(radio.value);
            });

            if (projectionStatus) {
                projectionStatus.textContent = keys.length === 0
                    ? "No lots selected. Showing whole-room projection."
                    : `${keys.length} lot${keys.length === 1 ? "" : "s"} selected for projected line mix.`;
            }

            const currentRunKey = inventory?.value || "";
            if (keys.length === 1) {
                setRunLot(rowForKey(keys[0]));
            } else if (keys.length > 1 && !keySet.has(currentRunKey)) {
                setRunLot(null);
            } else if (keys.length === 0 && currentRunKey) {
                const row = rowForKey(currentRunKey);
                setRunLot(row || null);
            }
        }

        function renderSizeChart(points) {
            const chart = document.querySelector("[data-size-chart]");
            const empty = document.querySelector("[data-size-empty]");
            if (!chart || !empty) return;
            chart.innerHTML = "";
            if (!points || points.length === 0) {
                chart.classList.add("hidden");
                empty.classList.remove("hidden");
                return;
            }

            const max = Math.max(...points.map(x => Number(x.estimatedBins || x.EstimatedBins || 0)));
            for (const point of points) {
                const estimated = Number(point.estimatedBins || point.EstimatedBins || 0);
                const height = estimated <= 0 || max <= 0 ? 0 : Math.max(4, Math.round(estimated / max * 100));
                const size = point.size || point.Size;
                const column = document.createElement("div");
                column.className = "size-chart-column";
                column.innerHTML = `<span class="size-bar-value">${estimated > 0 ? estimated.toFixed(estimated % 1 === 0 ? 0 : 1) : ""}</span><span class="size-bar" style="height: ${height}%"></span><span class="size-label">${size}</span>`;
                chart.appendChild(column);
            }

            empty.classList.add("hidden");
            chart.classList.remove("hidden");
        }

        function renderGradeSummary(points) {
            const summary = document.querySelector("[data-grade-summary]");
            const empty = document.querySelector("[data-grade-empty]");
            if (!summary || !empty) return;
            summary.innerHTML = "";
            if (!points || points.length === 0) {
                summary.classList.add("hidden");
                empty.classList.remove("hidden");
                return;
            }

            const max = Math.max(...points.map(x => Number(x.estimatedBins || x.EstimatedBins || 0)));
            for (const point of points) {
                const estimated = Number(point.estimatedBins || point.EstimatedBins || 0);
                const width = estimated <= 0 || max <= 0 ? 0 : Math.max(4, Math.round(estimated / max * 100));
                const grade = point.grade || point.Grade;
                const row = document.createElement("div");
                row.className = "grade-summary-row";
                row.innerHTML = `<span class="grade-label">${grade}</span><span class="grade-bar-track"><span class="grade-bar" style="width: ${width}%"></span></span><span class="grade-value">${estimated.toFixed(estimated % 1 === 0 ? 0 : 1)}</span>`;
                summary.appendChild(row);
            }

            empty.classList.add("hidden");
            summary.classList.remove("hidden");
        }

        function projectionContext(data, kind) {
            const represented = kind === "size" ? data.sizeRepresentedBins : data.gradeRepresentedBins;
            const missing = kind === "size" ? data.sizeMissingBins : data.gradeMissingBins;
            const prefix = data.isSelection ? `${data.label}: ${data.availableBins} selected bins.` : `Room summary: ${data.availableBins} bins currently available.`;
            if (missing > 0) {
                return `${prefix} ${kind === "size" ? "Sizing" : "Grade"} data represents ${represented} of ${data.availableBins} bins; ${missing} bins have no ${kind === "size" ? "sizing" : "grade"} data.`;
            }

            return `${prefix} Estimated bins, weighted by current available-bin balance.`;
        }

        function renderProjection(data) {
            const sizeTitle = document.querySelector("[data-projection-size-title]");
            const gradeTitle = document.querySelector("[data-projection-grade-title]");
            const sizeContext = document.querySelector("[data-projection-size-context]");
            const gradeContext = document.querySelector("[data-projection-grade-context]");
            if (sizeTitle) sizeTitle.textContent = data.isSelection ? `Size Distribution - ${data.label}` : "Size Distribution - Room Summary";
            if (gradeTitle) gradeTitle.textContent = data.isSelection ? `Expected Grade - ${data.label}` : "Expected Grade - Room Summary";
            if (sizeContext) sizeContext.textContent = projectionContext(data, "size");
            if (gradeContext) gradeContext.textContent = projectionContext(data, "grade");
            const selectedLotCount = document.querySelector("[data-selected-lot-count]");
            const selectedBinTotal = document.querySelector("[data-selected-bin-total]");
            const sizeRepresented = document.querySelector("[data-size-represented]");
            const sizeTotal = document.querySelector("[data-size-total]");
            const sizeMissing = document.querySelector("[data-size-missing]");
            const gradeRepresented = document.querySelector("[data-grade-represented]");
            const gradeTotal = document.querySelector("[data-grade-total]");
            const gradeMissing = document.querySelector("[data-grade-missing]");
            if (selectedLotCount) selectedLotCount.textContent = data.isSelection ? data.lotCount : 0;
            if (selectedBinTotal) selectedBinTotal.textContent = data.isSelection ? data.availableBins : 0;
            if (sizeRepresented) sizeRepresented.textContent = data.sizeRepresentedBins;
            if (sizeTotal) sizeTotal.textContent = data.availableBins;
            if (sizeMissing) sizeMissing.textContent = `${data.sizeMissingBins} missing`;
            if (gradeRepresented) gradeRepresented.textContent = data.gradeRepresentedBins;
            if (gradeTotal) gradeTotal.textContent = data.availableBins;
            if (gradeMissing) gradeMissing.textContent = `${data.gradeMissingBins} missing`;
            renderSizeChart(data.sizeDistribution);
            renderGradeSummary(data.gradeSummary);
        }

        async function refreshProjection() {
            const requestId = ++projectionRequestId;
            if (projectionAbortController) projectionAbortController.abort();
            projectionAbortController = new AbortController();
            try {
                const response = await fetch("/BinsRun/Projection", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        warehouseId: warehouse?.value ? Number(warehouse.value) : null,
                        roomId: room?.value ? Number(room.value) : null,
                        inventoryKeys: selectedKeys()
                    }),
                    signal: projectionAbortController.signal
                });
                if (!response.ok) return;
                const data = await response.json();
                if (requestId === projectionRequestId) renderProjection(data);
            } catch (error) {
                if (error.name !== "AbortError") console.warn("Bins Run projection refresh failed.", error);
            }
        }

        projectCheckboxes.forEach(checkbox => checkbox.addEventListener("change", () => {
            syncLotSelection();
            refreshProjection();
        }));
        runRadios.forEach(radio => radio.addEventListener("change", () => setRunLot(rowForKey(radio.value))));
        selectAll?.addEventListener("click", () => {
            projectCheckboxes.forEach(x => x.checked = true);
            syncLotSelection();
            refreshProjection();
        });
        clearSelection?.addEventListener("click", () => {
            projectCheckboxes.forEach(x => x.checked = false);
            syncLotSelection();
            refreshProjection();
        });
        syncLotSelection();
    })();
</script>

@functions {
    private static string ProjectionContext(BinsRunProjectionViewModel? projection, string dataKind)
    {
        if (projection is null)
        {
            return "Estimated bins, weighted by each current lot's available-bin balance.";
        }

        var represented = dataKind == "Sizing" ? projection.SizeRepresentedBins : projection.GradeRepresentedBins;
        var missing = dataKind == "Sizing" ? projection.SizeMissingBins : projection.GradeMissingBins;
        var prefix = projection.IsSelection
            ? $"{projection.Label}: {projection.AvailableBins} selected bins."
            : $"Room summary: {projection.AvailableBins} bins currently available.";
        return missing > 0
            ? $"{prefix} {dataKind} data represents {represented} of {projection.AvailableBins} bins; {missing} bins have no {dataKind.ToLowerInvariant()} data."
            : $"{prefix} Estimated bins, weighted by current available-bin balance.";
    }
}
