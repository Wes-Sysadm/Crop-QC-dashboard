@model BinsRunPageViewModel
@{
    ViewData["Title"] = "Bins Run & Transfers";
    var activeSection = string.IsNullOrWhiteSpace(Model.Filter.Section) ? "Planner" : Model.Filter.Section;
    var selected = Model.Planner.SelectedProjection;
    var conversionSource = selected?.Sources.FirstOrDefault(x => x.Id == Model.Filter.ProjectionSourceId);
    var conversionInventory = Model.AvailableInventory.FirstOrDefault(x => x.InventoryKey == conversionSource?.InventoryKey);
}

<h1>Bins Run &amp; Transfers</h1>
<p class="muted">Plan future runs, record actual runs, move bins, correct counts, and review audited activity.</p>

@if (TempData["Error"] is string error)
{
    <p class="notice error">@error</p>
}
@if (TempData["Success"] is string success)
{
    <p class="notice success">@success</p>
}

<nav class="operation-tabs" aria-label="Bins Run and Transfers sections">
    <a class="@(activeSection.Equals("Planner", StringComparison.OrdinalIgnoreCase) ? "active" : "")" href="/BinsRun?Section=Planner&amp;RoomId=@Model.Filter.RoomId">Run Planner</a>
    <a class="@(activeSection.Equals("Actual", StringComparison.OrdinalIgnoreCase) ? "active" : "")" href="/BinsRun?Section=Actual&amp;RoomId=@Model.Filter.RoomId">Record Actual Run</a>
    <a class="@(activeSection.Equals("Transfer", StringComparison.OrdinalIgnoreCase) ? "active" : "")" href="/BinsRun?Section=Transfer&amp;RoomId=@Model.Filter.RoomId">Transfer</a>
    <a class="@(activeSection.Equals("TrueUp", StringComparison.OrdinalIgnoreCase) ? "active" : "")" href="/BinsRun?Section=TrueUp&amp;RoomId=@Model.Filter.RoomId">True Up</a>
    <a class="@(activeSection.Equals("Activity", StringComparison.OrdinalIgnoreCase) ? "active" : "")" href="/BinsRun?Section=Activity&amp;RoomId=@Model.Filter.RoomId">Recent Activity</a>
</nav>

@if (activeSection.Equals("Planner", StringComparison.OrdinalIgnoreCase))
{
    <section class="panel run-planner-calendar">
        <div class="room-card-header">
            <div>
                <h2>Planned Run Date</h2>
                <p class="muted">Pacific business dates. Dots show days with saved projections.</p>
            </div>
            <div class="action-bar">
                <form method="get" class="inline-form">
                    <input type="hidden" name="Section" value="Planner" />
                    <input type="hidden" name="RoomId" value="@Model.Filter.RoomId" />
                    <label>Open date <input type="date" name="PlannedDate" value="@Model.Planner.SelectedDate.ToString("yyyy-MM-dd")" /></label>
                    <button type="submit" class="secondary-button">Go</button>
                </form>
                <a class="button secondary-button" href="/BinsRun?Section=Planner&amp;PlannedDate=@DateOnly.FromDateTime(BusinessTime.NowPacific.DateTime).ToString("yyyy-MM-dd")">Today</a>
            </div>
        </div>
        <div class="run-calendar-days">
            @foreach (var day in Model.Planner.CalendarDays)
            {
                <a class="run-calendar-day @(day.IsSelected ? "selected" : "") @(day.IsToday ? "today" : "")"
                   href="/BinsRun?Section=Planner&amp;PlannedDate=@day.Date.ToString("yyyy-MM-dd")&amp;RoomId=@Model.Filter.RoomId">
                    <small>@day.Date.ToString("ddd")</small>
                    <strong>@day.Date.Day</strong>
                    <span>@day.Date.ToString("MMM")</span>
                    @if (day.ProjectionCount > 0)
                    {
                        <i title="@day.ProjectionCount saved projection(s)">@day.ProjectionCount</i>
                    }
                </a>
            }
        </div>
    </section>

    <section class="grid-two run-planner-layout">
        <div class="panel">
            <div class="room-card-header">
                <div>
                    <h2>@Model.Planner.SelectedDate.ToString("dddd, MMMM d")</h2>
                    <p class="muted">Saved projections for this date.</p>
                </div>
            </div>
            @if (Model.Planner.Projections.Count == 0)
            {
                <p class="empty-state">No projections are saved for this date.</p>
            }
            else
            {
                <div class="projection-list">
                @foreach (var item in Model.Planner.Projections)
                {
                    <a class="projection-list-item @(selected?.Id == item.Id ? "selected" : "")"
                       href="/BinsRun?Section=Planner&amp;PlannedDate=@item.PlannedRunDate.ToString("yyyy-MM-dd")&amp;ProjectionId=@item.Id&amp;RoomId=@Model.Filter.RoomId">
                        <span><strong>@item.Name</strong><small>@item.Status · @item.SourceCount source(s)</small></span>
                        <span><strong>@item.TotalPlannedBins bins</strong><small>@item.TotalRoundedProjectedBoxes boxes · @BusinessTime.FormatPacific(item.UpdatedAt)</small></span>
                    </a>
                }
                </div>
            }
            @if (Model.Planner.CanEdit)
            {
                <form class="form-grid compact-form" method="post" action="/BinsRun/Projections">
                    <h3 class="wide">Create Projection</h3>
                    <label class="field">Run date
                        <input type="date" name="PlannedRunDate" value="@Model.Planner.SelectedDate.ToString("yyyy-MM-dd")" required />
                    </label>
                    <label class="field">Name / shift
                        <input name="Name" value="@Model.Planner.CreateForm.Name" maxlength="100" required />
                    </label>
                    <button type="submit">Create Draft</button>
                </form>
            }
        </div>

        <div class="panel">
            @if (selected is null)
            {
                <h2>Projection Detail</h2>
                <p class="empty-state">Select or create a projection to begin planning.</p>
            }
            else
            {
                <div class="room-card-header">
                    <div>
                        <h2>@selected.Name</h2>
                        <p>@selected.PlannedRunDate.ToString("dddd, MMMM d, yyyy") · @selected.Creator · updated @BusinessTime.FormatPacific(selected.UpdatedAt)</p>
                    </div>
                    <span class="status @ProjectionStatusClass(selected.Status)">@selected.Status</span>
                </div>
                <div class="room-summary-metrics">
                    <div class="metric-card"><span class="metric-label">Planned Bins</span><strong data-total-planned-bins>@selected.TotalPlannedBins</strong></div>
                    <div class="metric-card"><span class="metric-label">Gross Pounds</span><strong>@selected.TotalProjectedPounds.ToString("0")</strong></div>
                    <div class="metric-card"><span class="metric-label">Box Equivalents</span><strong>@selected.TotalProjectedBoxes.ToString("0.##")</strong><span>@selected.TotalRoundedProjectedBoxes rounded</span></div>
                    <div class="metric-card"><span class="metric-label">Sources</span><strong>@selected.SourceCount</strong><span>@selected.ConvertedSourceCount linked to actual</span></div>
                </div>
                <p class="notice">
                    Projection is a planning estimate based on selected sample size distribution, configured pounds per bin, and 40-pound box equivalents. Actual packout will vary.
                </p>
                <p class="muted">Assumptions saved with this projection: apples @selected.ApplePoundsPerBin.ToString("0.##") lb/bin; pears @selected.PearPoundsPerBin.ToString("0.##") lb/bin; @selected.StandardBoxWeightPounds.ToString("0.##") lb/box.</p>

                @if (selected.CanEditRecord)
                {
                    <form class="form-grid compact-form" method="post" action="/BinsRun/Projections/@selected.Id/Header">
                        <input type="hidden" name="ConcurrencyVersion" value="@selected.ConcurrencyVersion" />
                        <label class="field">Run date
                            <input type="date" name="PlannedRunDate" value="@selected.PlannedRunDate.ToString("yyyy-MM-dd")" required />
                        </label>
                        <label class="field">Name / shift
                            <input name="Name" value="@selected.Name" maxlength="100" required />
                        </label>
                        <button type="submit">Save Draft</button>
                    </form>

                    <form class="form-grid compact-form run-source-search" method="post" action="/BinsRun/Projections/@selected.Id/Sources">
                        <input type="hidden" name="ConcurrencyVersion" value="@selected.ConcurrencyVersion" />
                        <input type="hidden" name="plannedDate" value="@selected.PlannedRunDate.ToString("yyyy-MM-dd")" />
                        <h3 class="wide">Add Inventory Lot or Confirmed Field Sample Block</h3>
                        <label class="field wide">Search by room, lot, grower, orchard, block, variety, or receipt
                            <input type="search" data-run-source-search value="@Model.Filter.SourceKey" autocomplete="off" />
                        </label>
                        <label class="field wide">Source
                            <select name="SourceKey" data-run-source-results required>
                                <option value="">Search for a source</option>
                            </select>
                        </label>
                        <label class="field">Planned bins
                            <input type="number" min="1" name="PlannedBins" value="1" required />
                        </label>
                        <label class="field">QC data
                            <select name="SelectedQcSource">
                                <option value="Automatic">Automatic — receipt QC first</option>
                                <option value="FieldSample">Latest confirmed Field Sample</option>
                                <option value="None">No usable QC data</option>
                            </select>
                        </label>
                        <label class="checkbox-field wide">
                            <input type="checkbox" name="AvailabilityOverrideAcknowledged" value="true" />
                            I acknowledge this planning quantity may exceed currently available bins
                        </label>
                        <button type="submit">Add Source</button>
                    </form>
                }
            }
        </div>
    </section>

    @if (selected is not null)
    {
        <section class="panel">
            <h2>Projection Sources</h2>
            @if (selected.Sources.Count == 0)
            {
                <p class="empty-state">Add one or more inventory lots or confirmed Field Sample blocks.</p>
            }
            else
            {
                <div class="projection-source-grid">
                @foreach (var source in selected.Sources.OrderBy(x => x.SortOrder))
                {
                    <article class="station-card">
                        <div class="station-card-header">
                            <div>
                                <h3>@source.SourceLabel</h3>
                                <p class="station-code">@source.SourceType · @source.Variety · @source.Commodity</p>
                            </div>
                            <span class="status @(source.ActualBinsRunEntryId is null ? "pending" : "ready")">@(source.ActualBinsRunEntryId is null ? "Planned" : "Actual linked")</span>
                        </div>
                        <dl class="station-meta">
                            <dt>Location</dt><dd>@(source.Room ?? "Planning-only block")</dd>
                            <dt>Lot / block</dt><dd>@(source.Lot ?? source.Block ?? "-")</dd>
                            <dt>Orchard / grower</dt><dd>@(source.Orchard ?? source.Grower ?? "-")</dd>
                            <dt>Grower number</dt><dd>@(source.GrowerNumber ?? "-")</dd>
                            <dt>Available snapshot</dt><dd>@(source.AvailableBinsSnapshot?.ToString() ?? "Not inventory-backed")</dd>
                            <dt>Planned bins</dt><dd>@source.PlannedBins</dd>
                            <dt>QC basis</dt><dd>@source.QcBasis</dd>
                            <dt>Sample date</dt>
                            <dd>
                                @BusinessTime.FormatPacific(source.QcSampleDate, empty: "No usable sample")
                                @if (source.QcSampleId is long sampleId)
                                {
                                    var sampleUrl = source.SelectedQcSourceType == "FieldSample"
                                        ? $"/FieldSamples/{sampleId}"
                                        : $"/Samples/{sampleId}";
                                    <a href="@sampleUrl">Open sample</a>
                                }
                            </dd>
                            <dt>Fruit rows</dt><dd>@(source.QcFruitCount?.ToString() ?? "-")</dd>
                            <dt>Average weight</dt><dd>@Format(source.AverageWeightGrams, " g")</dd>
                            <dt>Average pressure</dt><dd>@Format(source.AveragePressureLbs, " lb")</dd>
                            <dt>Grades</dt><dd>@(source.GradeSummary ?? "No data")</dd>
                            <dt>Defects</dt><dd>@(source.DefectSummary ?? "No data")</dd>
                            <dt>Gross pounds</dt><dd>@source.ProjectedPounds.ToString("0.##")</dd>
                            <dt>Box equivalents</dt><dd>@source.ProjectedBoxes.ToString("0.##") (@source.RoundedProjectedBoxes rounded)</dd>
                        </dl>
                        @if (!string.IsNullOrWhiteSpace(source.Warning))
                        {
                            <p class="notice warning">@source.Warning</p>
                        }
                        @if (source.SizeResults.Count > 0)
                        {
                            <div class="table-wrap">
                                <table>
                                    <thead><tr><th>Size</th><th>Fruit</th><th>Distribution</th><th>Boxes</th><th>Rounded</th></tr></thead>
                                    <tbody>
                                    @foreach (var size in source.SizeResults)
                                    {
                                        <tr><td>@size.Size</td><td>@size.SampleCount</td><td>@size.Percentage.ToString("0.#")%</td><td>@size.UnroundedBoxes.ToString("0.##")</td><td>@size.RoundedBoxes</td></tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                        @if (selected.CanEditRecord && source.ActualBinsRunEntryId is null)
                        {
                            <form class="form-grid compact-form" method="post" action="/BinsRun/Projections/@selected.Id/Sources/@source.Id">
                                <input type="hidden" name="ConcurrencyVersion" value="@selected.ConcurrencyVersion" />
                                <input type="hidden" name="plannedDate" value="@selected.PlannedRunDate.ToString("yyyy-MM-dd")" />
                                <label class="field">Planned bins
                                    <input type="number" min="1" name="PlannedBins" value="@source.PlannedBins" data-planned-bins required />
                                </label>
                                <label class="field">QC data source
                                    <select name="SelectedQcSource">
                                    @foreach (var choice in source.QcChoices)
                                    {
                                        <option value="@choice.Value" selected="@choice.IsSelected">@choice.Label</option>
                                    }
                                    </select>
                                </label>
                                <label class="field">Priority
                                    <input type="number" min="0" name="SortOrder" value="@source.SortOrder" />
                                </label>
                                <label class="field wide">Notes
                                    <input name="Notes" value="@source.Notes" maxlength="1000" />
                                </label>
                                <label class="checkbox-field wide">
                                    <input type="checkbox" name="AvailabilityOverrideAcknowledged" value="true" checked="@source.AvailabilityOverrideAcknowledged" />
                                    Acknowledge planning quantity above available snapshot
                                </label>
                                <button type="submit">Save Source</button>
                            </form>
                            <div class="action-bar">
                                <form method="post" action="/BinsRun/Projections/@selected.Id/Sources/@source.Id/Remove">
                                    <input type="hidden" name="ConcurrencyVersion" value="@selected.ConcurrencyVersion" />
                                    <input type="hidden" name="plannedDate" value="@selected.PlannedRunDate.ToString("yyyy-MM-dd")" />
                                    <button type="submit" class="secondary-button">Remove Source</button>
                                </form>
                                @if (source.SourceType == "Inventory" && source.InventoryKey is not null)
                                {
                                    <a class="button" href="/BinsRun?Section=Actual&amp;WarehouseId=@source.WarehouseId&amp;RoomId=@source.RoomId&amp;SourceKey=@Uri.EscapeDataString(source.InventoryKey)&amp;ProjectionId=@selected.Id&amp;ProjectionSourceId=@source.Id">Review Actual Run</a>
                                }
                                else
                                {
                                    <span class="muted">Map this planning-only block to real inventory before recording an actual run.</span>
                                }
                            </div>
                        }
                    </article>
                }
                </div>
            }
        </section>

        <section class="panel">
            <h2>Combined Gross Size Projection</h2>
            @if (selected.CombinedSizes.Count == 0)
            {
                <p class="empty-state">No calculated size distribution is available.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Commodity</th><th>Size</th><th>Unrounded boxes</th><th>Planning boxes</th></tr></thead>
                        <tbody>
                        @foreach (var size in selected.CombinedSizes)
                        {
                            <tr><td>@size.Commodity</td><td>@size.Size</td><td>@size.UnroundedBoxes.ToString("0.##")</td><td>@size.RoundedBoxes</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            <div class="action-bar">
                @if (selected.CanEditRecord)
                {
                    <form method="post" action="/BinsRun/Projections/@selected.Id/Ready">
                        <input type="hidden" name="ConcurrencyVersion" value="@selected.ConcurrencyVersion" />
                        <input type="hidden" name="plannedDate" value="@selected.PlannedRunDate.ToString("yyyy-MM-dd")" />
                        <button type="submit">Mark Ready</button>
                    </form>
                }
                <form class="inline-form" method="post" action="/BinsRun/Projections/@selected.Id/Duplicate">
                    <label>Duplicate to <input type="date" name="PlannedRunDate" value="@selected.PlannedRunDate.AddDays(1).ToString("yyyy-MM-dd")" required /></label>
                    <button type="submit" class="secondary-button">Duplicate</button>
                </form>
                @if (Model.Planner.CanAdmin && selected.Status is "Draft" or "Ready")
                {
                    <form class="inline-form" method="post" action="/BinsRun/Projections/@selected.Id/Cancel">
                        <input type="hidden" name="ConcurrencyVersion" value="@selected.ConcurrencyVersion" />
                        <input type="hidden" name="plannedDate" value="@selected.PlannedRunDate.ToString("yyyy-MM-dd")" />
                        <label>Reason <input name="Reason" maxlength="500" required /></label>
                        <button type="submit" class="secondary-button">Cancel</button>
                    </form>
                }
                <button type="button" class="secondary-button" onclick="window.print()">Print</button>
                <a class="button secondary-button" href="/BinsRun/Projections/@selected.Id/Export?plannedDate=@selected.PlannedRunDate.ToString("yyyy-MM-dd")">Export CSV</a>
            </div>
        </section>
    }
}
else
{
    <section class="panel">
        <h2>Select Room</h2>
        <form class="toolbar bins-run-filter" method="get" action="/BinsRun">
            <input type="hidden" name="Section" value="@activeSection" />
            <label>Facility
                <select name="WarehouseId" onchange="this.form.submit()">
                    <option value="">All facilities</option>
                    @foreach (var warehouse in Model.Warehouses)
                    {
                        <option value="@warehouse.Id" selected="@(Model.Filter.WarehouseId == warehouse.Id)">@warehouse.Code</option>
                    }
                </select>
            </label>
            <label>Room
                <select name="RoomId" onchange="this.form.submit()">
                    <option value="">Select room</option>
                    @foreach (var room in Model.Rooms)
                    {
                        <option value="@room.Id" selected="@(Model.Filter.RoomId == room.Id)">@room.Warehouse.Code / @(room.CropQcRoomName ?? room.DisplayName ?? room.Code)</option>
                    }
                </select>
            </label>
            <button type="submit">Open</button>
        </form>
    </section>

    @if (activeSection.Equals("Actual", StringComparison.OrdinalIgnoreCase))
    {
        <section class="panel">
            <h2>Record Actual Bins Run</h2>
            @if (Model.Filter.ProjectionId is not null)
            {
                <p class="notice">This form was opened from projection #@Model.Filter.ProjectionId. Review and confirm the actual quantity; the plan has not changed inventory.</p>
                @if (conversionSource?.AvailableBinsSnapshot is int plannedAvailable
                    && conversionInventory is not null
                    && conversionInventory.CurrentBins != plannedAvailable)
                {
                    <p class="notice warning">Inventory changed since planning: @plannedAvailable bins were available when projected; @conversionInventory.CurrentBins are available now. Enter and confirm the actual bins run.</p>
                }
            }
            @if (!Model.CanRecord)
            {
                <p class="notice warning">Bins Run Edit access is required.</p>
            }
            else if (Model.Filter.RoomId is null || Model.AvailableInventory.Count == 0)
            {
                <p class="empty-state">Select a room with available inventory.</p>
            }
            else
            {
                <form class="form-grid" method="post" action="/BinsRun/Create">
                    <input type="hidden" name="WarehouseId" value="@Model.Form.WarehouseId" />
                    <input type="hidden" name="RoomId" value="@Model.Form.RoomId" />
                    <input type="hidden" name="RunProjectionId" value="@Model.Form.RunProjectionId" />
                    <input type="hidden" name="RunProjectionSourceId" value="@Model.Form.RunProjectionSourceId" />
                    <label class="field wide">Inventory source
                        <select name="InventoryKey" data-inventory-select required>
                        @foreach (var option in Model.AvailableInventory)
                        {
                            <option value="@option.InventoryKey" data-bins="@option.CurrentBins" selected="@(option.InventoryKey == Model.Form.InventoryKey)">@option.Label · @option.Room</option>
                        }
                        </select>
                    </label>
                    <label class="field">Current available bins
                        <input name="ExpectedAvailableBins" value="@Model.Form.ExpectedAvailableBins" data-expected-bins readonly />
                    </label>
                    <label class="field">Actual bins run
                        <input type="number" min="1" name="BinsRun" value="@(Model.Filter.ProjectionSourceId is null ? "" : selected?.Sources.FirstOrDefault(x => x.Id == Model.Filter.ProjectionSourceId)?.PlannedBins)" required />
                    </label>
                    <label class="field">Run date/time
                        <input type="datetime-local" name="RunAt" value="@BusinessTime.FormatPacificInput(BusinessTime.UtcNow)" required />
                    </label>
                    <label class="field wide">Notes
                        <textarea name="Notes" maxlength="1000"></textarea>
                    </label>
                    <button type="submit">Record Actual Bins Run</button>
                </form>
            }
        </section>
    }
    else if (activeSection.Equals("Transfer", StringComparison.OrdinalIgnoreCase))
    {
        <section class="panel">
            <h2>Transfer Bins</h2>
            <p class="muted">Uses the existing audited source-neutral Transfer Out / Transfer In workflow and current quantity safeguards.</p>
            @if (!Model.CanTransfer)
            {
                <p class="notice warning">Room Transactions Edit access is required.</p>
            }
            else if (Model.Filter.RoomId is null)
            {
                <p class="empty-state">Select the source room.</p>
            }
            else
            {
                <form class="form-grid" method="post" action="/BinsRun/Transfer">
                    <input type="hidden" name="FromRoomId" value="@Model.Filter.RoomId" />
                    <label class="field wide">Source lot
                        <select name="SourceLotKey" required>
                            <option value="">Select current lot</option>
                            @foreach (var option in Model.TransferLotOptions)
                            {
                                <option value="@option.LotKey" selected="@(option.LotKey == Model.Filter.SourceKey)">@option.Label</option>
                            }
                        </select>
                    </label>
                    <label class="field">Destination room
                        <select name="ToRoomId" required>
                            <option value="">Select destination</option>
                            @foreach (var option in Model.TransferDestinationOptions)
                            {
                                <option value="@option.RoomId">@option.Label</option>
                            }
                        </select>
                    </label>
                    <label class="field">Bins to transfer <input type="number" min="1" name="BinCount" required /></label>
                    <label class="field">Pacific date/time <input type="datetime-local" name="TransferAt" value="@BusinessTime.FormatPacificInput(BusinessTime.UtcNow)" required /></label>
                    <label class="field wide">Reason <input name="Reason" maxlength="500" required /></label>
                    <label class="field wide">Notes <textarea name="Notes" maxlength="1000"></textarea></label>
                    <label class="checkbox-field wide"><input type="checkbox" name="ConfirmOverTransfer" value="true" /> Allow explicit over-transfer correction override</label>
                    <button type="submit">Record Transfer</button>
                </form>
            }
        </section>
    }
    else if (activeSection.Equals("TrueUp", StringComparison.OrdinalIgnoreCase))
    {
        <section class="panel">
            <h2>True Up Inventory</h2>
            <p class="muted">Uses the existing audited current-count correction workflow. No receipt, sample, photo, or history is deleted.</p>
            @if (!Model.CanTrueUp)
            {
                <p class="notice warning">Room Transactions Admin access is required.</p>
            }
            else if (Model.Filter.RoomId is null)
            {
                <p class="empty-state">Select a room.</p>
            }
            else
            {
                <form class="form-grid" method="post" action="/BinsRun/TrueUp">
                    <input type="hidden" name="RoomId" value="@Model.Filter.RoomId" />
                    <label class="field wide">Current receipt-backed lot
                        <select name="ReceiptId" required>
                            <option value="">Select current lot</option>
                            @foreach (var option in Model.TrueUpReceiptOptions)
                            {
                                <option value="@option.ReceiptId">@option.Label</option>
                            }
                        </select>
                    </label>
                    <label class="field">Verified current bin count <input type="number" min="0" name="NewBinCount" required /></label>
                    <label class="field">Pacific as-of time <input type="datetime-local" name="AdjustmentAt" value="@BusinessTime.FormatPacificInput(BusinessTime.UtcNow)" required /></label>
                    <label class="field wide">Reason <input name="Reason" maxlength="500" required /></label>
                    <label class="field wide">Notes <textarea name="Notes" maxlength="1000"></textarea></label>
                    <button type="submit">Record True-Up</button>
                </form>
            }
        </section>
    }

    @if (activeSection.Equals("Actual", StringComparison.OrdinalIgnoreCase) || activeSection.Equals("Activity", StringComparison.OrdinalIgnoreCase))
    {
        <section class="panel">
            <h2>Recent Bins Run History</h2>
            @if (Model.History.Count == 0)
            {
                <p class="empty-state">No Bins Run transactions match the selected room.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>When</th><th>Room</th><th>Inventory</th><th>Old</th><th>Run</th><th>New</th><th>User</th><th>Status</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.History)
                        {
                            <tr>
                                <td>@BusinessTime.FormatPacific(item.RunAt)</td><td>@item.Room</td><td>@item.Inventory</td>
                                <td>@item.PreviousAvailableBins</td><td>@item.BinsRun</td><td>@item.NewAvailableBins</td>
                                <td>@item.CreatedBy</td><td>@(item.IsReversed ? "Reversed" : "Active")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    @if (activeSection.Equals("Activity", StringComparison.OrdinalIgnoreCase))
    {
        <section class="panel">
            <h2>Recent Transfer / True-Up Activity</h2>
            @if (Model.InventoryActivity.Count == 0)
            {
                <p class="empty-state">Select a room to review inventory adjustments.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>When</th><th>Lot</th><th>Type</th><th>Old</th><th>Delta</th><th>New</th><th>Source</th><th>Reason</th><th>User</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.InventoryActivity)
                        {
                            <tr><td>@BusinessTime.FormatPacific(item.AdjustmentAt)</td><td>@item.Lot</td><td>@item.AdjustmentType</td><td>@(item.OldBinCount?.ToString() ?? "-")</td><td>@item.ChangeAmount</td><td>@item.NewBinCount</td><td>@(item.Source ?? "-")</td><td>@(item.Reason ?? item.Notes ?? "-")</td><td>@item.CreatedBy</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
}

<script>
    (() => {
        const sourceSearch = document.querySelector("[data-run-source-search]");
        const sourceResults = document.querySelector("[data-run-source-results]");
        let searchTimer;
        async function loadSources() {
            if (!sourceSearch || !sourceResults) return;
            const params = new URLSearchParams({ query: sourceSearch.value || "" });
            @if (Model.Filter.RoomId is not null)
            {
                <text>params.set("roomId", "@Model.Filter.RoomId");</text>
            }
            const response = await fetch(`/BinsRun/Sources?${params}`);
            if (!response.ok) return;
            const rows = await response.json();
            sourceResults.innerHTML = '<option value="">Select a source</option>';
            for (const row of rows) {
                const option = document.createElement("option");
                option.value = row.sourceKey;
                option.textContent = row.label;
                sourceResults.appendChild(option);
            }
            const requested = "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Filter.SourceKey ?? ""))";
            if (requested) sourceResults.value = requested;
        }
        if (sourceSearch) {
            sourceSearch.addEventListener("input", () => {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(loadSources, 300);
            });
            loadSources();
        }

        const inventory = document.querySelector("[data-inventory-select]");
        const expected = document.querySelector("[data-expected-bins]");
        inventory?.addEventListener("change", () => {
            expected.value = inventory.selectedOptions[0]?.dataset.bins || "0";
        });

        const planned = Array.from(document.querySelectorAll("[data-planned-bins]"));
        const total = document.querySelector("[data-total-planned-bins]");
        for (const input of planned) {
            input.addEventListener("input", () => {
                if (total) total.textContent = planned.reduce((sum, item) => sum + (Number(item.value) || 0), 0);
            });
        }
    })();
</script>

@functions {
    private static string ProjectionStatusClass(string status) => status switch
    {
        "Ready" or "Converted to Actual Run" => "ready",
        "Cancelled" or "Expired" or "Superseded" => "missing",
        _ => "pending"
    };

    private static string Format(decimal? value, string suffix) => value is null ? "No data" : $"{value:0.##}{suffix}";
}
