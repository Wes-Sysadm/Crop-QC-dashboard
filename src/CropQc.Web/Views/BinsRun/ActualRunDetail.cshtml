@model ActualRunDetailViewModel
@{
    ViewData["Title"] = $"Actual Run #{Model.Id}";
}

<section class="page-header">
    <div>
        <p class="eyebrow">Actual Run</p>
        <h1>Actual Run #@Model.Id</h1>
        <p class="muted">@Model.Facility · @BusinessTime.FormatPacific(Model.RunAt) · Revision @Model.RevisionNumber · @Model.Status</p>
    </div>
    <div class="button-row">
        <a class="button secondary-button" href="/BinsRun?Section=Actual">Actual Run history</a>
        @if (Model.Packout is not null)
        {
            <a class="button" href="/BinsRun/Packout/@Model.Packout.Id">Open Packout Result</a>
        }
    </div>
</section>

@if (Model.DetailCorrections.Count > 0 || Model.CanCorrectDetails)
{
    <section class="panel">
        <h2>Run Detail Corrections</h2>
        @if (Model.DetailCorrections.Count > 0)
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Previous date/time</th><th>Corrected date/time</th><th>Notes</th><th>Reason</th><th>By</th><th>At</th></tr></thead>
                    <tbody>
                    @foreach (var correction in Model.DetailCorrections)
                    {
                        <tr>
                            <td>@BusinessTime.FormatPacific(correction.PreviousRunAt)</td>
                            <td>@BusinessTime.FormatPacific(correction.NewRunAt)</td>
                            <td>@(correction.NotesChanged ? "Changed" : "Unchanged")</td>
                            <td>@correction.Reason</td>
                            <td>@correction.CorrectedBy</td>
                            <td>@BusinessTime.FormatPacific(correction.CorrectedAt)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        @if (Model.CanCorrectDetails)
        {
            <details class="actual-run-detail-correction">
                <summary class="button secondary-button">Edit Run Details</summary>
                <form class="form-grid" method="post" action="/BinsRun/ActualRuns/@Model.Id/Details">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ConcurrencyVersion" value="@Model.ConcurrencyVersion" />
                    <input type="hidden" name="OperationKey" value="@Guid.NewGuid().ToString("N")" />
                    <label>Run date/time (Pacific)
                        <input type="datetime-local" name="RunAt" value="@BusinessTime.FormatPacificInput(Model.RunAt)" required />
                    </label>
                    <label class="wide">Notes
                        <textarea name="Notes" maxlength="1000">@Model.Notes</textarea>
                    </label>
                    <label class="wide">Reason for correction
                        <textarea name="Reason" maxlength="1000" required></textarea>
                    </label>
                    <p class="notice warning wide">Correcting the run date changes run reporting and historical run placement. It does not change inventory quantities, source rooms, treatment lineage, packout results, or frozen Run Expectations.</p>
                    <button type="submit">Apply Run Detail Correction</button>
                </form>
            </details>
        }
    </section>
}

@if (Model.CanCorrectRunLines)
{
    <section class="panel">
        <h2>Correct Run Lines</h2>
        <p>Correct the Grower/Grower Lot source or bins pulled when the recorded Actual Run does not match the physical run.</p>
        <p class="notice warning">This inventory-affecting correction restores every current depletion, then creates a new audited Actual Run revision from exact current inventory and treatment segments. Run Facility and Sales Desk remain fixed; candidate sources stay limited to compatible fruit profiles, and exact room and treatment selection is required.</p>
        <a class="button" href="/BinsRun?Section=Actual&amp;EditActualRunId=@Model.Id">Review Run-Line Correction</a>
    </section>
}

@if (Model.RunRevisions.Count > 0)
{
    <section class="panel">
        <h2>Actual Run Revisions</h2>
        <p class="muted">Inventory-affecting revisions remain immutable. Only the revision marked Current contributes to current Actual Run reporting.</p>
        @foreach (var revision in Model.RunRevisions)
        {
            <article class="subpanel">
                <h3>Revision @revision.RevisionNumber @(revision.IsCurrent ? "(Current)" : "")</h3>
                <p><strong>@revision.OperationType</strong> · @BusinessTime.FormatPacific(revision.CorrectedAt) · @revision.CorrectedBy</p>
                @if (!string.IsNullOrWhiteSpace(revision.Reason))
                {
                    <p><strong>Correction reason:</strong> @revision.Reason</p>
                }
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Room</th><th>Grower number</th><th>Grower</th><th>Lot</th><th>Variety</th><th>Treatment</th><th>Bins</th></tr></thead>
                        <tbody>
                        @foreach (var line in revision.Lines)
                        {
                            <tr><td>@line.Room</td><td>@line.GrowerNumber</td><td>@line.Grower</td><td>@line.Lot</td><td>@line.Variety</td><td>@line.Treatment</td><td>@line.Bins</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </article>
        }
    </section>
}

@if (!string.IsNullOrWhiteSpace(Model.DetailWarning))
{
    <p class="notice warning" role="alert">@Model.DetailWarning</p>
}

<section class="panel">
    <h2>Actual Run summary</h2>
    <dl class="summary-grid">
        <div><dt>Facility</dt><dd>@Model.Facility</dd></div>
        <div><dt>Sales Desk</dt><dd>@(Model.Facility == CropQc.Data.Entities.EmploymentFacilities.Wp ? Model.SalesDesk : "N/A")</dd></div>
        <div><dt>Run date/time</dt><dd>@BusinessTime.FormatPacific(Model.RunAt, "dddd, MMMM d, yyyy h:mm tt")</dd></div>
        <div><dt>Revision</dt><dd>@Model.RevisionNumber</dd></div>
        <div><dt>Total bins</dt><dd>@Model.TotalBins</dd></div>
        <div><dt>Source lines</dt><dd>@Model.Contributions.Count</dd></div>
        <div><dt>Recorded by</dt><dd>@Model.CreatedBy</dd></div>
        <div><dt>Status</dt><dd>@Model.Status</dd></div>
    </dl>
    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <p><strong>Notes:</strong> @Model.Notes</p>
    }
</section>

@if (Model.Facility == CropQc.Data.Entities.EmploymentFacilities.Wp)
{
    <section class="panel">
        <h2>Sales Desk attribution</h2>
        <p><strong>Current:</strong> @Model.SalesDesk</p>
        @if (Model.SalesDeskCorrections.Count > 0)
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Original</th><th>Corrected</th><th>Reason</th><th>By</th><th>At</th></tr></thead>
                    <tbody>
                    @foreach (var correction in Model.SalesDeskCorrections)
                    {
                        <tr><td>@correction.PreviousSalesDesk</td><td>@correction.NewSalesDesk</td><td>@correction.Reason</td><td>@correction.CorrectedBy</td><td>@BusinessTime.FormatPacific(correction.CorrectedAt)</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        @if (Model.CanCorrectSalesDesk)
        {
            <form class="form-grid sales-desk-correction-form" method="post" action="/BinsRun/ActualRuns/@Model.Id/SalesDesk">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ConcurrencyVersion" value="@Model.ConcurrencyVersion" />
                <input type="hidden" name="OperationKey" value="@Guid.NewGuid().ToString("N")" />
                <label>New Sales Desk
                    <select name="SalesDeskId" required>
                        <option value="">Select Sales Desk</option>
                        @foreach (var desk in Model.SalesDeskOptions.Where(x => x.IsActive && x.Id != Model.SalesDeskId))
                        {
                            <option value="@desk.Id">@desk.Name</option>
                        }
                    </select>
                </label>
                <label class="wide">Reason<textarea name="Reason" maxlength="1000" required></textarea></label>
                <p class="muted wide">This changes reporting attribution only. Inventory, treatment lineage, run quantities, and frozen expectations are unchanged.</p>
                <button type="submit">Apply Sales Desk Correction</button>
            </form>
        }
    </section>
}

<section class="panel">
    <h2>Source contribution</h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Facility</th><th>Room</th><th>Grower number</th><th>Grower</th><th>Lot</th><th>Variety</th><th>Production</th><th>Organic / Conventional</th><th>Status</th><th>Treatment</th><th>Crop year</th><th>Bins</th><th>Contribution</th></tr>
            </thead>
            <tbody>
            @foreach (var source in Model.Contributions)
            {
                <tr>
                    <td>@source.Facility</td>
                    <td>@source.Room</td>
                    <td>@source.GrowerNumber</td>
                    <td>@source.Grower</td>
                    <td>@source.Lot</td>
                    <td>@source.Variety</td>
                    <td>@source.ProductionType</td>
                    <td>@(source.IsOrganic is null ? "Unknown" : source.IsOrganic.Value ? "Organic" : "Conventional")</td>
                    <td>@source.InventoryStatus</td>
                    <td>
                        @source.TreatmentSummary
                        @if (source.TreatmentReports.Count > 0)
                        {
                            <div class="treatment-report-run-links">
                                <strong>Treatment Report:</strong>
                                @foreach (var report in source.TreatmentReports)
                                {
                                    <a href="/RoomTreatments/@report.ApplicationId/Reports/@report.AttachmentId/Content" target="_blank" rel="noopener">@report.FileName</a>
                                }
                            </div>
                        }
                    </td>
                    <td>@source.CropYear</td>
                    <td>@source.Bins</td>
                    <td>@source.ContributionPercent.ToString("0.##")%</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section class="panel">
    <h2>@(Model.CurrentExpectation?.IsHistoricalReconstruction == true ? "Historical Reconstructed Benchmark" : "Run Expectation")</h2>
    @if (!Model.OptionalDetailAvailable)
    {
        <p class="warning">Run Expectation data is unavailable until the required database update is completed. The Actual Run summary and source contribution above remain available.</p>
    }
    else if (Model.CurrentExpectation is null)
    {
        <p class="warning">This legacy Actual Run does not have a frozen Run Expectation.</p>
    }
    else
    {
        var expectation = Model.CurrentExpectation;
        @if (expectation.RunAtSnapshot != Model.RunAt)
        {
            <p class="notice">The run date was corrected after this Run Expectation was frozen. The expectation retains its original run-date snapshot for auditability.</p>
        }
        @if (expectation.IsHistoricalReconstruction)
        {
            <p class="notice warning" role="alert">
                This benchmark was reconstructed after the physical run using configuration available at reconstruction time. It is not an original pre-run forecast.
                QC evidence was limited to samples taken on or before @(expectation.QcEvidenceCutoff?.ToString("g") ?? "the physical run time").
            </p>
        }
        <dl class="summary-grid">
            <div><dt>@(expectation.IsHistoricalReconstruction ? "Reconstructed benchmark packout" : "Expected packout")</dt><dd>@expectation.ExpectedPackoutPercent.ToString("0.##")%</dd></div>
            <div><dt>@(expectation.IsHistoricalReconstruction ? "Reconstructed benchmark packed pounds" : "Expected packed pounds")</dt><dd>@expectation.ExpectedPackedPounds.ToString("0.##") lb</dd></div>
            <div><dt>@(expectation.IsHistoricalReconstruction ? "Reconstructed benchmark whole 40-lb boxes" : "Expected whole 40-lb boxes")</dt><dd>@expectation.ExpectedWholeBoxes</dd></div>
            <div><dt>@(expectation.IsHistoricalReconstruction ? "Reconstructed benchmark cull" : "Expected cull")</dt><dd>@expectation.ExpectedCullPounds.ToString("0.##") lb</dd></div>
            <div><dt>@(expectation.IsHistoricalReconstruction ? "Reconstructed benchmark juice" : "Expected juice")</dt><dd>@expectation.ExpectedJuicePounds.ToString("0.##") lb</dd></div>
            <div><dt>@(expectation.IsHistoricalReconstruction ? "Reconstructed benchmark peeler" : "Expected peeler")</dt><dd>@expectation.ExpectedPeelerPounds.ToString("0.##") lb</dd></div>
            <div><dt>@(expectation.IsHistoricalReconstruction ? "Reconstructed benchmark waste" : "Expected waste")</dt><dd>@expectation.ExpectedWastePounds.ToString("0.##") lb</dd></div>
            <div><dt>Confidence</dt><dd>@expectation.ConfidencePercent.ToString("0.##")%</dd></div>
            <div><dt>@(expectation.IsHistoricalReconstruction ? "Reconstructed" : "Calculated")</dt><dd>@BusinessTime.FormatPacific(expectation.CalculatedAt)</dd></div>
            <div><dt>Calculation version</dt><dd>@expectation.CalculationVersion</dd></div>
        </dl>
        <div class="grid two-column-grid">
            <div>
                <h3>@(expectation.IsHistoricalReconstruction ? "Reconstructed benchmark size distribution" : "Expected size distribution")</h3>
                @if (expectation.SizeDistribution.Count == 0)
                {
                    <p class="muted">@(expectation.IsHistoricalReconstruction ? "No eligible size observations existed at the physical-run QC cutoff." : "No eligible size observations were available when this expectation was frozen.")</p>
                }
                else
                {
                    <table>
                        <thead><tr><th>Size</th><th>Expected share</th></tr></thead>
                        <tbody>
                        @foreach (var size in expectation.SizeDistribution.OrderBy(x => x.Key))
                        {
                            <tr><td>@size.Key</td><td>@size.Value.ToString("0.##")%</td></tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
            <div>
                <h3>@(expectation.IsHistoricalReconstruction ? "Reconstructed benchmark grade distribution" : "Expected grade distribution")</h3>
                @if (expectation.GradeDistribution.Count == 0)
                {
                    <p class="muted">@(expectation.IsHistoricalReconstruction ? "No eligible grade observations existed at the physical-run QC cutoff." : "No eligible grade observations were available when this expectation was frozen.")</p>
                }
                else
                {
                    <table>
                        <thead><tr><th>Grade</th><th>Expected share</th></tr></thead>
                        <tbody>
                        @foreach (var grade in expectation.GradeDistribution.OrderBy(x => x.Key))
                        {
                            <tr><td>@grade.Key</td><td>@grade.Value.ToString("0.##")%</td></tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>
        @if (Model.Expectations.Count > 1)
        {
            <details>
                <summary>Prior immutable Run Expectation revisions</summary>
                <ul>
                @foreach (var prior in Model.Expectations.Where(x => x.Id != expectation.Id))
                {
                    <li>Revision @prior.RevisionNumber · @prior.TotalBins bins · @prior.ExpectedPackoutPercent.ToString("0.##")% expected packout · @BusinessTime.FormatPacific(prior.CalculatedAt)</li>
                }
                </ul>
            </details>
        }
    }
</section>

<section class="panel">
    <h2>Packout Result and supporting documents</h2>
    @if (!Model.OptionalDetailAvailable)
    {
        <p class="warning">The supporting-document area is reachable, but upload and Packout Result data are unavailable until the required database update is completed.</p>
    }
    else if (!Model.CanViewPackout)
    {
        <p class="muted">Packout Result View access is required.</p>
    }
    else if (Model.Packout is null)
    {
        @if (Model.CanUploadPackout)
        {
            <form method="post" enctype="multipart/form-data" action="/BinsRun/ActualRuns/@Model.Id/Packout" class="form-grid" data-upload-feedback-form data-upload-progress-form data-upload-busy-text="Uploading packout report files...">
                @Html.AntiForgeryToken()
                <label>Packing date<input type="date" name="PackingDate" value="@BusinessTime.PacificDate(Model.RunAt).ToString("yyyy-MM-dd")" required /></label>
                <label>Run number<input type="number" name="RunNumber" min="1" value="1" required /></label>
                <label>Dumped bins<input type="number" name="DumpedBins" min="0.01" step="0.01" value="@Model.TotalBins" required /></label>
                <label class="wide">Packout report files<input type="file" name="Files" multiple required accept=".pdf,.xls,.xlsx,.csv,.txt,.jpg,.jpeg,.png,.tif,.tiff" /></label>
                <p class="muted wide">Files must be parts or pages of this one physical run report. Original documents are retained permanently even when reconciliation or parsing is unavailable.</p>
                <div class="upload-feedback wide" data-upload-feedback role="status" aria-live="polite" hidden>
                    <span class="upload-feedback-spinner" data-upload-feedback-spinner aria-hidden="true"></span>
                    <span data-upload-feedback-message></span>
                    <progress data-upload-feedback-progress max="100" value="0" hidden></progress>
                </div>
                <button type="submit">Upload Packout Result</button>
            </form>
        }
        else
        {
            <p class="muted">No Packout Result has been uploaded.</p>
        }
    }
    else
    {
        <dl class="summary-grid">
            <div><dt>Status</dt><dd>@Model.Packout.Status</dd></div>
            <div><dt>Dumped bins</dt><dd>@Model.Packout.DumpedBins.ToString("0.##")</dd></div>
            <div><dt>Actual packed pounds</dt><dd>@Model.Packout.PackedPounds.ToString("0.##") lb</dd></div>
            <div><dt>Actual packout</dt><dd>@(Model.Packout.ActualPackoutPercent?.ToString("0.##") ?? "Not calculated")%</dd></div>
        </dl>
        <a class="button" href="/BinsRun/Packout/@Model.Packout.Id">Review Packout Result</a>
        @if (Model.CurrentExpectation is null)
        {
            <p class="notice warning">Reconciliation unavailable — this historical run predates frozen Run Expectations.</p>
        }
        @if (Model.Packout.Documents.Count > 0)
        {
            <h3>Supporting Packout Documents</h3>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>File</th><th>Size</th><th>Uploaded</th><th>By</th><th>Parsing</th><th>Action</th></tr></thead>
                    <tbody>
                    @foreach (var document in Model.Packout.Documents)
                    {
                        <tr>
                            <td>@document.FileName</td>
                            <td>@((document.FileSizeBytes / 1024d).ToString("0.#")) KB</td>
                            <td>@BusinessTime.FormatPacific(document.UploadedAt, empty: "Legacy upload")</td>
                            <td>@document.UploadedBy</td>
                            <td><span>@document.ParseStatus</span>@if (!string.IsNullOrWhiteSpace(document.Diagnostic)) { <br /><span class="muted">@document.Diagnostic</span> }</td>
                            <td>@if (document.CanOpen) { <a class="button secondary-button" target="_blank" rel="noopener" href="/BinsRun/Packout/@Model.Packout.Id/Sources/@document.Id/Content">View or download</a> } else { <span class="muted">Legacy original unavailable</span> }</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    }
</section>

@if (Model.Packout is not null && Model.CurrentExpectation is not null)
{
    <section class="panel">
        <h2>@(Model.CurrentExpectation.IsHistoricalReconstruction ? "Reconstructed Benchmark vs. Actual" : "Expected vs. Actual")</h2>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Measure</th><th>@(Model.CurrentExpectation.IsHistoricalReconstruction ? "Reconstructed benchmark" : "Expected")</th><th>Actual</th><th>Variance</th></tr></thead>
                <tbody>
                    <tr><td>Packout</td><td>@Model.CurrentExpectation.ExpectedPackoutPercent.ToString("0.##")%</td><td>@(Model.Packout.ActualPackoutPercent?.ToString("0.##") ?? "—")%</td><td>@(Model.Packout.PackoutVariancePercent?.ToString("+0.##;-0.##;0") ?? "—") points</td></tr>
                    <tr><td>Packed pounds</td><td>@Model.CurrentExpectation.ExpectedPackedPounds.ToString("0.##")</td><td>@Model.Packout.PackedPounds.ToString("0.##")</td><td>@((Model.Packout.PackedPounds - Model.CurrentExpectation.ExpectedPackedPounds).ToString("+0.##;-0.##;0"))</td></tr>
                    <tr><td>@(Model.CurrentExpectation.IsHistoricalReconstruction ? "Size benchmark score" : "Size distribution accuracy")</td><td>@(Model.CurrentExpectation.IsHistoricalReconstruction ? "Reconstructed benchmark" : "Frozen expectation")</td><td>@(Model.Packout.SizeAccuracyPercent?.ToString("0.##") ?? "Not calculated")%</td><td>@(Model.CurrentExpectation.IsHistoricalReconstruction ? "Benchmark score" : "Accuracy score")</td></tr>
                    <tr><td>@(Model.CurrentExpectation.IsHistoricalReconstruction ? "Grade benchmark score" : "Grade distribution accuracy")</td><td>@(Model.CurrentExpectation.IsHistoricalReconstruction ? "Reconstructed benchmark" : "Frozen expectation")</td><td>@(Model.Packout.GradeAccuracyPercent?.ToString("0.##") ?? "Not calculated")%</td><td>@(Model.CurrentExpectation.IsHistoricalReconstruction ? "Benchmark score" : "Accuracy score")</td></tr>
                    <tr><td>@(Model.CurrentExpectation.IsHistoricalReconstruction ? "Reconstructed benchmark score" : "Accuracy")</td><td>—</td><td>@(Model.Packout.AccuracyPercent?.ToString("0.##") ?? "Not calculated")%</td><td>—</td></tr>
                </tbody>
            </table>
        </div>
    </section>
}

@if (Model.Packout?.Allocations.Count > 0)
{
    <section class="panel">
        <h2>Estimated Allocation by Source Lot</h2>
        <p class="muted">These values are proportional estimates based on bins contributed. The overall Packout Result remains authoritative.</p>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Room</th><th>Grower / lot</th><th>Bins</th><th>Share</th><th>Packed lb</th><th>Whole boxes</th><th>Residual lb</th><th>Juice</th><th>Peeler</th><th>Waste</th></tr></thead>
                <tbody>
                @foreach (var allocation in Model.Packout.Allocations)
                {
                    <tr>
                        <td>@allocation.Room</td>
                        <td>@allocation.Grower / @allocation.Lot</td>
                        <td>@allocation.Bins</td>
                        <td>@allocation.ContributionPercent.ToString("0.##")%</td>
                        <td>@allocation.PackedPounds.ToString("0.##")</td>
                        <td>@allocation.WholeBoxes</td>
                        <td>@allocation.ResidualPounds.ToString("0.##")</td>
                        <td>@allocation.JuicePounds.ToString("0.##")</td>
                        <td>@allocation.PeelerPounds.ToString("0.##")</td>
                        <td>@allocation.WastePounds.ToString("0.##")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
