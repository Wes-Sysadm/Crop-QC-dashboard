@model ActualRunDetailViewModel
@{
    ViewData["Title"] = $"Actual Run #{Model.Id}";
}

<section class="page-header">
    <div>
        <p class="eyebrow">Actual Run</p>
        <h1>Actual Run #@Model.Id</h1>
        <p class="muted">@Model.Facility · @Model.RunAt.ToString("g") · Revision @Model.RevisionNumber · @Model.Status</p>
    </div>
    <div class="button-row">
        <a class="button secondary-button" href="/BinsRun?Section=Actual">Actual Run history</a>
        @if (Model.Packout is not null)
        {
            <a class="button" href="/BinsRun/Packout/@Model.Packout.Id">Open Packout Result</a>
        }
    </div>
</section>

<section class="panel">
    <h2>Actual Run summary</h2>
    <dl class="summary-grid">
        <div><dt>Facility</dt><dd>@Model.Facility</dd></div>
        <div><dt>Run date/time</dt><dd>@Model.RunAt.ToString("f")</dd></div>
        <div><dt>Revision</dt><dd>@Model.RevisionNumber</dd></div>
        <div><dt>Total bins</dt><dd>@Model.TotalBins</dd></div>
        <div><dt>Recorded by</dt><dd>@Model.CreatedBy</dd></div>
        <div><dt>Status</dt><dd>@Model.Status</dd></div>
    </dl>
    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <p><strong>Notes:</strong> @Model.Notes</p>
    }
</section>

<section class="panel">
    <h2>Source contribution</h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Room</th><th>Grower</th><th>Lot</th><th>Variety</th><th>Production</th><th>Crop year</th><th>Bins</th><th>Contribution</th></tr>
            </thead>
            <tbody>
            @foreach (var source in Model.Contributions)
            {
                <tr>
                    <td>@source.Room</td>
                    <td>@source.Grower</td>
                    <td>@source.Lot</td>
                    <td>@source.Variety</td>
                    <td>@source.ProductionType</td>
                    <td>@source.CropYear</td>
                    <td>@source.Bins</td>
                    <td>@source.ContributionPercent.ToString("0.##")%</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section class="panel">
    <h2>Run Expectation</h2>
    @if (Model.CurrentExpectation is null)
    {
        <p class="warning">This legacy Actual Run does not have a frozen Run Expectation.</p>
    }
    else
    {
        var expectation = Model.CurrentExpectation;
        <dl class="summary-grid">
            <div><dt>Expected packout</dt><dd>@expectation.ExpectedPackoutPercent.ToString("0.##")%</dd></div>
            <div><dt>Expected packed pounds</dt><dd>@expectation.ExpectedPackedPounds.ToString("0.##") lb</dd></div>
            <div><dt>Expected whole 40-lb boxes</dt><dd>@expectation.ExpectedWholeBoxes</dd></div>
            <div><dt>Expected cull</dt><dd>@expectation.ExpectedCullPounds.ToString("0.##") lb</dd></div>
            <div><dt>Expected juice</dt><dd>@expectation.ExpectedJuicePounds.ToString("0.##") lb</dd></div>
            <div><dt>Expected peeler</dt><dd>@expectation.ExpectedPeelerPounds.ToString("0.##") lb</dd></div>
            <div><dt>Expected waste</dt><dd>@expectation.ExpectedWastePounds.ToString("0.##") lb</dd></div>
            <div><dt>Confidence</dt><dd>@expectation.ConfidencePercent.ToString("0.##")%</dd></div>
            <div><dt>Calculated</dt><dd>@expectation.CalculatedAt.ToString("g")</dd></div>
            <div><dt>Calculation version</dt><dd>@expectation.CalculationVersion</dd></div>
        </dl>
        <div class="grid two-column-grid">
            <div>
                <h3>Expected size distribution</h3>
                @if (expectation.SizeDistribution.Count == 0)
                {
                    <p class="muted">No eligible size observations were available when this expectation was frozen.</p>
                }
                else
                {
                    <table>
                        <thead><tr><th>Size</th><th>Expected share</th></tr></thead>
                        <tbody>
                        @foreach (var size in expectation.SizeDistribution.OrderBy(x => x.Key))
                        {
                            <tr><td>@size.Key</td><td>@size.Value.ToString("0.##")%</td></tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
            <div>
                <h3>Expected grade distribution</h3>
                @if (expectation.GradeDistribution.Count == 0)
                {
                    <p class="muted">No eligible grade observations were available when this expectation was frozen.</p>
                }
                else
                {
                    <table>
                        <thead><tr><th>Grade</th><th>Expected share</th></tr></thead>
                        <tbody>
                        @foreach (var grade in expectation.GradeDistribution.OrderBy(x => x.Key))
                        {
                            <tr><td>@grade.Key</td><td>@grade.Value.ToString("0.##")%</td></tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>
        @if (Model.Expectations.Count > 1)
        {
            <details>
                <summary>Prior immutable Run Expectation revisions</summary>
                <ul>
                @foreach (var prior in Model.Expectations.Where(x => x.Id != expectation.Id))
                {
                    <li>Revision @prior.RevisionNumber · @prior.TotalBins bins · @prior.ExpectedPackoutPercent.ToString("0.##")% expected packout · @prior.CalculatedAt.ToString("g")</li>
                }
                </ul>
            </details>
        }
    }
</section>

<section class="panel">
    <h2>Packout Result</h2>
    @if (!Model.CanViewPackout)
    {
        <p class="muted">Packout Result View access is required.</p>
    }
    else if (Model.Packout is null)
    {
        @if (Model.CanUploadPackout)
        {
            <form method="post" enctype="multipart/form-data" action="/BinsRun/ActualRuns/@Model.Id/Packout" class="form-grid">
                @Html.AntiForgeryToken()
                <label>Packing date<input type="date" name="PackingDate" required /></label>
                <label>Run number<input type="number" name="RunNumber" min="1" value="1" required /></label>
                <label>Dumped bins<input type="number" name="DumpedBins" min="0.01" step="0.01" value="@Model.TotalBins" required /></label>
                <label class="wide">Packout report files<input type="file" name="Files" multiple required accept=".pdf,.xls,.xlsx,.csv,.txt,.jpg,.jpeg,.png,.tif,.tiff" /></label>
                <p class="muted wide">Files must be parts or pages of this one physical run report. Uploaded originals are removed after bounded parsing.</p>
                <button type="submit">Upload Packout Result</button>
            </form>
        }
        else
        {
            <p class="muted">No Packout Result has been uploaded.</p>
        }
    }
    else
    {
        <dl class="summary-grid">
            <div><dt>Status</dt><dd>@Model.Packout.Status</dd></div>
            <div><dt>Dumped bins</dt><dd>@Model.Packout.DumpedBins.ToString("0.##")</dd></div>
            <div><dt>Actual packed pounds</dt><dd>@Model.Packout.PackedPounds.ToString("0.##") lb</dd></div>
            <div><dt>Actual packout</dt><dd>@(Model.Packout.ActualPackoutPercent?.ToString("0.##") ?? "Not calculated")%</dd></div>
        </dl>
        <a class="button" href="/BinsRun/Packout/@Model.Packout.Id">Review Packout Result</a>
    }
</section>

@if (Model.Packout is not null && Model.CurrentExpectation is not null)
{
    <section class="panel">
        <h2>Expected vs. Actual</h2>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Measure</th><th>Expected</th><th>Actual</th><th>Variance</th></tr></thead>
                <tbody>
                    <tr><td>Packout</td><td>@Model.CurrentExpectation.ExpectedPackoutPercent.ToString("0.##")%</td><td>@(Model.Packout.ActualPackoutPercent?.ToString("0.##") ?? "—")%</td><td>@(Model.Packout.PackoutVariancePercent?.ToString("+0.##;-0.##;0") ?? "—") points</td></tr>
                    <tr><td>Packed pounds</td><td>@Model.CurrentExpectation.ExpectedPackedPounds.ToString("0.##")</td><td>@Model.Packout.PackedPounds.ToString("0.##")</td><td>@((Model.Packout.PackedPounds - Model.CurrentExpectation.ExpectedPackedPounds).ToString("+0.##;-0.##;0"))</td></tr>
                    <tr><td>Size distribution accuracy</td><td>Frozen expectation</td><td>@(Model.Packout.SizeAccuracyPercent?.ToString("0.##") ?? "Not calculated")%</td><td>Accuracy score</td></tr>
                    <tr><td>Grade distribution accuracy</td><td>Frozen expectation</td><td>@(Model.Packout.GradeAccuracyPercent?.ToString("0.##") ?? "Not calculated")%</td><td>Accuracy score</td></tr>
                    <tr><td>Accuracy</td><td>—</td><td>@(Model.Packout.AccuracyPercent?.ToString("0.##") ?? "Not calculated")%</td><td>—</td></tr>
                </tbody>
            </table>
        </div>
    </section>
}

@if (Model.Packout?.Allocations.Count > 0)
{
    <section class="panel">
        <h2>Estimated Allocation by Source Lot</h2>
        <p class="muted">These values are proportional estimates based on bins contributed. The overall Packout Result remains authoritative.</p>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Room</th><th>Grower / lot</th><th>Bins</th><th>Share</th><th>Packed lb</th><th>Whole boxes</th><th>Residual lb</th><th>Juice</th><th>Peeler</th><th>Waste</th></tr></thead>
                <tbody>
                @foreach (var allocation in Model.Packout.Allocations)
                {
                    <tr>
                        <td>@allocation.Room</td>
                        <td>@allocation.Grower / @allocation.Lot</td>
                        <td>@allocation.Bins</td>
                        <td>@allocation.ContributionPercent.ToString("0.##")%</td>
                        <td>@allocation.PackedPounds.ToString("0.##")</td>
                        <td>@allocation.WholeBoxes</td>
                        <td>@allocation.ResidualPounds.ToString("0.##")</td>
                        <td>@allocation.JuicePounds.ToString("0.##")</td>
                        <td>@allocation.PeelerPounds.ToString("0.##")</td>
                        <td>@allocation.WastePounds.ToString("0.##")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
