@model InterCrewTransferDetailViewModel
@inject CropQc.Shared.Time.IBusinessTimeService BusinessTime
@{ ViewData["Title"] = $"Inter-Crew Transfer #{Model.Id}"; }
<section class="page-header"><div><p class="eyebrow">Transfers</p><h1>Inter-Crew Transfer #@Model.Id</h1><p class="muted">One truck, one custody transfer, one receiving event.</p></div><a class="secondary-button" href="/BinsRun?Section=Transfer&amp;TransferType=InterCrew">Back to Transfers</a></section>
<section class="panel"><div class="panel-heading"><h2>@Model.Source → @Model.DestinationGroup</h2><span class="status-pill @(Model.Status == "InTransit" ? "status-warning" : Model.Status == "Reversed" ? "status-muted" : Model.Status == "ReceivedNeedsReview" ? "status-warning" : "status-ok")">@Model.StatusLabel</span></div>
<dl class="summary-list"><dt>Grower</dt><dd>@Model.Grower</dd><dt>Lot</dt><dd>@Model.Lot</dd><dt>Variety</dt><dd>@Model.Variety</dd><dt>Treatment</dt><dd>@Model.Treatment</dd><dt>Loaded</dt><dd>@Model.BinsLoaded bins at @BusinessTime.FormatPacific(Model.LoadedAt)</dd><dt>Received</dt><dd>@(Model.BinsReceived is int received ? $"{received} bins" : "Not received")</dd><dt>Variance</dt><dd>@(Model.Variance is int variance ? $"{variance:+#;-#;0} bins" : "—")</dd><dt>Destination Room</dt><dd>@(Model.Destination ?? "Selected by receiving crew")</dd><dt>Truck / Load / BOL</dt><dd>@(Model.Bol ?? "—")</dd><dt>Loaded by</dt><dd>@Model.LoadedBy</dd><dt>Received by</dt><dd>@(Model.ReceivedBy ?? "—")</dd><dt>Notes</dt><dd>@(Model.Notes ?? "—")</dd></dl></section>
@if (Model.CanReceive)
{
<section class="panel"><h2>Receive Load</h2><p class="notice information">Enter the physical count received. The load is received once into one destination Room; partial receiving is not supported.</p><form method="post" action="/BinsRun/InterCrewTransfers/@Model.Id/Receive" class="form-grid"><input type="hidden" name="OperationKey" value="@Guid.NewGuid().ToString("N")" /><label class="field">Destination Room<select name="DestinationRoomId" required><option value="">Select Room...</option>@foreach (var room in Model.DestinationRooms) { <option value="@room.Id">@room.Facility / @room.Room</option> }</select></label><label class="field">Bins received<input name="BinsReceived" type="number" min="1" inputmode="numeric" required /></label><label class="field">Received date/time (Pacific)<input name="ReceivedAt" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required /></label><label class="field wide">Receiving note<textarea name="Note" maxlength="1000"></textarea></label><button type="submit">Receive Entire Load</button></form></section>
}
@if (Model.Status == "ReceivedNeedsReview" && Model.CanAdmin)
{
<section class="panel"><h2>Review Count Variance</h2><p class="notice warning">Loaded @Model.BinsLoaded; received @Model.BinsReceived; variance @Model.Variance. Reviewing does not rewrite either count.</p><form method="post" action="/BinsRun/InterCrewTransfers/@Model.Id/Review" class="form-grid"><input type="hidden" name="OperationKey" value="@Guid.NewGuid().ToString("N")" /><label class="field wide">Required review note<textarea name="Note" required maxlength="1000"></textarea></label><button type="submit">Record Review</button></form></section>
}
@if (!string.IsNullOrWhiteSpace(Model.ReviewNote)) { <section class="panel"><h2>Variance Review</h2><dl class="summary-list"><dt>Note</dt><dd>@Model.ReviewNote</dd><dt>Reviewed by</dt><dd>@Model.ReviewedBy</dd><dt>Reviewed at</dt><dd>@(Model.ReviewedAt is DateTimeOffset at ? BusinessTime.FormatPacific(at) : "—")</dd></dl></section> }
@if (Model.Status == "Reversed") { <section class="panel"><h2>Administrative Reversal</h2><p>@Model.ReversalReason</p><p class="notice information">The original loaded and received counts remain immutable in history.</p></section> }
else if (Model.CanAdmin) { <section class="panel danger-zone"><h2>Reverse Incorrect Transfer</h2><p class="notice warning">A received reversal removes the exact received bins from the destination and restores the exact loaded bins to the source. It fails closed if the destination lacks inventory.</p><form method="post" action="/BinsRun/InterCrewTransfers/@Model.Id/Reverse" class="form-grid" onsubmit="return confirm('Reverse this transfer using its exact immutable counts?');"><input type="hidden" name="OperationKey" value="@Guid.NewGuid().ToString("N")" /><label class="field wide">Required reason<textarea name="Reason" required maxlength="1000"></textarea></label><button type="submit" class="danger-button">Reverse Transfer</button></form></section> }
