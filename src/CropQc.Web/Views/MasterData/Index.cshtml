@model MasterDataPageViewModel
@inject CropQc.Web.Services.IAdminAuthorizationService AdminAuthorization
@{
    ViewData["Title"] = Model.Title;
    var links = new[]
    {
        ("Warehouses", "/MasterData/warehouses"),
        ("Rooms", "/MasterData/rooms"),
        ("Fruit profiles / variety codes", "/MasterData/fruit-profiles"),
        ("Grades", "/MasterData/grades"),
        ("Defects", "/MasterData/defects"),
        ("Sample types", "/MasterData/sample-types"),
        ("Grower Lots", "/MasterData/grower-lots"),
        ("Starch scale values", "/MasterData/starch-scale-values"),
        ("Size thresholds", "/MasterData/size-thresholds")
    };
    var roomWarehouseOptions = Model.Type == "rooms"
        ? Model.Items.Select(x => x.Cells[0]).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList()
        : new List<string>();
    var importPreview = Model.ImportPreview;
}

<h1>@Model.Title</h1>
@if (Model.DataWarning is not null)
{
    <p class="notice warning">@Model.DataWarning</p>
}

<nav class="toolbar">
@foreach (var link in links)
{
    <a class="button" href="@link.Item2">@link.Item1</a>
}
@if (Model.CanEdit)
{
    @if (AdminAuthorization.IsAdmin(User))
    {
        <a class="button secondary-button" href="/Admin/Configuration">Configuration</a>
    }
}
</nav>

@if (Model.Type == "rooms")
{
    @if (Model.Items.Count == 0)
    {
        <p class="notice warning">No rooms are currently configured. Set <code>Database__SeedMasterDataOnStartup=true</code> and redeploy to add the required MVP 1 room list, then verify <code>/health/master-data</code>.</p>
    }
    <section class="toolbar" aria-label="Room filters">
        <div class="field">
            <label>Warehouse</label>
            <select id="roomWarehouseFilter">
                <option value="">All warehouses</option>
                @foreach (var warehouseCode in roomWarehouseOptions)
                {
                    <option value="@warehouseCode">@warehouseCode</option>
                }
            </select>
        </div>
        <div class="field">
            <label>Active Status</label>
            <select id="roomActiveFilter">
                <option value="">All statuses</option>
                <option value="Yes">Active</option>
                <option value="No">Inactive</option>
            </select>
        </div>
    </section>
}

@if (TempData["Error"] is not null)
{
    <p class="notice warning">@TempData["Error"]</p>
}
@if (TempData["Success"] is not null)
{
    <p class="notice success">@TempData["Success"]</p>
}

@if (Model.CanEdit && Model.Type != "index")
{
    <section class="panel">
        <h2>Add @Model.Title</h2>
        <form class="form-grid" method="post" action="/MasterData/@Model.Type/Save">
            @await Html.PartialAsync("_MasterDataFields", Model.EditForm ?? new MasterDataEditForm { Type = Model.Type })
            <button type="submit">Add</button>
        </form>
    </section>
}

@if (Model.CanEdit && Model.Type == "grower-lots")
{
    <section class="panel">
        <h2>Import Grower Lots</h2>
        <p class="muted">Upload a CSV with <strong>Grower</strong>, <strong>Lot #</strong>, and <strong>Pool Start</strong>. Aliases like <code>Grower Number</code>, <code>#</code>, <code>Lot Number</code>, and <code>POOL Starts</code> are accepted. Import inserts or updates only; it never deletes production rows that are missing from the file.</p>
        <form class="form-grid" method="post" enctype="multipart/form-data" action="/MasterData/grower-lots/ImportPreview">
            <label class="field wide">Grower lot CSV
                <input type="file" name="CsvFile" accept=".csv,text/csv" required />
            </label>
            <button type="submit">Preview Import</button>
        </form>
    </section>

    @if (importPreview is not null)
    {
        <section class="panel">
            <h2>Import Preview</h2>
            <div class="metric-grid">
                <div><strong>@importPreview.AddCount</strong><span>Add</span></div>
                <div><strong>@importPreview.UpdateCount</strong><span>Update</span></div>
                <div><strong>@importPreview.UnchangedCount</strong><span>Unchanged</span></div>
                <div><strong>@importPreview.ConflictCount</strong><span>Conflicts</span></div>
                <div><strong>@importPreview.InvalidCount</strong><span>Invalid</span></div>
                <div><strong>@importPreview.InactiveCount</strong><span>Inactive</span></div>
            </div>
            <div class="table-wrap contained-table">
                <table>
                    <thead>
                        <tr>
                            <th>Row</th>
                            <th>Action</th>
                            <th>Grower</th>
                            <th>Lot #</th>
                            <th>Pool Start</th>
                            <th>Message</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in importPreview.Rows.Take(50))
                    {
                        <tr>
                            <td class="numeric-cell">@row.RowNumber</td>
                            <td class="nowrap-cell">@row.Action</td>
                            <td>@row.Grower</td>
                            <td class="nowrap-cell">@row.LotNumber</td>
                            <td class="nowrap-cell">@row.PoolStart</td>
                            <td>@row.Message</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (importPreview.Rows.Count > 50)
            {
                <p class="muted">Showing first 50 preview rows.</p>
            }
            <div class="action-bar">
                <form method="post" action="/MasterData/grower-lots/ImportApply">
                    <input type="hidden" name="CsvText" value="@importPreview.CsvText" />
                    <input type="hidden" name="ConfirmImport" value="true" />
                    <button type="submit" disabled="@(!importPreview.CanApply)">Import Grower Lots</button>
                </form>
                @if (!importPreview.CanApply)
                {
                    <p class="notice warning">Resolve conflicts or invalid rows before applying this import.</p>
                }
            </div>
        </section>
    }
}

<div class="table-wrap">
    <table>
        <thead>
            <tr>
            @foreach (var column in Model.Columns)
            {
                <th>@column</th>
            }
            @if (Model.CanEdit && Model.Type != "index")
            {
                <th>Actions</th>
            }
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items.Count > 0 ? Model.Items : Model.Rows.Select((row, index) => new MasterDataEditItem(index, row, true)))
        {
            <tr class="@(Model.Type == "rooms" ? "room-row" : null)" data-warehouse="@(Model.Type == "rooms" ? item.Cells[0] : null)" data-active="@(Model.Type == "rooms" ? item.Cells[^1] : null)">
            @for (var i = 0; i < item.Cells.Count; i++)
            {
                @if (Model.Type == "fruit-profiles" && i == 5 && item.VarietyColor is not null)
                {
                    <td>
                        <span class="variety-color-preview" style="--variety-color: @item.VarietyColor.HexColor" aria-label="@item.VarietyColor.VarietyName color preview"></span>
                        <span class="nowrap-cell">@item.VarietyColor.HexColor</span>
                    </td>
                }
                else if (Model.Type == "fruit-profiles" && i == 6 && item.VarietyColor is not null)
                {
                    <td>
                        <span class="status @(item.VarietyColor.IsConfigured ? "ready" : "pending")">@(item.VarietyColor.IsConfigured ? "Configured" : "Fallback")</span>
                        <div class="muted">Default @item.VarietyColor.FallbackColor</div>
                    </td>
                }
                else
                {
                    <td>@item.Cells[i]</td>
                }
            }
            @if (Model.CanEdit && Model.Type != "index")
            {
                <td class="button-row">
                    <a class="button secondary-button" href="/MasterData/@Model.Type/Edit/@item.Id">Edit</a>
                    @if (item.IsActive)
                    {
                        <form method="post" action="/MasterData/@Model.Type/Deactivate/@item.Id">
                            <button class="secondary-button" type="submit">Deactivate</button>
                        </form>
                    }
                </td>
            }
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.Type == "rooms")
{
    <script>
        (() => {
            const warehouseFilter = document.getElementById("roomWarehouseFilter");
            const activeFilter = document.getElementById("roomActiveFilter");
            const rows = Array.from(document.querySelectorAll(".room-row"));

            function applyRoomFilters() {
                const warehouse = warehouseFilter.value;
                const active = activeFilter.value;
                rows.forEach(row => {
                    const warehouseMatches = !warehouse || row.dataset.warehouse === warehouse;
                    const activeMatches = !active || row.dataset.active === active;
                    row.hidden = !(warehouseMatches && activeMatches);
                });
            }

            warehouseFilter.addEventListener("change", applyRoomFilters);
            activeFilter.addEventListener("change", applyRoomFilters);
        })();
    </script>
}
