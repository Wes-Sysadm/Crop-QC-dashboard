@model MasterDataPageViewModel
@inject CropQc.Web.Services.IUserAccessService UserAccess
@{
    ViewData["Title"] = Model.Title;
    var links = new[]
    {
        ("Warehouses", "/MasterData/warehouses"),
        ("Rooms", "/MasterData/rooms"),
        ("Fruit Profiles", "/MasterData/fruit-profiles"),
        ("Variety Codes", "/MasterData/fruit-profiles#variety-codes"),
        ("Grades", "/MasterData/grades"),
        ("Defects", "/MasterData/defects"),
        ("Sample types", "/MasterData/sample-types"),
        ("Canonical Growers", "/MasterData/canonical-growers"),
        ("Orchard Blocks", "/MasterData/orchard-blocks"),
        ("Grower Lots", "/MasterData/grower-lots"),
        ("Starch scale values", "/MasterData/starch-scale-values"),
        ("Size thresholds", "/MasterData/size-thresholds"),
        ("Treatment Chemicals", "/MasterData/treatment-chemicals"),
        ("Processors", "/MasterData/processors"),
        ("Sales Desks", "/MasterData/sales-desks")
    };
    var roomWarehouseOptions = Model.Type == "rooms"
        ? Model.Items.Select(x => x.Cells[0]).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList()
        : new List<string>();
    var importPreview = Model.ImportPreview;
    var canOpenConfiguration = await UserAccess.HasAccessAsync(User, ApplicationAreas.Configuration, PageAccessLevel.Admin, Context.RequestAborted);
}

<h1>@Model.Title</h1>
@if (Model.DataWarning is not null)
{
    <p class="notice warning">@Model.DataWarning</p>
}

<nav class="toolbar">
@foreach (var link in links)
{
    <a class="button" href="@link.Item2">@link.Item1</a>
}
@if (Model.CanEdit)
{
    @if (canOpenConfiguration)
    {
        <a class="button secondary-button" href="/Admin/Configuration">Configuration</a>
    }
}
</nav>

@if (Model.Type is "canonical-growers" or "grower-lots" or "orchard-blocks")
{
}

@if (Model.Type == "rooms")
{
    @if (Model.Items.Count == 0)
    {
        <p class="notice warning">No rooms are currently configured. Set <code>Database__SeedMasterDataOnStartup=true</code> and redeploy to add the required MVP 1 room list, then verify <code>/health/master-data</code>.</p>
    }
    <section class="toolbar" aria-label="Room filters">
        <div class="field">
            <label>Warehouse</label>
            <select id="roomWarehouseFilter">
                <option value="">All warehouses</option>
                @foreach (var warehouseCode in roomWarehouseOptions)
                {
                    <option value="@warehouseCode">@warehouseCode</option>
                }
            </select>
        </div>
        <div class="field">
            <label>Active Status</label>
            <select id="roomActiveFilter">
                <option value="">All statuses</option>
                <option value="Yes">Active</option>
                <option value="No">Inactive</option>
            </select>
        </div>
    </section>
}

@if (TempData["Error"] is not null)
{
    <p class="notice warning">@TempData["Error"]</p>
}
@if (TempData["Success"] is not null)
{
    <p class="notice success">@TempData["Success"]</p>
}

@if (Model.Type is "canonical-growers" or "grower-lots" or "orchard-blocks")
{
    <section class="panel" aria-labelledby="orchardIdentitySearchHeading">
        <h2 id="orchardIdentitySearchHeading">Search growers, lots, or orchards</h2>
        <p class="muted">One search covers canonical growers, Grower Lots, canonical orchards and blocks, aliases, confirmed receipt identities, and confirmed Field Sample identities. Discovery does not merge records or create an orchard.</p>
        <label class="field wide">Grower / Grower Lot / Orchard
            <input id="orchardIdentitySearch" type="search" autocomplete="off" placeholder="Enter at least 2 characters" />
        </label>
        <p id="orchardIdentitySearchStatus" class="muted" aria-live="polite"></p>
        <div id="orchardIdentitySearchResults" class="table-wrap contained-table" hidden>
            <table>
                <thead>
                    <tr>
                        <th>Result type</th>
                        <th>Identity</th>
                        <th>Grower / number</th>
                        <th>Orchard / block / lot</th>
                        <th>Facility / crop year</th>
                        <th>Resolution</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </section>
}

@if (Model.CanEdit && Model.Type != "index")
{
    <section class="panel">
        <h2>Add @Model.Title</h2>
        <form class="form-grid" method="post" action="/MasterData/@Model.Type/Save">
            @await Html.PartialAsync("_MasterDataFields", Model.EditForm ?? new MasterDataEditForm { Type = Model.Type })
            <button type="submit">Add</button>
        </form>
    </section>
}

@if (Model.CanEdit && Model.Type == "grower-lots")
{
    <section class="panel">
        <h2>Import Grower Lots</h2>
        <p class="muted">Upload a CSV with <strong>Grower</strong>, <strong>Grower Number</strong>, and <strong>Pool Start</strong>. Only active reviewed Grower Numbers are accepted; names are taken from the reviewed Grower master. Existing PoolStart values and historical rows are preserved.</p>
        <form class="form-grid" method="post" enctype="multipart/form-data" action="/MasterData/grower-lots/ImportPreview">
            <label class="field wide">Grower lot CSV
                <input type="file" name="CsvFile" accept=".csv,text/csv" required />
            </label>
            <button type="submit">Preview Import</button>
        </form>
    </section>

    @if (importPreview is not null)
    {
        <section class="panel">
            <h2>Import Preview</h2>
            <div class="metric-grid">
                <div><strong>@importPreview.AddCount</strong><span>Add</span></div>
                <div><strong>@importPreview.UpdateCount</strong><span>Update</span></div>
                <div><strong>@importPreview.UnchangedCount</strong><span>Unchanged</span></div>
                <div><strong>@importPreview.ConflictCount</strong><span>Conflicts</span></div>
                <div><strong>@importPreview.InvalidCount</strong><span>Invalid</span></div>
                <div><strong>@importPreview.InactiveCount</strong><span>Inactive</span></div>
            </div>
            <div class="table-wrap contained-table">
                <table>
                    <thead>
                        <tr>
                            <th>Row</th>
                            <th>Action</th>
                            <th>Grower</th>
                            <th>Grower Number</th>
                            <th>Pool Start</th>
                            <th>Message</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in importPreview.Rows.Take(50))
                    {
                        <tr>
                            <td class="numeric-cell">@row.RowNumber</td>
                            <td class="nowrap-cell">@row.Action</td>
                            <td>@row.Grower</td>
                            <td class="nowrap-cell">@row.LotNumber</td>
                            <td class="nowrap-cell">@row.PoolStart</td>
                            <td>@row.Message</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (importPreview.Rows.Count > 50)
            {
                <p class="muted">Showing first 50 preview rows.</p>
            }
            <div class="action-bar">
                <form method="post" action="/MasterData/grower-lots/ImportApply">
                    <input type="hidden" name="CsvText" value="@importPreview.CsvText" />
                    <input type="hidden" name="ConfirmImport" value="true" />
                    <button type="submit" disabled="@(!importPreview.CanApply)">Import Grower Lots</button>
                </form>
                @if (!importPreview.CanApply)
                {
                    <p class="notice warning">Resolve conflicts or invalid rows before applying this import.</p>
                }
            </div>
        </section>
    }
}

@if (Model.Type == "canonical-growers" && Model.UnmappedGrowers.Count > 0)
{
    <section class="panel">
        <div class="room-card-header">
            <div>
                <h2>Unmapped source growers</h2>
                <p class="muted">Resolve source grower names or numbers that do not yet map to a canonical grower.</p>
            </div>
            <span class="status pending">@Model.UnmappedGrowers.Count need review</span>
        </div>
        <div class="table-wrap contained-table">
            <table>
                <thead>
                    <tr>
                        <th>Source grower</th>
                        <th>Grower number</th>
                        <th>Facility</th>
                        <th>Crop years</th>
                        <th>Receipts</th>
                        <th>Lots</th>
                        <th>Bins received</th>
                        @if (Model.CanEdit)
                        {
                            <th>Action</th>
                        }
                    </tr>
                </thead>
                <tbody>
                @foreach (var source in Model.UnmappedGrowers.Take(50))
                {
                    <tr>
                        <td>@source.SourceGrowerName</td>
                        <td>@(string.IsNullOrWhiteSpace(source.GrowerNumber) ? "-" : source.GrowerNumber)</td>
                        <td>@(string.IsNullOrWhiteSpace(source.Facility) ? "-" : source.Facility)</td>
                        <td>@(source.CropYears.Count == 0 ? "-" : string.Join(", ", source.CropYears))</td>
                        <td class="numeric-cell">@source.ReceiptCount</td>
                        <td class="numeric-cell">@source.LotCount</td>
                        <td class="numeric-cell">@source.BinsReceived</td>
                        @if (Model.CanEdit)
                        {
                            <td><a class="button secondary-button" href="@Url.Action("MapGrower", "MasterData", new { sourceGrowerName = source.SourceGrowerName, growerNumber = source.GrowerNumber, facility = source.Facility, cropYear = source.CropYears.LastOrDefault(), returnUrl = Context.Request.Path + Context.Request.QueryString })">Map grower</a></td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (Model.UnmappedGrowers.Count > 50)
        {
            <p class="muted">Showing first 50 unmapped source growers.</p>
        }
    </section>
}

<div class="table-wrap">
    <table>
        <thead>
            <tr>
            @foreach (var column in Model.Columns)
            {
                <th>@column</th>
            }
            @if (Model.CanEdit && Model.Type != "index")
            {
                <th>Actions</th>
            }
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items.Count > 0 ? Model.Items : Model.Rows.Select((row, index) => new MasterDataEditItem(index, row, true)))
        {
            <tr class="@(Model.Type == "rooms" ? "room-row" : null)" data-warehouse="@(Model.Type == "rooms" ? item.Cells[0] : null)" data-active="@(Model.Type == "rooms" ? item.Cells[^1] : null)">
            @for (var i = 0; i < item.Cells.Count; i++)
            {
                @if (Model.Type == "fruit-profiles" && i == 5 && item.VarietyColor is not null)
                {
                    <td>
                        <span class="variety-color-preview" style="--variety-color: @item.VarietyColor.HexColor" aria-label="@item.VarietyColor.VarietyName color preview"></span>
                        <span class="nowrap-cell">@item.VarietyColor.HexColor</span>
                    </td>
                }
                else if (Model.Type == "fruit-profiles" && i == 6 && item.VarietyColor is not null)
                {
                    <td>
                        <span class="status @(item.VarietyColor.IsConfigured ? "ready" : "pending")">@(item.VarietyColor.IsConfigured ? "Configured" : "Fallback")</span>
                        <div class="muted">Default @item.VarietyColor.FallbackColor</div>
                    </td>
                }
                else
                {
                    <td>@item.Cells[i]</td>
                }
            }
            @if (Model.CanEdit && Model.Type != "index")
            {
                <td class="button-row">
                    <a class="button secondary-button" href="/MasterData/@Model.Type/Edit/@item.Id">Edit</a>
                    @if (item.IsActive)
                    {
                        <form method="post" action="/MasterData/@Model.Type/Deactivate/@item.Id">
                            <button class="secondary-button" type="submit">Deactivate</button>
                        </form>
                    }
                </td>
            }
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.Type is "canonical-growers" or "grower-lots" or "orchard-blocks")
{
    <script>
    (() => {
        const input = document.getElementById("orchardIdentitySearch");
        const status = document.getElementById("orchardIdentitySearchStatus");
        const results = document.getElementById("orchardIdentitySearchResults");
        const body = results.querySelector("tbody");
        let timer;
        let request;

        const appendCell = (row, value) => {
            const cell = document.createElement("td");
            cell.textContent = value == null || value === "" ? "—" : String(value);
            row.appendChild(cell);
        };
        const render = (rows) => {
            body.replaceChildren();
            for (const item of rows) {
                const row = document.createElement("tr");
                appendCell(row, item.resultType);
                appendCell(row, item.displayName);
                appendCell(row, [item.growerName, item.growerNumber].filter(Boolean).join(" / "));
                appendCell(row, [item.canonicalOrchardName, item.blockName, item.lotNumber].filter(Boolean).join(" / "));
                appendCell(row, [
                    (item.facilities || []).join(", "),
                    (item.cropYears || []).join(", ")
                ].filter(Boolean).join(" / "));
                appendCell(row, item.canonicalSetupRequired
                    ? "Canonical orchard setup or selection required"
                    : `Confirmed orchard: ${item.canonicalOrchardName}`);
                body.appendChild(row);
            }
            results.hidden = rows.length === 0;
            status.textContent = rows.length === 0
                ? "No existing identity evidence matched."
                : `${rows.length} result${rows.length === 1 ? "" : "s"}.`;
        };
        const search = async () => {
            const query = input.value.trim();
            if (query.length < 2) {
                request?.abort();
                body.replaceChildren();
                results.hidden = true;
                status.textContent = query.length === 0 ? "" : "Enter at least 2 characters.";
                return;
            }
            request?.abort();
            request = new AbortController();
            status.textContent = "Searching…";
            try {
                const response = await fetch(`/MasterData/OrchardIdentity/Search?query=${encodeURIComponent(query)}`, {
                    signal: request.signal,
                    headers: { "Accept": "application/json" }
                });
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                render(await response.json());
            } catch (error) {
                if (error.name === "AbortError") return;
                results.hidden = true;
                status.textContent = "Identity search is temporarily unavailable. Retry or use the existing tables below.";
            }
        };
        input.addEventListener("input", () => {
            clearTimeout(timer);
            timer = setTimeout(search, 350);
        });
    })();
    </script>
}

@if (Model.Type == "rooms")
{
    <script>
        (() => {
            const warehouseFilter = document.getElementById("roomWarehouseFilter");
            const activeFilter = document.getElementById("roomActiveFilter");
            const rows = Array.from(document.querySelectorAll(".room-row"));

            function applyRoomFilters() {
                const warehouse = warehouseFilter.value;
                const active = activeFilter.value;
                rows.forEach(row => {
                    const warehouseMatches = !warehouse || row.dataset.warehouse === warehouse;
                    const activeMatches = !active || row.dataset.active === active;
                    row.hidden = !(warehouseMatches && activeMatches);
                });
            }

            warehouseFilter.addEventListener("change", applyRoomFilters);
            activeFilter.addEventListener("change", applyRoomFilters);
        })();
    </script>
}
