@model MasterDataPageViewModel
@{
    ViewData["Title"] = Model.Title;
    var links = new[]
    {
        ("Warehouses", "/MasterData/warehouses"),
        ("Rooms", "/MasterData/rooms"),
        ("Fruit profiles / variety codes", "/MasterData/fruit-profiles"),
        ("Grades", "/MasterData/grades"),
        ("Defects", "/MasterData/defects"),
        ("Sample types", "/MasterData/sample-types"),
        ("Starch scale values", "/MasterData/starch-scale-values"),
        ("Size thresholds", "/MasterData/size-thresholds")
    };
    var roomWarehouseOptions = Model.Type == "rooms"
        ? Model.Items.Select(x => x.Cells[0]).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList()
        : new List<string>();
}

<h1>@Model.Title</h1>
@if (Model.DataWarning is not null)
{
    <p class="notice warning">@Model.DataWarning</p>
}

<nav class="toolbar">
@foreach (var link in links)
{
    <a class="button" href="@link.Item2">@link.Item1</a>
}
@if (Model.CanEdit)
{
    <a class="button secondary-button" href="/Admin/Configuration">Configuration</a>
}
</nav>

@if (Model.Type == "rooms")
{
    @if (Model.Items.Count == 0)
    {
        <p class="notice warning">No rooms are currently configured. Set <code>Database__SeedMasterDataOnStartup=true</code> and redeploy to add the required MVP 1 room list, then verify <code>/health/master-data</code>.</p>
    }
    <section class="toolbar" aria-label="Room filters">
        <div class="field">
            <label>Warehouse</label>
            <select id="roomWarehouseFilter">
                <option value="">All warehouses</option>
                @foreach (var warehouseCode in roomWarehouseOptions)
                {
                    <option value="@warehouseCode">@warehouseCode</option>
                }
            </select>
        </div>
        <div class="field">
            <label>Active Status</label>
            <select id="roomActiveFilter">
                <option value="">All statuses</option>
                <option value="Yes">Active</option>
                <option value="No">Inactive</option>
            </select>
        </div>
    </section>
}

@if (TempData["Error"] is not null)
{
    <p class="notice warning">@TempData["Error"]</p>
}
@if (TempData["Success"] is not null)
{
    <p class="notice success">@TempData["Success"]</p>
}

@if (Model.CanEdit && Model.Type != "index")
{
    <section class="panel">
        <h2>Add @Model.Title</h2>
        <form class="form-grid" method="post" action="/MasterData/@Model.Type/Save">
            @await Html.PartialAsync("_MasterDataFields", Model.EditForm ?? new MasterDataEditForm { Type = Model.Type })
            <button type="submit">Add</button>
        </form>
    </section>
}

<div class="table-wrap">
    <table>
        <thead>
            <tr>
            @foreach (var column in Model.Columns)
            {
                <th>@column</th>
            }
            @if (Model.CanEdit && Model.Type != "index")
            {
                <th>Actions</th>
            }
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items.Count > 0 ? Model.Items : Model.Rows.Select((row, index) => new MasterDataEditItem(index, row, true)))
        {
            <tr class="@(Model.Type == "rooms" ? "room-row" : null)" data-warehouse="@(Model.Type == "rooms" ? item.Cells[0] : null)" data-active="@(Model.Type == "rooms" ? item.Cells[^1] : null)">
            @foreach (var cell in item.Cells)
            {
                <td>@cell</td>
            }
            @if (Model.CanEdit && Model.Type != "index")
            {
                <td class="button-row">
                    <a class="button secondary-button" href="/MasterData/@Model.Type/Edit/@item.Id">Edit</a>
                    @if (item.IsActive)
                    {
                        <form method="post" action="/MasterData/@Model.Type/Deactivate/@item.Id">
                            <button class="secondary-button" type="submit">Deactivate</button>
                        </form>
                    }
                </td>
            }
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.Type == "rooms")
{
    <script>
        (() => {
            const warehouseFilter = document.getElementById("roomWarehouseFilter");
            const activeFilter = document.getElementById("roomActiveFilter");
            const rows = Array.from(document.querySelectorAll(".room-row"));

            function applyRoomFilters() {
                const warehouse = warehouseFilter.value;
                const active = activeFilter.value;
                rows.forEach(row => {
                    const warehouseMatches = !warehouse || row.dataset.warehouse === warehouse;
                    const activeMatches = !active || row.dataset.active === active;
                    row.hidden = !(warehouseMatches && activeMatches);
                });
            }

            warehouseFilter.addEventListener("change", applyRoomFilters);
            activeFilter.addEventListener("change", applyRoomFilters);
        })();
    </script>
}
