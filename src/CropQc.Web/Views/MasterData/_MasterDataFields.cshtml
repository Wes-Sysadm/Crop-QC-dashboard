@model MasterDataEditForm
@inject CropQc.Data.CropQcDbContext DbContext
@{
    var warehouses = DbContext.Warehouses.OrderBy(x => x.Code).ToList();
    var commodityOptions = (Model.CommodityOptions.Count > 0 ? Model.CommodityOptions : new[] { "Apple", "Pear" })
        .Append(Model.FruitType)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();
    var commodityListId = $"commodity-options-{Model.Type}";
}
<input type="hidden" name="Id" value="@Model.Id" />
<input type="hidden" name="Type" value="@Model.Type" />

@if (Model.Type == "rooms")
{
    <div class="field"><label>Warehouse</label><select name="WarehouseId" required><option value="">Select</option>@foreach (var warehouse in warehouses){<option value="@warehouse.Id" selected="@(Model.WarehouseId == warehouse.Id ? "selected" : null)">@warehouse.Code</option>}</select></div>
}

@if (Model.Type is "warehouses" or "grades")
{
    <div class="field"><label>Code</label><input name="Code" value="@Model.Code" required /></div>
    <div class="field"><label>Name / Description</label><input name="Name" value="@Model.Name" required /></div>
}
else if (Model.Type == "rooms")
{
    <div class="field"><label>Code</label><input name="Code" value="@Model.Code" required /></div>
    <div class="field"><label>Name</label><input name="Name" value="@Model.Name" required /></div>
    <div class="field"><label>Capacity Bins</label><input name="CapacityBins" type="number" min="0" value="@Model.CapacityBins" required /></div>
}
else if (Model.Type == "fruit-profiles")
{
    <div class="field"><label>Variety Code</label><input name="Code" value="@Model.Code" required /></div>
    <div class="field"><label>Name</label><input name="Name" value="@Model.Name" required /></div>
    <div class="field"><label>Description</label><input name="Description" value="@Model.Description" /></div>
    <div class="field wide">
        <label>Commodity</label>
        <input name="FruitType" value="@Model.FruitType" list="@commodityListId" required />
        <datalist id="@commodityListId">
            @foreach (var commodity in commodityOptions)
            {
                <option value="@commodity"></option>
            }
        </datalist>
        <span class="muted">Choose an existing commodity or type a new one, such as Cherry, Peach, Nectarine, or Apricot.</span>
    </div>
    <div class="field"><label>Production Type</label><select name="ProductionType" required><option selected="@(Model.ProductionType == "Conventional" ? "selected" : null)">Conventional</option><option selected="@(Model.ProductionType == "Organic" ? "selected" : null)">Organic</option></select></div>
}
else if (Model.Type is "defects" or "sample-types")
{
    <div class="field"><label>Name</label><input name="Name" value="@Model.Name" required /></div>
}
else if (Model.Type == "starch-scale-values")
{
    <div class="field"><label>Value</label><input name="Value" type="number" step="0.1" value="@Model.Value" required /></div>
    <div class="field"><label>Display Order</label><input name="SortOrder" type="number" value="@Model.SortOrder" /></div>
}
else if (Model.Type == "size-thresholds")
{
    <div class="field wide">
        <label>Commodity</label>
        <input name="FruitType" value="@Model.FruitType" list="@commodityListId" required />
        <datalist id="@commodityListId">
            @foreach (var commodity in commodityOptions)
            {
                <option value="@commodity"></option>
            }
        </datalist>
    </div>
    <div class="field"><label>Size Category</label><input name="SizeCategory" type="number" value="@Model.SizeCategory" required /></div>
    <div class="field"><label>Minimum Weight Grams</label><input name="MinimumWeightGrams" type="number" step="0.0001" value="@Model.MinimumWeightGrams" required /></div>
    <p class="muted wide">Weights are minimum thresholds. Fruit is assigned the largest size category it qualifies for; below the smallest threshold is Undersized.</p>
}

<label class="checkbox-field wide"><input type="checkbox" name="IsActive" value="true" checked="@Model.IsActive" /> Active</label><input type="hidden" name="IsActive" value="false" />
