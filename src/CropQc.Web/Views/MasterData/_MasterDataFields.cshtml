@model MasterDataEditForm
@inject CropQc.Data.CropQcDbContext DbContext
@inject CropQc.Web.Services.IFacilityContextService FacilityContext
@{
    var warehouses = DbContext.Warehouses.OrderBy(x => x.Code).ToList();
    var endOfDayFillGroups = Model.Type == "rooms"
        ? DbContext.EndOfDayFillReportGroups.Where(x => x.IsActive).OrderBy(x => x.Facility).ThenBy(x => x.Name).ToList()
        : [];
    var commodityOptions = (Model.CommodityOptions.Count > 0 ? Model.CommodityOptions : new[] { "Apple", "Pear" })
        .Append(Model.FruitType)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();
    var commodityListId = $"commodity-options-{Model.Type}";
}
<input type="hidden" name="Id" value="@Model.Id" />
<input type="hidden" name="Type" value="@Model.Type" />

@if (Model.Type == "rooms")
{
    <div class="field"><label>Warehouse</label><select name="WarehouseId" required><option value="">Select</option>@foreach (var warehouse in warehouses){<option value="@warehouse.Id" selected="@(Model.WarehouseId == warehouse.Id ? "selected" : null)">@warehouse.Code</option>}</select></div>
}

@if (Model.Type is "warehouses" or "grades")
{
    <div class="field"><label>Code</label><input name="Code" value="@Model.Code" required /></div>
    <div class="field"><label>Name / Description</label><input name="Name" value="@Model.Name" required /></div>
}
else if (Model.Type == "rooms")
{
    <div class="field"><label>Code</label><input name="Code" value="@Model.Code" required /></div>
    <div class="field"><label>Name</label><input name="Name" value="@Model.Name" required /></div>
    <div class="field"><label>Compu-Tech Code</label><input name="CompuTechCode" value="@Model.CompuTechCode" maxlength="100" /></div>
    <div class="field"><label>Capacity Bins</label><input name="CapacityBins" type="number" min="0" value="@Model.CapacityBins" required /></div>
    <div class="field wide">
        <label>End of Day Fill Report</label>
        <select name="EndOfDayFillReportGroupId" data-end-of-day-fill-group>
            <option value="">Not included</option>
            @foreach (var group in endOfDayFillGroups)
            {
                <option value="@group.Id" data-facility="@group.Facility" selected="@(Model.EndOfDayFillReportGroupId == group.Id ? "selected" : null)">@group.Name</option>
            }
        </select>
        <span class="muted" data-end-of-day-fill-group-help>Only active reports for the selected room warehouse are available. This room record is the authoritative report membership.</span>
    </div>
    <script>
        (() => {
            const warehouse = document.querySelector('select[name="WarehouseId"]');
            const group = document.querySelector('[data-end-of-day-fill-group]');
            const help = document.querySelector('[data-end-of-day-fill-group-help]');
            const facilities = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(warehouses.ToDictionary(x => x.Id.ToString(), x => FacilityContext.GetOperatingCompanyFacility(x.Code, x.Name))));
            const filterGroups = () => {
                const facility = facilities[warehouse?.value] || "";
                [...group.options].forEach(option => {
                    if (!option.value) return;
                    const incompatible = option.dataset.facility !== facility;
                    option.hidden = incompatible && !option.selected;
                    option.disabled = incompatible && !option.selected;
                });
                const selected = group.selectedOptions[0];
                const incompatibleSelection = selected?.value && selected.dataset.facility !== facility;
                group.setCustomValidity(incompatibleSelection
                    ? `The selected ${selected.dataset.facility} report cannot be assigned to this ${facility || "unresolved"} room.`
                    : "");
                help.textContent = incompatibleSelection
                    ? `The selected report belongs to ${selected.dataset.facility}. Choose ${facility || "the room's facility"} or Not included before saving.`
                    : "Only active reports for the selected room warehouse are available. This room record is the authoritative report membership.";
            };
            warehouse?.addEventListener("change", filterGroups);
            group?.addEventListener("change", filterGroups);
            filterGroups();
        })();
    </script>
}
else if (Model.Type == "grower-lots")
{
    <div class="field wide"><label>Grower</label><input name="Name" value="@Model.Name" required /></div>
    <div class="field"><label>Lot #</label><input name="Code" value="@Model.Code" required /></div>
    <div class="field"><label>Pool Start</label><input name="PoolStart" value="@Model.PoolStart" maxlength="20" /></div>
    <div class="field wide"><label>Notes</label><input name="Description" value="@Model.Description" maxlength="1000" /></div>
    <p class="muted wide">Pool Start is the first two letters/characters of the pool and is stored for future final-results analysis.</p>
}
else if (Model.Type == "canonical-growers")
{
    <div class="field wide"><label>Canonical grower name</label><input name="Name" value="@Model.Name" required maxlength="200" /></div>
    <div class="field wide">
        <label>Aliases / source names</label>
        <textarea name="GrowerAliases" rows="6" placeholder="One alias per line">@Model.GrowerAliases</textarea>
        <span class="muted">Original receipt and sample values stay unchanged. These aliases only group reporting cards.</span>
    </div>
    <div class="field wide">
        <label>Grower numbers</label>
        <textarea name="GrowerNumbers" rows="5" placeholder="One grower number per line">@Model.GrowerNumbers</textarea>
        <span class="muted">Numbers are mapped to this canonical grower for review/search. If a number is reused in a different scope, leave it unmapped until scoped mapping is added.</span>
    </div>
}
else if (Model.Type == "orchard-blocks")
{
    <div class="field wide"><label>Orchard</label><input name="Name" value="@Model.Name" required maxlength="200" /></div>
    <div class="field wide"><label>Canonical block name</label><input name="Code" value="@Model.Code" required maxlength="150" /></div>
    <div class="field wide">
        <label>Aliases / alternate block spellings</label>
        <textarea name="BlockAliases" rows="5" placeholder="One alias per line">@Model.BlockAliases</textarea>
        <span class="muted">Aliases are scoped to the orchard. Original Field Sample block text remains unchanged.</span>
    </div>
    <div class="field wide"><label>Notes</label><input name="Description" value="@Model.Description" maxlength="1000" /></div>
}
else if (Model.Type == "fruit-profiles")
{
    <div class="field"><label>Variety Code</label><input name="Code" value="@Model.Code" required /></div>
    <div class="field"><label>Name</label><input name="Name" value="@Model.Name" required /></div>
    <div class="field"><label>Description</label><input name="Description" value="@Model.Description" /></div>
    <div class="field wide">
        <label>Commodity</label>
        <input name="FruitType" value="@Model.FruitType" list="@commodityListId" required />
        <datalist id="@commodityListId">
            @foreach (var commodity in commodityOptions)
            {
                <option value="@commodity"></option>
            }
        </datalist>
        <span class="muted">Choose an existing commodity or type a new one, such as Cherry, Peach, Nectarine, or Apricot.</span>
    </div>
    <div class="field"><label>Production Type</label><select name="ProductionType" required><option selected="@(Model.ProductionType == "Conventional" ? "selected" : null)">Conventional</option><option selected="@(Model.ProductionType == "Organic" ? "selected" : null)">Organic</option></select></div>
    <input type="hidden" name="VarietyColorKey" value="@Model.VarietyColorKey" />
    <input type="hidden" name="CanonicalVarietyName" value="@Model.CanonicalVarietyName" />
    <input type="hidden" name="VarietyFallbackColor" value="@Model.VarietyFallbackColor" />
    <input type="hidden" name="VarietyColorIsConfigured" value="@(Model.VarietyColorIsConfigured ? "true" : "false")" />
    <section class="panel wide variety-master-color-panel">
        <div class="room-card-header">
            <div>
                <h3>Dashboard color</h3>
                <p class="muted">Managed with the variety master data. Aliases use the same canonical color.</p>
            </div>
            <span class="status @(Model.VarietyColorIsConfigured ? "ready" : "pending")">@(Model.VarietyColorIsConfigured ? "Configured" : "Fallback")</span>
        </div>
        <div class="form-grid compact-form-grid">
            <div class="field">
                <label>Canonical variety</label>
                <input value="@(string.IsNullOrWhiteSpace(Model.CanonicalVarietyName) ? Model.Name : Model.CanonicalVarietyName)" readonly />
            </div>
            <div class="field">
                <label>Known aliases</label>
                <input name="VarietyAliases" value="@(string.IsNullOrWhiteSpace(Model.VarietyAliases) ? "None configured" : Model.VarietyAliases)" readonly />
            </div>
            <label class="field">
                <span>Picker</span>
                <input type="color" value="@(string.IsNullOrWhiteSpace(Model.VarietyHexColor) ? "#2F80ED" : Model.VarietyHexColor)" data-master-color-picker />
            </label>
            <label class="field">
                <span>Hex</span>
                <input name="VarietyHexColor" value="@Model.VarietyHexColor" pattern="#[0-9A-Fa-f]{6}" maxlength="7" data-master-color-hex />
            </label>
            <div class="field">
                <label>Preview</label>
                <span class="variety-color-preview large-preview" style="--variety-color: @(string.IsNullOrWhiteSpace(Model.VarietyHexColor) ? "#2F80ED" : Model.VarietyHexColor)" data-master-color-preview aria-label="Variety color preview"></span>
                <span class="muted">Fallback @Model.VarietyFallbackColor</span>
            </div>
            <p class="muted wide" data-master-color-contrast>Text is shown over a protected content panel on room cards; use a distinct color for quick scanning.</p>
            <button class="secondary-button" type="submit" name="ResetVarietyColor" value="true" disabled="@(!Model.VarietyColorIsConfigured ? "disabled" : null)">Reset color to fallback</button>
        </div>
    </section>
}
else if (Model.Type is "defects" or "sample-types")
{
    <div class="field"><label>Name</label><input name="Name" value="@Model.Name" required /></div>
}
else if (Model.Type == "starch-scale-values")
{
    <div class="field"><label>Value</label><input name="Value" type="number" step="0.1" value="@Model.Value" required /></div>
    <div class="field"><label>Display Order</label><input name="SortOrder" type="number" value="@Model.SortOrder" /></div>
}
else if (Model.Type == "size-thresholds")
{
    <div class="field wide">
        <label>Commodity</label>
        <input name="FruitType" value="@Model.FruitType" list="@commodityListId" required />
        <datalist id="@commodityListId">
            @foreach (var commodity in commodityOptions)
            {
                <option value="@commodity"></option>
            }
        </datalist>
    </div>
    <div class="field"><label>Size Category</label><input name="SizeCategory" type="number" value="@Model.SizeCategory" required /></div>
    <div class="field"><label>Minimum Weight Grams</label><input name="MinimumWeightGrams" type="number" step="0.0001" value="@Model.MinimumWeightGrams" required /></div>
    <p class="muted wide">Weights are minimum thresholds. Fruit is assigned the largest size category it qualifies for; below the smallest threshold is Undersized.</p>
}

<label class="checkbox-field wide"><input type="checkbox" name="IsActive" value="true" checked="@Model.IsActive" /> Active</label><input type="hidden" name="IsActive" value="false" />

@if (Model.Type == "fruit-profiles")
{
    <script>
        document.querySelectorAll(".variety-master-color-panel").forEach(panel => {
            const picker = panel.querySelector("[data-master-color-picker]");
            const hex = panel.querySelector("[data-master-color-hex]");
            const preview = panel.querySelector("[data-master-color-preview]");
            const contrast = panel.querySelector("[data-master-color-contrast]");
            const apply = value => {
                if (!/^#[0-9A-Fa-f]{6}$/.test(value)) return;
                const color = value.toUpperCase();
                picker.value = color;
                hex.value = color;
                preview.style.setProperty("--variety-color", color);
                const red = parseInt(color.slice(1, 3), 16);
                const green = parseInt(color.slice(3, 5), 16);
                const blue = parseInt(color.slice(5, 7), 16);
                const luminance = (0.2126 * red + 0.7152 * green + 0.0722 * blue) / 255;
                contrast.textContent = luminance > 0.78
                    ? "Very light colors may need the protected room-card text panel for readability."
                    : "Text is shown over a protected content panel on room cards; use a distinct color for quick scanning.";
            };
            picker?.addEventListener("input", () => apply(picker.value));
            hex?.addEventListener("input", () => apply(hex.value));
        });
    </script>
}
