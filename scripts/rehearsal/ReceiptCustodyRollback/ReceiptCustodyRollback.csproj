<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="DispatchProbe/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(FrozenApplicationPath)' == ''">
    <ProjectReference Include="../../../src/CropQc.Web/CropQc.Web.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(FrozenApplicationPath)' != ''">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="$(FrozenApplicationPath)/*.dll" />
  </ItemGroup>
</Project>
