<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Crop QC Station"
    Manufacturer="Fruit and Land Company"
    Version="$(var.ProductVersion)"
    UpgradeCode="{B4A785D6-D30F-4C6E-89A8-3683F27066E1}"
    Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Crop QC Station is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="CompanyFolder" Name="CropQc">
        <Directory Id="INSTALLFOLDER" Name="QcStation" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Crop QC Station" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="{9F116619-55E0-452A-B5FA-FA874AB83379}">
      <Shortcut
        Id="StartMenuShortcut"
        Name="Crop QC Station"
        Description="Launch Crop QC Station"
        Target="[INSTALLFOLDER]CropQc.QcStation.WinForms.exe"
        WorkingDirectory="INSTALLFOLDER" />
      <Shortcut
        Id="DesktopShortcut"
        Directory="DesktopFolder"
        Name="Crop QC Station"
        Description="Launch Crop QC Station"
        Target="[INSTALLFOLDER]CropQc.QcStation.WinForms.exe"
        WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\CropQc\QcStation" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="ProtocolHandler" Directory="INSTALLFOLDER" Guid="{5E717FC6-3AE3-49D5-A4ED-602748E56DE2}">
      <RegistryKey Root="HKCR" Key="cropqcstation">
        <RegistryValue Type="string" Value="URL:Crop QC Station" KeyPath="yes" />
        <RegistryValue Name="URL Protocol" Type="string" Value="" />
        <RegistryKey Key="DefaultIcon">
          <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]CropQc.QcStation.WinForms.exe&quot;,0" />
        </RegistryKey>
        <RegistryKey Key="shell\open\command">
          <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]CropQc.QcStation.WinForms.exe&quot; &quot;%1&quot;" />
        </RegistryKey>
      </RegistryKey>
    </Component>

    <Feature Id="MainFeature" Title="Crop QC Station" Level="1">
      <ComponentGroupRef Id="PublishedAppComponents" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="ProtocolHandler" />
    </Feature>
  </Package>
</Wix>
