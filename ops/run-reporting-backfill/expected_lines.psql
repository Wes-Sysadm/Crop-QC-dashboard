DROP TABLE IF EXISTS expected_run_reporting_lines;
CREATE TEMP TABLE expected_run_reporting_lines (
    entry_id bigint PRIMARY KEY,
    facility_code text NOT NULL,
    crop_year integer NOT NULL,
    fruit_profile_id integer NOT NULL,
    variety_code text NOT NULL,
    production_type text NOT NULL,
    is_organic boolean NOT NULL,
    grower_number text NOT NULL
);

